/** app.wxss **/
page {
  height: 100%;
  width: 100%;
  background-color: #080a0f;
  color: #f3f4f6;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum";
  text-rendering: optimizeLegibility;
  box-sizing: border-box;
  overflow: hidden;
  -webkit-font-smoothing: antialiased;
}

.app-container,
.pack-page-container,
.mine-page-container,
.leaderboard-page-container {
  background-color: #080a0f;
  transform: translateZ(0);
  -webkit-transform: translateZ(0);
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
}

view, text, button, input, scroll-view, image {
  box-sizing: border-box;
  -webkit-tap-highlight-color: transparent;
  -webkit-touch-callout: none;
}

button::after {
  border: none;
}

/* 全局统一样式：矢量返回箭头图标 (替代「<返回」文本，标准返回键) */
.back-chevron-arrow {
  width: 18rpx;
  height: 18rpx;
  border-left: 4rpx solid #fbbf24;
  border-bottom: 4rpx solid #fbbf24;
  transform: rotate(45deg);
  margin-left: 6rpx;
  box-sizing: border-box;
}

/* 保持主页 index 与名烟品鉴舞台顶栏全屏沉浸纯透 */
.app-container .custom-navbar,
.pack-page-container .custom-navbar.navbar-stage-immersive {
  background: none !important;
  border-bottom: none !important;
  box-shadow: none !important;
}

/* ==================== 全局通用：VIP 尊享动态极光天幕与浮光星尘 ==================== */
.vip-ambient-stage {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 0;
  overflow: hidden;
}

/* 🏎️ 小米汽车 8 层高透镜面清漆全局反光弧面 (Global Clear-Coat Horizon Reflection) */
.vip-ambient-stage::after {
  content: '';
  position: absolute;
  top: -20%;
  left: -20%;
  width: 140%;
  height: 60%;
  background: radial-gradient(ellipse 80% 50% at 50% 20%, rgba(255, 255, 255, 0.09) 0%, rgba(255, 255, 255, 0.02) 45%, transparent 70%);
  transform: rotate(-8deg);
  pointer-events: none;
  opacity: 0.75;
}

.vip-aurora-orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(56rpx);
  opacity: 0.55;
  animation: globalVipOrbBreath 6s infinite alternate ease-in-out;
}

.vip-aurora-orb.orb-primary {
  width: 520rpx;
  height: 300rpx;
  top: -50rpx;
  left: 50%;
  margin-left: -260rpx;
  background: radial-gradient(circle, var(--vip-theme-orb1, rgba(168, 85, 247, 0.38)) 0%, transparent 72%);
}

.vip-aurora-orb.orb-secondary {
  width: 400rpx;
  height: 400rpx;
  top: 38%;
  right: -120rpx;
  background: radial-gradient(circle, var(--vip-theme-orb2, rgba(192, 132, 252, 0.20)) 0%, transparent 70%);
  animation-delay: -3s;
}

@keyframes globalVipOrbBreath {
  0% { transform: scale(0.92); opacity: 0.42; }
  100% { transform: scale(1.12); opacity: 0.72; }
}

.vip-spark {
  position: absolute;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--vip-theme-spark, #f5d0fe);
  box-shadow: 0 0 14rpx var(--vip-theme-spark-glow, #c084fc);
  opacity: 0.6;
  animation: globalVipSparkFloat 5s infinite ease-in-out;
}

.vip-spark.s1 { top: 16%; left: 16%; animation-delay: 0s; }
.vip-spark.s2 { top: 32%; right: 14%; width: 6rpx; height: 6rpx; animation-delay: -1.6s; }
.vip-spark.s3 { top: 62%; left: 18%; width: 6rpx; height: 6rpx; animation-delay: -3.2s; }

@keyframes globalVipSparkFloat {
  0%, 100% { transform: translateY(0) scale(0.8); opacity: 0.25; }
  50% { transform: translateY(-24rpx) scale(1.2); opacity: 0.85; }
}

