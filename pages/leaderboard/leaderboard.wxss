/* pages/leaderboard/leaderboard.wxss */
.leaderboard-page-container {
  width: 100vw;
  height: 100vh;
  background: 
    radial-gradient(circle at 50% 6%, rgba(245, 158, 11, 0.22) 0%, rgba(217, 119, 6, 0.08) 40%, transparent 68%),
    linear-gradient(180deg, #182030 0%, #111624 36%, #0b0f18 100%);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  position: relative;
  box-sizing: border-box;
}

.leaderboard-page-container.theme-emerald,
.leaderboard-page-container.theme-day {
  background: 
    radial-gradient(circle at 50% 6%, rgba(16, 185, 129, 0.35) 0%, rgba(5, 150, 105, 0.10) 40%, transparent 68%),
    linear-gradient(180deg, #122b23 0%, #0c1c16 38%, #07120e 100%);
}

.leaderboard-page-container.theme-purple,
.leaderboard-page-container.theme-month {
  background: 
    radial-gradient(circle at 50% 6%, rgba(168, 85, 247, 0.35) 0%, rgba(126, 34, 206, 0.10) 40%, transparent 68%),
    linear-gradient(180deg, #25163d 0%, #180d29 38%, #0f071a 100%);
}

.leaderboard-page-container.theme-glacier,
.leaderboard-page-container.theme-lifetime {
  background: 
    radial-gradient(circle at 50% 6%, rgba(251, 191, 36, 0.38) 0%, rgba(180, 83, 9, 0.14) 42%, transparent 70%),
    linear-gradient(180deg, #2e2212 0%, #1f160b 38%, #140d06 100%);
}

.leaderboard-page-container.theme-gold {
  background: radial-gradient(circle at 50% 18%, #362916 0%, #141008 78%);
}

/* ==================== 顶部自定义导航栏 ==================== */
.custom-navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  background: rgba(8, 10, 15, 0.85);
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  box-sizing: border-box;
}

.theme-day .custom-navbar {
  background: rgba(5, 20, 16, 0.86);
  border-bottom-color: rgba(16, 185, 129, 0.22);
}
.theme-month .custom-navbar {
  background: rgba(16, 10, 28, 0.86);
  border-bottom-color: rgba(168, 85, 247, 0.24);
}
.theme-lifetime .custom-navbar {
  background: rgba(20, 14, 6, 0.88);
  border-bottom-color: rgba(251, 191, 36, 0.26);
}

.navbar-content {
  position: relative;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-left: 20rpx;
  box-sizing: border-box;
}

.nav-back-btn {
  position: relative;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 50%;
  color: #e2e8f0;
  transition: all 0.2s ease;
  padding: 0;
}

.nav-back-btn:active {
  transform: scale(0.92);
  background: rgba(255, 255, 255, 0.16);
}

.nav-center-title-box {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  margin: auto;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  z-index: 5;
}

.nav-center-title-text {
  font-size: 34rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  background: linear-gradient(135deg, #f8fafc 0%, #cbd5e1 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  text-align: center;
}

.nav-placeholder {
  width: 60rpx;
  height: 60rpx;
}
