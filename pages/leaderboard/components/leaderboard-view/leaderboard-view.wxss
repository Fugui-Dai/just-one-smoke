.rank-row-card.top-1 .slogan-icon { color: #fde047; }
.rank-row-card.top-1 .hero-slogan-text { color: #fef08a; font-weight: 600; }

.rank-row-card.top-2 .slogan-icon { color: #94a3b8; }
.rank-row-card.top-2 .hero-slogan-text { color: #f1f5f9; }

.rank-row-card.top-3 .slogan-icon { color: #fb923c; }
.rank-row-card.top-3 .hero-slogan-text { color: #fed7aa; }

.rank-row-card.is-me-card .slogan-icon { color: #38bdf8; }
.rank-row-card.is-me-card .hero-slogan-text { color: #bae6fd; font-weight: 600; }

/* 底部 替烟、省、坚持 一排显示 */
.hero-data-tags {
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
  gap: 6rpx;
  width: 100%;
  overflow: hidden;
}

.data-tag {
  font-size: 21rpx;
  font-weight: 600;
  color: #fbbf24;
  background: rgba(245, 158, 11, 0.10);
  border: 1px solid rgba(245, 158, 11, 0.25);
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  letter-spacing: 0.2rpx;
  white-space: nowrap;
  flex-shrink: 0;
  line-height: 1.25;
}

.data-tag.green {
  color: #34d399;
  background: rgba(16, 185, 129, 0.10);
  border: 1px solid rgba(16, 185, 129, 0.25);
}

.data-tag.purple {
  color: #38bdf8;
  background: rgba(56, 189, 248, 0.10);
  border: 1px solid rgba(56, 189, 248, 0.25);
}

.like-btn-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 4rpx 10rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.08);
  transition: all 0.2s ease;
  flex-shrink: 0;
}

.like-btn-wrap:active {
  transform: scale(0.9);
}

.like-btn-wrap.liked {
  border-color: rgba(239, 68, 68, 0.4);
  background: rgba(239, 68, 68, 0.15);
}

.like-heart { font-size: 22rpx; }
.like-count {
  font-size: 20rpx;
  color: #9ca3af;
  font-weight: 600;
  margin-top: 1rpx;
}

.like-btn-wrap.liked .like-count {
  color: #f87171;
  font-weight: 700;
}

/* 底部收尾文案 */
.list-end-footer {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 36rpx 20rpx 20rpx;
}

.footer-divider-line {
  flex: 1;
  height: 1px;
  background: rgba(255, 255, 255, 0.08);
}

.footer-text {
  font-size: 22rpx;
  color: #64748b;
  letter-spacing: 2rpx;
  font-weight: 500;
}

