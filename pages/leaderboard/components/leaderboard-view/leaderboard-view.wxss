/* components/leaderboard-view/leaderboard-view.wxss */

:host {
  display: block;
  width: 100%;
  height: 100%;
  flex: 1;
  min-height: 0;
  overflow: hidden;
  box-sizing: border-box;
}

.leaderboard-scroll {
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  -webkit-overflow-scrolling: touch;
}

.leaderboard-content {
  padding: 24rpx;
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom, 0px));
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  box-sizing: border-box;
}

/* 我的排位尊贵卡片 */
.my-rank-card {
  position: relative;
  overflow: hidden;
  background: linear-gradient(145deg, rgba(22, 28, 42, 0.75) 0%, rgba(12, 16, 26, 0.92) 100%);
  border: 1px solid rgba(255, 255, 255, 0.10);
  border-radius: 28rpx;
  padding: 26rpx;
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, 0.50), inset 0 1rpx 0 rgba(255, 255, 255, 0.12);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}

/* VIP 翡翠绿主题 (日卡) */
.theme-day .my-rank-card,
.theme-emerald .my-rank-card {
  background: linear-gradient(145deg, rgba(6, 78, 59, 0.38) 0%, rgba(4, 47, 46, 0.22) 55%, rgba(6, 14, 12, 0.92) 100%);
  border: 1.5px solid rgba(52, 211, 153, 0.55);
  box-shadow: 0 14rpx 38rpx rgba(0, 0, 0, 0.65), 0 0 24rpx rgba(16, 185, 129, 0.22);
}

/* VIP 暗紫星河主题 (月卡) */
.theme-month .my-rank-card,
.theme-purple .my-rank-card {
  background: linear-gradient(145deg, rgba(88, 28, 135, 0.38) 0%, rgba(59, 7, 100, 0.22) 55%, rgba(12, 8, 20, 0.92) 100%);
  border: 1.5px solid rgba(192, 132, 252, 0.55);
  box-shadow: 0 14rpx 38rpx rgba(0, 0, 0, 0.65), 0 0 24rpx rgba(168, 85, 247, 0.22);
}

/* VIP 曜石黑金流光排位卡皮肤 (至尊永久卡) */
.theme-lifetime .my-rank-card,
.theme-glacier .my-rank-card,
.my-rank-card.is-vip-rank-card {
  background:
    radial-gradient(circle at 12% 20%, rgba(251, 191, 36, 0.25) 0%, transparent 58%),
    linear-gradient(135deg, #2a2012 0%, #161310 48%, #0d0f14 100%);
  border: 1.5px solid rgba(251, 191, 36, 0.65);
  box-shadow: 0 14rpx 38rpx rgba(0, 0, 0, 0.72), 0 0 28rpx rgba(251, 191, 36, 0.25), inset 0 1rpx 2rpx rgba(255, 243, 199, 0.25);
}

.my-rank-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.my-rank-identity {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
}

.my-rank-avatar-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  gap: 6rpx;
}

.my-rank-badge-num {
  width: 86rpx;
  height: 32rpx;
  box-sizing: border-box;
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 800;
  color: #111827;
  background: linear-gradient(135deg, #fef08a, #f59e0b);
  border-radius: 8rpx;
  box-shadow: 0 4rpx 10rpx rgba(245, 158, 11, 0.4);
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.5rpx;
  text-align: center;
}

.my-rank-avatar-wrap {
  position: relative;
