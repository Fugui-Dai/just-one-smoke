<scroll-view 
  class="leaderboard-scroll" 
  scroll-y="{{ true }}" 
  enable-back-to-top="{{ true }}" 
  enhanced="{{ true }}" 
  bounces="{{ true }}" 
  show-scrollbar="{{ false }}"
>
  <view class="leaderboard-content {{ vipTheme ? 'theme-' + vipTheme : '' }} {{ vipAnimPhase === 'a' ? 'vip-sweep-phase-a' : 'vip-sweep-phase-b' }}" style="padding-top: calc({{ (topPadding && topPadding > 0) ? topPadding : 88 }}px + 24rpx);">
    
    <!-- 我的排位尊贵卡片 (Sticky My Rank · VIP 尊享曜石黑金流光皮肤与皇冠铭牌) -->
    <view class="my-rank-card {{ isVip ? 'is-vip-rank-card' : '' }}">
      <view class="my-rank-top">
        <view class="my-rank-identity">
          <view class="my-rank-avatar-col">
            <view class="my-rank-avatar-wrap">
              <image class="my-rank-avatar-img {{ isVip ? 'vip-avatar-ring' : '' }}" src="{{ profile.avatarUrl || defaultAvatarSvg }}" mode="aspectFill" binderror="onAvatarError" />
            </view>
            <view class="my-rank-badge-num">No.{{ myRankInfo.rank || 1 }}</view>
          </view>
          <view class="my-rank-text-wrap">
            <view class="my-rank-name-row">
              <text class="my-rank-name {{ isVip ? 'vip-gold-name' : '' }}">{{ profile.nickName || '微信烟友' }}</text>
              <view class="vip-noble-nameplate" wx:if="{{ isVip }}">
                <text class="vnn-crown">👑</text>
                <text class="vnn-txt">VIP</text>
              </view>
              <text 
                class="my-rank-title-tag tier-{{ myRankInfo.titleTier || 'green' }}"
                style="{{ myRankInfo.titleBadgeBg ? ('background: ' + myRankInfo.titleBadgeBg + '; color: ' + myRankInfo.titleTagColor + '; border-color: ' + myRankInfo.titleBorderColor + ';') : '' }}"
              >{{ myRankInfo.title || '无烟先锋' }}</text>
            </view>
            <view class="my-rank-slogan-wrap" wx:if="{{ myRankInfo.quote || profile.customQuote }}">
              <text class="mr-slogan-text">{{ myRankInfo.quote || profile.customQuote }}</text>
            </view>
          </view>
        </view>
        <view class="my-rank-beat">
          <text class="beat-label">自律领先</text>
          <text class="beat-pct">{{ myRankInfo.beatPercent || 50 }}%</text>
        </view>
      </view>
      <view class="my-rank-metrics">
        <view class="metric-item">
          <text class="m-val">{{ totalSubstituted }}</text>
          <text class="m-lbl">累计少抽(支)</text>
        </view>
        <view class="metric-item">
          <text class="m-val">¥{{ totalSavedMoney }}</text>
          <text class="m-lbl">省下烟钱</text>
        </view>
        <view class="metric-item">
          <text class="m-val">{{ quitDays + 1 }}</text>
          <text class="m-lbl">坚持天数</text>
        </view>
      </view>
    </view>

    <!-- 4维同行分榜切换栏 -->
    <view class="rank-category-tabs">
      <view 
        class="rank-cat-tab {{ currentCategory === 'substituted' ? 'active' : '' }}" 
        bindtap="onSwitchCategory" 
        data-category="substituted"
      >
        <text class="rct-text">🌿 少抽榜</text>
      </view>
      <view 
        class="rank-cat-tab {{ currentCategory === 'saved' ? 'active' : '' }}" 
        bindtap="onSwitchCategory" 
        data-category="saved"
      >
        <text class="rct-text">💰 省钱榜</text>
      </view>
      <view 
        class="rank-cat-tab {{ currentCategory === 'days' ? 'active' : '' }}" 
        bindtap="onSwitchCategory" 
        data-category="days"
      >
        <text class="rct-text">⏳ 坚持榜</text>
      </view>
      <view 
        class="rank-cat-tab {{ currentCategory === 'likes' ? 'active' : '' }}" 
        bindtap="onSwitchCategory" 
        data-category="likes"
      >
        <text class="rct-text">❤️ 人气榜</text>
      </view>
    </view>

    <!-- 公平防刷公示徽标 (仅省钱榜展示：防止个人偏好虚高恶意刷榜) -->
    <view class="rank-fairness-pill" wx:if="{{ currentCategory === 'saved' }}">
      <text class="rfp-icon">⚖️</text>
      <text class="rfp-text">同行省钱榜按标准中高档烟基准（¥2.5/支）统算 · 杜绝虚高刷榜</text>
    </view>

    <!-- 英雄榜单列表 -->
    <view class="rank-list-wrapper">
      <view 
        class="rank-row-card {{ item.rank <= 3 ? 'top-' + item.rank : '' }} {{ item.isMe ? 'is-me-card' : '' }} {{ (item.isMe && isVip) ? 'is-vip-me-row' : '' }}"
        wx:for="{{ list }}"
        wx:key="id"
      >
        <!-- 排名序号 / 皇冠 -->
        <view class="rank-number-box">
          <text class="crown-icon" wx:if="{{ item.rank === 1 }}">👑</text>
          <text class="crown-icon" wx:elif="{{ item.rank === 2 }}">🥈</text>
          <text class="crown-icon" wx:elif="{{ item.rank === 3 }}">🥉</text>
          <text class="plain-rank {{ item.isMe ? 'is-me-rank' : '' }}" wx:else>{{ item.rank }}</text>
        </view>

        <!-- 英雄头像与信息 (支持本人高清头像与微信Svg回退) -->
        <image class="hero-avatar-img" src="{{ item.avatarUrl || defaultAvatarSvg }}" mode="aspectFill" wx:if="{{ item.avatarUrl || item.isMe }}" binderror="onAvatarError" />
        <view class="hero-avatar" wx:else>{{ item.avatar }}</view>

        <view class="hero-info-main">
          <view class="hero-title-line">
            <text class="hero-name {{ item.isMe ? 'is-me-name' : '' }}">{{ item.nickname }}</text>
            <text class="hero-vip-badge" wx:if="{{ (item.isMe && isVip) || item.isVip }}">👑 VIP</text>
            <text 
              class="hero-title-tag tier-{{ item.titleTier || 'green' }}" 
              wx:if="{{ item.title }}"
              style="{{ item.titleBadgeBg ? ('background: ' + item.titleBadgeBg + '; color: ' + item.titleTagColor + '; border-color: ' + item.titleBorderColor + ';') : '' }}"
            >{{ item.title }}</text>
            <text class="me-badge" wx:if="{{ item.isMe }}">我</text>
          </view>
          <view class="hero-slogan-wrap" wx:if="{{ item.quote }}">
            <text class="hero-slogan-text">{{ item.quote }}</text>
          </view>
          <view class="hero-data-tags">
            <text class="data-tag">少抽 {{ item.substituted }}支</text>
            <text class="data-tag green">省 ¥{{ item.savedMoney }}</text>
            <text class="data-tag purple">坚持 {{ item.days }}天</text>
          </view>
        </view>

        <!-- 点赞清风互动按钮 -->
        <view 
          class="like-btn-wrap {{ item.isLiked ? 'liked' : '' }}"
          catchtap="onLikeItem"
          data-id="{{ item.id }}"
        >
          <text class="like-heart">{{ item.isLiked ? '❤️' : '🤍' }}</text>
          <text class="like-count">{{ item.likes }}</text>
        </view>
      </view>
    </view>

    <!-- 底部已展示前50名自律同行者结语 -->
    <view class="list-end-footer" wx:if="{{ list.length >= 50 }}">
      <view class="footer-divider-line"></view>
      <text class="footer-text">✦ 全国前 50 席自律同行先锋 · 每日互相点赞送暖 ✦</text>
      <view class="footer-divider-line"></view>
    </view>

  </view>
</scroll-view>
