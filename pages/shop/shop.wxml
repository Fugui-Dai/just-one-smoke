<!-- pages/shop/shop.wxml -->
<view class="pack-page-container {{ vipTheme ? 'theme-' + vipTheme : '' }}" style="{{ themeOpt ? ('--vip-theme-dot: ' + themeOpt.dotColor + '; --vip-theme-orb1: ' + themeOpt.orb1 + '; --vip-theme-orb2: ' + themeOpt.orb2 + '; --vip-theme-spark: ' + themeOpt.spark + '; --vip-theme-spark-glow: ' + themeOpt.sparkGlow + '; background: ' + themeOpt.bgGradient + ' !important;') : '' }}">

  <!-- VIP 尊享动态极光天幕与浮光星尘层 (开通 VIP 后激活情绪价值背景特效) -->
  <view wx:if="{{ vipTheme }}" class="vip-ambient-stage">
    <view class="vip-aurora-orb orb-primary"></view>
    <view class="vip-aurora-orb orb-secondary"></view>
    <view class="vip-spark s1"></view>
    <view class="vip-spark s2"></view>
    <view class="vip-spark s3"></view>
    <view class="vip-spark s4"></view>
  </view>

  <!-- ==================== 顶部自定义导航栏 (全站统一高雅银白标题) ==================== -->
  <view class="custom-navbar navbar-shelf-solid" style="padding-top: {{ statusBarHeight }}px; height: {{ statusBarHeight + navBarHeight }}px;">
    <view class="navbar-content" style="height: {{ navBarHeight }}px; padding-right: {{ capsuleRightSpace }}px;">
      
      <!-- 返回按钮 -->
      <view class="nav-back-btn" bindtap="onNavigateBack">
        <view class="back-chevron-arrow"></view>
      </view>

      <!-- 导航中心标题：与全站其他页面统一银白字色 -->
      <view class="nav-center-title-box">
        <text class="nav-center-title-text">传世典藏</text>
      </view>

      <!-- 右侧占位保持对称 -->
      <view class="nav-placeholder"></view>

    </view>
  </view>


  <!-- ==================== 视图 1: 名烟精品陈列展柜 (The Boutique Shelf Showcase) ==================== -->
  <scroll-view 
    class="shelf-view-scroll" 
    scroll-y 
    enable-back-to-top
  >
    <view class="shelf-content-container" style="padding-top: {{ statusBarHeight + navBarHeight + 10 }}px;">
      
      <!-- 2. 分类筛选胶囊条 (腾讯级五大精炼分组，经典移至首位，对称双字排版) -->
      <view class="category-filter-strip">
        <view 
          class="cat-filter-item {{ activeFilter === 'all' ? 'active-cat' : '' }}" 
          bindtap="onSelectFilter" 
          data-filter="all"
        >
          全部
        </view>
        <view 
          class="cat-filter-item {{ activeFilter === 'heritage' ? 'active-cat' : '' }}" 
          bindtap="onSelectFilter" 
          data-filter="heritage"
        >
          经典
        </view>
        <view 
          class="cat-filter-item {{ activeFilter === 'national' ? 'active-cat' : '' }}" 
          bindtap="onSelectFilter" 
          data-filter="national"
        >
          国烤
        </view>
        <view 
          class="cat-filter-item {{ activeFilter === 'slender' ? 'active-cat' : '' }}" 
          bindtap="onSelectFilter" 
          data-filter="slender"
        >
          细支
        </view>
        <view 
          class="cat-filter-item {{ activeFilter === 'imported' ? 'active-cat' : '' }}" 
          bindtap="onSelectFilter" 
          data-filter="imported"
        >
          港外
        </view>
        <view 
          class="cat-filter-item {{ activeFilter === 'wonder' ? 'active-cat' : '' }}" 
          bindtap="onSelectFilter" 
          data-filter="wonder"
        >
          名筑
        </view>
      </view>

      <!-- 2.5 纯净健康与控烟导向提示栏 (腾讯级合规精工微标：明确标价为参考基准，用于为您精确测算省下的烟资) -->
      <view class="shelf-compliance-banner">
        <text class="compliance-icon">✦</text>
        <text class="compliance-text">倡导健康呼吸 · 标价为真烟参考零售价，用于测算为您省下的烟资</text>
      </view>

      <!-- 3. 沉浸式 3D 展柜网格 (Dark Luxury 3D Showcase Grid) -->
      <view class="shelf-display-cabinet">
        <view 
          class="shelf-pack-card {{ item.isEquipped ? 'is-currently-equipped' : '' }} {{ !item.unlocked ? 'is-locked-pack' : '' }}"
          wx:for="{{ filteredCatalogList }}"
          wx:key="id"
          bindtap="onTapShelfPack"
          data-item="{{ item }}"
        >
          <!-- 当前品吸专属尊贵立式金签 (竖向典雅封签，紧贴右上极窄边缘，绝不横向遮挡烟盒) -->
          <view class="shelf-equipped-tag shelf-equipped-tag-vertical" wx:if="{{ item.isEquipped }}">
            <text class="set-spark">✦</text>
            <text class="set-char">品</text>
            <text class="set-char">吸</text>
            <text class="set-char">中</text>
          </view>

          <!-- 货架背部同源基因氛围光 -->
          <view class="card-ambient-spot" style="background: {{ item.packTheme.accentColor }};"></view>

          <!-- 烟盒 3D 展厅腔体与数字底座 (Dark Gallery Chamber & 3D Digital Pedestal - 纯净艺术无浮层干扰) -->
          <view class="shelf-pack-facade {{ item.packImage ? 'has-real-pack' : '' }} {{ item.packType === 'slender' ? 'slender-facade' : (item.isCigar ? 'cigar-facade' : '') }}">
            <block wx:if="{{ item.packImage }}">
              <!-- 展厅竖向光栅背景纹理 -->
              <view class="shelf-gallery-flutes"></view>

              <!-- 数字展厅 3D 圆柱底座 (柔和接地阴影 + 金属拉丝盘面 + 微弱光晕) -->
              <view class="shelf-pedestal-base">
                <view class="pedestal-cylinder-body"></view>
                <view class="pedestal-top-disc"></view>
                <view class="pedestal-contact-shadow"></view>
                <view class="pedestal-rim-glow"></view>
              </view>

              <!-- 表面高光反射与覆膜流光层 (进页面完成后平滑执行扫光) -->
              <view class="facade-sheen-overlay {{ enableSheen ? 'is-sheen-active' : '' }}"></view>

              <!-- 微 3D 轴测透视藏品容器 -->
              <view class="shelf-pack-3d-tilt">
                <image 
                  class="shelf-pack-real-img" 
                  src="{{ item.packImage }}" 
                  mode="aspectFit" 
                />
              </view>
            </block>
          </view>

          <!-- 货架商品信息与真实参考零售价 (高对比度奢华排版，100%全宽舒展品名，两端严整对齐) -->
          <view class="shelf-meta-block">
            <view class="meta-title-row">
              <text class="shelf-brand-title">{{ item.shelfTitle || item.name }}</text>
            </view>

            <!-- 官方指导零售价高光标签 + 余量/自律解锁标签 (右侧严整对齐) -->
            <view class="shelf-price-row">
              <view class="price-val-wrap">
                <text class="price-ref-label">参考</text>
                <text class="price-symbol">¥</text>
                <text class="price-val">{{ item.price }}</text>
                <text class="price-unit">/{{ item.isCigar ? '支' : '盒' }}</text>
              </view>
              <text class="meta-status-pill stock {{ item.currentStock === 0 ? 'empty' : '' }}" wx:if="{{ item.unlocked }}">{{ item.currentStock === 0 ? '空盒' : ('余' + item.currentStock + '支') }}</text>
              <text class="meta-status-pill locked" wx:else>需替{{ item.requiredCount }}支</text>
            </view>
          </view>

        </view>
      </view>

      <!-- 4. 展柜底部权威合规免责声明 (腾讯大厂合规高规格 · 彻底消除烟草广告与商标侵权争议) -->
      <view class="shelf-legal-disclaimer">
        <view class="sld-badge">✦ 公益控烟与健康倡导声明 ✦</view>
        <view class="sld-list">
          <view class="sld-item">
            <text class="sld-dot">1.</text>
            <text class="sld-item-text">本应用为公益控烟与健康打卡工具，绝不售卖任何香烟、烟草及电子烟实物。</text>
          </view>
          <view class="sld-item">
            <text class="sld-dot">2.</text>
            <text class="sld-item-text">展柜中的虚拟烟盒与烟支均为 3D 原创数字艺术建模，旨在通过心理替代辅助戒烟，与任何现实烟草品牌无商业合作或代言关系。</text>
          </view>
          <view class="sld-item">
            <text class="sld-dot">3.</text>
            <text class="sld-item-text">界面标注的参考价格仅用于为您测算「替烟省下的真实开支与健康收益」。</text>
          </view>
          <view class="sld-item sld-warning-item">
            <text class="sld-dot">4.</text>
            <text class="sld-item-text">吸烟严重危害健康，未成年人严禁使用本应用。</text>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>


  <!-- ==================== 腾讯级双路径解锁决策弹窗 (Unlock Decision Modal) ==================== -->
  <view 
    class="unlock-choice-backdrop" 
    wx:if="{{ showUnlockDialog }}" 
    catchtouchmove="preventTouchMove"
    bindtap="closeUnlockDialog"
  >
    <view class="unlock-choice-dialog" catchtap="preventTouchMove">
      
      <!-- 弹窗关闭按钮 -->
      <view class="dialog-close-btn" bindtap="closeUnlockDialog">✕</view>

      <!-- 弹窗顶栏 -->
      <view class="dialog-header-area">
        <view class="dialog-lock-crest">
          <text class="dialog-lock-icon">🔒</text>
        </view>
        <text class="dialog-title">经典烟盒 · 开启新盒</text>
        <text class="dialog-sub">坚持少抽达成目标，或通过尊享特权即刻开盒</text>
      </view>

      <!-- 选中的名烟信息展台卡片 -->
      <view class="dialog-product-card" wx:if="{{ dialogCigarette }}">
        <view class="dpc-pack-visual">
          <image 
            class="dpc-pack-img" 
            src="{{ dialogCigarette.packImage }}" 
            mode="aspectFit" 
            wx:if="{{ dialogCigarette.packImage }}" 
          />
          <view class="dpc-pack-fallback" style="background: {{ dialogCigarette.packTheme.boxGradient }};" wx:else>
            <text class="dpc-fb-text">{{ dialogCigarette.name }}</text>
          </view>
        </view>
        
        <view class="dpc-meta-info">
          <view class="dpc-name-line">
            <text class="dpc-brand-name">{{ dialogCigarette.name }}</text>
            <text class="dpc-cat-tag">{{ dialogCigarette.brand }}</text>
          </view>
          <view class="dpc-price-line">
            <block wx:if="{{ isIOS }}">
              <text class="dpc-price-sym">实体真烟参考：</text>
              <text class="dpc-price-val">{{ dialogCigarette.price }}元</text>
              <text class="dpc-price-unit">/ {{ dialogCigarette.isCigar ? '支' : '盒' }}（测算基准）</text>
            </block>
            <block wx:else>
              <text class="dpc-price-sym">实体真烟参考价：¥</text>
              <text class="dpc-price-val">{{ dialogCigarette.price }}</text>
              <text class="dpc-price-unit">/ {{ dialogCigarette.isCigar ? '支' : '盒' }}</text>
            </block>
          </view>
          <text class="dpc-slogan-line" wx:if="{{ dialogCigarette.slogan }}">“{{ dialogCigarette.slogan }}”</text>
        </view>
      </view>

      <!-- 双路径决策对比卡片 (The Dual-Pathway Comparison) -->
      <view class="dual-pathway-container">
        
        <!-- 路径 A: 免费替烟积累进度 -->
        <view class="pathway-track track-substitution">
          <view class="track-header">
            <view class="track-title-wrap">
              <view class="track-dot dot-green"></view>
              <text class="track-title">路径一：坚持控烟少抽</text>
            </view>
            <text class="track-status-tag">{{ dialogProgressPercent }}%</text>
          </view>
          
          <view class="track-progress-bar-wrap">
            <view class="track-progress-fill" style="width: {{ dialogProgressPercent + '%' }};"></view>
          </view>

          <view class="track-progress-desc">
            <text>已少抽 {{ dialogTotalSubs }} 支 / 需达 {{ dialogNeededCount }} 支（还差 {{ dialogRemainingCount }} 支）</text>
          </view>
        </view>

        <!-- 路径 B: 尊享沙龙特权直通 -->
        <view class="pathway-track track-vip" bindtap="onGoToVipFromDialog">
          <view class="track-header">
            <view class="track-title-wrap">
              <view class="track-dot dot-gold"></view>
              <text class="track-title">路径二：VIP尊享特权直通</text>
            </view>
            <text class="track-vip-badge">特权直通</text>
          </view>
          
          <view class="track-vip-perks-row">
            <view class="perk-chip"><text class="perk-chip-icon">⚡</text><text>37款烟盒全畅享</text></view>
            <view class="perk-chip"><text class="perk-chip-icon">🚫</text><text>全域纯净无广</text></view>
            <view class="perk-chip"><text class="perk-chip-icon">♾️</text><text>随心即拆新包</text></view>
          </view>
        </view>

      </view>

      <!-- 核心转化行动按键组 (The Conversion CTA Stack) -->
      <view class="dialog-actions-stack">
        <!-- 1. 主行动点 (Primary CTA): 沙龙特权开通 -->
        <view class="dialog-cta-primary" bindtap="onGoToVipFromDialog">
          <text class="cta-crown-glyph">👑</text>
          <view class="cta-text-group">
            <text class="cta-main-title">开启VIP特权即刻开盒</text>
            <text class="cta-sub-title">全套烟盒解锁 · 尊享全图鉴体验</text>
          </view>
          <text class="cta-arrow-glyph">➔</text>
        </view>

        <!-- 2. 次行动点 (Secondary CTA): 免费解锁今日整盒畅吸 (静默生效，无需扰民提示) -->
        <view class="dialog-cta-secondary" bindtap="onTrialSmokeFromDialog">
          <text class="cta-sec-icon">✨</text>
          <text class="cta-sec-text">掌柜特赠今日整盒品尝</text>
          <text class="cta-sec-tag">每日特赠</text>
        </view>

        <!-- 3. 第三行动点 (Tertiary CTA): 继续坚持健康替烟 -->
        <view class="dialog-cta-tertiary" bindtap="closeUnlockDialog">
          <text class="cta-tert-text">稍后再说 · 坚持打卡</text>
        </view>
      </view>

    </view>
  </view>

  <!-- 全局腾讯级灵动微胶囊 Toast HUD -->
  <custom-toast id="customToast" />

</view>
