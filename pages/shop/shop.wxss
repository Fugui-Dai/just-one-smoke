/* ==================== 10. 腾讯级双路径解锁决策弹窗 (Touchpoint 3) ==================== */
.unlock-choice-backdrop {
  position: fixed;
  inset: 0;
  z-index: 160;
  background: rgba(0, 0, 0, 0.82);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
  animation: modalBackdropFadeIn 0.25s ease both;
}

@keyframes modalBackdropFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.unlock-choice-dialog {
  width: 100%;
  max-width: 630rpx;
  background: linear-gradient(160deg, #171c2a 0%, #0c0f18 100%);
  border: 1px solid rgba(251, 191, 36, 0.35);
  border-radius: 36rpx;
  padding: 38rpx 30rpx 32rpx 30rpx;
  box-shadow: 0 24rpx 64rpx rgba(0, 0, 0, 0.9), 0 0 36rpx rgba(251, 191, 36, 0.12);
  display: flex;
  flex-direction: column;
  position: relative;
  box-sizing: border-box;
  animation: dialogScaleUp 0.28s cubic-bezier(0.16, 1, 0.3, 1) both;
}

@keyframes dialogScaleUp {
  from {
    opacity: 0;
    transform: scale(0.92) translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}

.dialog-close-btn {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.12);
  color: #94a3b8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  transition: all 0.2s ease;
  z-index: 10;
}

.dialog-close-btn:active {
  transform: scale(0.9);
  background: rgba(255, 255, 255, 0.15);
  color: #f8fafc;
}

.dialog-header-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  margin-bottom: 24rpx;
}

.dialog-lock-crest {
