/* pages/pack/pack.wxss */

/* ==================== 1. 全局容器与暗黑舞台背景 ==================== */
.pack-page-container {
  width: 100vw;
  height: 100vh;
  background: radial-gradient(circle at 50% 18%, #161b26 0%, #080a0f 75%);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  position: relative;
  box-sizing: border-box;
}

/* ==================== 2. 自定义导航栏 ==================== */
.custom-navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  background: rgba(8, 10, 15, 0.85);
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  box-sizing: border-box;
}

.navbar-content {
  position: relative;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-left: 20rpx;
  box-sizing: border-box;
}

.nav-back-btn {
  position: relative;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 50%;
  color: #e2e8f0;
  transition: all 0.2s ease;
  padding: 0;
}

.nav-back-btn:active {
  transform: scale(0.92);
  background: rgba(255, 255, 255, 0.16);
}

.nav-title-box {
  display: flex;
  align-items: center;
}

.nav-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #f8fafc;
  letter-spacing: 1rpx;
}

.nav-center-title-box {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  margin: auto;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  z-index: 5;
}

.nav-center-title-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 1rpx;
  max-width: 420rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: center;
}

.nav-sound-btn {
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 50%;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  margin-right: 12rpx;
}

.nav-sound-btn.muted {
  opacity: 0.5;
}

.nav-placeholder {
  width: 80rpx;
}


/* ==================== 3. 主内容区域 ==================== */
.pack-main-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
}

/* 顶部烟盒信息卡 */
.pack-meta-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 32rpx;
  z-index: 30;
}

.brand-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.brand-main-name {
  font-size: 32rpx;
  font-weight: 800;
  color: #f8fafc;
}

.brand-badge-tag {
  font-size: 18rpx;
  color: #f59e0b;
  background: rgba(245, 158, 11, 0.15);
  border: 1px solid rgba(245, 158, 11, 0.35);
  padding: 2rpx 10rpx;
  border-radius: 12rpx;
  font-weight: 600;
}

.brand-tagline {
  font-size: 20rpx;
  color: #94a3b8;
  margin-top: 4rpx;
}

/* 烟盒余量胶囊 */
.pack-inventory-pill {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(16, 185, 129, 0.15);
  border: 1px solid rgba(16, 185, 129, 0.35);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.inv-pulse-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #10b981;
  box-shadow: 0 0 10rpx #10b981;
}

.inv-text {
  font-size: 20rpx;
  color: #34d399;
  font-weight: 700;
}

.pack-inventory-pill.pill-low {
  background: rgba(245, 158, 11, 0.15);
  border-color: rgba(245, 158, 11, 0.4);
}
.pack-inventory-pill.pill-low .inv-pulse-dot { background: #f59e0b; box-shadow: 0 0 10rpx #f59e0b; }
.pack-inventory-pill.pill-low .inv-text { color: #fbbf24; }

.pack-inventory-pill.pill-empty {
  background: rgba(239, 68, 68, 0.15);
  border-color: rgba(239, 68, 68, 0.4);
}
.pack-inventory-pill.pill-empty .inv-pulse-dot { background: #ef4444; box-shadow: 0 0 10rpx #ef4444; }
.pack-inventory-pill.pill-empty .inv-text { color: #f87171; }


/* ==================== 4. 3D 拟真烟盒舞台 (3D Pack Stage) ==================== */
.pack-3d-stage {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  perspective: 2400px;
  -webkit-perspective: 2400px;
}

/* 3D 烟盒主体外壳容器 (严格 360x580，1:1 无损对齐真实烟盒立面切片) */
.pack-box-wrapper {
  position: relative;
  width: 360rpx;
  height: 580rpx;
  transform-style: preserve-3d;
  -webkit-transform-style: preserve-3d;
  transition: transform 0.4s ease;
  filter: drop-shadow(0 26rpx 48rpx rgba(0, 0, 0, 0.75));
}

/* 细支烟盒比例 (保持 360x580 纯画幅统一，无拉伸畸变) */
.pack-box-wrapper.slender-box {
  width: 360rpx;
  height: 580rpx;
}

/* 雪茄大号木盒比例 (保持 360x580 纯画幅统一，无拉伸畸变) */
.pack-box-wrapper.cigar-box {
  width: 360rpx;
  height: 580rpx;
}

/* ==================== 盒内内胆与金箔层 ==================== */
.pack-inner-chamber {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  width: 360rpx;
  height: 240rpx;
  background: #09090b;
  border-radius: 12rpx 12rpx 0 0;
  border-left: 2rpx solid rgba(255, 255, 255, 0.22);
  border-right: 2rpx solid rgba(255, 255, 255, 0.22);
  box-sizing: border-box;
  overflow: hidden;
  z-index: 5;
  box-shadow: inset 0 10rpx 20rpx rgba(0, 0, 0, 0.85);
}

/* 金锡箔纸内衬 (细腻压纹微光) */
.foil-paper-liner {
  position: absolute;
  inset: 0;
  background: var(--foil-color, #f59e0b);
  opacity: 0.92;
  background-image: repeating-linear-gradient(
    45deg,
    rgba(255, 255, 255, 0.2) 0px,
    rgba(255, 255, 255, 0.2) 2px,
    transparent 2px,
    transparent 6px
  ),
  repeating-linear-gradient(
    -45deg,
    rgba(0, 0, 0, 0.08) 0px,
    rgba(0, 0, 0, 0.08) 2px,
    transparent 2px,
    transparent 6px
  );
  box-shadow: inset 0 0 16rpx rgba(0, 0, 0, 0.6);
}

.foil-notch-cutout {
  position: absolute;
  top: 0;
  left: 20%;
  right: 20%;
  height: 40rpx;
  background: #0a0a0c;
  border-radius: 0 0 20rpx 20rpx;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.6);
}

/* 真实硬盒内衬领口卡纸 (Inner Collar Frame) */
.inner-collar-frame {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: calc(240rpx - var(--lid-h, 168rpx) + 38rpx);
  z-index: 8;
  pointer-events: none;
}

.collar-u-notch {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, #f8fafc 0%, #e2e8f0 70%, #cbd5e1 100%);
  border-top: 1px solid rgba(255, 255, 255, 0.85);
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.35);
  clip-path: polygon(
    0% 0%,
    24% 0%,
    32% 55%,
    68% 55%,
    76% 0%,
    100% 0%,
    100% 100%,
    0% 100%
  );
  -webkit-clip-path: polygon(
    0% 0%,
    24% 0%,
    32% 55%,
    68% 55%,
    76% 0%,
    100% 0%,
    100% 100%,
    0% 100%
  );
}

.collar-card-rim {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2rpx;
  background: rgba(255, 255, 255, 0.6);
}

/* 盒内过滤嘴矩阵排列 */
.cigarettes-matrix {
  position: absolute;
  top: 36rpx;
  left: 16rpx;
  right: 16rpx;
  bottom: 12rpx;
  display: grid;
  gap: 8rpx;
  align-items: center;
  justify-content: center;
  z-index: 6;
}

/* 常规 20 支排列 (2 排，每排 10 支) */
.cigarettes-matrix.standard-matrix {
  grid-template-columns: repeat(10, 1fr);
  grid-template-rows: repeat(2, 1fr);
  gap: 6rpx;
}

/* 细支 20 支排列 (2 排，每排 10 支细腻小圆孔) */
.cigarettes-matrix.slender-matrix {
  grid-template-columns: repeat(10, 1fr);
  grid-template-rows: repeat(2, 1fr);
  gap: 4rpx;
}

/* 雪茄 5 支排列 (1 排 5 支大雪茄) */
.cigarettes-matrix.cigar-matrix {
  grid-template-columns: repeat(5, 1fr);
  grid-template-rows: 1fr;
  gap: 12rpx;
}

.cig-filter-slot {
  width: 100%;
  height: 100%;
  min-height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  transition: transform 0.2s ease;
}

.cig-filter-slot:active {
  transform: translateY(-8rpx);
}

.cig-filter-slot.slot-pulled-out {
  transform: translateY(-56rpx);
  transition: transform 1.2s cubic-bezier(0.2, 0.85, 0.32, 1);
  filter: drop-shadow(0 0 10rpx rgba(251, 191, 36, 0.7));
}

/* 立体圆柱过滤嘴 */
.slot-filter-cylinder {
  width: 100%;
  height: 100%;
  border-radius: 8rpx 8rpx 0 0;
  position: relative;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.5), inset 0 2rpx 3rpx rgba(255, 255, 255, 0.35);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.filter-top-bevel {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 8rpx;
  border-radius: 50% 50% 0 0;
  background: rgba(255, 255, 255, 0.35);
}

.filter-mini-band {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  box-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.4);
}

.filter-bead-spark {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  position: absolute;
  top: 40%;
  box-shadow: 0 0 8rpx currentColor;
  animation: pulse-bead-spark 2s infinite ease-in-out;
}

@keyframes pulse-bead-spark {
  0%, 100% { opacity: 0.7; transform: scale(0.9); }
  50% { opacity: 1; transform: scale(1.2); }
}

/* 空凹槽 */
.slot-empty-groove {
  width: 100%;
  height: 100%;
  border-radius: 8rpx 8rpx 0 0;
  background: rgba(0, 0, 0, 0.75);
  border: 1px dashed rgba(255, 255, 255, 0.1);
  box-shadow: inset 0 6rpx 10rpx rgba(0, 0, 0, 0.9);
}


/* ==================== 3D 翻盖盒盖 (Flip-Top Lid) ==================== */
.pack-flip-lid {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  width: 360rpx;
  height: var(--lid-h, 168rpx);
  z-index: 30;
  transform-origin: top center;
  transform-style: preserve-3d;
  -webkit-transform-style: preserve-3d;
  transition: transform 0.65s cubic-bezier(0.25, 1.4, 0.5, 1);
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.45);
  box-sizing: border-box;
}

/* 盒盖打开状态：向上3D翻转并与下盒身保持 100% 等宽对齐 */
.pack-box-wrapper.lid-open .pack-flip-lid {
  transform: rotateX(-168deg) translateY(0rpx) translateZ(1rpx);
}

.lid-face-outer {
  position: absolute;
  inset: 0;
  background: var(--lid-grad, #991b1b);
  border-radius: 12rpx 12rpx 0 0;
  border: 1px solid rgba(255, 255, 255, 0.18);
  border-bottom: none;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 14rpx;
  overflow: hidden;
  box-shadow: inset 0 2rpx 6rpx rgba(255, 255, 255, 0.35);
  -webkit-backface-visibility: hidden;
  backface-visibility: hidden;
}

.lid-bevel-edge {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: rgba(255, 255, 255, 0.4);
}

.lid-seal-tape {
  align-self: center;
  background: rgba(255, 255, 255, 0.9);
  padding: 2rpx 16rpx;
  border-radius: 6rpx;
  border: 1px solid #ffffff;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.3);
}

.seal-text {
  font-size: 16rpx;
  font-weight: 800;
  color: #1e293b;
  letter-spacing: 2rpx;
}

.lid-brand-print {
  display: flex;
  justify-content: center;
}

.lid-sub-text {
  font-size: 20rpx;
  font-weight: 700;
  color: #fef08a;
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.5);
}

/* 真实名烟盖顶大图切片 (100% 严丝合缝，解码期由品牌同色渐变托底防黑闪) */
.lid-face-outer.has-real-lid {
  padding: 0;
  background: var(--lid-grad, #161b26);
  border: none;
  border-radius: 12rpx 12rpx 0 0;
  overflow: hidden;
  box-shadow: none;
}

.pack-lid-real-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 360rpx;
  height: 580rpx;
  display: block;
  pointer-events: none;
  filter: contrast(1.03) brightness(1.02);
  image-rendering: -webkit-optimize-contrast;
  image-rendering: crisp-edges;
  transform: translateZ(0);
  -webkit-transform: translateZ(0);
}

/* 闭合时底部极细物理缝隙阴影 */
.lid-bottom-slit-shadow {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 2rpx;
  background: rgba(0, 0, 0, 0.45);
  pointer-events: none;
}

/* 盒盖翻转内侧 (拟真白卡纸与铝箔折边) */
.lid-face-inner {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, #f8fafc 0%, #f1f5f9 60%, #e2e8f0 100%);
  transform: rotateX(180deg);
  -webkit-backface-visibility: hidden;
  backface-visibility: hidden;
  border-radius: 12rpx 12rpx 0 0;
  overflow: hidden;
  border: 1px solid rgba(255, 255, 255, 0.4);
  box-shadow: inset 0 -4rpx 12rpx rgba(0, 0, 0, 0.25);
}

/* 盒盖内翻折铝箔边 (顶部金/银箔衬边) */
.lid-inner-foil-strip {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 36rpx;
  opacity: 0.9;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.25);
  background-image: repeating-linear-gradient(
    45deg,
    rgba(255, 255, 255, 0.25) 0px,
    rgba(255, 255, 255, 0.25) 2px,
    transparent 2px,
    transparent 6px
  );
}

/* 盒盖白卡纸内衬与品牌钢印 */
.lid-inner-cardstock {
  position: absolute;
  top: 40rpx;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.lid-inner-watermark {
  font-size: 16rpx;
  font-weight: 700;
  color: #94a3b8;
  letter-spacing: 3rpx;
  opacity: 0.65;
  text-transform: uppercase;
}

/* 盒盖内侧两侧微折舌阴影 */
.lid-dust-flap {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 14rpx;
  background: linear-gradient(to right, rgba(0, 0, 0, 0.12), transparent);
}
.lid-dust-flap.right {
  right: 0;
  background: linear-gradient(to left, rgba(0, 0, 0, 0.12), transparent);
}

/* ==================== 烟盒主体箱体 (Pack Main Body) ==================== */
.pack-main-body {
  position: absolute;
  top: var(--lid-h, 168rpx);
  left: 0;
  right: 0;
  bottom: 0;
  width: 360rpx;
  z-index: 10;
  border-radius: 0 0 12rpx 12rpx;
  box-sizing: border-box;
  overflow: hidden;
}

/* 盒身切口白色卡纸厚度剖面光边缘 */
.body-top-rim-edge {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2rpx;
  background: rgba(255, 255, 255, 0.55);
  z-index: 15;
}

.body-face-outer {
  position: absolute;
  inset: 0;
  background: var(--box-grad, #7f1d1d);
  border-radius: 0 0 12rpx 12rpx;
  border: 1px solid rgba(255, 255, 255, 0.16);
  border-top: none;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 20rpx 18rpx 16rpx 18rpx;
  box-shadow: inset 0 2rpx 4rpx rgba(255, 255, 255, 0.25);
  overflow: hidden;
}

.body-face-outer.has-real-body {
  padding: 0;
  background: var(--box-grad, #161b26);
  border: none;
  border-radius: 0 0 12rpx 12rpx;
  overflow: hidden;
  box-shadow: none;
}

.pack-body-real-img {
  position: absolute;
  top: calc(-1 * var(--lid-h, 168rpx));
  left: 0;
  width: 360rpx;
  height: 580rpx;
  display: block;
  pointer-events: none;
  filter: contrast(1.03) brightness(1.02);
  image-rendering: -webkit-optimize-contrast;
  image-rendering: crisp-edges;
  transform: translateZ(0);
  -webkit-transform: translateZ(0);
}

/* 品牌中央徽标 */
.brand-emblem-container {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 10rpx 0;
  width: 100%;
}

.emblem-big-title {
  font-size: 52rpx;
  font-weight: 900;
  color: var(--accent-color, #fbbf24);
  letter-spacing: 6rpx;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.7);
  font-family: serif;
}

.emblem-sub-title {
  font-size: 20rpx;
  font-weight: 700;
  color: #fef08a;
  letter-spacing: 3rpx;
  margin-top: 6rpx;
}

/* 1. 中华天安门 */
.emblem-tiananmen {
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 2rpx solid #f59e0b;
  outline: 1rpx solid rgba(245, 158, 11, 0.4);
  padding: 12rpx 28rpx;
  border-radius: 8rpx;
  background: rgba(0, 0, 0, 0.15);
}
.tiananmen-facade-gate {
  font-size: 40rpx;
  filter: drop-shadow(0 2rpx 6rpx rgba(245, 158, 11, 0.6));
}
.chunghwa-font {
  color: #fde047;
  font-size: 56rpx;
  letter-spacing: 8rpx;
}
.emblem-star-row {
  font-size: 20rpx;
  color: #fde047;
  letter-spacing: 6rpx;
  margin-top: 4rpx;
}
.emblem-eng-sub {
  font-size: 16rpx;
  color: #fbbf24;
  letter-spacing: 4rpx;
  font-weight: 800;
}

/* 2. 炫赫门 */
.emblem-dragon {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.nanjing-red-seal-big {
  background: #dc2626;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 900;
  padding: 2rpx 12rpx;
  border-radius: 4rpx;
  border: 1rpx solid #fef08a;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.5);
  margin-bottom: 6rpx;
}
.xuanhemen-font {
  color: #fde047;
  font-size: 50rpx;
  letter-spacing: 6rpx;
}

/* 3. 利群三段 */
.emblem-liqun {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}
.liqun-gold-separator {
  width: 80%;
  height: 4rpx;
  background: linear-gradient(90deg, transparent 0%, #f59e0b 50%, transparent 100%);
  margin-bottom: 8rpx;
}
.liqun-font {
  color: #f8fafc;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.8);
  font-size: 54rpx;
}

/* 4. 黄鹤楼1916 */
.emblem-1916 {
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 2rpx solid #b45309;
  border-radius: 50%;
  width: 190rpx;
  height: 190rpx;
  justify-content: center;
  background: rgba(0, 0, 0, 0.15);
}
.bronze-crane-tower {
