/* pages/shop/shop.wxss */

/* ==================== 1. 全局容器与暗黑舞台背景 (支持 VIP 专属主题联动) ==================== */
.pack-page-container {
  width: 100vw;
  height: 100vh;
  background: radial-gradient(circle at 50% 10%, #17181c 0%, #111215 45%, #0b0c0e 100%);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  position: relative;
  box-sizing: border-box;
  transition: background 0.35s ease;
}

.pack-page-container.theme-emerald,
.pack-page-container.theme-day {
  background: radial-gradient(circle at 50% 8%, rgba(16, 185, 129, 0.28) 0%, #091c17 46%, #050c0a 100%);
}

.pack-page-container.theme-purple,
.pack-page-container.theme-month {
  background: radial-gradient(circle at 50% 8%, rgba(168, 85, 247, 0.30) 0%, #150c24 46%, #08050e 100%);
}

.pack-page-container.theme-glacier,
.pack-page-container.theme-lifetime {
  background: radial-gradient(circle at 50% 8%, rgba(251, 191, 36, 0.30) 0%, rgba(180, 83, 9, 0.14) 36%, #141008 65%, #070604 100%);
}

/* VIP 动态极光天幕与浮光星尘舞台 */
.vip-ambient-stage {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 1;
  overflow: hidden;
}

.vip-aurora-orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(56rpx);
  opacity: 0.55;
  animation: vipOrbBreath 6s infinite alternate ease-in-out;
}

.vip-aurora-orb.orb-primary {
  width: 520rpx;
  height: 320rpx;
  top: -60rpx;
  left: 50%;
  margin-left: -260rpx;
  background: radial-gradient(circle, rgba(168, 85, 247, 0.42) 0%, transparent 72%);
}

.vip-aurora-orb.orb-secondary {
  width: 420rpx;
  height: 420rpx;
  bottom: 12%;
  right: -120rpx;
  background: radial-gradient(circle, rgba(192, 132, 252, 0.22) 0%, transparent 70%);
  animation-delay: -3s;
}

.theme-day .vip-aurora-orb.orb-primary,
.theme-emerald .vip-aurora-orb.orb-primary {
  background: radial-gradient(circle, rgba(16, 185, 129, 0.42) 0%, transparent 72%);
}
.theme-day .vip-aurora-orb.orb-secondary,
.theme-emerald .vip-aurora-orb.orb-secondary {
  background: radial-gradient(circle, rgba(52, 211, 153, 0.22) 0%, transparent 70%);
}

.theme-lifetime .vip-aurora-orb.orb-primary,
.theme-glacier .vip-aurora-orb.orb-primary {
  background: radial-gradient(circle, rgba(251, 191, 36, 0.45) 0%, transparent 72%);
}
.theme-lifetime .vip-aurora-orb.orb-secondary,
.theme-glacier .vip-aurora-orb.orb-secondary {
  background: radial-gradient(circle, rgba(245, 158, 11, 0.25) 0%, transparent 70%);
}

@keyframes vipOrbBreath {
  0% { transform: scale(0.92) translateY(0); opacity: 0.42; }
  100% { transform: scale(1.12) translateY(18rpx); opacity: 0.72; }
}

.vip-spark {
  position: absolute;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #f5d0fe;
  box-shadow: 0 0 14rpx #c084fc;
  opacity: 0.6;
  animation: vipSparkFloat 5s infinite ease-in-out;
}
.theme-day .vip-spark { background: #a7f3d0; box-shadow: 0 0 14rpx #34d399; }
.theme-lifetime .vip-spark { background: #fef08a; box-shadow: 0 0 16rpx #fbbf24; }

.vip-spark.s1 { top: 18%; left: 14%; animation-delay: 0s; }
.vip-spark.s2 { top: 28%; right: 16%; width: 6rpx; height: 6rpx; animation-delay: -1.4s; }
.vip-spark.s3 { top: 56%; left: 22%; width: 6rpx; height: 6rpx; animation-delay: -2.8s; }
.vip-spark.s4 { top: 72%; right: 20%; animation-delay: -3.9s; }

@keyframes vipSparkFloat {
  0%, 100% { transform: translateY(0) scale(0.8); opacity: 0.25; }
  50% { transform: translateY(-28rpx) scale(1.25); opacity: 0.85; }
}

/* ==================== 2. 自定义导航栏 (与全站统一银白标题与磨砂玻璃返回键) ==================== */
.custom-navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: transparent;
  box-sizing: border-box;
  transition: background 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
}

.custom-navbar.navbar-shelf-solid {
  background: rgba(8, 10, 15, 0.85) !important;
  backdrop-filter: blur(20px) !important;
  -webkit-backdrop-filter: blur(20px) !important;
  border-bottom: 1px solid rgba(255, 255, 255, 0.06) !important;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.45) !important;
}

.theme-day .custom-navbar.navbar-shelf-solid {
  background: rgba(5, 20, 16, 0.86) !important;
  border-bottom-color: rgba(16, 185, 129, 0.22) !important;
}
.theme-month .custom-navbar.navbar-shelf-solid {
  background: rgba(16, 10, 28, 0.86) !important;
  border-bottom-color: rgba(168, 85, 247, 0.24) !important;
}
.theme-lifetime .custom-navbar.navbar-shelf-solid {
  background: rgba(20, 14, 6, 0.88) !important;
  border-bottom-color: rgba(251, 191, 36, 0.26) !important;
}

.navbar-content {
  position: relative;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-left: 20rpx;
  background: transparent !important;
  box-sizing: border-box;
}

.nav-back-btn {
  position: relative;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 50%;
  color: #e2e8f0;
  transition: all 0.2s ease;
  padding: 0;
}

.nav-back-btn .back-chevron-arrow {
  width: 18rpx;
  height: 18rpx;
  border-left: 4rpx solid #e2e8f0;
  border-bottom: 4rpx solid #e2e8f0;
  transform: rotate(45deg);
  margin-left: 6rpx;
}

.nav-back-btn:active {
  transform: scale(0.92);
  background: rgba(255, 255, 255, 0.16);
}

.nav-center-title-box {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  margin: auto;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  z-index: 5;
}

.nav-center-title-text {
  font-size: 34rpx;
  font-weight: 800;
  color: #f8fafc;
  background: linear-gradient(135deg, #f8fafc 0%, #cbd5e1 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  letter-spacing: 2rpx;
  max-width: 420rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: center;
}

.nav-placeholder {
  width: 60rpx;
  height: 60rpx;
}

/* ==================== 3. 名烟精品陈列货架视图 (The Shelf Showcase) ==================== */
.shelf-view-scroll {
  position: relative;
  z-index: 2;
  width: 100%;
  height: 100vh;
  box-sizing: border-box;
}

.shelf-content-container {
  padding: 10rpx 16rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom, 0px));
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  box-sizing: border-box;
  animation: shelfContentFadeIn 0.28s cubic-bezier(0.16, 1, 0.3, 1) both;
}

@keyframes shelfContentFadeIn {
  from {
    opacity: 0.85;
    transform: translateY(8rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ==================== 4. 置顶 VIP 特权横幅 (含已开通尊享流光状态) ==================== */
.shelf-vip-banner {
  position: relative;
  overflow: hidden;
  width: 100%;
  min-height: 76rpx;
  background:
    radial-gradient(circle at 10% 50%, rgba(218, 178, 92, 0.34) 0%, rgba(164, 124, 48, 0.14) 36%, transparent 68%),
    linear-gradient(90deg, #332919 0%, #1d1914 42%, #121317 100%);
  border: 1px solid rgba(218, 180, 102, 0.52);
  border-radius: 20rpx;
  padding: 10rpx 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 8rpx 22rpx rgba(0, 0, 0, 0.62), 0 2rpx 12rpx rgba(212, 175, 55, 0.14), inset 0 1rpx 1rpx rgba(255, 236, 179, 0.22);
  transition: all 0.25s ease;
  box-sizing: border-box;
}

.shelf-vip-banner.vip-active-banner {
  background:
    radial-gradient(circle at 12% 50%, rgba(168, 85, 247, 0.36) 0%, transparent 65%),
    linear-gradient(90deg, rgba(46, 22, 75, 0.92) 0%, rgba(24, 14, 42, 0.92) 50%, rgba(15, 12, 24, 0.95) 100%);
  border-color: rgba(192, 132, 252, 0.58);
  box-shadow: 0 8rpx 28rpx rgba(168, 85, 247, 0.24), inset 0 1rpx 2rpx rgba(245, 208, 254, 0.28);
}

.theme-day .shelf-vip-banner.vip-active-banner {
  background:
    radial-gradient(circle at 12% 50%, rgba(16, 185, 129, 0.36) 0%, transparent 65%),
    linear-gradient(90deg, rgba(12, 52, 40, 0.92) 0%, rgba(8, 30, 24, 0.92) 50%, rgba(6, 18, 15, 0.95) 100%);
  border-color: rgba(52, 211, 153, 0.58);
  box-shadow: 0 8rpx 28rpx rgba(16, 185, 129, 0.24), inset 0 1rpx 2rpx rgba(167, 243, 208, 0.28);
}

.theme-lifetime .shelf-vip-banner.vip-active-banner {
  background:
    radial-gradient(circle at 12% 50%, rgba(251, 191, 36, 0.40) 0%, transparent 65%),
    linear-gradient(90deg, rgba(62, 42, 12, 0.94) 0%, rgba(32, 22, 8, 0.94) 50%, rgba(16, 12, 6, 0.96) 100%);
  border-color: rgba(253, 224, 71, 0.68);
  box-shadow: 0 8rpx 30rpx rgba(245, 158, 11, 0.28), inset 0 1rpx 2rpx rgba(254, 240, 138, 0.35);
}

.vip-banner-shimmer {
  position: absolute;
  top: 0;
  left: -100%;
  width: 60%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.14), transparent);
  transform: skewX(-25deg);
  animation: bannerSweep 4.2s infinite ease-in-out;
  pointer-events: none;
}

@keyframes bannerSweep {
  0%, 30% { left: -100%; }
  75%, 100% { left: 150%; }
}

.shelf-vip-banner:active {
  transform: scale(0.985);
  border-color: rgba(234, 195, 92, 0.72);
}

.shelf-vip-banner.is-vip-active {
  background:
    radial-gradient(circle at 12% 50%, rgba(234, 195, 92, 0.38) 0%, rgba(168, 128, 52, 0.16) 38%, transparent 68%),
    linear-gradient(90deg, #382d1b 0%, #1e1a14 44%, #121317 100%);
  border-color: rgba(234, 195, 92, 0.62);
  box-shadow: 0 8rpx 22rpx rgba(0, 0, 0, 0.65), 0 0 18rpx rgba(212, 175, 55, 0.18), inset 0 1rpx 2rpx rgba(255, 240, 195, 0.26);
}

.shelf-vip-banner-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
}

.vip-crown-icon-wrap {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  background: linear-gradient(145deg, #cba558 0%, #926d29 100%);
  border: 1px solid rgba(255, 236, 179, 0.62);
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.48), inset 0 2rpx 3rpx rgba(255, 245, 210, 0.42);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.vip-crown-icon-wrap.active-crown {
  background: linear-gradient(145deg, #d7b264 0%, #9b742d 100%);
  border-color: rgba(255, 240, 195, 0.75);
}

.vip-crown-icon {
  font-size: 26rpx;
  line-height: 1;
  filter: drop-shadow(0 2rpx 4rpx rgba(0, 0, 0, 0.45));
}

.vip-banner-texts {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.vip-banner-headline {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.vip-headline-tag {
  font-size: 17rpx;
  font-weight: 800;
  color: #fef08a;
  background: rgba(180, 138, 52, 0.36);
  border: 1px solid rgba(234, 195, 92, 0.72);
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  line-height: 1.25;
  white-space: nowrap;
}

.vip-headline-tag.active-tag {
  background: rgba(196, 152, 62, 0.42);
  border-color: rgba(247, 223, 160, 0.82);
  color: #fffbeb;
}

.vip-headline-title {
  font-size: 24rpx;
  font-weight: 800;
  color: #fffbeb;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.6);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.vip-banner-sub {
  font-size: 20rpx;
  font-weight: 600;
  color: #f3e5ab;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.65);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.shelf-vip-banner-btn {
  display: flex;
  align-items: center;
  gap: 4rpx;
  background: linear-gradient(180deg, rgba(218, 178, 92, 0.32) 0%, rgba(164, 124, 48, 0.24) 100%);
  border: 1px solid rgba(234, 195, 92, 0.78);
  color: #fef08a;
  padding: 9rpx 18rpx;
  border-radius: 999rpx;
  box-shadow: inset 0 1rpx 2rpx rgba(255, 240, 195, 0.32);
  flex-shrink: 0;
  margin-left: 10rpx;
}

.shelf-vip-banner-btn.active-btn {
  background: linear-gradient(180deg, rgba(234, 195, 92, 0.36) 0%, rgba(180, 138, 52, 0.28) 100%);
  border: 1px solid rgba(247, 223, 160, 0.85);
  color: #fffbeb;
}

.vip-btn-text {
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1;
}

.vip-btn-arrow {
  font-size: 18rpx;
  font-weight: 800;
  line-height: 1;
}

/* ==================== 5. 分类筛选胶囊条 ==================== */
.category-filter-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 0;
}

.cat-filter-item {
  flex: 1;
  text-align: center;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.12);
  padding: 8rpx 0;
  border-radius: 999rpx;
  font-size: 23rpx;
  color: #e2e8f0;
  font-weight: 600;
  letter-spacing: 2rpx;
  transition: all 0.22s ease;
}

.cat-filter-item.active-cat {
  background: linear-gradient(180deg, rgba(168, 130, 54, 0.48) 0%, rgba(92, 68, 22, 0.72) 100%);
  border-color: #e2be6f;
  color: #fef08a;
  font-weight: 800;
  box-shadow: 0 4rpx 14rpx rgba(218, 178, 92, 0.32), inset 0 1rpx 2rpx rgba(255, 240, 195, 0.38);
}

/* ==================== 6. 控烟健康指引提示栏 ==================== */
.shelf-compliance-banner {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(20, 22, 27, 0.88);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 999rpx;
  padding: 6rpx 16rpx;
  margin: 0;
}

.compliance-icon {
  font-size: 18rpx;
  color: #eab308;
  line-height: 1;
  flex-shrink: 0;
}

.compliance-text {
  font-size: 19rpx;
  color: #cbd5e1;
  letter-spacing: 0.3rpx;
  font-weight: 500;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ==================== 7. 3列×3行沉浸式 3D 展柜网格 ==================== */
.shelf-display-cabinet {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  width: 100%;
  box-sizing: border-box;
}

.shelf-pack-card {
  background: linear-gradient(180deg, #16181d 0%, #0d0e12 100%);
  border: 1px solid rgba(255, 255, 255, 0.14);
  border-radius: 18rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  position: relative;
  transition: border-color 0.25s ease, box-shadow 0.25s ease;
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.72), inset 0 1rpx 0 rgba(255, 255, 255, 0.12);
  box-sizing: border-box;
}

.shelf-pack-card::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 20%;
  right: 20%;
  height: 2rpx;
  background: radial-gradient(circle, rgba(226, 232, 240, 0.55) 0%, transparent 75%);
  pointer-events: none;
  z-index: 12;
}

.shelf-pack-card.is-currently-equipped {
  border: 1.5px solid rgba(226, 190, 111, 0.82);
  box-shadow: 0 10rpx 28rpx rgba(0, 0, 0, 0.82), 0 0 22rpx rgba(212, 175, 55, 0.26), inset 0 0 16rpx rgba(212, 175, 55, 0.08);
}

.shelf-pack-card.is-currently-equipped::after {
  left: 12%;
  right: 12%;
  height: 3rpx;
  background: radial-gradient(circle, rgba(247, 226, 173, 0.95) 0%, rgba(212, 175, 55, 0.45) 48%, transparent 82%);
  box-shadow: 0 0 12rpx rgba(243, 210, 122, 0.65);
}

.shelf-pack-card.is-locked-pack {
  border-color: rgba(255, 255, 255, 0.12);
}

.shelf-pack-card.is-locked-pack .shelf-pack-facade {
  filter: none;
  -webkit-filter: none;
  opacity: 1;
}

.shelf-pack-card:active {
  border-color: rgba(234, 195, 92, 0.68);
  transform: none;
}

.shelf-equipped-badge {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  z-index: 15;
  background: linear-gradient(90deg, #c89e4c 0%, #ecd28f 50%, #b88c36 100%);
  color: #1c1305;
  font-size: 14rpx;
  font-weight: 800;
  padding: 3rpx 10rpx;
  border-radius: 8rpx;
  box-shadow: 0 2rpx 12rpx rgba(226, 190, 111, 0.55), inset 0 1rpx 1rpx rgba(255, 248, 220, 0.65);
  pointer-events: none;
}

.shelf-vip-badge {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  z-index: 14;
  display: flex;
  align-items: center;
  gap: 3rpx;
  background: linear-gradient(135deg, rgba(22, 24, 30, 0.92) 0%, rgba(12, 13, 18, 0.96) 100%);
  border: 1px solid rgba(212, 175, 55, 0.52);
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.65);
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
  pointer-events: none;
}

.vip-badge-crown {
  font-size: 13rpx;
  line-height: 1;
}

.vip-badge-txt {
  font-size: 13rpx;
  font-weight: 800;
  color: #f3d27a;
  line-height: 1;
}

.pack-lock-tip {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  z-index: 14;
  font-size: 13rpx;
  font-weight: 600;
  color: rgba(248, 250, 252, 0.78);
  background: rgba(12, 14, 18, 0.82);
  border: 1px solid rgba(255, 255, 255, 0.12);
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
  white-space: nowrap;
  pointer-events: none;
}

.card-ambient-spot {
  position: absolute;
  top: 24rpx;
  left: 12%;
  right: 12%;
  height: 196rpx;
  border-radius: 50%;
  opacity: 0.20;
  filter: blur(26rpx);
  pointer-events: none;
  z-index: 1;
}

.shelf-pack-facade {
  height: 256rpx;
  width: 100%;
  position: relative;
  z-index: 2;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 8rpx 8rpx 6rpx 8rpx;
  box-sizing: border-box;
  overflow: hidden;
  box-shadow: inset 0 2rpx 6rpx rgba(255, 255, 255, 0.08);
}

.shelf-pack-card.is-currently-equipped .shelf-pack-facade {
  border-bottom-color: rgba(226, 190, 111, 0.28);
}

.shelf-pack-facade.has-real-pack {
  height: 256rpx;
  padding: 12rpx 10rpx 20rpx 10rpx;
  background:
    radial-gradient(circle at 50% 40%, rgba(38, 42, 52, 0.48) 0%, rgba(16, 18, 23, 0.90) 68%, #090a0d 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.shelf-pack-facade.slender-facade {
  padding: 8rpx 10rpx 6rpx 10rpx;
}

.shelf-pack-facade.has-real-pack.slender-facade {
  padding: 12rpx 10rpx 20rpx 10rpx;
}

.shelf-gallery-flutes {
  position: absolute;
  inset: 0;
  background: repeating-linear-gradient(
    90deg,
    rgba(255, 255, 255, 0.012) 0rpx,
    rgba(255, 255, 255, 0.012) 10rpx,
    transparent 10rpx,
    transparent 22rpx
  );
  mask-image: radial-gradient(ellipse at 50% 42%, black 20%, transparent 80%);
  -webkit-mask-image: radial-gradient(ellipse at 50% 42%, black 20%, transparent 80%);
  pointer-events: none;
  z-index: 1;
}

/* ==================== 数字底座 (3D Cylindrical Digital Pedestal Base) ==================== */
.shelf-pedestal-base {
  position: absolute;
  bottom: 6rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 86%;
  height: 36rpx;
  pointer-events: none;
  z-index: 2;
}

.pedestal-cylinder-body {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
