}

.stock-dot.stock-empty {
  background: #ef4444;
}

.stock-text {
  font-size: 15rpx;
  color: #94a3b8;
  white-space: nowrap;
}

/* 快速操作触控条 */
.shelf-actions-bar {
  display: flex;
  width: 100%;
  margin-top: 2rpx;
}

.act-btn {
  width: 100%;
  font-size: 16rpx;
  font-weight: 700;
  border-radius: 14rpx;
  padding: 8rpx 0;
  line-height: 1.2;
  margin: 0;
  text-align: center;
  white-space: nowrap;
