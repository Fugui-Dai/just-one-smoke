/* ==================== 抽出一支烟的飞升动画 (Pulled Cigarette) ==================== */
.pulled-cigarette-flight {
  position: absolute;
  top: 100rpx;
  left: 50%;
  transform: translateX(-50%) translateY(40rpx) scale(0.95);
  width: 26rpx;
  height: 380rpx;
  z-index: 40;
  display: flex;
  flex-direction: column;
  pointer-events: none;
  opacity: 0;
  /* 慢慢提出来：1.75s 舒缓平滑抽出动画 */
  transition: transform 1.75s cubic-bezier(0.2, 0.85, 0.32, 1), opacity 0.5s ease, filter 1.75s ease;
}

.pulled-cigarette-flight.in-flight {
  opacity: 1;
  transform: translateX(-50%) translateY(-235rpx) rotate(-2deg) scale(1.06);
  filter: drop-shadow(0 16rpx 36rpx rgba(245, 158, 11, 0.65));
}

.flight-cig-paper {
  flex: 1;
  background: var(--paper-bg, #fffdf5);
  border-radius: 4rpx 4rpx 0 0;
  box-shadow: inset 2rpx 0 4rpx rgba(0, 0, 0, 0.15);
  position: relative;
}

.flight-cig-fire-tip {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: #374151;
}

.flight-cig-filter {
  height: 90rpx;
  background: var(--filter-bg, #991b1b);
  border-radius: 0 0 4rpx 4rpx;
  position: relative;
  box-shadow: inset 0 2rpx 4rpx rgba(255, 255, 255, 0.35);
}

.flight-filter-band {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 8rpx;
  background: var(--band-bg, #f59e0b);
}

.flight-bead-dot {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  box-shadow: 0 0 8rpx currentColor;
}

.flight-sparks {
  position: absolute;
  inset: 0;
}
.spark-dot {
  position: absolute;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #ffbe3b;
  box-shadow: 0 0 10rpx #ffbe3b;
  animation: spark-fly 0.6s infinite ease-out;
}
.s1 { top: 20%; left: -16rpx; }
.s2 { top: 60%; right: -16rpx; animation-delay: 0.2s; }
.s3 { top: 80%; left: -10rpx; animation-delay: 0.4s; }

@keyframes spark-fly {
  0% { transform: scale(1); opacity: 1; }
  100% { transform: scale(0) translate(10rpx, -20rpx); opacity: 0; }
}


/* 烟盒下方专属品牌经典标语 */
.pack-slogan-card {
  margin-top: 24rpx;
