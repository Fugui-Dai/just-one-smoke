/* pages/mine/mine.wxss */
.mine-page-container {
  width: 100vw;
  height: 100vh;
  background: radial-gradient(ellipse at 50% 0%, #1e283d 0%, #131826 55%, #0e121d 100%);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  position: relative;
  box-sizing: border-box;
  transition: background 0.35s ease;
}

.mine-page-container.theme-emerald,
.mine-page-container.theme-day {
  background: radial-gradient(circle at 50% 14%, rgba(16, 185, 129, 0.42) 0%, #103227 48%, #0a1f18 82%);
}

.mine-page-container.theme-purple,
.mine-page-container.theme-month {
  background: radial-gradient(circle at 50% 14%, rgba(168, 85, 247, 0.42) 0%, #291747 48%, #140b24 82%);
}

.mine-page-container.theme-glacier,
.mine-page-container.theme-lifetime {
  background: radial-gradient(circle at 50% 14%, rgba(251, 191, 36, 0.45) 0%, rgba(180, 83, 9, 0.22) 38%, #261c0d 68%, #161007 88%);
}

/* ==================== 顶部自定义导航栏 ==================== */
.custom-navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  background: rgba(8, 10, 15, 0.85);
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  box-sizing: border-box;
}

.theme-day .custom-navbar {
  background: rgba(5, 20, 16, 0.86);
  border-bottom-color: rgba(16, 185, 129, 0.22);
}
.theme-month .custom-navbar {
  background: rgba(16, 10, 28, 0.86);
  border-bottom-color: rgba(168, 85, 247, 0.24);
}
.theme-lifetime .custom-navbar {
  background: rgba(20, 14, 6, 0.88);
  border-bottom-color: rgba(251, 191, 36, 0.26);
}

.navbar-content {
  position: relative;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-left: 20rpx;
  box-sizing: border-box;
}

.nav-back-btn {
  position: relative;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 50%;
  color: #e2e8f0;
  transition: all 0.2s ease;
  padding: 0;
}

.nav-back-btn:active {
  transform: scale(0.92);
  background: rgba(255, 255, 255, 0.14);
}

.back-chevron-arrow {
  width: 18rpx;
  height: 18rpx;
  border-left: 4rpx solid #e2e8f0;
  border-bottom: 4rpx solid #e2e8f0;
  transform: rotate(45deg);
  margin-left: 6rpx;
}

.nav-center-title-box {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  margin: auto;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  z-index: 5;
}

.nav-center-title-text {
  font-size: 34rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  color: #f8fafc;
  background: linear-gradient(135deg, #f8fafc 0%, #cbd5e1 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  text-align: center;
}

.nav-placeholder {
  width: 60rpx;
  height: 60rpx;
}

/* ==================== 偏好设置弹窗 (高定一屏无滑动全览) ==================== */
.glass-modal-backdrop {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: radial-gradient(circle at 50% 50%, rgba(15, 23, 42, 0.94) 0%, rgba(4, 7, 15, 0.98) 100%);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  box-sizing: border-box;
}

.profile-dialog-card {
  width: 100%;
  max-width: 680rpx;
  background: linear-gradient(180deg, #182236 0%, #0d121f 100%);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 36rpx;
  padding: 20rpx 24rpx 26rpx 24rpx;
  box-shadow: 0 32rpx 80rpx -12rpx rgba(0, 0, 0, 0.9), inset 0 1px 0 rgba(255, 255, 255, 0.16);
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
}

.dialog-drag-handle {
  width: 64rpx;
  height: 6rpx;
  background: rgba(255, 255, 255, 0.22);
  border-radius: 4rpx;
  margin: 0 auto 12rpx auto;
  flex-shrink: 0;
}

.dialog-top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
  flex-shrink: 0;
}

.dialog-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.dialog-header-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #f8fafc;
  letter-spacing: 0.5rpx;
}

.dialog-status-tag {
  font-size: 22rpx;
  font-weight: 600;
  color: #fbbf24;
  background: rgba(245, 158, 11, 0.15);
  border: 1px solid rgba(245, 158, 11, 0.35);
  border-radius: 10rpx;
  padding: 2rpx 12rpx;
}

.dialog-close-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #94a3b8;
  transition: all 0.2s ease;
}

.dialog-close-btn-hover {
  background: rgba(255, 255, 255, 0.18);
  color: #ffffff;
}

/* 实时推算紧凑双核/三栏数据条 */
.projection-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, rgba(245, 158, 11, 0.12) 0%, rgba(16, 185, 129, 0.08) 100%);
  border: 1px solid rgba(245, 158, 11, 0.25);
  border-radius: 20rpx;
  padding: 12rpx 16rpx;
  margin-bottom: 14rpx;
  flex-shrink: 0;
}

.strip-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.strip-label {
  font-size: 22rpx;
  font-weight: 600;
  color: #94a3b8;
  margin-bottom: 2rpx;
}

.strip-val-box {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
}

.strip-symbol {
  font-size: 22rpx;
  font-weight: 700;
  color: #fbbf24;
}

.strip-num {
  font-size: 32rpx;
  font-weight: 900;
  color: #fbbf24;
}

.green-text {
  color: #34d399;
}

.cyan-text {
  color: #38bdf8;
}

.strip-unit {
  font-size: 22rpx;
  font-weight: 600;
  color: #94a3b8;
  margin-left: 2rpx;
}

.strip-divider {
  width: 1px;
  height: 38rpx;
  background: rgba(255, 255, 255, 0.12);
  margin: 0 8rpx;
}

/* 核心表单容器 (纯一屏无滚动) */
.dialog-form-container {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.pref-compact-card {
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 22rpx;
  padding: 14rpx 16rpx;
}

.pref-row-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.pref-title-group {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.pref-mini-icon {
  width: 34rpx;
  height: 34rpx;
  flex-shrink: 0;
}

.pref-field-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #f1f5f9;
}

.pref-field-hint {
  font-size: 22rpx;
  color: #94a3b8;
}

/* 紧凑微步进器 */
.mini-stepper {
  display: flex;
  align-items: center;
  background: rgba(13, 18, 29, 0.9);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 16rpx;
  padding: 4rpx 6rpx;
}

.mini-step-btn {
  width: 52rpx;
  height: 48rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #f8fafc;
  background: rgba(255, 255, 255, 0.08);
  transition: all 0.15s ease;
}

.step-hover {
  background: rgba(255, 255, 255, 0.2);
  transform: scale(0.96);
}

.mini-disabled {
  opacity: 0.22;
  color: #64748b;
  pointer-events: none;
}

.mini-input-box {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 10rpx;
}

.mini-currency {
  font-size: 22rpx;
  font-weight: 700;
  color: #fbbf24;
}

.mini-input {
  width: 76rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 800;
  color: #ffffff;
  height: 48rpx;
}

.mini-suffix {
  font-size: 22rpx;
  font-weight: 600;
  color: #94a3b8;
}

/* 快捷胶囊单行 */
.compact-chips-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  width: 100%;
}

.compact-chip {
  flex: 1;
  text-align: center;
  padding: 8rpx 4rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.09);
  font-size: 20rpx;
  letter-spacing: -0.5rpx;
  font-weight: 600;
  color: #cbd5e1;
  transition: all 0.15s ease;
  white-space: nowrap;
}

.compact-chip:active {
  transform: scale(0.96);
}

.chip-active-gold {
  background: rgba(245, 158, 11, 0.24);
  border-color: #f59e0b;
  color: #fbbf24;
  font-weight: 700;
  box-shadow: 0 0 10rpx rgba(245, 158, 11, 0.3);
}

.chip-active-cyan {
  background: rgba(56, 189, 248, 0.24);
  border-color: #38bdf8;
  color: #38bdf8;
  font-weight: 700;
  box-shadow: 0 0 10rpx rgba(56, 189, 248, 0.3);
}

.chip-active-purple {
  background: rgba(168, 85, 247, 0.24);
  border-color: #c084fc;
  color: #c084fc;
  font-weight: 700;
  box-shadow: 0 0 10rpx rgba(168, 85, 247, 0.3);
}

/* 底部操作按钮 */
.dialog-footer-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 18rpx;
  flex-shrink: 0;
}

.footer-btn-cancel {
  flex: 1;
  height: 76rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  color: #94a3b8;
  transition: all 0.2s ease;
}

.footer-btn-cancel-hover {
  background: rgba(255, 255, 255, 0.14);
  color: #ffffff;
}

.footer-btn-save {
  flex: 2;
  height: 76rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 50%, #d97706 100%);
  box-shadow: 0 8rpx 24rpx rgba(245, 158, 11, 0.32);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  transition: all 0.2s ease;
}

.footer-btn-save-hover {
  opacity: 0.92;
  transform: scale(0.985);
}

.btn-save-text {
  font-size: 26rpx;
  font-weight: 800;
  color: #1e1b12;
}

.btn-save-arrow {
  font-size: 28rpx;
  font-weight: 800;
  color: #1e1b12;
}

/* ==========================================================================
 * [DEV_ADMIN_TEST] 管理员极速测试控制台样式 (可整块安全删除)
 * ========================================================================== */
.dev-admin-backdrop {
  position: fixed;
  inset: 0;
  z-index: 99999;
  background: rgba(0, 0, 0, 0.72);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.2s ease;
}

.dev-admin-backdrop-active {
  opacity: 1;
  pointer-events: auto;
}

.dev-admin-drawer {
  width: 100%;
  max-height: 86vh;
  background: #0f172a;
  border-top: 2rpx solid #334155;
  border-radius: 28rpx 28rpx 0 0;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  transform: translateY(100%);
  transition: transform 0.24s ease-out;
}

.dev-admin-backdrop-active .dev-admin-drawer {
  transform: translateY(0);
}

.dev-admin-header {
  padding: 16rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #1e293b;
  border-bottom: 1rpx solid #334155;
}

.dev-admin-title-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.dev-admin-title {
  font-size: 26rpx;
  font-weight: 800;
  color: #f1f5f9;
}

.dev-admin-sub-tag {
  font-size: 18rpx;
  color: #94a3b8;
  background: #334155;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.dev-admin-close-btn {
  padding: 8rpx 20rpx;
  border-radius: 10rpx;
  background: #334155;
  color: #e2e8f0;
  font-size: 22rpx;
  font-weight: 700;
}

/* 状态指示条 */
.dev-admin-hud-bar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 10rpx 20rpx;
  background: #0b1120;
  border-bottom: 1rpx solid #1e293b;
}

.dev-hud-txt {
  font-size: 20rpx;
  color: #64748b;
}

.dev-c-gold { color: #f59e0b; font-weight: 700; }
.dev-c-dim { color: #94a3b8; font-weight: 700; }
.dev-c-cyan { color: #06b6d4; font-weight: 700; }
.dev-c-green { color: #10b981; font-weight: 700; }
.dev-c-purple { color: #a855f7; font-weight: 700; }

.dev-admin-scroll {
  flex: 1;
  height: 72vh;
  max-height: 76vh;
  box-sizing: border-box;
  -webkit-overflow-scrolling: touch;
  overscroll-behavior: contain;
}

.dev-admin-content-pad {
  padding: 16rpx 20rpx 48rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  box-sizing: border-box;
}

.dev-group {
  background: #1e293b;
  border: 1rpx solid #334155;
  border-radius: 14rpx;
  padding: 14rpx 12rpx;
  box-sizing: border-box;
}

.dev-group-label {
  font-size: 21rpx;
  font-weight: 800;
  color: #94a3b8;
  margin-bottom: 10rpx;
  padding-left: 4rpx;
}

/* 一行多个网格排布 */
.dev-row-grid {
  display: grid;
  gap: 8rpx;
}

.cols-4 {
  grid-template-columns: repeat(4, 1fr);
}

.cols-3 {
  grid-template-columns: repeat(3, 1fr);
}

.cols-1 {
  grid-template-columns: 1fr;
}

.dev-btn {
  height: 58rpx;
  border-radius: 8rpx;
  font-size: 21rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-sizing: border-box;
  padding: 0 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.dev-btn-active {
  opacity: 0.6;
  transform: scale(0.97);
}

/* 按钮颜色 */
.btn-amber {
  background: #78350f;
  border: 1rpx solid #b45309;
  color: #fde68a;
}

.btn-blue {
  background: #0c4a6e;
  border: 1rpx solid #0284c7;
  color: #bae6fd;
}

.btn-cyan {
  background: #164e63;
  border: 1rpx solid #0891b2;
  color: #a5f3fc;
}

.btn-green {
  background: #064e3b;
  border: 1rpx solid #059669;
  color: #a7f3d0;
}

.btn-orange {
  background: #7c2d12;
  border: 1rpx solid #ea580c;
  color: #fed7aa;
}

.btn-purple {
  background: #581c87;
  border: 1rpx solid #9333ea;
  color: #e9d5ff;
}

.btn-gold {
  background: #713f12;
  border: 1rpx solid #ca8a04;
  color: #fef08a;
}

.btn-gray {
  background: #334155;
  border: 1rpx solid #475569;
  color: #cbd5e1;
}

.btn-red {
  background: #7f1d1d;
  border: 1rpx solid #dc2626;
  color: #fecaca;
}

.disclaimer-copy-hover {
  opacity: 0.6;
}
/* ==================== [DEV_ADMIN_TEST] 结束 ==================== */



