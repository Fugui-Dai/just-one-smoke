<!-- pages/mine/mine.wxml -->
<view class="mine-page-container {{ vipTheme ? 'theme-' + vipTheme : '' }}">

  <!-- VIP 尊享动态极光天幕与浮光星尘层 -->
  <view wx:if="{{ vipTheme }}" class="vip-ambient-stage">
    <view class="vip-aurora-orb orb-primary"></view>
    <view class="vip-aurora-orb orb-secondary"></view>
    <view class="vip-spark s1"></view>
    <view class="vip-spark s2"></view>
    <view class="vip-spark s3"></view>
  </view>

  <!-- ==================== 顶部统一导航栏 (安全避让微信原生胶囊按钮) ==================== -->
  <view class="custom-navbar" style="padding-top: {{ statusBarHeight }}px; height: {{ statusBarHeight + navBarHeight }}px;">
    <view class="navbar-content" style="height: {{ navBarHeight }}px; padding-right: {{ capsuleRightSpace }}px;">
      
      <!-- 返回按钮 -->
      <view class="nav-back-btn" bindtap="onNavigateBack">
        <view class="back-chevron-arrow"></view>
      </view>

      <!-- 导航中心标题 -->
      <view class="nav-center-title-box">
        <text class="nav-center-title-text">机能蜕变</text>
      </view>

      <!-- 占位平衡 (已删除设置图标) -->
      <view class="nav-placeholder"></view>

    </view>
  </view>

  <!-- ==================== 个人中心 / 健康数据看板 ==================== -->
  <stats-view 
    profile="{{ profile }}"
    myRankInfo="{{ myRankInfo }}"
    totalSubstituted="{{ totalSubstituted }}"
    totalPacksSaved="{{ totalPacksSaved }}"
    totalSavedMoney="{{ totalSavedMoney }}"
    totalTarAvoided="{{ totalTarAvoided }}"
    totalLifeRegained="{{ totalLifeRegained }}"
    lifeRegainedHours="{{ lifeRegainedHours }}"
    igniteCount="{{ igniteCount }}"
    totalIgnites="{{ totalIgnites }}"
    totalFinishedCigs="{{ totalFinishedCigs }}"
    quitDays="{{ quitDays }}"
    weeklyAvg="{{ weeklyAvg }}"
    todayCount="{{ todayCount }}"
    dailyTrends="{{ dailyTrends }}"
    whoStages="{{ whoStages }}"
    topPadding="{{ (statusBarHeight || 44) + (navBarHeight || 44) }}"
    bindopenprofile="openProfileModal"
    bindupdateavatar="onUpdateAvatar"
    bindupdatenickname="onUpdateNickname"
    bindtoleaderboard="goToLeaderboard"
    bindgotoleaderboard="goToLeaderboard"
    bindtitlechange="onTitleChange"
    bindopenadmintest="onOpenAdminTest"
    bindthemechange="onVipThemeChange"
    bindthemepreview="onVipThemePreview"
    vipTheme="{{ vipTheme }}"
  />

  <!-- ==================== 偏好设置弹窗 (高定一屏无滑动全览) ==================== -->
  <view class="glass-modal-backdrop" wx:if="{{ showProfileModal }}" catchtouchmove="preventTouchMove">
    <view class="profile-dialog-card">
      <!-- 顶部指示拉手 -->
      <view class="dialog-drag-handle"></view>

      <!-- 顶部精炼标题栏 -->
      <view class="dialog-top-bar">
        <view class="dialog-title-row">
          <text class="dialog-header-title">吸烟偏好设置</text>
          <view class="dialog-status-tag">测算基准</view>
        </view>
        <view class="dialog-close-btn" bindtap="closeProfileModal" hover-class="dialog-close-btn-hover">✕</view>
      </view>

      <!-- 实时推算双核数据条 (Ultra-compact Live Strip) -->
      <view class="projection-strip">
        <view class="strip-item gold-strip">
          <text class="strip-label">💰 预计年省</text>
          <view class="strip-val-box">
            <text class="strip-symbol">¥</text>
            <text class="strip-num">{{ projections.annualMoneyFormatted }}</text>
          </view>
        </view>
        <view class="strip-divider"></view>
        <view class="strip-item emerald-strip">
          <text class="strip-label">🌿 年免焦油</text>
          <view class="strip-val-box">
            <text class="strip-num green-text">{{ projections.annualTar }}</text>
            <text class="strip-unit">g</text>
          </view>
        </view>
        <view class="strip-divider"></view>
        <view class="strip-item cyan-strip">
          <text class="strip-label">📦 少抽烟包</text>
          <view class="strip-val-box">
            <text class="strip-num cyan-text">{{ projections.annualPacks }}</text>
            <text class="strip-unit">包/年</text>
          </view>
        </view>
      </view>

      <!-- 核心表单区 (无需滑动，一屏通览) -->
      <view class="dialog-form-container">
        
        <!-- 1. 单包香烟价格 -->
        <view class="pref-compact-card">
          <view class="pref-row-header">
            <view class="pref-title-group">
              <image class="pref-mini-icon" src="{{ priceCoinIcon }}" />
              <text class="pref-field-title">日常口粮烟售价</text>
              <text class="pref-field-hint">(现实测算基准·¥5~¥100)</text>
            </view>
            <view class="mini-stepper">
              <view class="mini-step-btn minus {{ editProfile.packPrice <= 5 ? 'mini-disabled' : '' }}" 
                    bindtap="adjustPackPrice" data-delta="-1" hover-class="step-hover">-</view>
              <view class="mini-input-box">
                <text class="mini-currency">¥</text>
                <input class="mini-input" 
                       type="number" 
                       maxlength="3" 
                       value="{{ editProfile.packPrice }}" 
                       bindinput="onInputPackPrice" 
                       bindblur="onBlurPackPrice" />
              </view>
              <view class="mini-step-btn plus {{ editProfile.packPrice >= 100 ? 'mini-disabled' : '' }}" 
                    bindtap="adjustPackPrice" data-delta="1" hover-class="step-hover">+</view>
            </view>
          </view>
          <view class="compact-chips-row">
            <view wx:for="{{ quickPricePresets }}" wx:key="val" 
                  class="compact-chip {{ editProfile.packPrice === item.val ? 'chip-active-gold' : '' }}" 
                  bindtap="setQuickPrice" data-val="{{ item.val }}">
              {{ item.label }}
            </view>
          </view>
        </view>

        <!-- 2. 日均吸烟量 -->
        <view class="pref-compact-card">
          <view class="pref-row-header">
            <view class="pref-title-group">
              <image class="pref-mini-icon" src="{{ cigsCountIcon }}" />
              <text class="pref-field-title">日均吸烟量</text>
              <text class="pref-field-hint">约{{ editProfile.cigsPerDay ? (editProfile.cigsPerDay / 20) : 0 }}包/天</text>
            </view>
            <view class="mini-stepper">
              <view class="mini-step-btn minus {{ editProfile.cigsPerDay <= 1 ? 'mini-disabled' : '' }}" 
                    bindtap="adjustCigsPerDay" data-delta="-1" hover-class="step-hover">-</view>
              <view class="mini-input-box">
                <input class="mini-input" 
                       type="number" 
                       maxlength="3" 
                       value="{{ editProfile.cigsPerDay }}" 
                       bindinput="onInputCigsPerDay" 
                       bindblur="onBlurCigsPerDay" />
                <text class="mini-suffix">支</text>
              </view>
              <view class="mini-step-btn plus {{ editProfile.cigsPerDay >= 100 ? 'mini-disabled' : '' }}" 
                    bindtap="adjustCigsPerDay" data-delta="1" hover-class="step-hover">+</view>
            </view>
          </view>
          <view class="compact-chips-row">
            <view wx:for="{{ quickCigPresets }}" wx:key="val" 
                  class="compact-chip {{ editProfile.cigsPerDay === item.val ? 'chip-active-cyan' : '' }}" 
                  bindtap="setQuickCigs" data-val="{{ item.val }}">
              {{ item.label }}
            </view>
          </view>
        </view>

        <!-- 3. 既往烟龄 -->
        <view class="pref-compact-card">
          <view class="pref-row-header">
            <view class="pref-title-group">
              <image class="pref-mini-icon" src="{{ yearsClockIcon }}" />
              <text class="pref-field-title">既往吸烟年限</text>
              <text class="pref-field-hint">累计烟龄</text>
            </view>
            <view class="mini-stepper">
              <view class="mini-step-btn minus {{ editProfile.smokeYears <= 0 ? 'mini-disabled' : '' }}" 
                    bindtap="adjustSmokeYears" data-delta="-1" hover-class="step-hover">-</view>
              <view class="mini-input-box">
                <input class="mini-input" 
                       type="number" 
                       maxlength="2" 
                       value="{{ editProfile.smokeYears }}" 
                       bindinput="onInputSmokeYears" 
                       bindblur="onBlurSmokeYears" />
                <text class="mini-suffix">年</text>
              </view>
              <view class="mini-step-btn plus {{ editProfile.smokeYears >= 70 ? 'mini-disabled' : '' }}" 
                    bindtap="adjustSmokeYears" data-delta="1" hover-class="step-hover">+</view>
            </view>
          </view>
          <view class="compact-chips-row">
            <view wx:for="{{ quickYearPresets }}" wx:key="val" 
                  class="compact-chip {{ editProfile.smokeYears === item.val ? 'chip-active-purple' : '' }}" 
                  bindtap="setQuickYears" data-val="{{ item.val }}">
              {{ item.label }}
            </view>
          </view>
        </view>

      </view>

      <!-- 底部双操作按钮 -->
      <view class="dialog-footer-actions">
        <view class="footer-btn-cancel" bindtap="closeProfileModal" hover-class="footer-btn-cancel-hover">
          <text>取消</text>
        </view>
        <view class="footer-btn-save" bindtap="saveProfile" hover-class="footer-btn-save-hover">
          <text class="btn-save-text">保存偏好设置</text>
          <text class="btn-save-arrow">→</text>
        </view>
      </view>
    </view>
  </view>


  <!-- ==========================================================================
       [DEV_ADMIN_TEST] 管理员极速测试控制台弹窗 (可整块安全删除)
       ========================================================================== -->
  <view class="dev-admin-backdrop {{ showAdminTestModal ? 'dev-admin-backdrop-active' : '' }}" 
        wx:if="{{ showAdminTestModal }}" 
        bindtap="onCloseAdminTest" 
        catchtouchmove="preventTouchMove">
    <view class="dev-admin-drawer" catchtap="preventBubble">
      
      <!-- 顶部简易标题栏 -->
      <view class="dev-admin-header">
        <view class="dev-admin-title-wrap">
          <text class="dev-admin-title">🛠️ 管理员快速测试工具箱</text>
          <text class="dev-admin-sub-tag">快速注入</text>
        </view>
        <view class="dev-admin-close-btn" bindtap="onCloseAdminTest" hover-class="dev-btn-active">✕ 关闭</view>
      </view>

      <!-- 实时状态条 -->
      <view class="dev-admin-hud-bar">
        <text class="dev-hud-txt">VIP: <text class="{{ devVipActive ? 'dev-c-gold' : 'dev-c-dim' }}">{{ devVipActive ? (devVipInfo.isLifetime ? '永久VIP' : '已开通') : '未开通' }}</text></text>
        <text class="dev-hud-txt">今日: <text class="dev-c-gold">{{ devDailySmokedCount || 0 }}支</text></text>
        <text class="dev-hud-txt">替烟: <text class="dev-c-green">{{ totalSubstituted }}支</text></text>
        <text class="dev-hud-txt">当前盒: <text class="dev-c-purple">{{ devCurrentPackCount }}支</text></text>
      </view>

      <!-- 滚动操作面板 -->
      <scroll-view class="dev-admin-scroll" scroll-y enable-passive>
        <view class="dev-admin-content-pad">

          <!-- 分组 1: 首页吸烟仿真 (一行4个) -->
          <view class="dev-group">
            <view class="dev-group-label">🔥 首页吸烟与燃烧仿真 (返回首页可见)</view>
            <view class="dev-row-grid cols-4">
              <view class="dev-btn btn-amber" bindtap="devSetSmokeProgress90" hover-class="dev-btn-active">吸烟90%</view>
              <view class="dev-btn btn-amber" bindtap="devSetSmokeProgress50" hover-class="dev-btn-active">吸烟50%</view>
              <view class="dev-btn btn-blue" bindtap="devSetSmokeProgress10" hover-class="dev-btn-active">吸烟10%</view>
              <view class="dev-btn btn-green" bindtap="devResetFullSmoke" hover-class="dev-btn-active">满长100%</view>
              <view class="dev-btn btn-orange" bindtap="devIgniteNow" hover-class="dev-btn-active">立即点燃</view>
              <view class="dev-btn btn-gray" bindtap="devExtinguishNow" hover-class="dev-btn-active">立即掐灭</view>
              <view class="dev-btn btn-cyan" bindtap="devTapAshNow" hover-class="dev-btn-active">立即弹灰</view>
              <view class="dev-btn btn-purple" bindtap="devToggleBead" hover-class="dev-btn-active">捏/复爆珠</view>
            </view>
            <view class="dev-row-grid cols-1" style="margin-top: 8rpx;">
              <view class="dev-btn btn-gold" bindtap="devFinishSmokeNow" hover-class="dev-btn-active">⚡ 快速吸尽此支 (立即+1替烟并结算)</view>
            </view>
          </view>

          <!-- 分组 2: 打卡天数与时间 (一行4个) -->
          <view class="dev-group">
            <view class="dev-group-label">📅 打卡天数与时间模拟</view>
            <view class="dev-row-grid cols-4">
              <view class="dev-btn btn-blue" bindtap="devAddQuitDays" data-days="1" hover-class="dev-btn-active">打卡+1天</view>
              <view class="dev-btn btn-blue" bindtap="devAddQuitDays" data-days="7" hover-class="dev-btn-active">打卡+7天</view>
              <view class="dev-btn btn-blue" bindtap="devAddQuitDays" data-days="30" hover-class="dev-btn-active">打卡+30天</view>
              <view class="dev-btn btn-gray" bindtap="devSetQuitDays" data-days="1" hover-class="dev-btn-active">设为第1天</view>
              <view class="dev-btn btn-purple" bindtap="devSetQuitDays" data-days="21" hover-class="dev-btn-active">设为21天</view>
              <view class="dev-btn btn-gold" bindtap="devSetQuitDays" data-days="100" hover-class="dev-btn-active">设为100天</view>
              <view class="dev-btn btn-cyan" bindtap="devSetQuitDays" data-days="365" hover-class="dev-btn-active">设为1年</view>
            </view>
          </view>

          <!-- 分组 3: VIP 会员测试 (一行4个) -->
          <view class="dev-group">
            <view class="dev-group-label">👑 VIP特权与到期模拟</view>
            <view class="dev-row-grid cols-4">
              <view class="dev-btn btn-gold" bindtap="devActivateVipLifetime" hover-class="dev-btn-active">永久VIP</view>
              <view class="dev-btn btn-purple" bindtap="devActivateVipMonth" hover-class="dev-btn-active">30天月卡</view>
              <view class="dev-btn btn-green" bindtap="devActivateVipDay" hover-class="dev-btn-active">24小时卡</view>
              <view class="dev-btn btn-orange" bindtap="devExpireVipNow" hover-class="dev-btn-active">过期1秒</view>
            </view>
            <view class="dev-row-grid cols-1" style="margin-top: 8rpx;">
              <view class="dev-btn btn-gray" bindtap="devClearVip" hover-class="dev-btn-active">恢复非VIP (清除全部VIP特权)</view>
            </view>
          </view>

          <!-- 分组 4: 替烟支数与趋势数据 (一行4个) -->
          <view class="dev-group">
            <view class="dev-group-label">📊 替烟支数与趋势数据 (今日已抽: {{ devDailySmokedCount || 0 }} 支)</view>
            <view class="dev-row-grid cols-4">
              <view class="dev-btn btn-gold" bindtap="devAddDailySmoked10" hover-class="dev-btn-active">⚡ 今日+10支</view>
              <view class="dev-btn btn-purple" bindtap="devSetDailySmoked40" hover-class="dev-btn-active">今日直达40</view>
              <view class="dev-btn btn-cyan" bindtap="devAddRecords" data-count="1" hover-class="dev-btn-active">替烟+1</view>
              <view class="dev-btn btn-cyan" bindtap="devAddRecords" data-count="5" hover-class="dev-btn-active">替烟+5</view>
              <view class="dev-btn btn-blue" bindtap="devSetTotalRecords" data-count="100" hover-class="dev-btn-active">设为100支</view>
              <view class="dev-btn btn-blue" bindtap="devSetTotalRecords" data-count="500" hover-class="dev-btn-active">设为500支</view>
              <view class="dev-btn btn-gray" bindtap="devClearDailySmoked" hover-class="dev-btn-active">清零今日抽吸</view>
              <view class="dev-btn btn-green" bindtap="devFill7DaysTrends" hover-class="dev-btn-active">填满7天图</view>
            </view>
          </view>

          <!-- 分组 5: 烟盒库存调试 (一行4个) -->
          <view class="dev-group">
            <view class="dev-group-label">📦 烟盒库存调试</view>
            <view class="dev-row-grid cols-4">
              <view class="dev-btn btn-orange" bindtap="devSetCurrentPackCount" data-count="0" hover-class="dev-btn-active">当前盒0支</view>
              <view class="dev-btn btn-orange" bindtap="devSetCurrentPackCount" data-count="1" hover-class="dev-btn-active">当前盒1支</view>
              <view class="dev-btn btn-green" bindtap="devRefillCurrentPack" hover-class="dev-btn-active">当前盒补满</view>
              <view class="dev-btn btn-green" bindtap="devRefillAllPacks" hover-class="dev-btn-active">37款盒全满</view>
            </view>
          </view>

          <!-- 分组 6: 展柜名烟、烟雾与成就解锁 (一行4个) -->
          <view class="dev-group">
            <view class="dev-group-label">🌟 展柜名烟、烟雾与成就解锁</view>
            <view class="dev-row-grid cols-4">
              <view class="dev-btn btn-gold" bindtap="devUnlockAllCigarettes" hover-class="dev-btn-active">解锁37款烟</view>
              <view class="dev-btn btn-gray" bindtap="devLockAllCigarettes" hover-class="dev-btn-active">锁定名烟</view>
              <view class="dev-btn btn-purple" bindtap="devUnlockAllSmokeEffects" hover-class="dev-btn-active">解锁6款雾</view>
              <view class="dev-btn btn-gray" bindtap="devLockAllSmokeEffects" hover-class="dev-btn-active">重置烟雾</view>
            </view>
            <view class="dev-row-grid cols-1" style="margin-top: 8rpx;">
              <view class="dev-btn btn-gold" bindtap="devUnlockAllAchievements" hover-class="dev-btn-active">👑 一键点亮全部 16 阶成就与佩戴【无烟圣尊】</view>
            </view>
          </view>

          <!-- 分组 7: 📜 16 阶成语境界称号快速步进 (实时换徽章) -->
          <view class="dev-group">
            <view class="dev-group-label">📜 16 阶成语境界称号快速步进 (实时换徽章)</view>
            <view class="dev-row-grid cols-2">
              <view class="dev-btn btn-blue" bindtap="devStepTitlePrev" hover-class="dev-btn-active">◀ 上一阶称号</view>
              <view class="dev-btn btn-gold" bindtap="devStepTitleNext" hover-class="dev-btn-active">下一阶称号 ▶</view>
            </view>
            <view class="dev-row-grid cols-4" style="margin-top: 8rpx;">
              <view class="dev-btn btn-green" bindtap="devSetTitleTier" data-title="积微成著" hover-class="dev-btn-active">积微成著</view>
              <view class="dev-btn btn-cyan" bindtap="devSetTitleTier" data-title="从容自若" hover-class="dev-btn-active">从容自若</view>
              <view class="dev-btn btn-amber" bindtap="devSetTitleTier" data-title="金石为开" hover-class="dev-btn-active">金石为开</view>
              <view class="dev-btn btn-purple" bindtap="devSetTitleTier" data-title="返璞归真" hover-class="dev-btn-active">返璞归真</view>
            </view>
          </view>

          <!-- 分组 8: 🌌 全域流光心境换肤即时切换 (20款) -->
          <view class="dev-group">
            <view class="dev-group-label">🌌 全域流光心境换肤即时切换 (20款高奢流光)</view>
            <view class="dev-row-grid cols-1">
              <view class="dev-btn btn-purple" bindtap="devCycleVipTheme" hover-class="dev-btn-active">🌌 循环切下一款换肤 (20款轮换)</view>
            </view>
          </view>

          <!-- 分组 9: 系统与维护 (一行3个) -->
          <view class="dev-group">
            <view class="dev-group-label">⚙️ 系统维护与重置</view>
            <view class="dev-row-grid cols-3">
              <view class="dev-btn btn-cyan" bindtap="devShowDataSnapshot" hover-class="dev-btn-active">数据快照</view>
              <view class="dev-btn btn-orange" bindtap="devResetAllStorage" hover-class="dev-btn-active">恢复出厂数据</view>
              <view class="dev-btn btn-red" bindtap="devLockAdminMode" hover-class="dev-btn-active">关闭管理员模式</view>
            </view>
          </view>

        </view>
      </scroll-view>

    </view>
  </view>
  <!-- 全局腾讯级灵动微胶囊 Toast HUD -->
  <custom-toast id="customToast" />

</view>
