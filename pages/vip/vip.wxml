<!-- pages/vip/vip.wxml -->
<view class="vip-page-container theme-{{ currentTheme }}">

  <!-- ==================== 顶部极光沉浸导航栏 ==================== -->
  <view class="custom-navbar" style="padding-top: {{ statusBarHeight }}px; height: {{ statusBarHeight + navBarHeight }}px;">
    <view class="navbar-content" style="height: {{ navBarHeight }}px; padding-right: {{ capsuleRightSpace }}px;">
      
      <!-- 返回按钮 -->
      <view class="nav-back-btn" bindtap="onNavigateBack">
        <view class="back-chevron-arrow"></view>
      </view>

      <!-- 导航中心标题 -->
      <view class="nav-center-title-box">
        <text class="nav-crown-icon">👑</text>
        <text class="nav-center-title-text">VIP特权中心</text>
      </view>

      <!-- 占位平衡 -->
      <view class="nav-placeholder"></view>

    </view>
  </view>

  <!-- ==================== VIP 主体流式滚动区 (微信原生顺畅平滑滚动) ==================== -->
  <view class="vip-scroll-content" style="padding-top: {{ statusBarHeight + navBarHeight + 10 }}px;">

      <!-- iOS 平台规范合规说明条 (微信生态合规高定设计 - 纯净自律专区，零违规敏感字眼) -->
      <view class="ios-compliance-banner" wx:if="{{ isIOS && !vipInfo.isVip }}">
        <view class="icb-glow"></view>
        <view class="icb-icon">🌿</view>
        <view class="icb-content">
          <text class="icb-title">纯净自律 · 公益特权专区</text>
          <text class="icb-desc">为倡导健康生活与纯净呼吸，本专区特权面向全体自律伙伴全面开放免费点亮体验。</text>
        </view>
      </view>

      <!-- 1. 腾讯游戏级 3D 浮雕黑金星曜 Header 舞台 (根据所选档位动态渲染专属气氛) -->
      <view class="vip-hero-stage">
        
        <!-- 动态沉浸环境氛围光晕与星光微粒 -->
        <view class="hero-aurora-glow"></view>
        <view class="hero-aurora-glow-secondary"></view>
        <view class="hero-ambient-particles">
          <view class="p-orb p-orb-1"></view>
          <view class="p-orb p-orb-2"></view>
          <view class="p-orb p-orb-3"></view>
        </view>

        <!-- 3D 皇冠与尊贵徽章 -->
        <view class="hero-crown-wrapper">
          <view class="crown-emblem">
            <text class="crown-emoji">👑</text>
          </view>
          <view class="crown-level-badge">{{ selectedTier.themeName }}</view>
        </view>

        <!-- 主副标案 (随所选档位动态响应，情绪价值拉满) -->
        <view class="hero-text-block">
          <view class="theme-mood-pill">
            <text class="mood-spark">✨</text>
            <text class="mood-text">{{ selectedTier.themeName }} · {{ selectedTier.name }}</text>
          </view>
          <text class="hero-main-title">{{ selectedTier.heroTitle }}</text>
          <text class="hero-sub-slogan">{{ selectedTier.heroSlogan }}</text>
        </view>

        <!-- 当前用户会员状态提示卡 -->
        <view class="current-status-strip {{ vipInfo.isVip ? 'status-active' : 'status-inactive' }}">
          <view class="status-left">
            <text class="status-dot"></text>
            <text class="status-title">{{ vipInfo.isVip ? (vipInfo.isLifetime ? '至尊终身特权生效中' : '尊享特权生效中') : (isIOS ? '当前暂未开启自律特权' : '当前暂未开通 VIP 特权') }}</text>
          </view>
          <text class="status-right" wx:if="{{ vipInfo.isVip }}">{{ vipInfo.isLifetime ? '终身有效' : (vipInfo.formattedExpire + ' 到期') }}</text>
          <text class="status-right hint" wx:else>{{ isIOS ? '开启立享 6 大特权' : '开通立享 6 大特权' }}</text>
        </view>

      </view>

      <!-- 🎨 VIP 专属流光主题衣橱 (速7 · 驭7 先锋名车全系高定色彩) -->
      <view class="vip-theme-wardrobe-card">
        <view class="vtw-header">
          <view class="vtw-header-left">
            <text class="vtw-title">🎨 专属全站背景装扮</text>
          </view>
          <text class="vtw-current">{{ vipInfo.isVip ? ('当前装扮：' + activeVipThemeName) : (isIOS ? '点亮全系主题车色' : '开通点亮全系车色') }}</text>
        </view>

        <!-- 🏎️ 分类过滤标签栏 (全部 / 速7电跑 / 驭7奢享 / 经典尊享) -->
        <view class="vtw-category-tabs">
          <block wx:for="{{ themeCategories }}" wx:key="id">
            <view 
              class="vtw-cat-tab {{ currentThemeCategory === item.id ? 'active' : '' }}"
              bindtap="onSelectThemeCategory"
              data-category="{{ item.id }}"
            >
              <text class="vtw-cat-name">{{ item.name }}</text>
              <text class="vtw-cat-count">{{ item.count }}</text>
            </view>
          </block>
        </view>

        <!-- 药丸/色块矩阵 (4列自适应微距网格) -->
        <scroll-view class="vtw-pills-scroll" scroll-y enhanced show-scrollbar="{{ false }}">
          <view class="vtw-pills-row">
            <block wx:for="{{ filteredThemeOptions }}" wx:key="id">
              <view 
                class="vtw-pill {{ activeVipThemeId === item.id ? 'vtw-pill-active' : '' }} {{ item.isLocked ? 'vtw-pill-locked' : '' }}"
                bindtap="onSelectVipTheme"
                data-id="{{ item.id }}"
                style="{{ activeVipThemeId === item.id ? ('border-color: ' + item.dotColor + '; box-shadow: 0 0 20rpx ' + item.dotColor + '66, inset 0 2rpx 8rpx rgba(255,255,255,0.25); background: ' + item.dotColor + '20;') : '' }}"
              >
                <view class="vtw-pill-icon-box">
                  <view class="vtw-car-dot" style="background: radial-gradient(circle at 35% 30%, #ffffff 0%, {{ item.dotColor }} 45%, #050508 100%); box-shadow: 0 0 12rpx {{ item.dotColor }}, inset 0 2rpx 3rpx rgba(255,255,255,0.8);">
                    <view class="car-dot-specular"></view>
                  </view>
                  <text class="vtw-lock-badge" wx:if="{{ item.isLocked }}">🔒</text>
                </view>
                <view class="vtw-pill-texts">
                  <text class="vtw-pill-name" style="{{ activeVipThemeId === item.id ? ('color: ' + item.dotColor + ';') : '' }}">{{ item.name }}</text>
                </view>
              </view>
            </block>
          </view>
        </scroll-view>
      </view>


      <!-- 2. 腾讯游戏经典 3 档横向对比定价套餐 (Horizontal 3-Tier Selector) -->
      <view class="pricing-section">
        <view class="section-badge-bar">
          <text class="sb-dot"></text>
          <text class="sb-title">{{ vipInfo.isLifetime ? '我的终身特权方案' : (isIOS ? '自律成长权益' : '精选会员方案') }}</text>
        </view>

        <view class="pricing-cards-row">
          
          <block wx:for="{{ tiers }}" wx:key="id">
            <view 
              class="tier-card tier-card-{{ item.id }} {{ selectedTierId === item.id ? 'is-selected' : '' }} {{ item.highlight ? 'is-highlight' : '' }} {{ (vipInfo.isLifetime && item.id !== 'lifetime') ? 'is-tier-included' : '' }} {{ (vipInfo.isLifetime && item.id === 'lifetime') ? 'is-lifetime-owned' : '' }}"
              bindtap="onSelectTier"
              data-id="{{ item.id }}"
            >
              <!-- 推荐角标 / 当前尊享 / 终身已含角标 -->
              <view class="tier-tag-ribbon ribbon-lifetime ribbon-owned" wx:if="{{ vipInfo.isLifetime && item.id === 'lifetime' }}">
                <text class="ribbon-text">👑 当前尊享</text>
              </view>
              <view class="tier-tag-ribbon ribbon-{{ item.id }} ribbon-included" wx:elif="{{ vipInfo.isLifetime && item.id !== 'lifetime' }}">
                <text class="ribbon-text">终身已含</text>
              </view>
              <view class="tier-tag-ribbon ribbon-{{ item.id }} {{ item.highlight ? 'ribbon-hot' : '' }}" wx:elif="{{ item.badge }}">
                <text class="ribbon-text">{{ item.badge }}</text>
              </view>

              <!-- 套餐名称与时长 -->
              <view class="tier-name-box">
                <text class="tier-name">{{ item.name }}</text>
                <text class="tier-period">{{ item.period }}</text>
              </view>

              <!-- 价格主体 (永久会员态展示终身已含/永久尊享，iOS合规态展示特色时长，安卓态展示标价) -->
              <block wx:if="{{ vipInfo.isLifetime }}">
                <view class="tier-price-row tier-owned-price-row" wx:if="{{ item.id === 'lifetime' }}">
                  <text class="price-owned-text">永久尊享</text>
                </view>
                <view class="tier-price-row tier-included-price-row tier-included-{{ item.id }}" wx:else>
                  <text class="price-included-text">终身已含</text>
                </view>
                <view class="tier-daily-box">
                  <text class="daily-label gold" wx:if="{{ item.id === 'lifetime' }}">终身永久有效</text>
                  <text class="daily-label included-label" wx:else>已享终身权益</text>
                </view>
                <text class="tier-original-price owned" wx:if="{{ item.id === 'lifetime' }}">已永久解锁</text>
                <text class="tier-original-price included" wx:elif="{{ item.id === 'day' }}">无需单独开通</text>
                <text class="tier-original-price included" wx:else>无需按月续订</text>
              </block>

              <!-- iOS 合规体验展示 (完全隐去真实货币符号 ¥ 与数字，展现权益规格) -->
              <block wx:elif="{{ isIOS }}">
                <view class="tier-price-row">
                  <text class="price-feature-badge {{ item.id === 'month' ? 'badge-hot' : (item.id === 'lifetime' ? 'badge-gold' : '') }}">{{ item.id === 'day' ? '24H 极速体验' : (item.id === 'month' ? '30天 深度陪伴' : '终身 曜世特权') }}</text>
                </view>
                <view class="tier-daily-box">
                  <text class="daily-label ios-label {{ item.id === 'lifetime' ? 'gold' : '' }}">{{ item.id === 'day' ? '免广告 · 快速体验' : (item.id === 'month' ? '全33款名烟畅吸' : '全版本终身免广') }}</text>
                </view>
                <text class="tier-original-price ios-sub">{{ item.id === 'day' ? '零门槛体验' : (item.id === 'month' ? '全图鉴解锁' : '专属黑金标') }}</text>
              </block>

              <!-- Android 正常商业化展示 -->
              <block wx:else>
                <view class="tier-price-row">
                  <text class="price-currency">¥</text>
                  <text class="price-integer">{{ item.price }}</text>
                  <text class="price-unit">{{ item.id === 'day' ? '/天' : (item.id === 'month' ? '/月' : '') }}</text>
                </view>
                <view class="tier-daily-box">
                  <text class="daily-label" wx:if="{{ item.id !== 'lifetime' }}">低至 ¥{{ item.dailyCost }}/天</text>
                  <text class="daily-label gold" wx:else>{{ item.dailyCost }}</text>
                </view>
                <text class="tier-original-price">原价 ¥{{ item.originalPrice }}</text>
              </block>

              <!-- 选中标记圆圈 -->
              <view class="tier-select-circle {{ selectedTierId === item.id ? 'circle-active' : '' }}">
                <text class="check-tick" wx:if="{{ selectedTierId === item.id }}">✓</text>
              </view>

            </view>
          </block>

        </view>
      </view>


      <!-- 3. 腾讯游戏标配：6 大核心特权矩阵 (Visual Privileges Grid) -->
      <view class="privileges-section">
        <view class="section-badge-bar">
          <text class="sb-dot gold"></text>
          <text class="sb-title">VIP 专属 6 大特权</text>
        </view>

        <view class="privileges-matrix-grid">
          <block wx:for="{{ privileges }}" wx:key="id">
            <view class="privilege-glass-card">
              <view class="priv-icon-circle" style="background: {{ item.bgGradient }}; color: {{ item.color }};">
                <text class="priv-icon-text">{{ item.icon }}</text>
              </view>
              <view class="priv-info">
                <text class="priv-title">{{ item.title }}</text>
                <text class="priv-subtitle">{{ item.subtitle }}</text>
              </view>
            </view>
          </block>
        </view>
      </view>


      <!-- 4. 普通用户 VS VIP 会员价值透视对比表 -->
      <view class="compare-table-section">
        <view class="section-badge-bar">
          <text class="sb-dot purple"></text>
          <text class="sb-title">特权深度对比</text>
        </view>

        <view class="compare-card">
          <view class="compare-thead">
            <text class="th-item th-feat">功能权益</text>
            <text class="th-item th-free">普通烟民</text>
            <text class="th-item th-vip">VIP会员</text>
          </view>
          
          <block wx:for="{{ compareRows }}" wx:key="feature">
            <view class="compare-trow">
              <text class="td-item td-feat">{{ item.feature }}</text>
              <text class="td-item td-free">{{ item.freeText }}</text>
              <text class="td-item td-vip">{{ item.vipText }}</text>
            </view>
          </block>
        </view>
      </view>


      <!-- 5. 官方安全与体验保障说明 -->
      <view class="safety-guarantee-card">
        <view class="guarantee-header">
          <text class="gh-icon">🛡️</text>
          <text class="gh-title">服务体验官方承诺</text>
        </view>
        <view class="guarantee-tips-list">
          <block wx:if="{{ isIOS }}">
            <text class="gt-item">· 开启后特权立即生效并绑定当前微信设备。</text>
            <text class="gt-item">· 绿色免广告陪伴，尊享无烟自律全图鉴。</text>
            <text class="gt-item">· 纯净绿色体验，健康减压生活陪伴。</text>
          </block>
          <block wx:else>
            <text class="gt-item">· 开通后特权立即生效并绑定当前微信设备。</text>
            <text class="gt-item">· 无任何强制扣费，到期自动停权不扣款。</text>
            <text class="gt-item">· 纯净绿色体验，健康减压生活陪伴。</text>
          </block>
        </view>
      </view>

      <!-- 底部安全留白避让固定收银台 -->
      <view class="bottom-safe-spacer"></view>

    </view>


  <!-- ==================== 底部固定高规格收银台 (Tencent Sticky Checkout Bar) ==================== -->
  <view class="sticky-checkout-dock">
    
    <!-- 协议勾选行 / 终身会员官方凭证 / iOS 合规免勾选协议 -->
    <block wx:if="{{ vipInfo.isLifetime }}">
      <view class="agreement-row agreement-lifetime-row" bindtap="openProtocolModal">
        <text class="lifetime-cert-badge">💎 官方认证</text>
        <text class="agreement-lifetime-text">至尊终身特权已永久生效 · </text>
        <text class="agreement-link">查看《服务协议》</text>
      </view>
    </block>
    <block wx:elif="{{ isIOS }}">
      <view class="agreement-row agreement-row-ios">
        <text class="agreement-prefix">点击即代表查阅并同意</text>
        <text class="agreement-link" catchtap="openProtocolModal">《用户服务与隐私协议》</text>
      </view>
    </block>
    <block wx:else>
      <view class="agreement-row" bindtap="toggleAgreement">
        <view class="custom-checkbox {{ isAgreed ? 'is-checked' : '' }}">
          <text class="checkbox-tick" wx:if="{{ isAgreed }}">✓</text>
        </view>
        <view class="agreement-text">
          <text class="agreement-prefix">我已阅读并同意</text>
          <text class="agreement-link" catchtap="openProtocolModal">《VIP会员服务协议》</text>
        </view>
      </view>
    </block>

    <!-- 结算操作主栏 -->
    <view class="checkout-main-bar">
      
      <!-- 左侧价格展示 / 终身尊贵状态 / iOS 尊享专区 -->
      <view class="checkout-price-left">
        <block wx:if="{{ vipInfo.isLifetime }}">
          <view class="cpl-amount-row">
            <text class="cpl-lifetime-badge">👑 终身有效</text>
            <text class="cpl-lifetime-status">全量特权生效中</text>
          </view>
          <text class="cpl-tip">已尊享：全域免广告 · 33款名烟全图鉴畅吸</text>
        </block>
        <block wx:elif="{{ isIOS }}">
          <view class="cpl-amount-row">
            <text class="cpl-ios-badge">👑 自律成长专区</text>
          </view>
          <text class="cpl-tip">倡导健康自律 · 体验 {{ selectedTier.name }} 特权</text>
        </block>
        <block wx:else>
          <view class="cpl-amount-row">
            <text class="cpl-label">应付</text>
            <text class="cpl-sym">¥</text>
            <text class="cpl-price">{{ selectedTier.price }}</text>
            <text class="cpl-orig">¥{{ selectedTier.originalPrice }}</text>
          </view>
          <text class="cpl-tip">已选：{{ selectedTier.name }}（{{ selectedTier.shortDesc || selectedTier.desc }}）</text>
        </block>
      </view>

      <!-- 右侧按键 (已是永久会员去品吸名烟 / iOS 免费开启自律特权 / 安卓立即开通) -->
      <block wx:if="{{ vipInfo.isLifetime }}">
        <button 
          class="checkout-cta-btn btn-lifetime-active" 
          bindtap="onNavigateBack"
        >
          <view class="btn-shine-sweep"></view>
          <text class="btn-cta-text">去品吸名烟 →</text>
        </button>
      </block>
      <block wx:elif="{{ isIOS }}">
        <button 
          class="checkout-cta-btn btn-ios-free" 
          bindtap="onSubscribe"
        >
          <view class="btn-shine-sweep"></view>
          <text class="btn-cta-text">开启自律特权 →</text>
        </button>
      </block>
      <block wx:else>
        <button 
          class="checkout-cta-btn {{ !isAgreed ? 'btn-disabled' : '' }}" 
          bindtap="onSubscribe"
        >
          <view class="btn-shine-sweep"></view>
          <text class="btn-cta-text">立即开通</text>
        </button>
      </block>

    </view>

  </view>


  <!-- ==================== 开通成功庆祝弹窗 (Success Modal) ==================== -->
  <view class="glass-modal-backdrop" wx:if="{{ showSuccessModal }}" catchtouchmove="preventTouchMove">
    <view class="success-dialog-card">
      <view class="dialog-confetti-badge">🎉</view>
      <text class="dialog-title">{{ isIOS ? '恭喜开启【' + activatedTierName + '】特权' : '恭喜开通【' + activatedTierName + '】' }}</text>
      <text class="dialog-subtitle">全域免广告、全套名烟已全量装配至您的账号！</text>

      <view class="dialog-rights-list">
        <view class="drl-item"><text class="drl-tick">✓</text><text>已免除所有激励视频等待</text></view>
        <view class="drl-item"><text class="drl-tick">✓</text><text>中华/炫赫门/牛来/心动女神等33款名烟已全解锁</text></view>
        <view class="drl-item"><text class="drl-tick">✓</text><text>已点亮 VIP 专属荣耀金冠标识</text></view>
      </view>

      <button class="dialog-primary-btn" bindtap="closeSuccessModal">立即回展柜品吸体验</button>
    </view>
  </view>


  <!-- ==================== 服务协议与隐私条款弹窗 (Protocol Modal) ==================== -->
  <view class="glass-modal-backdrop" wx:if="{{ showProtocolModal }}" catchtouchmove="preventTouchMove">
    <view class="protocol-dialog-card">
      <view class="protocol-top-bar">
        <text class="proto-title">{{ isIOS ? '用户自律特权与隐私协议' : 'VIP 会员服务与隐私协议' }}</text>
        <view class="proto-close-btn" bindtap="closeProtocolModal">✕</view>
      </view>
      <scroll-view class="proto-scroll" scroll-y enhanced show-scrollbar="{{ true }}">
        <!-- iOS 纯净健康合规协议展示 -->
        <view class="proto-content" wx:if="{{ isIOS }}">
          <text class="proto-date">更新日期：2026 年 10 月 13 日</text>

          <text class="proto-lead">欢迎您使用本小程序的自律特权与健康辅助服务。本协议是您与本小程序运营方就自律特权服务及隐私保护相关事项所订立的协议。<text class="proto-bold">请您在开启特权服务前，仔细阅读并充分理解本协议的全部内容，特别是以加粗标注的免责声明、权利限制及未成年人保护条款。</text>一旦您进入并使用本功能，即视为您已阅读、理解并同意接受本协议的全部约定。</text>

          <text class="proto-h2">一、服务范围</text>
          <text class="proto-p">1.1 本小程序自律特权服务为数字化虚拟健康减压辅助服务，您开启后可在特权有效期内享受以下专属权益：</text>
          <text class="proto-li">（1）免除观看激励视频直接获得相应权益（包括整盒拆封补满、解锁名烟图鉴、切换动态场景、使用专属特效等操作）；</text>
          <text class="proto-li">（2）免门槛解锁并使用小程序内全部已上线的 33 款替烟艺术外观图鉴；</text>
          <text class="proto-li">（3）解锁并使用小程序内全部已上线的沉浸环境主题与定制火机焰色；</text>
          <text class="proto-li">（4）解锁并使用小程序内全部已上线的拟真烟雾特效与专属身份标识；</text>
          <text class="proto-li">（5）运营方不时推出的其他自律专属权益（以届时页面实际公布内容为准）。</text>

          <text class="proto-p">1.2 自律特权提供以下三种体验方案供您自主选择：</text>
