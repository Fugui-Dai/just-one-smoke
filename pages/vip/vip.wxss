/* ==================== 腾讯游戏级 3 档情绪场域氛围系统 (Tencent Emotion Mood Theme) ==================== */

/* 1. 情绪药丸胶囊 (Mood Pill) */
.theme-mood-pill {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 22rpx;
  border-radius: 30rpx;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  margin-bottom: 10rpx;
  transition: all 0.4s ease;
}

.mood-spark {
  font-size: 24rpx;
  animation: sparkPulse 2s infinite ease-in-out;
}

@keyframes sparkPulse {
  0%, 100% { transform: scale(1); opacity: 0.85; }
  50% { transform: scale(1.3); opacity: 1; }
}

.theme-day .theme-mood-pill {
  background: rgba(16, 185, 129, 0.16);
  border: 1px solid rgba(52, 211, 153, 0.4);
  color: #6ee7b7;
}

.theme-month .theme-mood-pill {
  background: rgba(168, 85, 247, 0.2);
  border: 1px solid rgba(192, 132, 252, 0.45);
  color: #d8b4fe;
}

.theme-lifetime .theme-mood-pill {
  background: rgba(245, 158, 11, 0.2);
  border: 1px solid rgba(251, 191, 36, 0.48);
  color: #fde047;
}

/* 2. 动态氛围主标题与发光 */
.theme-day .hero-main-title {
  background: linear-gradient(135deg, #ffffff 0%, #a7f3d0 45%, #34d399 100%);
  -webkit-background-clip: text;
  text-shadow: 0 4rpx 24rpx rgba(16, 185, 129, 0.35);
}

.theme-month .hero-main-title {
  background: linear-gradient(135deg, #ffffff 0%, #f3e8ff 45%, #c084fc 100%);
  -webkit-background-clip: text;
  text-shadow: 0 4rpx 24rpx rgba(168, 85, 247, 0.4);
}

.theme-lifetime .hero-main-title {
  background: linear-gradient(135deg, #ffffff 0%, #fef08a 45%, #f59e0b 100%);
  -webkit-background-clip: text;
  text-shadow: 0 4rpx 24rpx rgba(245, 158, 11, 0.4);
}

/* 3. 专属 3D 皇冠与徽章 */
.theme-day .crown-emblem {
  background: radial-gradient(circle at 35% 35%, #a7f3d0 0%, #10b981 60%, #064e3b 100%);
  box-shadow: 0 10rpx 32rpx rgba(16, 185, 129, 0.55), inset 0 2rpx 6rpx rgba(255, 255, 255, 0.6);
}

.theme-day .crown-level-badge {
  background: linear-gradient(90deg, #a7f3d0, #10b981);
  color: #022c22;
  box-shadow: 0 4rpx 14rpx rgba(16, 185, 129, 0.35);
}

.theme-month .crown-emblem {
  background: radial-gradient(circle at 35% 35%, #e9d5ff 0%, #a855f7 60%, #581c87 100%);
  box-shadow: 0 10rpx 32rpx rgba(168, 85, 247, 0.6), inset 0 2rpx 6rpx rgba(255, 255, 255, 0.6);
}

.theme-month .crown-level-badge {
  background: linear-gradient(90deg, #f3e8ff, #a855f7);
  color: #3b0764;
  box-shadow: 0 4rpx 14rpx rgba(168, 85, 247, 0.4);
}

.theme-lifetime .crown-emblem {
  background: radial-gradient(circle at 35% 35%, #fef08a 0%, #f59e0b 60%, #78350f 100%);
  box-shadow: 0 10rpx 36rpx rgba(245, 158, 11, 0.65), inset 0 2rpx 8rpx rgba(255, 255, 255, 0.7);
}

.theme-lifetime .crown-level-badge {
  background: linear-gradient(90deg, #fef08a, #f59e0b);
  color: #1e1305;
  box-shadow: 0 4rpx 14rpx rgba(245, 158, 11, 0.45);
}

/* 4. 专属档位角标 */
.ribbon-day {
  background: linear-gradient(90deg, #10b981, #059669) !important;
}

.ribbon-month {
  background: linear-gradient(90deg, #c084fc, #9333ea) !important;
}

.ribbon-lifetime {
  background: linear-gradient(90deg, #f59e0b, #d97706) !important;
}

/* 5. 档位卡片专属选中辉光 */
.tier-card.tier-card-day.is-selected {
