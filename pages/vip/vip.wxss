/* pages/vip/vip.wxss */

page {
  background-color: #07090e;
  min-height: 100%;
  color: #f8fafc;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.vip-page-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: radial-gradient(circle at 50% -10%, rgba(168, 85, 247, 0.28) 0%, rgba(124, 58, 237, 0.12) 35%, #0d0718 70%, #06040b 100%);
  box-sizing: border-box;
  position: relative;
  overflow-x: hidden;
  transition: background 0.5s cubic-bezier(0.4, 0, 0.2, 1);
}

.vip-page-container.theme-day {
  background: radial-gradient(circle at 50% -10%, rgba(16, 185, 129, 0.32) 0%, rgba(5, 150, 105, 0.16) 35%, #041612 70%, #020b09 100%);
}

.vip-page-container.theme-month {
  background: radial-gradient(circle at 50% -10%, rgba(168, 85, 247, 0.32) 0%, rgba(124, 58, 237, 0.18) 35%, #10081d 70%, #08040f 100%);
}

.vip-page-container.theme-lifetime {
  background: radial-gradient(circle at 50% -10%, rgba(251, 191, 36, 0.35) 0%, rgba(180, 83, 9, 0.22) 35%, #160e03 70%, #080602 100%);
}

.vip-page-container.theme-classic {
  background: radial-gradient(circle at 50% -10%, rgba(148, 163, 184, 0.14) 0%, #111318 45%, #07080b 100%);
}

/* iOS 合规提示条 (微信生态合规高定设计) */
.ios-compliance-banner {
  position: relative;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin: 0 0 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: rgba(30, 41, 59, 0.75);
  border: 1px solid rgba(148, 163, 184, 0.25);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.35);
  overflow: hidden;
  box-sizing: border-box;
}

.icb-glow {
  position: absolute;
  top: -20rpx;
  left: -20rpx;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(56, 189, 248, 0.25) 0%, transparent 70%);
  pointer-events: none;
}

.icb-icon {
  font-size: 32rpx;
  line-height: 1.2;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.icb-content {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.icb-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #38bdf8;
  letter-spacing: 0.5rpx;
}

.icb-desc {
  font-size: 21rpx;
  line-height: 1.45;
  color: #cbd5e1;
}

/* VIP 专属流光主题衣橱 */
.vip-theme-wardrobe-card {
  width: 100%;
  margin: 0;
  padding: 24rpx 22rpx 20rpx;
  border-radius: 24rpx;
  background: rgba(15, 18, 28, 0.72);
  border: 1.5px solid rgba(255, 255, 255, 0.10);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.45);
  box-sizing: border-box;
}

.vtw-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.vtw-header-left {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.vtw-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #f8fafc;
  letter-spacing: 1rpx;
}

.vtw-subtitle {
  font-size: 22rpx;
  font-weight: 500;
  color: #94a3b8;
}

.vtw-current {
  font-size: 24rpx;
  font-weight: 600;
  color: #fbbf24;
}

/* 分类 Tab 切换 */
.vtw-category-tabs {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 18rpx;
  overflow-x: auto;
}

.vtw-cat-tab {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 22rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  font-size: 24rpx;
  color: #cbd5e1;
  transition: all 0.2s ease;
  white-space: nowrap;
}

.vtw-cat-tab.active {
  background: rgba(255, 255, 255, 0.22);
  border-color: rgba(255, 255, 255, 0.45);
  color: #ffffff;
  font-weight: 800;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
}

.vtw-cat-count {
  font-size: 20rpx;
  font-weight: 600;
  color: #94a3b8;
  opacity: 1;
}

.vtw-cat-tab.active .vtw-cat-count {
  color: #f1f5f9;
}

/* 药丸网格滚动区 */
.vtw-pills-scroll {
  max-height: 480rpx;
  width: 100%;
}

.vtw-pills-row {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14rpx;
  padding-bottom: 6rpx;
}

.vtw-pill {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 14rpx 6rpx;
  border-radius: 20rpx;
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.08) 0%, rgba(255, 255, 255, 0.02) 40%, rgba(0, 0, 0, 0.35) 100%);
  border: 1.5rpx solid rgba(255, 255, 255, 0.12);
  box-shadow: inset 0 1rpx 2rpx rgba(255, 255, 255, 0.25), 0 4rpx 14rpx rgba(0, 0, 0, 0.35);
  overflow: hidden;
  transition: all 0.22s cubic-bezier(0.25, 1, 0.5, 1);
}

.vtw-pill:active {
  transform: scale(0.95);
}



.vtw-pill-icon-box {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  z-index: 2;
}

/* 纳米珠光金属车漆圆点 (High-Gloss Pearlescent Specular Dot) */
.vtw-car-dot {
  position: relative;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  border: 1.5rpx solid rgba(255, 255, 255, 0.7);
  box-sizing: border-box;
  overflow: hidden;
}

/* 车漆迎光面微弧高光点 (Liquid Fresnel Reflection) */
.car-dot-specular {
  position: absolute;
  top: 3rpx;
  left: 4rpx;
  width: 8rpx;
  height: 5rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.95);
  filter: blur(0.5px);
  transform: rotate(-35deg);
}

.vtw-lock-badge {
  position: absolute;
  top: -8rpx;
  right: -14rpx;
  font-size: 20rpx;
  line-height: 1;
  z-index: 3;
}

.vtw-pill-texts {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  width: 100%;
}

.vtw-pill-name {
  font-size: 24rpx;
  font-weight: 700;
  color: #f1f5f9;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-shadow: 0 1rpx 6rpx rgba(0, 0, 0, 0.8);
}

.vtw-pill-active .vtw-pill-name {
  color: #ffffff;
  font-weight: 800;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.95);
}

.vtw-pill-tag {
  font-size: 20rpx;
  color: #cbd5e1;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.vtw-pill-tag.tag-locked {
  color: #f59e0b;
}

.vtw-pill.vtw-pill-locked {
  opacity: 0.58;
  background: rgba(255, 255, 255, 0.02);
  border-color: rgba(255, 255, 255, 0.05);
}

/* ==================== 顶部极光沉浸导航栏 ==================== */
.custom-navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: rgba(7, 9, 14, 0.82);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

.theme-day .custom-navbar {
  background: rgba(4, 20, 16, 0.88) !important;
  border-bottom: 1px solid rgba(16, 185, 129, 0.24) !important;
  box-shadow: 0 4rpx 24rpx rgba(16, 185, 129, 0.10) !important;
}

.theme-month .custom-navbar {
  background: rgba(16, 8, 29, 0.88) !important;
  border-bottom: 1px solid rgba(168, 85, 247, 0.26) !important;
  box-shadow: 0 4rpx 24rpx rgba(168, 85, 247, 0.12) !important;
}

.theme-lifetime .custom-navbar {
  background: rgba(22, 14, 3, 0.90) !important;
  border-bottom: 1px solid rgba(251, 191, 36, 0.28) !important;
  box-shadow: 0 4rpx 28rpx rgba(245, 158, 11, 0.14) !important;
}

.navbar-content {
  position: relative;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-left: 20rpx;
  box-sizing: border-box;
}

.nav-back-btn {
  position: relative;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 50%;
  color: #e2e8f0;
  transition: all 0.2s ease;
  padding: 0;
}

.nav-back-btn:active {
  transform: scale(0.92);
  background: rgba(255, 255, 255, 0.16);
}

.nav-center-title-box {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  margin: auto;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  z-index: 5;
  gap: 8rpx;
}

.nav-crown-icon {
  font-size: 30rpx;
}

.nav-center-title-text {
  font-size: 34rpx;
  font-weight: 800;
  color: #f8fafc;
  background: linear-gradient(135deg, #f8fafc 0%, #cbd5e1 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  letter-spacing: 2rpx;
  max-width: 420rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: center;
}

.nav-placeholder {
  width: 60rpx;
  height: 60rpx;
}

/* ==================== 原生流式滚动内容区 ==================== */
.vip-scroll-content {
  width: 100%;
  padding: 24rpx;
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom, 20px));
  display: flex;
  flex-direction: column;
  gap: 26rpx;
  box-sizing: border-box;
}

/* ==================== 1. 腾讯游戏级 3D 浮雕黑金星曜 Header ==================== */
.vip-hero-stage {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  position: relative;
  padding: 16rpx 20rpx 4rpx;
}

.hero-aurora-glow {
  position: absolute;
  top: -60rpx;
  width: 520rpx;
  height: 260rpx;
  background: radial-gradient(circle, rgba(168, 85, 247, 0.45) 0%, rgba(124, 58, 237, 0.18) 55%, transparent 80%);
  filter: blur(48px);
  z-index: 0;
  pointer-events: none;
  transition: all 0.5s ease;
}

.hero-aurora-glow-secondary {
  position: absolute;
  top: 40rpx;
  width: 380rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(192, 132, 252, 0.25) 0%, transparent 75%);
  filter: blur(36px);
  z-index: 0;
  pointer-events: none;
  transition: all 0.5s ease;
}

.hero-aurora-glow {
  position: absolute;
  top: -60rpx;
  width: 520rpx;
  height: 260rpx;
  background: radial-gradient(circle, var(--vip-theme-orb1, rgba(168, 85, 247, 0.45)) 0%, transparent 80%);
  filter: blur(48px);
  z-index: 0;
  pointer-events: none;
  transition: all 0.5s ease;
}

.hero-aurora-glow-secondary {
  position: absolute;
  top: 40rpx;
  width: 380rpx;
  height: 200rpx;
  background: radial-gradient(circle, var(--vip-theme-orb2, rgba(192, 132, 252, 0.25)) 0%, transparent 75%);
  filter: blur(36px);
  z-index: 0;
  pointer-events: none;
  transition: all 0.5s ease;
}

/* 腾讯游戏级漂浮星光粒子 */
.hero-ambient-particles {
  position: absolute;
  top: -40rpx;
  left: 0;
  right: 0;
  height: 360rpx;
  pointer-events: none;
  z-index: 0;
  overflow: hidden;
}

.p-orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(14px);
  opacity: 0.55;
  background: var(--vip-theme-orb1, rgba(192, 132, 252, 0.42));
  animation: orbFloat 6s infinite ease-in-out alternate;
  transition: background 0.5s ease;
}

.p-orb-1 {
  width: 130rpx;
  height: 130rpx;
  top: 20rpx;
  left: 12%;
}

.p-orb-2 {
  width: 160rpx;
  height: 160rpx;
  top: 10rpx;
  right: 10%;
  animation-delay: -2.5s;
}

.p-orb-3 {
  width: 90rpx;
  height: 90rpx;
  top: 80rpx;
  left: 48%;
  animation-delay: -4.5s;
}

@keyframes orbFloat {
  0% { transform: translate(0, 0) scale(0.92); opacity: 0.45; }
  100% { transform: translate(18rpx, 24rpx) scale(1.18); opacity: 0.7; }
}

.theme-day .p-orb { background: rgba(52, 211, 153, 0.4); }
.theme-month .p-orb { background: rgba(192, 132, 252, 0.42); }
.theme-lifetime .p-orb { background: rgba(251, 191, 36, 0.42); }

.hero-crown-wrapper {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 20rpx;
}


.crown-emblem {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 35%, #ffd54f 0%, #d49520 60%, #8d5d0e 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 30rpx rgba(245, 158, 11, 0.45), inset 0 2rpx 6rpx rgba(255, 255, 255, 0.6);
  border: 2rpx solid rgba(255, 255, 255, 0.4);
}

.crown-emoji {
  font-size: 56rpx;
  filter: drop-shadow(0 4rpx 6rpx rgba(0, 0, 0, 0.3));
}

.crown-level-badge {
  margin-top: 10rpx;
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  color: #1e1305;
  background: linear-gradient(90deg, #fef08a, #f59e0b);
  padding: 2rpx 16rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(245, 158, 11, 0.3);
}

.hero-text-block {
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  margin-bottom: 12rpx;
  min-height: 156rpx;
  width: 100%;
  box-sizing: border-box;
}

.hero-main-title {
  font-size: 40rpx;
  font-weight: 800;
  letter-spacing: 1.5rpx;
  background: linear-gradient(135deg, #ffffff 0%, #fef08a 50%, #f59e0b 100%);
  -webkit-background-clip: text;
  color: transparent;
  text-shadow: 0 4rpx 20rpx rgba(245, 158, 11, 0.25);
  line-height: 1.25;
  white-space: nowrap;
}

.hero-sub-slogan {
  font-size: 22rpx;
  color: #cbd5e1;
  letter-spacing: 0.5rpx;
  line-height: 1.35;
  white-space: nowrap;
  max-width: 96%;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 用户状态栏 */
.current-status-strip {
  z-index: 1;
  width: 100%;
  max-width: 660rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 24rpx;
  border-radius: 20rpx;
  box-sizing: border-box;
  font-size: 22rpx;
}

.status-inactive {
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.12);
}

.status-active {
  background: linear-gradient(90deg, rgba(245, 158, 11, 0.18), rgba(217, 119, 6, 0.10));
  border: 1px solid rgba(245, 158, 11, 0.45);
}

.status-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #34d399;
  box-shadow: 0 0 10rpx #34d399;
}

.status-inactive .status-dot {
  background: #94a3b8;
  box-shadow: none;
}

.status-title {
  color: #f1f5f9;
  font-weight: 500;
}

.status-right {
  font-weight: 600;
  color: #fbbf24;
}

.status-right.hint {
  color: #cbd5e1;
  font-size: 22rpx;
}

/* ==================== 1. 三档定价套餐 (Horizontal 3-Tier Selector) ==================== */
.pricing-section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* ==================== 2. 全域流光心境换肤衣橱 ==================== */
.wardrobe-section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.section-badge-bar {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding-left: 6rpx;
}

.sb-dot {
  width: 8rpx;
  height: 24rpx;
  border-radius: 4rpx;
  background: #38bdf8;
}

.sb-dot.gold {
  background: #fbbf24;
}

.sb-dot.purple {
  background: #c084fc;
}

.sb-dot.cyan {
  background: #2dd4bf;
}

.sb-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #f8fafc;
}

.sb-note {
  font-size: 22rpx;
  color: #94a3b8;
  margin-left: auto;
}

.sb-note-highlight {
  color: #fbbf24;
  font-weight: 600;
}

.pricing-cards-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.tier-card {
  position: relative;
  background: linear-gradient(165deg, rgba(26, 32, 46, 0.90) 0%, rgba(13, 18, 28, 0.96) 100%);
  border: 2px solid rgba(255, 255, 255, 0.12);
  border-radius: 24rpx;
  padding: 24rpx 10rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  box-sizing: border-box;
  transition: all 0.25s ease;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.35);
}

.tier-card.is-selected {
  background: linear-gradient(165deg, rgba(45, 36, 20, 0.95) 0%, rgba(25, 20, 11, 0.98) 100%);
  border-color: #fbbf24;
  box-shadow: 0 12rpx 36rpx rgba(245, 158, 11, 0.35);
  transform: translateY(-4rpx);
}

.tier-card.is-highlight {
  border-color: rgba(251, 191, 36, 0.4);
}

/* 推荐角标 */
.tier-tag-ribbon {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  background: linear-gradient(90deg, #3b82f6, #06b6d4);
  padding: 4rpx 0;
  font-size: 20rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 0.5rpx;
}

.tier-tag-ribbon.ribbon-hot {
  background: linear-gradient(90deg, #f59e0b, #ef4444);
}

.tier-name-box {
  margin-top: 14rpx;
  margin-bottom: 12rpx;
}

.tier-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #f1f5f9;
  display: block;
}

.tier-period {
  font-size: 22rpx;
  color: #cbd5e1;
  margin-top: 2rpx;
  display: block;
}

.tier-price-row {
  display: flex;
  align-items: baseline;
  justify-content: center;
  margin-bottom: 8rpx;
}

.price-currency {
  font-size: 24rpx;
  font-weight: 700;
  color: #fbbf24;
}

.price-integer {
  font-size: 48rpx;
  font-weight: 900;
  color: #fbbf24;
  line-height: 1;
  letter-spacing: -1rpx;
  margin: 0 2rpx;
}

.tier-card.is-selected .price-integer {
  color: #fde047;
  text-shadow: 0 2rpx 12rpx rgba(253, 224, 71, 0.4);
}

.price-unit {
  font-size: 20rpx;
  color: #cbd5e1;
}

.tier-daily-box {
  margin-bottom: 6rpx;
}

.daily-label {
  font-size: 22rpx;
  color: #34d399;
  font-weight: 600;
  background: rgba(16, 185, 129, 0.12);
  padding: 2rpx 10rpx;
  border-radius: 12rpx;
  display: inline-block;
}

.daily-label.gold {
  color: #fbbf24;
  background: rgba(245, 158, 11, 0.15);
}

.tier-original-price {
  font-size: 22rpx;
  color: #94a3b8;
  text-decoration: line-through;
  margin-bottom: 14rpx;
}

/* iOS 档位特性徽章 (代替 ¥ 价格标) */
.price-feature-badge {
  font-size: 24rpx;
  font-weight: 800;
  color: #34d399;
  background: rgba(16, 185, 129, 0.16);
  border: 1px solid rgba(52, 211, 153, 0.3);
  padding: 6rpx 14rpx;
  border-radius: 12rpx;
