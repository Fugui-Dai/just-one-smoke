  position: absolute;
  top: 16rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 390rpx;
  height: 54rpx;
  border-radius: 50%;
  background: radial-gradient(ellipse at center, rgba(10, 16, 28, 0.72) 0%, rgba(10, 16, 28, 0.42) 58%, transparent 85%);
  filter: blur(6px);
  z-index: 1;
}

/* 2. 聚光灯照射到底面的椭圆流金青碧水洼光斑 (Spotlight Floor Wash Pool) */
.pedestal-spotlight-pool {
  position: absolute;
  top: 4rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 480rpx;
  height: 92rpx;
  border-radius: 50%;
  background: radial-gradient(
    ellipse at center,
    rgba(254, 243, 199, 0.45) 0%,
    rgba(56, 189, 248, 0.28) 42%,
    rgba(245, 158, 11, 0.18) 68%,
    transparent 85%
  );
  filter: blur(4px);
  z-index: 2;
  animation: spotlightPoolBreathe 5s ease-in-out infinite alternate;
}

@keyframes spotlightPoolBreathe {
  0% { transform: translateX(-50%) scale(0.97); opacity: 0.85; }
  100% { transform: translateX(-50%) scale(1.03); opacity: 1.0; }
}

/* 3. 外圈柔光椭圆流金环 (Outer Elliptical Gold Halo Ring) */
.pedestal-outer-halo-ring {
  position: absolute;
  top: 2rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 536rpx;
  height: 98rpx;
  border-radius: 50%;
  border: 1.5rpx solid rgba(253, 224, 71, 0.48);
  box-shadow: 0 0 24rpx rgba(245, 158, 11, 0.30), inset 0 0 18rpx rgba(45, 212, 191, 0.18);
  z-index: 3;
}

/* 4. 内圈高光流金椭圆主光环 (Inner Intense Golden-Cyan Elliptical Ring) */
.pedestal-inner-halo-ring {
  position: absolute;
  top: 10rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 468rpx;
  height: 80rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(254, 249, 195, 0.92);
  box-shadow:
    0 0 20rpx #fef08a,
    0 0 38rpx rgba(245, 158, 11, 0.62),
    inset 0 0 22rpx rgba(45, 212, 191, 0.42);
  z-index: 4;
}

/* 5. 光环正前方 6 点钟璀璨星芒高光核 (Front-Center Specular Starburst Flare) */
.pedestal-front-flare {
  position: absolute;
  bottom: 0rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 180rpx;
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 5;
}

.front-flare-core {
  width: 56rpx;
  height: 18rpx;
  border-radius: 50%;
  background: radial-gradient(ellipse at center, #ffffff 0%, #fef08a 45%, rgba(245, 158, 11, 0.4) 80%, transparent 100%);
  box-shadow: 0 0 20rpx #ffffff, 0 0 36rpx #fef08a;
  filter: blur(1px);
}

.front-flare-streak {
  position: absolute;
  width: 170rpx;
  height: 3rpx;
  background: linear-gradient(90deg, transparent 0%, #fef08a 30%, #ffffff 50%, #fef08a 70%, transparent 100%);
  box-shadow: 0 0 14rpx #fef08a;
}

/* 6. 抽烟触发时的多重同心能量脉冲波纹 (Launch Ripple Waves) */
.pedestal-ripple-pulse {
  position: absolute;
  top: 14rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 280rpx;
  height: 68rpx;
  border-radius: 50%;
  border: 3rpx solid #38bdf8;
  box-shadow: 0 0 26rpx #38bdf8, inset 0 0 16rpx #fde047;
  opacity: 0;
  pointer-events: none;
  z-index: 6;
}

.pack-master-pedestal.pedestal-rippling .pedestal-ripple-pulse.pr-1,
.pack-master-pedestal.is-rippling .pedestal-ripple-pulse.pr-1 {
  animation: pedestalPulseWaveOut 0.62s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

.pack-master-pedestal.pedestal-rippling .pedestal-ripple-pulse.pr-2,
.pack-master-pedestal.is-rippling .pedestal-ripple-pulse.pr-2 {
  border-color: #fde047;
  box-shadow: 0 0 32rpx #fde047, inset 0 0 20rpx #38bdf8;
  animation: pedestalPulseWaveOut 0.74s cubic-bezier(0.16, 1, 0.3, 1) 0.08s forwards;
}

.pack-master-pedestal.pedestal-rippling .pedestal-ripple-pulse.pr-3,
.pack-master-pedestal.is-rippling .pedestal-ripple-pulse.pr-3 {
  border-color: #22d3ee;
  animation: pedestalPulseWaveOut 0.86s cubic-bezier(0.16, 1, 0.3, 1) 0.16s forwards;
}

@keyframes pedestalPulseWaveOut {
  0% {
    opacity: 1;
    transform: translateX(-50%) scale(0.45);
  }
  70% {
    opacity: 0.85;
  }
  100% {
    opacity: 0;
    transform: translateX(-50%) scale(2.45);
  }
}

/* 保留旧类名兼容占位 */
.pack-ripple-pedestal {
  display: none;
}

/* ---------- Stage 02: 盒内选中烟支发光波纹与垂直拔起动效 ---------- */
.cig-filter-slot.is-slot-launching {
  z-index: 45;
  overflow: visible !important;
}

.slot-launch-fx {
  position: absolute;
  inset: -24rpx -18rpx;
  pointer-events: none;
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: center;
}

.slot-launch-ripple {
  position: absolute;
  bottom: 16rpx;
  width: 44rpx;
  height: 20rpx;
  border-radius: 50%;
  border: 2.5rpx solid #38bdf8;
  box-shadow: 0 0 16rpx #38bdf8, 0 0 24rpx #fde047;
  animation: slotRippleExpand 0.36s ease-out infinite;
}

.slot-launch-ripple.sr-2 {
  border-color: #fde047;
  animation-delay: 0.1s;
}

@keyframes slotRippleExpand {
  0% { opacity: 1; transform: scale(0.5); }
  100% { opacity: 0; transform: scale(2.6); }
}

.slot-launch-beam {
  position: absolute;
  bottom: 0;
  width: 26rpx;
  height: 220rpx;
  background: linear-gradient(180deg, rgba(56, 189, 248, 0) 0%, rgba(56, 189, 248, 0.85) 55%, #ffffff 100%);
  filter: blur(3rpx);
  animation: slotBeamFlash 0.34s ease-out forwards;
}

@keyframes slotBeamFlash {
  0% { opacity: 0; transform: scaleY(0.2); }
  40% { opacity: 1; transform: scaleY(1.1); }
  100% { opacity: 0; transform: scaleY(1.4); }
}

.slot-cigarette-stick.stick-rising-out {
  box-shadow: 0 0 24rpx #38bdf8, 0 0 42rpx #fde047 !important;
  animation: slotStickAscendOut 0.32s cubic-bezier(0.22, 1, 0.36, 1) forwards !important;
}

@keyframes slotStickAscendOut {
  0% {
    transform: translateY(0) scale(1);
    filter: brightness(1.1);
  }
  45% {
    transform: translateY(-58rpx) scale(1.04);
    filter: brightness(1.35);
  }
  100% {
    transform: translateY(-155rpx) scale(1.06);
    filter: brightness(1.5);
  }
}

.filter-oriental-swirl {
  position: absolute;
  top: 22%;
  left: 12%;
  right: 12%;
  height: 12rpx;
  border-top: 1rpx solid rgba(253, 224, 71, 0.55);
  border-bottom: 1rpx solid rgba(253, 224, 71, 0.55);
  border-radius: 50%;
  pointer-events: none;
}

/* ---------- 全屏 60fps 2D/3D 银河星云 S 型轨迹粒子画布 ---------- */
.pack-flight-canvas {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 306;
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.18s ease-out;
}

.pack-flight-canvas.is-canvas-visible {
  opacity: 1;
}

/* ---------- 1. 渐进深空星云暗场 (保持后方烟盒与空槽清晰可辨) ---------- */
.ssr-stage-backdrop {
  position: fixed;
  inset: 0;
  z-index: 302;
  background: radial-gradient(
    circle at 50% 42%,
    rgba(30, 58, 138, 0.45) 0%,
    rgba(67, 24, 114, 0.35) 32%,
    rgba(15, 23, 42, 0.85) 60%,
    rgba(4, 7, 17, 0.96) 100%
  );
  opacity: 0;
  pointer-events: none;
}

.ssr-stage-backdrop.ssr-active {
  animation: ssrBackdropProgressive 2.05s ease-out forwards;
}

@keyframes ssrBackdropProgressive {
  0% { opacity: 0.06; }
  25% { opacity: 0.26; }
  50% { opacity: 0.68; }
  100% { opacity: 0.82; }
}

/* ---------- 顶层特效舞台容器 ---------- */
.ssr-awaken-overlay {
  position: fixed;
  inset: 0;
  z-index: 310;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  pointer-events: auto;
}

/* 顶部全息分镜状态铭牌 (02 [点击触发] ~ 06 [屏幕呈现]) */
.ssr-stage-hud-pill {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  z-index: 35;
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 28rpx;
  border-radius: 999rpx;
  background: rgba(9, 14, 28, 0.82);
  border: 1.5rpx solid rgba(56, 189, 248, 0.65);
  box-shadow: 0 0 24rpx rgba(56, 189, 248, 0.35), inset 0 0 12rpx rgba(253, 224, 71, 0.22);
}

.hud-scan-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #38bdf8;
  box-shadow: 0 0 12rpx #38bdf8, 0 0 20rpx #fde047;
  animation: hudDotPulse 0.6s ease-in-out infinite alternate;
}

@keyframes hudDotPulse {
  from { transform: scale(0.85); opacity: 0.7; }
  to { transform: scale(1.25); opacity: 1; }
}

.hud-stage-label {
  font-size: 22rpx;
  font-weight: 800;
  color: #fef08a;
  letter-spacing: 3rpx;
  text-shadow: 0 0 12rpx rgba(56, 189, 248, 0.85);
}

/* ---------- 2. CSS 3D S-Curve 银河星云三色流光绶带 (与 60fps Canvas 协同辉映) ---------- */
.ssr-scurve-galaxy-layer {
  position: absolute;
  inset: 0;
  z-index: 5;
  pointer-events: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.scurve-ribbon-arc {
  position: absolute;
  border-radius: 50%;
  opacity: 0;
  pointer-events: none;
}

/* 上回环星云弧 (对应 04 破空盘旋上拐点) */
.scurve-ribbon-arc.arc-upper {
  width: 460rpx;
  height: 230rpx;
  top: 21%;
  left: 23%;
  border-top: 10rpx solid #38bdf8;
  border-left: 14rpx solid #fde047;
  box-shadow: 0 0 28rpx #38bdf8, 0 0 48rpx rgba(168, 85, 247, 0.65), inset 0 0 16rpx #fde047;
  transform: rotate(-16deg) scale(0.8);
}

/* 中段横贯大S金紫星河绶带 (对应 04 破空盘旋主轨迹) */
.scurve-ribbon-arc.arc-middle {
  width: 600rpx;
  height: 300rpx;
  top: 32%;
  right: 6%;
  border-right: 18rpx solid #fde047;
  border-bottom: 14rpx solid #38bdf8;
  box-shadow: 0 0 32rpx #fde047, 0 0 54rpx rgba(139, 92, 246, 0.65), inset 0 0 18rpx #38bdf8;
  transform: rotate(14deg) scale(0.85);
}

/* 下回环螺旋放大星河弧 (对应 05 弧线放大) */
.scurve-ribbon-arc.arc-lower {
  width: 640rpx;
  height: 320rpx;
  bottom: 23%;
  left: 5%;
  border-bottom: 18rpx solid #fde047;
  border-left: 14rpx solid #c084fc;
  box-shadow: 0 0 32rpx #38bdf8, 0 0 52rpx rgba(253, 224, 71, 0.65), inset 0 0 18rpx #c084fc;
  transform: rotate(-12deg) scale(0.85);
}

.ssr-awaken-overlay.ssr-active .scurve-ribbon-arc.arc-upper {
  animation: scurveRibbonSweep 1.35s ease-out 0.24s forwards;
}

.ssr-awaken-overlay.ssr-active .scurve-ribbon-arc.arc-middle {
  animation: scurveRibbonSweep 1.35s ease-out 0.42s forwards;
}

.ssr-awaken-overlay.ssr-active .scurve-ribbon-arc.arc-lower {
  animation: scurveRibbonSweep 1.35s ease-out 0.62s forwards;
}

@keyframes scurveRibbonSweep {
  0% {
    opacity: 0;
    transform: scale(0.55) rotate(-8deg);
  }
  30% {
    opacity: 0.92;
    transform: scale(1.02) rotate(0deg);
  }
  75% {
    opacity: 0.75;
    transform: scale(1.06) rotate(4deg);
  }
  100% {
    opacity: 0.18;
    transform: scale(1.12) rotate(6deg);
  }
}

/* ---------- 3. 冲霄能量光柱与 Stage 06 星芒大爆发法阵 ---------- */
.ssr-sky-pillar {
  position: absolute;
  top: 6%;
  bottom: 14%;
  left: 50%;
  width: 170rpx;
  transform: translateX(-50%);
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(56, 189, 248, 0.14) 18%,
    rgba(254, 240, 138, 0.46) 50%,
    rgba(56, 189, 248, 0.14) 82%,
    transparent 100%
  );
  -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 20%, #000 80%, transparent 100%);
  mask-image: linear-gradient(180deg, transparent 0%, #000 20%, #000 80%, transparent 100%);
  filter: blur(6rpx);
  opacity: 0;
  z-index: 2;
  pointer-events: none;
}

.ssr-awaken-overlay.ssr-active .ssr-sky-pillar {
  animation: ssrPillarStageFlow 2.0s ease-in-out forwards;
}

@keyframes ssrPillarStageFlow {
  0% { opacity: 0; transform: translateX(-50%) scaleX(0.4); }
  18% { opacity: 0.95; transform: translateX(-50%) scaleX(0.65); }
  55% { opacity: 0.25; transform: translateX(-50%) scaleX(0.5); }
  78% { opacity: 0.95; transform: translateX(-50%) scaleX(1.15); }
  100% { opacity: 0.75; transform: translateX(-50%) scaleX(1.0); }
}

/* 双层破空震波环 (3D Perspective Shockwaves) */
.ssr-shockwave-ring {
  position: absolute;
  top: 44%;
  left: 50%;
  width: 480rpx;
  height: 480rpx;
  margin-left: -240rpx;
  margin-top: -240rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(254, 240, 138, 0.88);
  box-shadow: 0 0 32rpx rgba(56, 189, 248, 0.8), inset 0 0 22rpx rgba(245, 158, 11, 0.55);
  opacity: 0;
  z-index: 3;
  pointer-events: none;
}

.ssr-awaken-overlay.ssr-active .ssr-shockwave-ring.ring-1 {
  animation: ssrShockwaveExpand 0.82s cubic-bezier(0.16, 1, 0.3, 1) 1.18s forwards;
}

.ssr-awaken-overlay.ssr-active .ssr-shockwave-ring.ring-2 {
  border-color: #38bdf8;
  animation: ssrShockwaveExpand 0.95s cubic-bezier(0.16, 1, 0.3, 1) 1.28s forwards;
}

@keyframes ssrShockwaveExpand {
  0% {
    opacity: 0.95;
    transform: scale(0.25);
  }
  70% {
    opacity: 0.65;
  }
  100% {
    opacity: 0;
    transform: scale(1.42);
  }
}

/* Stage 06 [屏幕呈现]: 360° 璀璨鎏金与赛博青星芒轮盘 */
.ssr-celestial-wheel {
  position: absolute;
  top: 43%;
  left: 50%;
  width: 560rpx;
  height: 560rpx;
  margin-left: -280rpx;
  margin-top: -280rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  z-index: 4;
  pointer-events: none;
}

.ssr-awaken-overlay.ssr-active .ssr-celestial-wheel {
  animation: ssrWheelFinalBurst 0.95s cubic-bezier(0.16, 1, 0.3, 1) 1.12s forwards;
}

@keyframes ssrWheelFinalBurst {
  0% { opacity: 0; transform: scale(0.35) rotate(-25deg); }
  45% { opacity: 1; transform: scale(1.08) rotate(0deg); }
  100% { opacity: 0.92; transform: scale(1.0) rotate(8deg); }
}

.ssr-god-rays {
  position: absolute;
  inset: -80rpx;
  border-radius: 50%;
  background: repeating-conic-gradient(
    from 0deg,
    rgba(253, 224, 71, 0.45) 0deg 9deg,
    rgba(56, 189, 248, 0.35) 9deg 18deg,
    transparent 18deg 30deg
  );
  -webkit-mask-image: radial-gradient(circle, #000 0%, rgba(0, 0, 0, 0.82) 48%, transparent 76%);
  mask-image: radial-gradient(circle, #000 0%, rgba(0, 0, 0, 0.82) 48%, transparent 76%);
  animation: ssrWheelSpinCw 12s linear infinite;
}

.ssr-radial-starburst {
  position: absolute;
  inset: -50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.starburst-ray {
  position: absolute;
  width: 660rpx;
  height: 5rpx;
  background: linear-gradient(90deg, transparent 0%, #38bdf8 20%, #fde047 45%, #ffffff 50%, #fde047 55%, #38bdf8 80%, transparent 100%);
  box-shadow: 0 0 24rpx #fde047, 0 0 36rpx #38bdf8;
}
.starburst-ray.sr-1 { transform: rotate(0deg); }
.starburst-ray.sr-2 { transform: rotate(30deg); }
.starburst-ray.sr-3 { transform: rotate(60deg); }
.starburst-ray.sr-4 { transform: rotate(90deg); }
.starburst-ray.sr-5 { transform: rotate(120deg); }
.starburst-ray.sr-6 { transform: rotate(150deg); }

.ssr-sacred-halo {
  position: absolute;
  width: 440rpx;
  height: 440rpx;
  border-radius: 50%;
  border: 2.5rpx solid rgba(56, 189, 248, 0.75);
  box-shadow: 0 0 46rpx rgba(56, 189, 248, 0.55), inset 0 0 34rpx rgba(251, 191, 36, 0.45);
  animation: ssrWheelSpinCcw 16s linear infinite;
}

.halo-diamond {
  position: absolute;
  font-size: 22rpx;
  color: #fde047;
  text-shadow: 0 0 12rpx #38bdf8;
  line-height: 1;
}
.halo-diamond.d-top { top: -14rpx; left: 50%; transform: translateX(-50%); }
.halo-diamond.d-bottom { bottom: -14rpx; left: 50%; transform: translateX(-50%); }
.halo-diamond.d-left { left: -14rpx; top: 50%; transform: translateY(-50%); }
.halo-diamond.d-right { right: -14rpx; top: 50%; transform: translateY(-50%); }

.ssr-inner-energy-ring {
  position: absolute;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  border: 2rpx dashed rgba(254, 240, 138, 0.55);
  animation: ssrWheelSpinCw 9s linear infinite;
}

@keyframes ssrWheelSpinCw {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

@keyframes ssrWheelSpinCcw {
  from { transform: rotate(360deg); }
  to { transform: rotate(0deg); }
}

/* ---------- 4. 螺旋飞升星尘粒子与垂直拔升速度光束 ---------- */
.ssr-particles-field {
  position: absolute;
  inset: 0;
  z-index: 6;
  pointer-events: none;
}

.ssr-ember-particle {
  position: absolute;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: radial-gradient(circle, #ffffff 0%, #38bdf8 45%, #fde047 100%);
  box-shadow: 0 0 16rpx #38bdf8, 0 0 28rpx #fde047;
  opacity: 0;
}

.ssr-awaken-overlay.ssr-active .ssr-ember-particle {
  animation: ssrParticleRise 1.15s ease-out infinite;
}

.ssr-ember-particle.p1 { left: 32%; top: 58%; animation-delay: 0.04s; }
.ssr-ember-particle.p2 { left: 68%; top: 62%; width: 12rpx; height: 12rpx; animation-delay: 0.10s; }
.ssr-ember-particle.p3 { left: 24%; top: 46%; width: 8rpx; height: 8rpx; animation-delay: 0.18s; }
.ssr-ember-particle.p4 { left: 74%; top: 44%; width: 11rpx; height: 11rpx; animation-delay: 0.14s; }
.ssr-ember-particle.p5 { left: 38%; top: 32%; width: 9rpx; height: 9rpx; animation-delay: 0.24s; }
.ssr-ember-particle.p6 { left: 62%; top: 30%; width: 10rpx; height: 10rpx; animation-delay: 0.08s; }
.ssr-ember-particle.p7 { left: 45%; top: 68%; width: 8rpx; height: 8rpx; animation-delay: 0.28s; }
.ssr-ember-particle.p8 { left: 55%; top: 24%; width: 12rpx; height: 12rpx; animation-delay: 0.20s; }

@keyframes ssrParticleRise {
  0% {
    opacity: 0;
    transform: translateY(45rpx) scale(0.6);
  }
  30% {
    opacity: 1;
    transform: translateY(-20rpx) scale(1.15);
  }
  100% {
    opacity: 0;
    transform: translateY(-220rpx) scale(0.4);
  }
}

.ssr-light-streamer {
  position: absolute;
  width: 4rpx;
  height: 140rpx;
  background: linear-gradient(180deg, rgba(56, 189, 248, 0) 0%, #38bdf8 40%, #fde047 70%, rgba(255, 255, 255, 0) 100%);
  box-shadow: 0 0 14rpx #38bdf8;
  opacity: 0;
}

.ssr-awaken-overlay.ssr-active .ssr-light-streamer {
  animation: ssrStreamerShoot 0.78s cubic-bezier(0.16, 1, 0.3, 1) infinite;
}

.ssr-light-streamer.st1 { left: 38%; top: 56%; animation-delay: 0.04s; }
.ssr-light-streamer.st2 { left: 62%; top: 58%; animation-delay: 0.14s; }
.ssr-light-streamer.st3 { left: 31%; top: 44%; animation-delay: 0.22s; }
.ssr-light-streamer.st4 { left: 69%; top: 42%; animation-delay: 0.10s; }

@keyframes ssrStreamerShoot {
  0% {
    opacity: 0;
    transform: translateY(100rpx);
  }
  30% {
    opacity: 0.95;
  }
  100% {
    opacity: 0;
    transform: translateY(-250rpx);
  }
}

/* ---------- 5. 主角名烟【宝刀出鞘 · 游龙360°挽剑花 · 3D剑气星轨环绕】模型 ---------- */
.ssr-hero-cigarette-stage {
  position: absolute;
  top: 43%;
  left: 50%;
  width: var(--hero-w, 38rpx);
  height: var(--hero-h, 400rpx);
  margin-left: calc(var(--hero-w, 38rpx) * -0.5);
  margin-top: calc(var(--hero-h, 400rpx) * -0.5);
  z-index: 15;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transform: translate3d(var(--slot-offset-x, 0rpx), 160rpx, 0) scale(0.46) rotate(0deg);
  will-change: transform, opacity;
}

/* 经典宝刀出鞘 360° 单周掠空大回环 (1.42s) */
.ssr-awaken-overlay.ssr-active .ssr-hero-cigarette-stage {
  animation: ssrHeroArcFlight 1.42s cubic-bezier(0.22, 1, 0.36, 1) forwards;
}

/* 经典宝刀出鞘 · 游龙惊鸿 360° 挽剑花大回环 (382deg = 360° + 22°，精准落入粉黄蓝旋转中心) */
@keyframes ssrHeroArcFlight {
  0% {
    opacity: 0.95;
    transform: translate3d(var(--slot-offset-x, 0rpx), 160rpx, 0) scale(0.46) rotate(0deg);
  }
  15% {
    opacity: 1;
    transform: translate3d(calc(var(--slot-offset-x, 0rpx) * 0.35), -170rpx, 0) scale(0.66) rotate(-18deg);
  }
  35% {
    opacity: 1;
    transform: translate3d(205rpx, -75rpx, 0) scale(0.84) rotate(138deg);
  }
  58% {
    opacity: 1;
    transform: translate3d(-185rpx, 125rpx, 0) scale(1.36) rotate(286deg);
  }
  82% {
    opacity: 1;
    transform: translate3d(10rpx, -8rpx, 0) scale(1.22) rotate(388deg);
  }
  91% {
    opacity: 1;
    transform: translate3d(-4rpx, 3rpx, 0) scale(1.13) rotate(379deg);
  }
  100% {
    opacity: 1;
    transform: translate3d(0rpx, 0rpx, 0) scale(1.15) rotate(382deg);
  }
}

/* 破鞘与飞行阶段：尾部剑气推进尾焰 */
.ssr-tail-thruster-plume {
  position: absolute;
  bottom: -190rpx;
  left: 50%;
  width: 68rpx;
  height: 200rpx;
  margin-left: -34rpx;
  pointer-events: none;
  z-index: 2;
  display: flex;
  justify-content: center;
  opacity: 0;
}

.ssr-awaken-overlay.ssr-active .ssr-tail-thruster-plume {
  animation: ssrTailThrusterBurn 1.12s ease-out forwards;
}

@keyframes ssrTailThrusterBurn {
  0% { opacity: 0; transform: scaleY(0.3); }
  14% { opacity: 0.95; transform: scaleY(1.2); }
  65% { opacity: 0.75; transform: scaleY(0.9); }
  100% { opacity: 0; transform: scaleY(0); visibility: hidden; }
}

.thruster-core-beam {
  width: 22rpx;
  height: 100%;
  background: linear-gradient(180deg, #ffffff 0%, #fde047 30%, #38bdf8 68%, transparent 100%);
  filter: blur(4rpx);
  border-radius: 999rpx;
}

.thruster-side-streak {
  position: absolute;
  top: 10rpx;
  width: 6rpx;
  height: 150rpx;
  background: linear-gradient(180deg, #fde047 0%, #38bdf8 60%, transparent 100%);
  border-radius: 999rpx;
}
.thruster-side-streak.ts-left { left: 8rpx; }
.thruster-side-streak.ts-right { right: 8rpx; }

/* 3D 陀螺双龙剑气环绕法阵 (围绕定格名烟 3D 空间立体旋转环绕) */
.ssr-sword-orbit-system {
  position: absolute;
  width: 480rpx;
  height: 480rpx;
  left: 50%;
  top: 50%;
  margin-left: -240rpx;
  margin-top: -240rpx;
  pointer-events: none;
  z-index: 18;
  opacity: 0;
}

.ssr-awaken-overlay.ssr-active .ssr-sword-orbit-system {
  animation: ssrOrbitSystemFadeIn 0.55s ease-out 0.96s forwards;
}

@keyframes ssrOrbitSystemFadeIn {
  from { opacity: 0; transform: scale(0.65); }
  to { opacity: 1; transform: scale(1); }
}

.ssr-orbit-ring {
  position: absolute;
  left: 50%;
  top: 50%;
  border-radius: 50%;
  pointer-events: none;
}

.ssr-orbit-ring.orbit-jade {
  width: 280rpx;
  height: 280rpx;
  margin-left: -140rpx;
  margin-top: -140rpx;
  border: 2rpx dashed rgba(254, 240, 138, 0.55);
  animation: ssrWheelSpinCw 8s linear infinite;
}

/* 悬浮环绕的四方剑芒星印 */
.ssr-blade-sigil {
  position: absolute;
  font-size: 26rpx;
  color: #fde047;
  text-shadow: 0 0 16rpx #f59e0b, 0 0 28rpx #38bdf8;
  animation: ssrSigilPulse 1.8s ease-in-out infinite alternate;
}

.ssr-blade-sigil.sigil-1 { top: 44rpx; left: 68rpx; animation-delay: 0s; }
.ssr-blade-sigil.sigil-2 { top: 76rpx; right: 56rpx; color: #38bdf8; animation-delay: 0.4s; }
.ssr-blade-sigil.sigil-3 { bottom: 68rpx; left: 58rpx; color: #38bdf8; animation-delay: 0.8s; }
.ssr-blade-sigil.sigil-4 { bottom: 48rpx; right: 68rpx; animation-delay: 1.2s; }

@keyframes ssrSigilPulse {
  from { transform: translateY(6rpx) scale(0.82); opacity: 0.55; }
  to { transform: translateY(-10rpx) scale(1.22); opacity: 1; }
}

/* 定格瞬间刀光十字寒芒斩 (X-Slash Starburst Flare) */
.ssr-cross-slash {
  position: absolute;
  top: 28%;
  left: 50%;
  width: 480rpx;
  height: 480rpx;
  margin-left: -240rpx;
  margin-top: -240rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  z-index: 20;
  opacity: 0;
}

.ssr-awaken-overlay.ssr-active .ssr-cross-slash {
  animation: ssrCrossSlashFlash 0.72s ease-out 1.12s forwards;
}

.slash-beam {
  position: absolute;
  width: 460rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, transparent 0%, #38bdf8 15%, #fde047 35%, #ffffff 50%, #fde047 65%, #38bdf8 85%, transparent 100%);
  box-shadow: 0 0 32rpx #38bdf8, 0 0 56rpx #fde047, 0 0 80rpx #ffffff;
}

.slash-beam.beam-a { transform: rotate(34deg); }
.slash-beam.beam-b { transform: rotate(-34deg); }

.slash-core-star {
  font-size: 68rpx;
  color: #ffffff;
  text-shadow: 0 0 28rpx #fde047, 0 0 54rpx #38bdf8, 0 0 72rpx #ffffff;
  line-height: 1;
}

@keyframes ssrCrossSlashFlash {
  0% { opacity: 0; transform: scale(0.3); }
  25% { opacity: 1; transform: scale(1.18); }
  100% { opacity: 0; transform: scale(1.4); }
}

/* 名烟 3D 圆柱实体 (100% 纯正完整烟支还原，首尾干净纯粹，零杂色色块) */
.ssr-hero-cigarette-body {
  width: var(--hero-w, 38rpx);
  height: var(--hero-h, 400rpx);
  position: relative;
  z-index: 10;
  display: flex;
  flex-direction: column;
  border-radius: 6rpx;
  overflow: hidden;
  box-shadow: 
    0 24rpx 60rpx rgba(0, 0, 0, 0.92),
    0 0 44rpx rgba(251, 191, 36, 0.85),
    0 0 28rpx rgba(56, 189, 248, 0.65),
    inset 0 0 12rpx rgba(255, 255, 255, 0.45);
}

.ssr-hero-cigarette-body.is-hanyan-body {
  background: transparent;
  box-shadow: none;
  overflow: visible;
  filter: drop-shadow(0 18rpx 36rpx rgba(0, 0, 0, 0.88)) drop-shadow(0 0 24rpx rgba(251, 191, 36, 0.55));
}

/* 上段：纯正过滤嘴 */
.ssr-cig-filter {
  width: 100%;
  height: var(--hero-filter-h, 116rpx);
  background: var(--filter-bg, #d97706);
  position: relative;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ssr-filter-cylinder-shine {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    90deg,
    rgba(0, 0, 0, 0.26) 0%,
    rgba(255, 255, 255, 0.34) 30%,
    rgba(255, 255, 255, 0.05) 65%,
    rgba(0, 0, 0, 0.34) 100%
  );
  pointer-events: none;
}

/* 爆珠标识 */
.ssr-bead-gem {
  position: relative;
  z-index: 5;
  width: 14rpx;
  height: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ssr-bead-core {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background: var(--bead-color, #38bdf8);
  border: 1.5rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 0 0 2rpx rgba(9, 13, 22, 0.65), 0 0 10rpx var(--bead-color, #38bdf8);
  box-sizing: border-box;
}

/* 滤嘴纯正烫金箍圈 */
.ssr-filter-gold-band {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 10rpx;
  background: var(--band-bg, linear-gradient(90deg, #b45309 0%, #fde047 45%, #ffffff 50%, #fbbf24 60%, #92400e 100%));
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.35);
  z-index: 4;
}

/* 下段：修长纯净烟身纸管 (通体纯净延伸至底端，零杂色色块) */
.ssr-cig-paper {
  flex: 1;
  width: 100%;
  background: var(--paper-bg, #fffdf5);
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  padding-top: 22rpx;
  background-image: repeating-linear-gradient(
    0deg,
    rgba(0, 0, 0, 0.04) 0px,
    rgba(0, 0, 0, 0.04) 1px,
    transparent 1px,
    transparent 6px
  );
}

.ssr-paper-cylinder-shine {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    90deg,
    rgba(0, 0, 0, 0.14) 0%,
    rgba(255, 255, 255, 0.45) 30%,
    rgba(255, 255, 255, 0.05) 68%,
    rgba(0, 0, 0, 0.22) 100%
  );
  pointer-events: none;
}

.ssr-paper-brand-stamp {
  position: relative;
  z-index: 3;
  font-size: 15rpx;
  font-weight: 900;
  color: rgba(180, 83, 9, 0.85);
  writing-mode: vertical-lr;
  letter-spacing: 3rpx;
}

/* 贯穿全烟身的宝刀寒芒流光 (定格后持续周期性掠过刀锋流光) */
.ssr-blade-sheen {
  position: absolute;
  left: -100%;
  right: -100%;
  height: 90rpx;
  bottom: -120rpx;
  background: linear-gradient(
    180deg,
    transparent 0%,
    rgba(254, 240, 138, 0.38) 35%,
    rgba(255, 255, 255, 0.92) 50%,
    rgba(56, 189, 248, 0.35) 65%,
    transparent 100%
  );
  transform: rotate(-18deg);
  z-index: 15;
  pointer-events: none;
}

.ssr-awaken-overlay.ssr-active .ssr-blade-sheen {
  animation: ssrBladeSweepUp 2.6s cubic-bezier(0.22, 1, 0.36, 1) 1.08s infinite;
}

@keyframes ssrBladeSweepUp {
  0% { bottom: -120rpx; opacity: 0; }
  12% { opacity: 1; }
  38% { bottom: 115%; opacity: 0; }
  100% { bottom: 115%; opacity: 0; }
}

/* 老辈手卷旱烟专属 SSR 模型 (与首页 1:1 严密对齐：通体一体式白纸喇叭筒 + 齐平烟丝切口 + 作业本微蓝横线 + 老辈旱烟红章) */
.ssr-hanyan-cone {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.ssr-hanyan-paper-cone {
  width: 100%;
  flex: 1;
  background: linear-gradient(90deg, #cfc9ba 0%, #faf8f2 24%, #ffffff 48%, #faf8f2 74%, #c2bcb0 100%);
  clip-path: polygon(0 0, 100% 0, 73.5% 100%, 26.5% 100%);
  -webkit-clip-path: polygon(0 0, 100% 0, 73.5% 100%, 26.5% 100%);
  border-radius: 6rpx 6rpx 2rpx 2rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

/* 顶端齐平金黄烟丝切口与白纸管口缘 (1:1 对齐首页) */
.ssr-hanyan-top-cut {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 11rpx;
  background: radial-gradient(ellipse at 50% 50%, #451a03 0%, #78350f 55%, #b45309 85%, #faf8f2 100%);
  border-bottom: 2.5rpx solid #fcfbf7;
  border-radius: 0 0 50% 50%;
  z-index: 4;
}

/* 90年代手卷旱烟灵魂特征：作业本微蓝横线 (通体贯通) */
.ssr-hanyan-notebook-lines {
  position: absolute;
  inset: 0;
  background-image: repeating-linear-gradient(
    184deg,
    transparent 0rpx,
    transparent 34rpx,
    rgba(59, 130, 246, 0.28) 34rpx,
    rgba(59, 130, 246, 0.28) 36rpx
  );
  pointer-events: none;
  z-index: 2;
}

/* 手工斜向卷纸搭接缝 */
.ssr-hanyan-spiral-seam {
  position: absolute;
  top: 28%;
  width: 140%;
  height: 2rpx;
  background: rgba(168, 162, 158, 0.48);
  transform: rotate(24deg);
  z-index: 3;
}

.ssr-hanyan-spiral-seam.seam-lower {
  top: 64%;
}

/* 竖向传统红印章 (老辈旱烟) - 置于一体式喇叭筒中下段，与首页完全一致 */
.ssr-hanyan-red-stamp {
  position: relative;
  z-index: 5;
  margin-top: 76rpx;
  font-size: 15rpx;
  font-weight: 900;
  color: rgba(185, 28, 28, 0.82);
  writing-mode: vertical-lr;
  letter-spacing: 3rpx;
}

/* 6. 腾讯游戏 SSR 传说级黑金铭牌横幅 */
.ssr-mythic-banner {
  position: absolute;
  bottom: 136rpx;
  left: 50%;
  transform: translateX(-50%) translateY(36rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  z-index: 20;
  opacity: 0;
  transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1) 1.12s, opacity 0.35s ease 1.12s;
  width: 90%;
  max-width: 620rpx;
}

.ssr-awaken-overlay.ssr-active .ssr-mythic-banner {
  opacity: 1;
  transform: translateX(-50%) translateY(0);
}

.ssr-banner-top-tag {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  background: rgba(56, 189, 248, 0.16);
  border: 1px solid rgba(56, 189, 248, 0.62);
  padding: 4rpx 22rpx;
  border-radius: 999rpx;
  box-shadow: 0 0 20rpx rgba(56, 189, 248, 0.35);
}

.ssr-tag-ornament {
  font-size: 18rpx;
  color: #38bdf8;
}

.ssr-tag-text {
  font-size: 20rpx;
  font-weight: 800;
  color: #fef08a;
  letter-spacing: 3rpx;
}

.ssr-banner-main-box {
  width: 100%;
  background: linear-gradient(90deg, transparent 0%, rgba(15, 23, 42, 0.95) 18%, rgba(30, 41, 59, 0.98) 50%, rgba(15, 23, 42, 0.95) 82%, transparent 100%);
  border-top: 2rpx solid rgba(251, 191, 36, 0.65);
  border-bottom: 2rpx solid rgba(251, 191, 36, 0.65);
  padding: 16rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, 0.75);
}

.ssr-banner-wing {
  width: 48rpx;
  height: 3rpx;
  background: linear-gradient(90deg, transparent, #fbbf24);
}
.ssr-banner-wing.right-wing {
  background: linear-gradient(90deg, #fbbf24, transparent);
}

.ssr-banner-cig-name {
  font-size: 34rpx;
  font-weight: 900;
  color: #fef08a;
  letter-spacing: 3rpx;
  text-shadow: 0 2rpx 12rpx rgba(245, 158, 11, 0.75), 0 4rpx 16rpx rgba(0, 0, 0, 0.9);
  text-align: center;
}

.ssr-banner-sub-hint {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 2rpx;
}

.ssr-ignite-dot {
  font-size: 22rpx;
  color: #38bdf8;
}

.ssr-ignite-text {
  font-size: 22rpx;
  font-weight: 600;
  color: #cbd5e1;
  letter-spacing: 2rpx;
}
