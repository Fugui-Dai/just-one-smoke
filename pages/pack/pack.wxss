/* pages/pack/pack.wxss */

/* ==================== 1. 全局容器与典藏展厅微光舞台背景 ==================== */
.pack-page-container {
  width: 100vw;
  height: 100vh;
  /* 🏆 腾讯总监级高定：皇家星海·黛蓝典藏神兵殿堂 (Tencent Games Royal Sapphire & Celestial Showcase) */
  background: radial-gradient(ellipse 90% 75% at 50% 16%, #223048 0%, #1a2538 40%, #131b29 70%, #0d131f 100%);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  position: relative;
  box-sizing: border-box;
}

.pack-page-container.theme-emerald,
.pack-page-container.theme-day {
  background: radial-gradient(ellipse 90% 75% at 50% 16%, #1a3832 0%, #132a26 40%, #0d1d1a 70%, #091311 100%);
}

.pack-page-container.theme-purple,
.pack-page-container.theme-month {
  background: radial-gradient(ellipse 90% 75% at 50% 16%, #2f2042 0%, #241834 40%, #191024 70%, #100b18 100%);
}

.pack-page-container.theme-glacier,
.pack-page-container.theme-lifetime {
  background: radial-gradient(ellipse 90% 75% at 50% 16%, #36291a 0%, #2a1f13 40%, #1d150c 70%, #120d07 100%);
}

/* 动态奢华极光天幕与 3D 烟盒背光星尘舞台 (全员常驻基础轻奢氛围，VIP 增强专属色谱) */
.vip-ambient-stage {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 1;
  overflow: hidden;
}

.vip-aurora-orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(54rpx);
  opacity: 0.72;
  animation: packVipOrbBreath 5.5s infinite alternate ease-in-out;
}

/* 默认模式：天顶柔和明丽漫射 (通透舒朗，层次丰润，随车色主题自适应) */
.vip-aurora-orb.orb-primary {
  width: 600rpx;
  height: 360rpx;
  top: -40rpx;
  left: 50%;
  margin-left: -300rpx;
  background: radial-gradient(circle, var(--vip-theme-orb1, rgba(251, 191, 36, 0.32)) 0%, transparent 75%);
}

/* 默认模式：3D 烟盒后仰背部悬浮温润辉光 */
.vip-aurora-orb.orb-center-halo {
  width: 560rpx;
  height: 560rpx;
  top: 34%;
  left: 50%;
  margin-left: -280rpx;
  background: radial-gradient(circle, var(--vip-theme-orb2, rgba(245, 158, 11, 0.26)) 0%, transparent 72%);
  animation-delay: -2.6s;
}

/* 默认模式：底部展台流金地坪光池 */
.vip-aurora-orb.orb-bottom-glow {
  width: 680rpx;
  height: 400rpx;
  bottom: -40rpx;
  left: 50%;
  margin-left: -340rpx;
  background: radial-gradient(ellipse at 50% 80%, var(--vip-theme-orb1, rgba(56, 189, 248, 0.25)) 0%, transparent 80%);
  filter: blur(52rpx);
  animation: packFloorGlowBreathe 6.5s infinite alternate ease-in-out;
}

@keyframes packVipOrbBreath {
  0% { transform: scale(0.92); opacity: 0.50; }
  100% { transform: scale(1.12); opacity: 0.82; }
}

@keyframes packFloorGlowBreathe {
  0% { transform: scale(0.94); opacity: 0.65; }
  100% { transform: scale(1.08); opacity: 0.95; }
}

/* 浮空浪漫璀璨微晶星屑 */
.vip-spark {
  position: absolute;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--vip-theme-spark, #fef08a);
  box-shadow: 0 0 14rpx var(--vip-theme-spark-glow, rgba(251, 191, 36, 0.85));
  opacity: 0.68;
  animation: packVipSparkFloat 4.8s infinite ease-in-out;
}

.vip-spark.s1 { top: 22%; left: 14%; animation-delay: 0s; }
.vip-spark.s2 { top: 30%; right: 14%; width: 6rpx; height: 6rpx; animation-delay: -1.3s; }
.vip-spark.s3 { top: 58%; left: 16%; width: 6rpx; height: 6rpx; animation-delay: -2.5s; }
.vip-spark.s4 { top: 66%; right: 16%; animation-delay: -3.7s; }

@keyframes packVipSparkFloat {
  0%, 100% { transform: translateY(0) scale(0.8); opacity: 0.28; }
  50% { transform: translateY(-26rpx) scale(1.25); opacity: 0.88; }
}

/* ==================== 2. 自定义导航栏 (与全站统一银白标题与磨砂返回键) ==================== */
.custom-navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: transparent;
  box-sizing: border-box;
  transition: background 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
}

.custom-navbar.navbar-stage-immersive {
  backdrop-filter: none !important;
  -webkit-backdrop-filter: none !important;
  background: transparent !important;
  background-color: transparent !important;
  border-bottom: none !important;
  box-shadow: none !important;
}

.navbar-content {
  position: relative;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-left: 20rpx;
  background: transparent !important;
  box-sizing: border-box;
}

.nav-back-btn {
  position: relative;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 50%;
  color: #e2e8f0;
  transition: all 0.2s ease;
  padding: 0;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.35);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
}

.nav-back-btn .back-chevron-arrow {
  width: 18rpx;
  height: 18rpx;
  border-left: 4rpx solid #e2e8f0;
  border-bottom: 4rpx solid #e2e8f0;
  transform: rotate(45deg);
  margin-left: 6rpx;
}

.nav-back-btn:active {
  transform: scale(0.92);
  background: rgba(255, 255, 255, 0.16);
  border-color: rgba(255, 255, 255, 0.24);
}

.nav-center-title-box {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  margin: auto;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  z-index: 5;
}

.nav-center-title-text {
  font-size: 34rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  background: linear-gradient(135deg, #f8fafc 0%, #cbd5e1 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  color: #f8fafc;
  max-width: 420rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: center;
  filter: drop-shadow(0 2rpx 8rpx rgba(0, 0, 0, 0.6));
}

.nav-placeholder {
  width: 60rpx;
  height: 60rpx;
}


/* ==================== 3. 主内容区域 ==================== */
.pack-main-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
}

/* 顶部浪漫流金名牌 (Museum Plaque) + 烟盒剩余数量胶囊 */
.pack-meta-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 6rpx 24rpx 6rpx;
  background: transparent;
  z-index: 30;
}

.pack-romantic-plaque {
  position: relative;
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  background: linear-gradient(135deg, rgba(34, 48, 74, 0.82) 0%, rgba(24, 35, 56, 0.88) 50%, rgba(16, 24, 40, 0.92) 100%);
  border: 1.5rpx solid rgba(251, 191, 36, 0.52);
  padding: 10rpx 32rpx;
  border-radius: 999rpx;
  box-shadow: 0 8rpx 28rpx rgba(10, 16, 28, 0.6), 0 0 18rpx rgba(251, 191, 36, 0.25);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
}

.pack-romantic-plaque::before {
  content: '';
  position: absolute;
  inset: 4rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(254, 240, 138, 0.35);
  pointer-events: none;
}

.plaque-ornament {
  font-size: 20rpx;
  color: #fbbf24;
  text-shadow: 0 0 10rpx rgba(245, 158, 11, 0.7);
}

.plaque-brand-name {
  font-size: 27rpx;
  font-weight: 900;
  background: linear-gradient(180deg, #ffffff 0%, #fff7ed 35%, #fef08a 70%, #f59e0b 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  color: #fef08a;
  letter-spacing: 2rpx;
  filter: drop-shadow(0 2rpx 4rpx rgba(10, 16, 28, 0.6));
}

.plaque-divider {
  font-size: 20rpx;
  color: rgba(254, 240, 138, 0.55);
  font-weight: 700;
}

.plaque-price {
  font-size: 25rpx;
  font-weight: 900;
  color: #fde047;
  letter-spacing: 1rpx;
  text-shadow: 0 0 10rpx rgba(251, 191, 36, 0.5);
}

.plaque-spec {
  font-size: 22rpx;
  color: #e2e8f0;
  font-weight: 700;
  letter-spacing: 0.8rpx;
}

.brand-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.brand-main-name {
  font-size: 32rpx;
  font-weight: 900;
  color: #f8fafc;
}

.brand-badge-tag {
  font-size: 18rpx;
  color: #fef08a;
  background: rgba(245, 158, 11, 0.25);
  border: 1px solid rgba(251, 191, 36, 0.65);
  padding: 2rpx 10rpx;
  border-radius: 12rpx;
  font-weight: 700;
}

.brand-tagline {
  font-size: 20rpx;
  color: #cbd5e1;
  margin-top: 4rpx;
}

/* 烟盒余量胶囊行 (自适应窄屏与折叠屏包裹居中) */
.pack-inventory-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  flex-wrap: wrap;
  padding: 0 16rpx;
  row-gap: 10rpx;
  background: transparent;
}

.pack-inventory-pill {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  background: linear-gradient(90deg, rgba(16, 88, 70, 0.78) 0%, rgba(8, 58, 46, 0.88) 100%);
  border: 1.5rpx solid rgba(52, 211, 153, 0.55);
  padding: 6rpx 24rpx;
  border-radius: 999rpx;
  box-shadow: 0 4rpx 14rpx rgba(6, 36, 28, 0.4), inset 0 0 10rpx rgba(52, 211, 153, 0.2);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
}

.inv-pulse-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #34d399;
  box-shadow: 0 0 12rpx #34d399, 0 0 20rpx rgba(52, 211, 153, 0.6);
}

.inv-text {
  font-size: 22rpx;
  color: #d1fae5;
  font-weight: 800;
  letter-spacing: 1.5rpx;
}

.pack-inventory-pill.pill-low {
  background: linear-gradient(90deg, rgba(146, 64, 14, 0.82) 0%, rgba(95, 34, 4, 0.92) 100%);
  border-color: rgba(251, 191, 36, 0.75);
  box-shadow: 0 4rpx 14rpx rgba(30, 16, 6, 0.5);
}
.pack-inventory-pill.pill-low .inv-pulse-dot { background: #fbbf24; box-shadow: 0 0 12rpx #fbbf24; }
.pack-inventory-pill.pill-low .inv-text { color: #fef08a; }

.pack-inventory-pill.pill-empty {
  background: linear-gradient(90deg, rgba(153, 27, 27, 0.82) 0%, rgba(85, 12, 12, 0.92) 100%);
  border-color: rgba(248, 113, 113, 0.75);
  box-shadow: 0 4rpx 14rpx rgba(40, 10, 10, 0.5);
}
.pack-inventory-pill.pill-empty .inv-pulse-dot { background: #f87171; box-shadow: 0 0 12rpx #ef4444; }
.pack-inventory-pill.pill-empty .inv-text { color: #fee2e2; }

.pack-unwrap-mini-btn {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 22rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, rgba(46, 36, 24, 0.88) 0%, rgba(28, 20, 12, 0.95) 100%);
  border: 1.5rpx solid rgba(251, 191, 36, 0.65);
  box-shadow: 0 4rpx 14rpx rgba(10, 16, 28, 0.5);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  transition: transform 0.18s ease, background 0.18s ease;
}

.pack-unwrap-mini-btn:active {
  transform: scale(0.94);
  background: rgba(62, 48, 30, 0.95);
  border-color: rgba(251, 191, 36, 0.85);
}

.unwrap-mini-text {
  font-size: 20rpx;
  font-weight: 800;
  color: #fef08a;
  letter-spacing: 1.2rpx;
}

/* ==================== 3.5 品鉴出鞘特效四阶切换栏 (高定无界悬浮胶囊) ==================== */
.pack-vfx-selector-row {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 10rpx;
  padding: 0 16rpx;
}

.vfx-tier-tabs {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(10, 15, 26, 0.72);
  border: 1.5rpx solid rgba(255, 255, 255, 0.12);
  padding: 6rpx 10rpx;
  border-radius: 999rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.45), inset 0 1rpx 2rpx rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
}

.vfx-tier-chip {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: rgba(226, 232, 240, 0.65);
  border: 1rpx solid transparent;
  transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  position: relative;
}

.vfx-tier-chip:active {
  transform: scale(0.95);
}

.vfx-tier-chip .vt-icon {
  font-size: 18rpx;
  line-height: 1;
}

.vfx-tier-chip .vt-name {
  letter-spacing: 0.5rpx;
  line-height: 1;
}

/* 普通档位激活态 (白银冷月) */
.vfx-tier-chip.tier-standard.active-tier {
  background: linear-gradient(135deg, rgba(241, 245, 249, 0.28) 0%, rgba(148, 163, 184, 0.20) 100%);
  border-color: rgba(248, 250, 252, 0.85);
  color: #ffffff;
  font-weight: 800;
  box-shadow: 0 2rpx 10rpx rgba(255, 255, 255, 0.22);
}

/* 日卡档位激活态 (翡翠破晓) */
.vfx-tier-chip.tier-day.active-tier {
  background: linear-gradient(135deg, rgba(16, 185, 129, 0.35) 0%, rgba(5, 150, 105, 0.25) 100%);
  border-color: #34d399;
  color: #d1fae5;
  font-weight: 800;
  box-shadow: 0 2rpx 12rpx rgba(16, 185, 129, 0.40);
}

/* 月卡档位激活态 (极光紫晶) */
.vfx-tier-chip.tier-month.active-tier {
  background: linear-gradient(135deg, rgba(168, 85, 247, 0.35) 0%, rgba(126, 34, 206, 0.25) 100%);
  border-color: #c084fc;
  color: #f5d0fe;
  font-weight: 800;
  box-shadow: 0 2rpx 12rpx rgba(168, 85, 247, 0.45);
}

/* 至尊档位激活态 (曜世真龙) */
.vfx-tier-chip.tier-lifetime.active-tier {
  background: linear-gradient(135deg, rgba(251, 191, 36, 0.38) 0%, rgba(217, 119, 6, 0.26) 100%);
  border-color: #fde047;
  color: #fef08a;
  font-weight: 800;
  box-shadow: 0 2rpx 14rpx rgba(251, 191, 36, 0.55);
}

.vt-indicator {
  position: absolute;
  bottom: -2rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 14rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: currentColor;
  box-shadow: 0 0 6rpx currentColor;
}

/* ==================== 4. 3D 拟真烟盒舞台 (3D Pack Stage) ==================== */
.pack-3d-stage {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  perspective: 2400px;
  -webkit-perspective: 2400px;
  margin-top: 10rpx;
}

/* 舞台背部浪漫星芒光晕 */
.stage-romantic-halo {
  position: absolute;
  width: 580rpx;
  height: 580rpx;
  border-radius: 50%;
  top: 46%;
  left: 50%;
  transform: translate(-50%, -50%);
  filter: blur(45px);
  pointer-events: none;
  z-index: 1;
}

/* 3D 烟盒主体外壳容器 (严格 360x580，1:1 恒定比例，反重力微浮呼吸) */
.pack-box-wrapper {
  position: relative;
  width: 360rpx;
  height: 580rpx;
  z-index: 12;
  margin-top: 26rpx;
  border-radius: 12rpx;
  box-shadow:
    0 24rpx 56rpx rgba(10, 16, 28, 0.68),
    0 0 32rpx rgba(251, 191, 36, 0.24),
    0 0 18rpx rgba(56, 189, 248, 0.20);
  transition: box-shadow 0.35s ease, transform 0.35s ease;
  animation: packBoxHoverFloat 5.2s ease-in-out infinite alternate;
}

@keyframes packBoxHoverFloat {
  0% { transform: translateY(0rpx); }
  100% { transform: translateY(-8rpx); }
}

/* 盒盖打开状态：清除外层容器投影与浮动，保持稳固 */
.pack-box-wrapper.lid-open {
  transform: none;
  animation: none;
  margin-bottom: 0;
  box-shadow: none;
}

/* 细支烟盒比例 (保持 360x580 纯画幅统一，无拉伸畸变) */
.pack-box-wrapper.slender-box {
  width: 360rpx;
  height: 580rpx;
}

/* 雪茄大号木盒比例 (保持 360x580 纯画幅统一，无拉伸畸变) */
.pack-box-wrapper.cigar-box {
  width: 360rpx;
  height: 580rpx;
}

/* ==================== 盒内内胆与烟支展示仓 (Open Pack Upper Chamber - 常驻实心渲染于上盖后方，0ms 零延迟衔接，彻底根除翻盖瞬间透明缝隙) ==================== */
.pack-inner-chamber {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  width: 360rpx;
  height: calc(var(--lid-h, 168rpx) + 20rpx);
  background: transparent;
  box-sizing: border-box;
  overflow: visible;
  z-index: 10;
  opacity: 1;
  pointer-events: auto;
}

/* 烟壳左右两翼与顶部包边背景：高度进一步调减（top 下移至 40rpx），刚好承接后盖底沿，完全不挡后盖且两侧立壁高度更紧凑精致 */
.pack-inner-chamber::before {
  content: '';
  position: absolute;
  top: 40rpx;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--lid-grad, var(--box-grad, #7f1d1d));
  border-radius: 0;
  border-left: 1px solid rgba(255, 255, 255, 0.24);
  border-right: 1px solid rgba(255, 255, 255, 0.24);
  border-top: 1px solid rgba(255, 255, 255, 0.30);
  box-shadow: inset 0 2rpx 6rpx rgba(255, 255, 255, 0.25);
  pointer-events: none;
  z-index: 0;
}

/* 腾讯获奖级【千盒千面 · 同源色阶自适应内胆】：
   同步往下降低至 top: 44rpx（左右内缩 5rpx），既不遮挡后方盒盖，又完美衬托两排烟支 */
.foil-paper-liner {
  display: block;
  position: absolute;
  top: 44rpx;
  left: 5rpx;
  right: 5rpx;
  bottom: 0;
  border-radius: 8rpx 8rpx 0 0;
  z-index: 1;
  pointer-events: none;
  background: var(--lid-grad, var(--box-grad, #451a03));
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  border-bottom: none;
  overflow: hidden;
  box-shadow:
    inset 0 10rpx 24rpx rgba(0, 0, 0, 0.48),
    inset 0 1rpx 4rpx rgba(255, 255, 255, 0.28);
}

/* 第一层自适应滤镜：将烟壳原色柔和沉降 28% 形成盒内自然暗部色阶，顶部泛起 18% 专属主题柔光 */
.foil-paper-liner::before {
  content: '';
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse at 50% 15%, rgba(255, 255, 255, 0.16) 0%, transparent 72%),
    linear-gradient(180deg, rgba(15, 23, 42, 0.26) 0%, rgba(9, 13, 22, 0.42) 55%, rgba(0, 0, 0, 0.52) 100%);
  pointer-events: none;
}

/* 第二层自适应基因色晕染：提取每款烟独有的 --foil-color 在内胆顶端形成极细腻的微晶光泽过渡 */
.foil-paper-liner::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 75%;
  background: var(--foil-color, #f59e0b);
  opacity: 0.14;
  mask-image: linear-gradient(180deg, #000 0%, transparent 100%);
  -webkit-mask-image: linear-gradient(180deg, #000 0%, transparent 100%);
  pointer-events: none;
}

.inner-collar-frame {
  display: none;
}

.collar-u-notch,
.collar-card-rim {
  display: none;
}

.foil-notch-cutout,
.foil-texture-shimmer {
  display: none;
}

/* ==================== 盒内立体香烟真实双排阶梯陈列 (第一排 0..9 + 第二排 10..19 两排独立网格同时清晰呈现) ==================== */
.cigarettes-matrix {
  position: absolute;
  top: 48rpx;
  left: 8rpx;
  right: 8rpx;
  height: calc(var(--lid-h, 168rpx) - 40rpx);
  display: grid;
  align-items: start;
  justify-content: center;
  z-index: 10;
  box-sizing: border-box;
}

/* 移除生硬的人造金边分割线，还原真实前后排自然衔接 */
.cigarettes-matrix.standard-matrix::after,
.cigarettes-matrix.slender-matrix::after {
  display: none;
}

/* 常规 20 支排列：随两侧壁同步下移与缩减高度，上排从 48rpx 起算，下排从 104rpx 起算至 172rpx（深入盒身 4rpx 绝不悬空） */
.cigarettes-matrix.standard-matrix {
  grid-template-columns: repeat(10, 1fr);
  grid-template-rows: 56rpx 68rpx;
  column-gap: 4rpx;
  row-gap: 0rpx;
}

/* 细支 20 支排列：上排露出 56rpx，下排露出 64rpx 并深入盒体 4rpx 严丝合缝 */
.cigarettes-matrix.slender-matrix {
  grid-template-columns: repeat(10, 1fr);
  grid-template-rows: 56rpx 68rpx;
  column-gap: 5rpx;
  row-gap: 0rpx;
}

/* 雪茄 5 支排列 (单排 5 支大雪茄，随两侧壁同步下移且底部深入盒身绝不悬空) */
.cigarettes-matrix.cigar-matrix {
  top: 40rpx;
  left: 18rpx;
  right: 18rpx;
  grid-template-columns: repeat(5, 1fr);
  grid-template-rows: 132rpx;
  gap: 10rpx;
}

/* ====================================================================================
   【模式 A: 宽幕轻奢 6 支单排品鉴装】 (PACK_LAYOUT_MODE === 'row6')
   - 商业化高频闭环：6 支适中容量，高频刺激看广告与 VIP 开包转化
   - 视觉品质提升：Retina 级大滤嘴微距特写，云纹金箍细节毕现，点触命中率极佳
   - 兼容性：与原 20 支双排代码完全解耦，下方原 20 支所有规则完整保留随时切回
   ==================================================================================== */
.cigarettes-matrix.row6-matrix {
  top: 76rpx;
  left: 24rpx;
  right: 24rpx;
  grid-template-columns: repeat(6, 1fr);
  grid-template-rows: 140rpx;
  column-gap: 12rpx;
  row-gap: 0;
}

.row6-matrix .cig-filter-slot.row6-slot {
  grid-row: 1;
  top: 0;
  height: 140rpx;
  z-index: 8;
  display: flex;
  flex-direction: column;
  align-items: center;
  transform: none;
  filter: brightness(1.02) drop-shadow(0 2rpx 6rpx rgba(0, 0, 0, 0.45));
}

.row6-matrix .cig-filter-slot.row6-slot:active {
  transform: translateY(-8rpx);
}

.row6-matrix .cig-filter-slot.row6-slot.slot-pulled-out {
  transform: translateY(-68rpx);
  transition: transform 1.1s cubic-bezier(0.18, 0.89, 0.32, 1.15);
  filter: drop-shadow(0 0 14rpx rgba(251, 191, 36, 0.85));
}

/* 严格对齐真实香烟与吸烟页面的黄金标准粗细 (常规支 28rpx，细支 20rpx)，白色纸管深插盒身彻底消除黑边悬空 */
.row6-matrix .cig-filter-slot.row6-slot .slot-cigarette-stick {
  width: 28rpx;
  height: 140rpx;
}

.slender-box .row6-matrix .cig-filter-slot.row6-slot .slot-cigarette-stick {
  width: 20rpx;
}

.row6-matrix .cig-filter-slot.row6-slot .slot-filter-cylinder {
  width: 100%;
  height: 74rpx;
  border-radius: 6rpx 6rpx 0 0;
}

/* 白色烟身纸管：向上外露 18rpx，向下深插盒身 48rpx (总高 66rpx)，彻底消除下沿悬空与黑底穿帮 */
.row6-matrix .cig-filter-slot.row6-slot .slot-paper-cylinder {
  width: 100%;
  height: 66rpx;
}

.row6-matrix .cig-filter-slot.row6-slot .slot-hanyan-stick {
  width: 28rpx;
  height: 140rpx;
}

.row6-matrix .cig-filter-slot.row6-slot .slot-empty-groove {
  width: 28rpx;
  height: 92rpx;
}

.slender-box .row6-matrix .cig-filter-slot.row6-slot .slot-empty-groove {
  width: 20rpx;
}

.row6-matrix .cig-filter-slot.row6-slot.empty-slot {
  z-index: 2;
  height: 92rpx;
}

.cig-filter-slot {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  position: relative;
  transition: transform 0.2s ease, filter 0.2s ease;
  box-sizing: border-box;
}

/* 上排/后排 10 支 (index 0..9)：烟身直通盒底 (124rpx)，当前排被抽走时完整露出下半截白色烟身，绝不半空截断悬空 */
.standard-matrix .cig-filter-slot.back-row-slot,
.slender-matrix .cig-filter-slot.back-row-slot {
  grid-row: 1;
  top: 0;
  height: 58rpx;
  z-index: 6;
  transform: none;
  filter: brightness(1.02) drop-shadow(0 2rpx 4rpx rgba(0, 0, 0, 0.32));
}

.standard-matrix .cig-filter-slot.back-row-slot.empty-slot,
.slender-matrix .cig-filter-slot.back-row-slot.empty-slot {
  z-index: 2;
}

/* 下排/前排 10 支 (index 10..19)：盒口上方露出 64rpx，底部向下深入盒身 4rpx (总高 68rpx)，彻底消除底部悬空 */
.standard-matrix .cig-filter-slot.front-row-slot,
.slender-matrix .cig-filter-slot.front-row-slot {
  grid-row: 2;
  top: 0;
  height: 68rpx;
  z-index: 12;
  transform: none;
  filter: brightness(1.03) drop-shadow(0 -2rpx 5rpx rgba(0, 0, 0, 0.35)) drop-shadow(0 4rpx 8rpx rgba(0, 0, 0, 0.45));
}

/* 当下排烟支被抽走为空槽时，退至上排实心烟支后方 (z-index: 3 < 6)，让上排烟支的下半截白色烟身完整通到底部绝不悬空 */
.standard-matrix .cig-filter-slot.front-row-slot.empty-slot,
.slender-matrix .cig-filter-slot.front-row-slot.empty-slot {
  z-index: 3;
  pointer-events: none;
}

/* 雪茄单排 5 支高度 */
.cigar-matrix .cig-filter-slot.cigar-row-slot {
  grid-row: 1;
  top: 0;
  height: 132rpx;
  z-index: 8;
}

/* 第二排 10 支列映射：10..19 分别对应第 1..10 列 */
.standard-matrix .cig-filter-slot:nth-child(11),
.slender-matrix .cig-filter-slot:nth-child(11) { grid-column: 1; }
.standard-matrix .cig-filter-slot:nth-child(12),
.slender-matrix .cig-filter-slot:nth-child(12) { grid-column: 2; }
.standard-matrix .cig-filter-slot:nth-child(13),
.slender-matrix .cig-filter-slot:nth-child(13) { grid-column: 3; }
.standard-matrix .cig-filter-slot:nth-child(14),
.slender-matrix .cig-filter-slot:nth-child(14) { grid-column: 4; }
.standard-matrix .cig-filter-slot:nth-child(15),
.slender-matrix .cig-filter-slot:nth-child(15) { grid-column: 5; }
.standard-matrix .cig-filter-slot:nth-child(16),
.slender-matrix .cig-filter-slot:nth-child(16) { grid-column: 6; }
.standard-matrix .cig-filter-slot:nth-child(17),
.slender-matrix .cig-filter-slot:nth-child(17) { grid-column: 7; }
.standard-matrix .cig-filter-slot:nth-child(18),
.slender-matrix .cig-filter-slot:nth-child(18) { grid-column: 8; }
.standard-matrix .cig-filter-slot:nth-child(19),
.slender-matrix .cig-filter-slot:nth-child(19) { grid-column: 9; }
.standard-matrix .cig-filter-slot:nth-child(20),
.slender-matrix .cig-filter-slot:nth-child(20) { grid-column: 10; }

/* 上排烟支总高度 124rpx (48rpx + 124rpx = 172rpx)，直插下方烟盒内部，无论下排是否有烟都绝不悬空 */
.standard-matrix .cig-filter-slot.back-row-slot .slot-cigarette-stick,
.slender-matrix .cig-filter-slot.back-row-slot .slot-cigarette-stick {
  height: 124rpx;
}

.standard-matrix .cig-filter-slot.front-row-slot .slot-cigarette-stick,
.slender-matrix .cig-filter-slot.front-row-slot .slot-cigarette-stick {
  height: 68rpx;
}

.cigar-matrix .cig-filter-slot.cigar-row-slot .slot-cigarette-stick {
  height: 132rpx;
}

.standard-matrix .cig-filter-slot.back-row-slot .slot-filter-cylinder,
.slender-matrix .cig-filter-slot.back-row-slot .slot-filter-cylinder {
  height: 38rpx;
}

.standard-matrix .cig-filter-slot.front-row-slot .slot-filter-cylinder,
.slender-matrix .cig-filter-slot.front-row-slot .slot-filter-cylinder {
  height: 38rpx;
}

.standard-matrix .cig-filter-slot.back-row-slot .slot-paper-cylinder,
.slender-matrix .cig-filter-slot.back-row-slot .slot-paper-cylinder {
  height: 86rpx;
}

.standard-matrix .cig-filter-slot.front-row-slot .slot-paper-cylinder,
.slender-matrix .cig-filter-slot.front-row-slot .slot-paper-cylinder {
  height: 30rpx;
}

.cigar-matrix .cig-filter-slot.cigar-row-slot .slot-paper-cylinder {
  height: 82rpx;
}

.standard-matrix .cig-filter-slot.back-row-slot .slot-hanyan-stick,
.slender-matrix .cig-filter-slot.back-row-slot .slot-hanyan-stick {
  height: 124rpx;
}

.standard-matrix .cig-filter-slot.front-row-slot .slot-hanyan-stick,
.slender-matrix .cig-filter-slot.front-row-slot .slot-hanyan-stick {
  height: 68rpx;
}

.standard-matrix .cig-filter-slot.back-row-slot:active,
.slender-matrix .cig-filter-slot.back-row-slot:active {
  transform: translateY(-8rpx);
}

.standard-matrix .cig-filter-slot.front-row-slot:active,
.slender-matrix .cig-filter-slot.front-row-slot:active {
  transform: translateY(-8rpx);
}

.standard-matrix .cig-filter-slot.back-row-slot.slot-pulled-out,
.slender-matrix .cig-filter-slot.back-row-slot.slot-pulled-out {
  transform: translateY(-68rpx);
  transition: transform 1.1s cubic-bezier(0.18, 0.89, 0.32, 1.15);
  filter: drop-shadow(0 0 14rpx rgba(251, 191, 36, 0.85));
}

.standard-matrix .cig-filter-slot.front-row-slot.slot-pulled-out,
.slender-matrix .cig-filter-slot.front-row-slot.slot-pulled-out {
  transform: translateY(-68rpx);
  transition: transform 1.1s cubic-bezier(0.18, 0.89, 0.32, 1.15);
  filter: drop-shadow(0 0 14rpx rgba(251, 191, 36, 0.85));
}

/* 槽位内部完整烟支微缩模型 */
.slot-cigarette-stick {
  width: 100%;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 立体圆柱水松纸过滤嘴 (高定物理光影：左右曲面深影、左偏中央高光流线) */
.slot-filter-cylinder {
  width: 100%;
  height: 50rpx;
  border-radius: 6rpx 6rpx 0 0;
  position: relative;
  background-image: linear-gradient(
    90deg,
    rgba(0, 0, 0, 0.46) 0%,
    rgba(255, 255, 255, 0.22) 24%,
    rgba(255, 255, 255, 0.48) 36%,
    rgba(255, 255, 255, 0.08) 62%,
    rgba(0, 0, 0, 0.48) 100%
  );
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.6), inset 0 1rpx 2rpx rgba(255, 255, 255, 0.55);
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
  z-index: 2;
}

/* 下方延伸白色烟身纸管（真烟罗纹水纹质感，两排上下错落露出真实烟身） */
.slot-paper-cylinder {
  width: 100%;
  border-radius: 0;
  background-image: linear-gradient(
    90deg,
    rgba(0, 0, 0, 0.32) 0%,
    rgba(255, 255, 255, 0.62) 24%,
    rgba(255, 255, 255, 0.88) 36%,
    rgba(255, 255, 255, 0.12) 64%,
    rgba(0, 0, 0, 0.36) 100%
  );
  position: relative;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1;
  box-shadow: 0 3rpx 8rpx rgba(0, 0, 0, 0.5);
}

/* 真实卷烟纸防伪横纹罗纹 */
.slot-paper-ribbing {
  position: absolute;
  inset: 0;
  background-image: repeating-linear-gradient(
    0deg,
    rgba(0, 0, 0, 0.08) 0px,
    rgba(0, 0, 0, 0.08) 1.5px,
    transparent 1.5px,
    transparent 6px
  );
}

/* 老辈白纸手卷旱烟槽位：通体一体式纯白手卷纸喇叭筒，齐平金黄烟丝切口 + 作业本微蓝横线，无独立过滤嘴 */
.slot-hanyan-stick {
  width: 100%;
  height: 104rpx;
  background-color: #faf8f2;
  background-image:
    repeating-linear-gradient(
      184deg,
      transparent 0rpx,
      transparent 16rpx,
      rgba(59, 130, 246, 0.24) 16rpx,
      rgba(59, 130, 246, 0.24) 17.5rpx
    ),
    linear-gradient(90deg, #d6d1c4 0%, #faf8f2 24%, #ffffff 48%, #faf8f2 75%, #c8c2b5 100%);
  clip-path: polygon(8% 0, 92% 0, 72% 100%, 28% 100%);
  -webkit-clip-path: polygon(8% 0, 92% 0, 72% 100%, 28% 100%);
  border-radius: 4rpx 4rpx 0 0;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.45);
  position: relative;
  overflow: hidden;
}

.slot-hanyan-top {
  position: absolute;
  top: 0;
  left: 6%;
  right: 6%;
  height: 7rpx;
  background: radial-gradient(ellipse at 50% 50%, #451a03 0%, #78350f 55%, #b45309 85%, #faf8f2 100%);
  border-bottom: 1.5rpx solid #fcfbf7;
  border-radius: 50%;
}

.slot-hanyan-body {
  position: absolute;
  top: 24rpx;
  width: 100%;
  height: 1.5rpx;
  background: rgba(168, 162, 158, 0.48);
  transform: rotate(22deg);
}

/* 顶部圆形烟嘴 3D 截面（真实醋酸纤维棉芯同心圆纹理 + 外圈水松纸包边） */
.filter-top-bevel {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 8rpx;
  border-radius: 50%;
  background: radial-gradient(
    ellipse at 50% 50%,
    #ffffff 0%,
    #f8fafc 38%,
    #cbd5e1 70%,
    #64748b 100%
  );
  border: 1rpx solid rgba(255, 255, 255, 0.65);
  box-shadow: inset 0 1rpx 2rpx rgba(0, 0, 0, 0.35);
  box-sizing: border-box;
}

/* 滤嘴高定双道烫金箍环 */
.filter-mini-band {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: linear-gradient(90deg, #b45309 0%, #fef08a 32%, #fbbf24 64%, #92400e 100%);
  box-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.55), inset 0 1rpx 1rpx rgba(255, 255, 255, 0.7);
}

.filter-bead-spark {
  width: 9rpx;
  height: 9rpx;
  border-radius: 50%;
  position: absolute;
  top: 42%;
  border: 1.5rpx solid rgba(255, 255, 255, 0.95);
  box-shadow: 0 0 0 2rpx rgba(9, 13, 22, 0.75), 0 0 8rpx rgba(255, 255, 255, 0.85);
  box-sizing: border-box;
  animation: pulse-bead-spark 2s infinite ease-in-out;
}

@keyframes pulse-bead-spark {
  0%, 100% { opacity: 0.88; transform: scale(0.95); }
  50% { opacity: 1; transform: scale(1.18); }
}

/* 被抽走烟支后的独立空槽（柔和半透明虚化印记，自然融入烟壳底色，不生硬突兀） */
.slot-empty-groove {
  width: 100%;
  height: 100%;
  border-radius: 6rpx 6rpx 2rpx 2rpx;
  background: linear-gradient(
    90deg,
    rgba(0, 0, 0, 0.16) 0%,
    rgba(255, 255, 255, 0.04) 50%,
    rgba(0, 0, 0, 0.18) 100%
  );
  border-left: 1rpx solid rgba(255, 255, 255, 0.06);
  border-right: 1rpx solid rgba(0, 0, 0, 0.14);
  box-shadow: inset 0 4rpx 8rpx rgba(0, 0, 0, 0.22);
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
  opacity: 0.38;
  filter: blur(0.6rpx);
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
}

.empty-socket-rim {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 8rpx;
  border-radius: 50%;
  background: radial-gradient(ellipse at center, rgba(0, 0, 0, 0.25) 0%, rgba(255, 255, 255, 0.05) 100%);
  border: 1rpx dashed rgba(255, 255, 255, 0.22);
  box-sizing: border-box;
}

.empty-shadow {
  position: absolute;
  top: 8rpx;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.18) 0%, transparent 100%);
}


/* ==================== 3D 翻盖盒盖 (Flip-Top Lid) ==================== */
.pack-flip-lid {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  width: 360rpx;
  height: var(--lid-h, 168rpx);
  z-index: 35;
  opacity: 1 !important;
  isolation: isolate;
  overflow: hidden;
  transform-origin: 50% 100%;
  transform-style: flat;
  -webkit-transform-style: flat;
  backface-visibility: visible;
  -webkit-backface-visibility: visible;
  transform: perspective(1400px) translateY(0) rotateX(0deg) scaleX(1);
  transition: transform 1.12s cubic-bezier(0.25, 0.9, 0.3, 1), box-shadow 1.12s ease;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.45);
  box-sizing: border-box;
  background-color: #161b26;
  background-image: var(--lid-grad, linear-gradient(180deg, #991b1b, #7f1d1d));
  border-radius: 12rpx 12rpx 0 0;
}

/* 盒盖打开状态：保持恒定 168rpx 高度与前向层级 (z-index: 35)，底沿平滑抬升至 42rpx 严密压住 40rpx 内胆顶边，彻底杜绝任何瞬间透明断层或穿模 */
.pack-box-wrapper.lid-open .pack-flip-lid {
  z-index: 35;
  opacity: 1 !important;
  transform-origin: 50% 100%;
  transform: perspective(1400px) translateY(-126rpx) rotateX(36deg) scaleX(1.015);
  box-shadow: 0 -12rpx 24rpx rgba(0, 0, 0, 0.65);
  pointer-events: auto;
  cursor: pointer;
  transition: transform 1.12s cubic-bezier(0.25, 0.9, 0.3, 1), box-shadow 1.12s ease;
}

/* 当点选香烟向上拔升飞出时，盒盖退至后方，绝不遮挡飞出的香烟 */
.pack-box-wrapper.pulling-animation .pack-flip-lid {
  z-index: 4;
}

/* 盒盖打开时的顶部热区扩展，方便手指在朝上后仰的烟盖区域轻松点击合盖 */
.pack-box-wrapper.lid-open .pack-flip-lid::before {
  content: '';
  position: absolute;
  top: -50rpx;
  left: -20rpx;
  right: -20rpx;
  bottom: 0;
  z-index: 40;
  pointer-events: auto;
}

.lid-face-outer {
  position: absolute;
  inset: 0;
  z-index: 2;
  background-color: #161b26;
  background-image: var(--lid-grad, linear-gradient(180deg, #991b1b, #7f1d1d));
