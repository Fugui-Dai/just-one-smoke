  inset: 0;
  border: 2rpx solid #f59e0b;
  border-radius: 12rpx;
  background: rgba(18, 16, 14, 0.85);
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 0 6rpx;
}

.niulai-sprocket-dot {
  width: 8rpx;
  height: 12rpx;
  background: #fde047;
  border-radius: 2rpx;
}

.niulai-bull-horns-vector {
  position: relative;
  z-index: 2;
  width: 54rpx;
  height: 44rpx;
  background: linear-gradient(135deg, #fef08a 0%, #f59e0b 50%, #b45309 100%);
  clip-path: polygon(0 20%, 25% 0, 40% 40%, 50% 10%, 60% 40%, 75% 0, 100% 20%, 65% 80%, 50% 100%, 35% 80%);
  box-shadow: 0 0 14rpx rgba(245, 158, 11, 0.7);
}

.niulai-font {
  color: #fef08a !important;
  text-shadow: 0 0 16rpx rgba(245, 158, 11, 0.85), 0 2rpx 6rpx #000;
  font-size: 42rpx !important;
  font-weight: 900 !important;
  letter-spacing: 8rpx !important;
}

.niulai-gold-seal {
  background: linear-gradient(135deg, #b45309, #78350f);
  color: #fef08a;
  border: 1rpx solid #fbbf24;
  border-radius: 4rpx;
  font-size: 16rpx;
  font-weight: 700;
  padding: 2rpx 14rpx;
  letter-spacing: 3rpx;
  margin-top: 6rpx;
}

/* 底部官方健康警示框 (真实两段式标准) */
.pack-warning-banner {
  background: rgba(0, 0, 0, 0.65);
  border: 1px solid rgba(255, 255, 255, 0.25);
  border-radius: 8rpx;
  padding: 8rpx 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: inset 0 1rpx 3rpx rgba(0, 0, 0, 0.6);
}

.warning-company-header {
  font-size: 16rpx;
  font-weight: 700;
  color: #cbd5e1;
  letter-spacing: 2rpx;
  margin-bottom: 2rpx;
}

.warning-line {
  font-size: 18rpx;
  font-weight: 700;
  color: #f8fafc;
  letter-spacing: 1rpx;
  text-align: center;
}

.tar-spec-line {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-top: 4rpx;
}

.spec-tag {
  font-size: 14rpx;
  color: #94a3b8;
}

.spec-dot-divider {
  font-size: 14rpx;
  color: #64748b;
}

/* 锁定磨砂遮罩 */
.pack-locked-overlay {
  position: absolute;
  inset: 0;
  background: rgba(10, 14, 22, 0.82);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 25;
}

.lock-shield-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 24rpx;
}

.lock-shield-icon {
  font-size: 52rpx;
  margin-bottom: 8rpx;
}

.lock-shield-title {
  font-size: 26rpx;
  font-weight: 800;
  color: #f8fafc;
  margin-bottom: 6rpx;
}

.lock-shield-desc {
  font-size: 20rpx;
  color: #f87171;
}


/* ==================== 抽出一支烟的飞升动画 (Pulled Cigarette) ==================== */
.pulled-cigarette-flight {
  position: absolute;
  top: 60rpx;
  left: 50%;
  transform: translateX(-50%) translateY(50rpx) scale(0.95);
  width: var(--flight-w, 26rpx);
  height: var(--flight-h, 360rpx);
  z-index: 40;
  display: flex;
  flex-direction: column;
  pointer-events: none;
  opacity: 0;
  /* 优雅抽吸升空：1.1s 极速丝滑平移，顶部停留在安全美学高度，绝不碰触上方文字 */
  transition: transform 1.1s cubic-bezier(0.18, 0.89, 0.32, 1.15), opacity 0.25s ease, filter 1.1s ease;
}

.pulled-cigarette-flight.in-flight {
  opacity: 1;
  transform: translateX(-50%) translateY(-135rpx) rotate(-1.5deg) scale(1.06);
  filter: drop-shadow(0 16rpx 36rpx rgba(245, 158, 11, 0.65));
}

/* 顶部过滤嘴（真实人体工学抽烟拿取部位，朝上） */
.flight-cig-filter {
  height: var(--filter-h, 90rpx);
  background: var(--filter-bg, #b45309);
  border-radius: 6rpx 6rpx 0 0;
  position: relative;
  box-shadow: inset 0 3rpx 6rpx rgba(255, 255, 255, 0.4), inset 2rpx 0 4rpx rgba(0, 0, 0, 0.25);
  flex-shrink: 0;
}

.flight-filter-bevel {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 8rpx;
  background: rgba(255, 255, 255, 0.45);
  border-radius: 50% 50% 0 0;
}

.flight-filter-band {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 8rpx;
  background: var(--band-bg, #f59e0b);
  box-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.4);
}

.flight-bead-dot {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  box-shadow: 0 0 10rpx currentColor;
  animation: pulse-bead-spark 1.8s infinite ease-in-out;
}

/* 下方修长白色卷烟纸身（延伸至烟盒深处，带真实罗纹水印） */
.flight-cig-paper {
  flex: 1;
  background: var(--paper-bg, #fffdf5);
  border-radius: 0 0 4rpx 4rpx;
  box-shadow: inset 2rpx 0 4rpx rgba(0, 0, 0, 0.12);
  position: relative;
  background-image: repeating-linear-gradient(
    0deg,
    rgba(0, 0, 0, 0.04) 0px,
    rgba(0, 0, 0, 0.04) 1px,
    transparent 1px,
    transparent 6px
  );
}

.flight-cig-bottom-tobacco {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: linear-gradient(90deg, #451a03 0%, #78350f 50%, #451a03 100%);
  border-radius: 0 0 4rpx 4rpx;
}

/* 老辈白纸手卷旱烟：通体纯白一体化喇叭筒圆锥模型（100% 还原一整张白纸，绝无分截烟嘴） */
.flight-hanyan-seamless-cone {
  width: 36rpx;
  height: 250rpx;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.flight-hanyan-tobacco-head {
  width: 36rpx;
  height: 22rpx;
  position: relative;
  display: flex;
  justify-content: center;
}

.hanyan-loose-strand {
  position: absolute;
  width: 4rpx;
  background: #d97706;
  border-radius: 2rpx;
}

.hanyan-loose-strand.s1 {
  height: 16rpx;
  left: 6rpx;
  top: -8rpx;
  transform: rotate(-15deg);
  background: #f59e0b;
}

.hanyan-loose-strand.s2 {
  height: 20rpx;
  left: 16rpx;
  top: -12rpx;
  transform: rotate(4deg);
  background: #b45309;
}

.hanyan-loose-strand.s3 {
  height: 15rpx;
  right: 6rpx;
  top: -6rpx;
  transform: rotate(20deg);
  background: #78350f;
}

/* 一体成型纯白手卷圆锥纸身：上宽下尖，一气呵成 */
.flight-hanyan-paper-body {
  width: 100%;
  flex: 1;
  background: linear-gradient(90deg, #dfdacd 0%, #faf8f2 22%, #ffffff 50%, #faf8f2 78%, #d5cfc0 100%);
  clip-path: polygon(0 0, 100% 0, 62% 100%, 38% 100%);
  -webkit-clip-path: polygon(0 0, 100% 0, 62% 100%, 38% 100%);
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.35);
}

.flight-hanyan-seam {
  position: absolute;
  top: 26rpx;
  width: 100%;
  height: 2rpx;
  background: rgba(168, 162, 158, 0.55);
  transform: rotate(22deg);
}

.flight-hanyan-stamp {
  font-size: 13rpx;
  font-weight: 800;
  color: rgba(185, 28, 28, 0.72);
  writing-mode: vertical-lr;
  letter-spacing: 2rpx;
}

.flight-hanyan-pinched-tip {
  position: absolute;
  bottom: 0;
  width: 100%;
  height: 6rpx;
  background: rgba(214, 211, 209, 0.6);
}

.flight-sparks {
  position: absolute;
  inset: 0;
}
.spark-dot {
  position: absolute;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #ffbe3b;
  box-shadow: 0 0 10rpx #ffbe3b;
  animation: spark-fly 0.6s infinite ease-out;
}
.s1 { top: 20%; left: -16rpx; }
.s2 { top: 60%; right: -16rpx; animation-delay: 0.2s; }
.s3 { top: 80%; left: -10rpx; animation-delay: 0.4s; }

@keyframes spark-fly {
  0% { transform: scale(1); opacity: 1; }
  100% { transform: scale(0) translate(10rpx, -20rpx); opacity: 0; }
}


/* 烟盒下方专属品牌经典标语 (浪漫诗笺风格) */
.pack-slogan-card {
  margin-top: 28rpx;
  max-width: 90%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 20;
}

.slogan-ribbon {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  background: linear-gradient(135deg, rgba(245, 158, 11, 0.14) 0%, rgba(15, 23, 42, 0.88) 50%, rgba(245, 158, 11, 0.10) 100%);
  border: 1px solid rgba(251, 191, 36, 0.35);
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.55);
  border-radius: 999rpx;
  padding: 12rpx 32rpx;
  animation: fadeInSlogan 0.35s ease;
}

.slogan-quote {
  font-size: 26rpx;
  color: #fbbf24;
  font-weight: 900;
  line-height: 1;
}

.slogan-text {
  font-size: 22rpx;
  color: #fef08a;
  font-weight: 700;
  letter-spacing: 2.5rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.8);
  text-align: center;
}

@keyframes fadeInSlogan {
  from { opacity: 0; transform: translateY(12rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* 底部操作提示标签 */
.pack-interaction-hint {
  margin-top: 18rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.12);
  padding: 8rpx 26rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  position: relative;
  z-index: 20;
}
.hint-icon { font-size: 20rpx; }
.hint-text { font-size: 20rpx; color: #cbd5e1; font-weight: 500; letter-spacing: 1rpx; }


/* ==================== 5. 底部立体选烟操作区 (Bottom Dock) ==================== */
.pack-bottom-dock {
  background: rgba(14, 18, 28, 0.92);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border-top: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 36rpx 36rpx 0 0;
  padding: 20rpx 24rpx;
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom, 0px));
  box-sizing: border-box;
}

.brand-scroll-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.scroll-heading {
  font-size: 24rpx;
  font-weight: 700;
  color: #e2e8f0;
}

.scroll-count-tag {
  font-size: 18rpx;
  color: #94a3b8;
}

/* 品牌横滑预览栏 */
.brand-coverflow-scroll {
  white-space: nowrap;
  display: flex;
  gap: 16rpx;
  padding-bottom: 16rpx;
}

.brand-card-item {
  display: inline-flex;
  align-items: center;
  gap: 14rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.1);
  padding: 12rpx 18rpx;
  border-radius: 20rpx;
  transition: all 0.2s ease;
  flex-shrink: 0;
}

.brand-card-item.is-active-brand {
  background: rgba(245, 158, 11, 0.16);
  border-color: #f59e0b;
  box-shadow: 0 0 16rpx rgba(245, 158, 11, 0.35);
}

.brand-card-item.is-locked-brand {
  opacity: 0.55;
}

.mini-pack-preview {
  width: 36rpx;
  height: 52rpx;
  border-radius: 6rpx;
  position: relative;
  overflow: hidden;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
}

.mini-lid {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 14rpx;
  border-bottom: 1px solid rgba(255, 255, 255, 0.2);
}

.mini-logo-text {
  font-size: 12rpx;
  font-weight: 900;
  color: #ffffff;
}

.mini-meta-block {
  display: flex;
  flex-direction: column;
}

.mini-brand-name {
  font-size: 22rpx;
  font-weight: 700;
  color: #f8fafc;
}

.mini-bottom-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 4rpx;
}

.mini-price {
  font-size: 18rpx;
  font-weight: 700;
  color: #fbbf24;
}

.mini-active-status {
  font-size: 16rpx;
  color: #34d399;
}

.mini-lock-status {
  font-size: 16rpx;
  color: #ef4444;
}

/* 核心操作三连键 */
.action-buttons-row {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
}

.action-btn-card {
  flex: 1;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 24rpx;
  padding: 16rpx 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  transition: all 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.action-btn-card:active {
  filter: brightness(1.08);
}

.btn-icon {
  font-size: 36rpx;
}

.btn-text-wrap {
  display: flex;
  flex-direction: column;
}

.btn-main-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #f8fafc;
}

.btn-sub-note {
  font-size: 18rpx;
  color: #94a3b8;
  margin-top: 2rpx;
}

/* 核心抽烟大按键 (单一大按键全宽华丽排版) */
.action-btn-card.pull-btn {
  flex: 1;
  width: 100%;
  padding: 22rpx 32rpx;
  background: linear-gradient(135deg, #d97706 0%, #f59e0b 100%);
  border-color: #fde047;
  border-radius: 32rpx;
  box-shadow: 0 10rpx 28rpx rgba(245, 158, 11, 0.45);
}

.action-btn-card.pull-btn .btn-icon {
  font-size: 42rpx;
}

.action-btn-card.pull-btn .btn-main-title {
  color: #0b0f19;
  font-size: 30rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
}

.action-btn-card.pull-btn .btn-sub-note {
  color: #451a03;
  font-size: 20rpx;
  font-weight: 700;
  margin-top: 2rpx;
}

.action-btn-card.btn-disabled {
  opacity: 0.5;
  filter: grayscale(1);
}


/* ==================== 6. 取烟成功装配弹窗 (Modal) ==================== */
.glass-modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 150;
  background: rgba(0, 0, 0, 0.78);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 36rpx;
  box-sizing: border-box;
}

.drawn-confirm-card {
  width: 100%;
  max-width: 620rpx;
  background: linear-gradient(145deg, #1e2538 0%, #0d121f 100%);
  border: 1px solid rgba(245, 158, 11, 0.35);
  border-radius: 36rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.85);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  box-sizing: border-box;
}

.drawn-badge-glow {
  font-size: 64rpx;
  margin-bottom: 10rpx;
}

.drawn-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #f8fafc;
  margin-bottom: 8rpx;
}

.drawn-subtitle {
  font-size: 22rpx;
  color: #94a3b8;
  margin-bottom: 28rpx;
}

.drawn-preview-box {
  width: 100%;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 24rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 30rpx;
  box-sizing: border-box;
}

.preview-cig-cylinder {
  width: 24rpx;
  height: 120rpx;
  border-radius: 6rpx;
  position: relative;
  overflow: hidden;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.45);
  flex-shrink: 0;
}

.preview-filter {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 36rpx;
}

.preview-band {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
}

.preview-bead {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
}

.preview-meta {
  flex: 1;
  text-align: left;
  display: flex;
  flex-direction: column;
}

.pm-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #f8fafc;
  margin-bottom: 4rpx;
}

.pm-spec {
  font-size: 20rpx;
  color: #fbbf24;
  margin-bottom: 4rpx;
}

.pm-note {
  font-size: 18rpx;
  color: #94a3b8;
}

.drawn-actions-stack {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.primary-smoke-btn {
  width: 100%;
  background: linear-gradient(90deg, #d97706 0%, #f59e0b 100%);
  color: #0b0f19;
  font-size: 28rpx;
  font-weight: 800;
  border-radius: 36rpx;
  padding: 20rpx 0;
  line-height: 1.4;
  border: none;
}

.secondary-stay-btn {
  width: 100%;
  background: rgba(255, 255, 255, 0.08);
  color: #cbd5e1;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 36rpx;
  padding: 16rpx 0;
  line-height: 1.4;
  border: 1px solid rgba(255, 255, 255, 0.1);
}

/* ==================== 8. 模式切换胶囊 (货架全景 vs 3D翻盖) ==================== */
.mode-switch-capsule {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 32rpx;
  padding: 4rpx;
  gap: 4rpx;
}

.mode-capsule-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 16rpx;
  border-radius: 26rpx;
  font-size: 20rpx;
  color: #94a3b8;
  transition: all 0.25s ease;
}

.mode-capsule-item.active-mode {
  background: linear-gradient(90deg, #d97706 0%, #f59e0b 100%);
  color: #0b0f19;
  font-weight: 700;
  box-shadow: 0 2rpx 8rpx rgba(245, 158, 11, 0.35);
}

.mc-icon {
  font-size: 22rpx;
}

.mc-text {
  font-size: 20rpx;
}

/* ==================== 9. 名烟精品陈列货架视图 (The Shelf Showcase) ==================== */
.shelf-view-scroll {
  width: 100%;
  height: 100vh;
  box-sizing: border-box;
}

.shelf-content-container {
  padding: 16rpx 16rpx 160rpx 16rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.shelf-banner-card {
  width: 100%;
  background: linear-gradient(135deg, rgba(30, 41, 59, 0.7) 0%, rgba(15, 23, 42, 0.9) 100%);
  border: 1px solid rgba(251, 191, 36, 0.25);
  border-radius: 28rpx;
  padding: 24rpx 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-sizing: border-box;
}

.s-banner-badge {
  font-size: 18rpx;
  color: #fbbf24;
  font-weight: 700;
  letter-spacing: 1rpx;
  margin-bottom: 6rpx;
}

.s-banner-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #f8fafc;
  display: block;
}

.s-banner-sub {
  font-size: 20rpx;
  color: #94a3b8;
  margin-top: 4rpx;
  display: block;
}

.s-banner-count {
  background: rgba(251, 191, 36, 0.12);
  border: 1px solid rgba(251, 191, 36, 0.3);
  border-radius: 20rpx;
  padding: 12rpx 20rpx;
  text-align: center;
}

.s-count-num {
  font-size: 34rpx;
  font-weight: 800;
  color: #fbbf24;
  display: block;
  line-height: 1;
