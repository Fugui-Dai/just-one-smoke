/* ---------- 5. 主角名烟【宝刀出鞘 · 游龙360°挽剑花 · 3D剑气星轨环绕】模型 ---------- */
.ssr-hero-cigarette-stage {
  position: relative;
  z-index: 15;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transform: translate3d(var(--slot-offset-x, 0rpx), 100rpx, 0) scale(0.46) rotate(0deg);
  will-change: transform, opacity;
}

.ssr-awaken-overlay.ssr-active .ssr-hero-cigarette-stage {
  animation: ssrHeroArcFlight 1.62s cubic-bezier(0.22, 1, 0.36, 1) forwards;
}

/* 九天游龙 · 御剑惊鸿 720° 无尽星河莫比乌斯大回环关键帧：
   拔剑冲霄 -> 右上九天满月回旋 -> 对角极速横斩贴镜掠至左下 -> 右下盘龙逆升 -> 720°双周挽剑花归宗定格 (742deg = 720° + 22°黄金斜角) */
@keyframes ssrHeroArcFlight {
  0% {
    opacity: 0.96;
    transform: translate3d(var(--slot-offset-x, 0rpx), 110rpx, 0) scale(0.44) rotate(0deg);
  }
  /* 第一幕：破匣拔剑 · 冲霄直上左上星穹 */
  14% {
    opacity: 1;
    transform: translate3d(-110rpx, -245rpx, 0) scale(0.68) rotate(-42deg);
  }
  /* 第二幕：九天揽月 · 右上天顶满月大回旋 */
  30% {
    opacity: 1;
    transform: translate3d(235rpx, -145rpx, 0) scale(0.88) rotate(165deg);
  }
  /* 第三幕：御剑横空 · 对角极速斜劈横穿屏幕中心，直掠左下极近景贴镜放大 (1.48x 巨物感) */
  54% {
    opacity: 1;
    transform: translate3d(-225rpx, 115rpx, 0) scale(1.48) rotate(395deg);
  }
  /* 第四幕：盘龙逆升 · 下方横掠至右下回环腾起 */
  74% {
    opacity: 1;
    transform: translate3d(165rpx, 42rpx, 0) scale(1.28) rotate(585deg);
  }
  /* 第五幕：万剑归宗 · 720° 双周满旋冲入中央焦点并带物理弹性顿帧过冲 */
  88% {
    opacity: 1;
    transform: translate3d(-12rpx, -54rpx, 0) scale(1.26) rotate(750deg);
  }
  95% {
    opacity: 1;
    transform: translate3d(4rpx, -41rpx, 0) scale(1.16) rotate(739deg);
  }
  100% {
    opacity: 1;
    transform: translate3d(0rpx, -44rpx, 0) scale(1.18) rotate(742deg);
  }
}

/* 破鞘与飞行阶段：尾部剑气推进尾焰 (在定格前 1.28s 完全消散隐藏，绝不污染烟支底端) */
.ssr-tail-thruster-plume {
