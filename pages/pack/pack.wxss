/* ==========================================================================
   🏆 腾讯游戏 CG / UE5 级：6阶名烟拔升 + 2D/3D S型弧线插值 + 银河星云粒子拖尾
   01 [竖壳静置] -> 02 [点击触发] -> 03 [拔升腾空] -> 04 [破空盘旋] -> 05 [弧线放大] -> 06 [屏幕呈现]
   ========================================================================== */

/* ==========================================================================
   🏆 腾讯获奖级：浪漫创意双聚光灯系统 (Volumetric Dual Spotlights & Tyndall Motes)
   ========================================================================== */
.pack-spotlight-rig {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  overflow: visible;
  z-index: 2;
}

/* 1. 穹顶赛博流金光学翼轨 (Cyber-Gold Optical Wing Bar) */
.spotlight-luminaire-bar {
  position: absolute;
  top: -4rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 460rpx;
  height: 4rpx;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(56, 189, 248, 0.55) 14%,
    #fbbf24 34%,
    #ffffff 50%,
    #fbbf24 66%,
    rgba(56, 189, 248, 0.55) 86%,
    transparent 100%
  );
  border-radius: 999rpx;
  box-shadow: 0 0 16rpx #fbbf24, 0 0 32rpx rgba(56, 189, 248, 0.75);
}

/* 2. 电影级宽银幕变形拉丝光刃 (Anamorphic Horizontal Streak) */
.spotlight-anamorphic-streak {
  position: absolute;
  top: -3rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 680rpx;
  height: 2.5rpx;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(56, 189, 248, 0.45) 15%,
    rgba(254, 240, 138, 0.92) 38%,
    #ffffff 50%,
    rgba(254, 240, 138, 0.92) 62%,
    rgba(56, 189, 248, 0.45) 85%,
    transparent 100%
  );
  box-shadow: 0 0 20rpx #fef08a, 0 0 40rpx #38bdf8;
  animation: anamorphicStreakBreathe 4.2s ease-in-out infinite alternate;
}

@keyframes anamorphicStreakBreathe {
  0% { opacity: 0.68; transform: translateX(-50%) scaleX(0.86); }
  100% { opacity: 1.0; transform: translateX(-50%) scaleX(1.08); }
}

/* 3. 天顶中心八芒星钻石主灯核 */
.spotlight-crown-star {
  position: absolute;
  top: -20rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 32rpx;
  color: #ffffff;
  text-shadow: 0 0 12rpx #ffffff, 0 0 24rpx #fef08a, 0 0 44rpx #38bdf8;
  animation: crownStarTwinkle 3.2s ease-in-out infinite alternate;
}

@keyframes crownStarTwinkle {
  0% { opacity: 0.75; transform: translateX(-50%) scale(0.88); }
  100% { opacity: 1.0; transform: translateX(-50%) scale(1.22); }
}

/* 4. 天顶三联光学灯头 (Top Optical Emitters) */
.spotlight-emitter {
  position: absolute;
  top: -10rpx;
  border-radius: 50%;
  pointer-events: none;
}

.spotlight-emitter.emitter-left {
  left: 24%;
  width: 96rpx;
  height: 20rpx;
  background: radial-gradient(ellipse at center, #ffffff 0%, #38bdf8 45%, rgba(251, 191, 36, 0.4) 75%, transparent 100%);
  box-shadow: 0 0 22rpx #38bdf8, 0 0 38rpx rgba(251, 191, 36, 0.6);
  filter: blur(2px);
  animation: spotlightEmitterPulse 4.5s ease-in-out infinite alternate;
}

.spotlight-emitter.emitter-right {
  right: 24%;
  width: 96rpx;
  height: 20rpx;
  background: radial-gradient(ellipse at center, #ffffff 0%, #38bdf8 45%, rgba(251, 191, 36, 0.4) 75%, transparent 100%);
  box-shadow: 0 0 22rpx #38bdf8, 0 0 38rpx rgba(251, 191, 36, 0.6);
  filter: blur(2px);
  animation: spotlightEmitterPulse 4.5s ease-in-out 1.2s infinite alternate;
}

.spotlight-emitter.emitter-center {
  left: 50%;
  transform: translateX(-50%);
  top: -14rpx;
  width: 220rpx;
  height: 32rpx;
  background: radial-gradient(ellipse at center, #ffffff 0%, #fef08a 42%, rgba(56, 189, 248, 0.38) 72%, transparent 100%);
  box-shadow: 0 0 36rpx #fef08a, 0 0 56rpx rgba(56, 189, 248, 0.55);
  filter: blur(3px);
}

@keyframes spotlightEmitterPulse {
  0% { opacity: 0.72; transform: scaleX(0.90); }
  100% { opacity: 1.0; transform: scaleX(1.12); }
}

/* 5. 扇形辐射丁达尔神光射线簇 (Multi-Ray Conic God-Ray Fan - 自天顶呈扇形精准照亮烟壳上部) */
.spotlight-godray-fan {
  position: absolute;
  top: -4rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 680rpx;
  height: 540rpx;
  background: repeating-conic-gradient(
    from 144deg at 50% 0%,
    transparent 0deg 3.2deg,
    rgba(254, 240, 138, 0.24) 4.4deg,
    rgba(255, 255, 255, 0.48) 5.2deg,
    rgba(56, 189, 248, 0.22) 6.0deg,
    transparent 7.2deg 9.6deg
  );
  -webkit-mask-image: radial-gradient(ellipse 62% 85% at 50% 0%, #000 0%, rgba(0, 0, 0, 0.72) 48%, transparent 90%);
  mask-image: radial-gradient(ellipse 62% 85% at 50% 0%, #000 0%, rgba(0, 0, 0, 0.72) 48%, transparent 90%);
  filter: blur(2px);
  mix-blend-mode: screen;
  animation: godrayFanPulse 5.4s ease-in-out infinite alternate;
}

@keyframes godrayFanPulse {
  0% { opacity: 0.68; transform: translateX(-50%) scaleX(0.95); }
  100% { opacity: 0.98; transform: translateX(-50%) scaleX(1.04); }
}

/* 6. 3D 交叉追光光束 (Volumetric Crossing Cones) */
.spotlight-beam {
  position: absolute;
  top: 0;
  pointer-events: none;
  mix-blend-mode: screen;
}

.spotlight-beam.beam-left {
  left: 24%;
  width: 320rpx;
  height: 520rpx;
  transform-origin: top left;
  transform: rotate(16deg);
  clip-path: polygon(12% 0%, 36% 0%, 92% 100%, 8% 100%);
  -webkit-clip-path: polygon(12% 0%, 36% 0%, 92% 100%, 8% 100%);
  background: linear-gradient(
    180deg,
    rgba(255, 255, 255, 0.52) 0%,
    rgba(56, 189, 248, 0.26) 22%,
    rgba(254, 240, 138, 0.16) 52%,
    transparent 92%
  );
  filter: blur(8px);
  animation: spotlightBeamLeftSway 6.5s ease-in-out infinite alternate;
}

.spotlight-beam.beam-right {
  right: 24%;
  width: 320rpx;
  height: 520rpx;
  transform-origin: top right;
  transform: rotate(-16deg);
  clip-path: polygon(64% 0%, 88% 0%, 92% 100%, 8% 100%);
  -webkit-clip-path: polygon(64% 0%, 88% 0%, 92% 100%, 8% 100%);
  background: linear-gradient(
    180deg,
    rgba(255, 255, 255, 0.52) 0%,
    rgba(56, 189, 248, 0.26) 22%,
    rgba(254, 240, 138, 0.16) 52%,
    transparent 92%
  );
  filter: blur(8px);
  animation: spotlightBeamRightSway 6.5s ease-in-out 1.2s infinite alternate;
}

.spotlight-beam.beam-center {
  left: 50%;
  transform: translateX(-50%);
  width: 420rpx;
  height: 480rpx;
  clip-path: polygon(34% 0%, 66% 0%, 94% 100%, 6% 100%);
  -webkit-clip-path: polygon(34% 0%, 66% 0%, 94% 100%, 6% 100%);
  background: linear-gradient(
    180deg,
    rgba(255, 255, 255, 0.45) 0%,
    rgba(254, 240, 138, 0.25) 30%,
    rgba(56, 189, 248, 0.08) 65%,
    transparent 94%
  );
  filter: blur(10px);
  animation: spotlightCenterBreathe 5.2s ease-in-out infinite alternate;
}

/* 7. 双翼锐利赛博流金激光束边 (Sharp Laser Edge Rays) */
.spotlight-laser-edge {
  position: absolute;
  top: -2rpx;
  width: 3rpx;
  height: 440rpx;
  background: linear-gradient(
    180deg,
    #ffffff 0%,
    #fef08a 26%,
    #38bdf8 62%,
    transparent 100%
  );
  box-shadow: 0 0 12rpx #fef08a, 0 0 22rpx #38bdf8;
  transform-origin: top center;
  opacity: 0.78;
}

.spotlight-laser-edge.laser-left {
  left: 50%;
  transform: translateX(-90rpx) rotate(18deg);
  animation: laserLeftScan 5.8s ease-in-out infinite alternate;
}

.spotlight-laser-edge.laser-right {
  left: 50%;
  transform: translateX(90rpx) rotate(-18deg);
  animation: laserRightScan 5.8s ease-in-out infinite alternate;
}

@keyframes laserLeftScan {
  0% { opacity: 0.45; transform: translateX(-82rpx) rotate(15deg); }
  100% { opacity: 0.88; transform: translateX(-106rpx) rotate(21deg); }
}

@keyframes laserRightScan {
  0% { opacity: 0.45; transform: translateX(82rpx) rotate(-15deg); }
  100% { opacity: 0.88; transform: translateX(106rpx) rotate(-21deg); }
}

/* 8. 极光棱镜虹彩光晕层 (Prism Caustic Veil) */
.spotlight-prism-veil {
  position: absolute;
  top: 6rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 380rpx;
  height: 280rpx;
  background: radial-gradient(
    ellipse at 50% 0%,
    rgba(254, 240, 138, 0.28) 0%,
    rgba(56, 189, 248, 0.16) 42%,
    transparent 80%
  );
  filter: blur(12px);
  mix-blend-mode: screen;
  animation: prismVeilFloat 4.8s ease-in-out infinite alternate;
}

@keyframes prismVeilFloat {
  0% { opacity: 0.65; transform: translateX(-50%) scaleX(0.94); }
  100% { opacity: 1.0; transform: translateX(-50%) scaleX(1.06); }
}

@keyframes spotlightBeamLeftSway {
  0% { opacity: 0.68; transform: rotate(13deg) scaleX(0.95); }
  100% { opacity: 0.96; transform: rotate(18deg) scaleX(1.05); }
}

@keyframes spotlightBeamRightSway {
  0% { opacity: 0.68; transform: rotate(-13deg) scaleX(0.95); }
  100% { opacity: 0.96; transform: rotate(-18deg) scaleX(1.05); }
}

@keyframes spotlightCenterBreathe {
  0% { opacity: 0.65; transform: translateX(-50%) scale(0.96); }
  100% { opacity: 0.95; transform: translateX(-50%) scale(1.04); }
}

/* 9. 丁达尔神光悬浮星尘微粒 (Tyndall Stardust Motes) */
.spotlight-motes-field {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
}

.tyndall-mote {
  position: absolute;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 0 12rpx #fef08a, 0 0 24rpx #38bdf8;
  opacity: 0.85;
  animation: tyndallDrift 6.5s ease-in-out infinite alternate;
}

.tyndall-mote.m1  { width: 6rpx; height: 6rpx; top: 10%; left: 34%; animation-duration: 5.2s; animation-delay: 0.2s; }
.tyndall-mote.m2  { width: 7rpx; height: 7rpx; top: 16%; left: 64%; animation-duration: 6.5s; animation-delay: 1.1s; }
.tyndall-mote.m3  { width: 5rpx; height: 5rpx; top: 24%; left: 42%; animation-duration: 4.8s; animation-delay: 2.3s; }
.tyndall-mote.m4  { width: 8rpx; height: 8rpx; top: 30%; left: 58%; animation-duration: 7.2s; animation-delay: 0.7s; }
.tyndall-mote.m5  { width: 5rpx; height: 5rpx; top: 12%; left: 50%; animation-duration: 5.9s; animation-delay: 1.6s; }
.tyndall-mote.m6  { width: 7rpx; height: 7rpx; top: 36%; left: 35%; animation-duration: 6.1s; animation-delay: 1.8s; }
.tyndall-mote.m7  { width: 6rpx; height: 6rpx; top: 40%; left: 62%; animation-duration: 7.6s; animation-delay: 0.9s; }
.tyndall-mote.m8  { width: 8rpx; height: 8rpx; top: 20%; left: 28%; animation-duration: 5.5s; animation-delay: 0.5s; }
.tyndall-mote.m9  { width: 5rpx; height: 5rpx; top: 34%; left: 48%; animation-duration: 6.8s; animation-delay: 1.4s; }
.tyndall-mote.m10 { width: 6rpx; height: 6rpx; top: 44%; left: 53%; animation-duration: 5.4s; animation-delay: 2.1s; }

@keyframes tyndallDrift {
  0% {
    transform: translateY(0) translateX(0) scale(0.8);
    opacity: 0.35;
  }
  50% {
    opacity: 1.0;
    transform: translateY(-24rpx) translateX(10rpx) scale(1.25);
  }
  100% {
    transform: translateY(-48rpx) translateX(-8rpx) scale(0.9);
    opacity: 0.45;
  }
}

/* 10. 聚光灯倾泻在烟盒顶冠与双肩的流光高光 (仅在合盖状态照射盒顶；开盖时盒顶已朝上后仰翻开，自动隐藏不留彩色横条) */
.pack-spotlight-top-crown {
  position: absolute;
  top: -36rpx;
  left: -24rpx;
  right: -24rpx;
  height: 86rpx;
  background: radial-gradient(
    ellipse at 50% 65%,
    rgba(255, 255, 255, 0.42) 0%,
    rgba(254, 240, 138, 0.28) 36%,
    rgba(56, 189, 248, 0.12) 62%,
    transparent 82%
  );
  filter: blur(8px);
  pointer-events: none;
  z-index: 26;
  transition: opacity 0.22s ease;
}

.pack-spotlight-rim-highlight {
  position: absolute;
  top: 0;
  left: 6rpx;
  right: 6rpx;
  height: 4rpx;
  background: linear-gradient(90deg, transparent 0%, #38bdf8 20%, #ffffff 50%, #fef08a 80%, transparent 100%);
  box-shadow: 0 0 12rpx #fef08a, 0 0 20rpx #38bdf8;
  border-radius: 2rpx;
  pointer-events: none;
  z-index: 32;
  transition: opacity 0.22s ease;
}

/* 烟壳左右双肩受光流线 (Shoulder Rim Cascade) */
.pack-shoulder-cascade {
  position: absolute;
  top: 0;
  width: 3rpx;
  height: 220rpx;
  background: linear-gradient(180deg, #ffffff 0%, #fef08a 30%, rgba(56, 189, 248, 0.45) 65%, transparent 100%);
  box-shadow: 0 0 10rpx rgba(254, 240, 138, 0.75);
  pointer-events: none;
  z-index: 32;
  transition: opacity 0.22s ease;
}
.pack-shoulder-cascade.left {
  left: 0;
  border-radius: 12rpx 0 0 0;
}
.pack-shoulder-cascade.right {
  right: 0;
  border-radius: 0 12rpx 0 0;
}

.pack-spotlight-surface-sheen {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(
    180deg,
    rgba(255, 255, 255, 0.22) 0%,
    rgba(254, 240, 138, 0.10) 22%,
    transparent 52%
  );
  border-radius: 12rpx;
  pointer-events: none;
  z-index: 24;
  transition: opacity 0.22s ease;
}

/* 开盖状态下：盒盖已朝上后仰翻开，原 top:0 位置是敞开的烟仓，必须隐藏合盖专用的顶边彩色光线与肩线 */
.pack-box-wrapper.lid-open .pack-spotlight-top-crown,
.pack-box-wrapper.lid-open .pack-spotlight-rim-highlight,
.pack-box-wrapper.lid-open .pack-shoulder-cascade,
.pack-box-wrapper.lid-open .pack-spotlight-surface-sheen {
  opacity: 0 !important;
  visibility: hidden !important;
}

/* 底部圆圈底座与背部圆圈光晕彻底禁用 */
.pack-master-pedestal,
.stage-romantic-halo {
  display: none !important;
}

/* 1. 地面真实环境遮挡软阴影 (Contact Shadow) */
.pedestal-contact-shadow {
  position: absolute;
  top: 56rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 360rpx;
  height: 46rpx;
  border-radius: 50%;
  background: radial-gradient(ellipse at center, rgba(0, 0, 0, 0.95) 0%, rgba(0, 0, 0, 0.65) 55%, transparent 80%);
  filter: blur(8px);
}

/* 2. 聚光灯照射到底面的椭圆柔光水洼光斑 (Spotlight Floor Wash Pool) */
.pedestal-spotlight-pool {
  position: absolute;
  top: 40rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 460rpx;
  height: 106rpx;
  border-radius: 50%;
  background: radial-gradient(
    ellipse at center,
    rgba(254, 243, 199, 0.42) 0%,
    rgba(253, 230, 138, 0.22) 40%,
    rgba(245, 158, 11, 0.08) 68%,
    transparent 82%
  );
  box-shadow: 0 0 42rpx rgba(251, 191, 36, 0.28);
  filter: blur(4px);
  animation: spotlightPoolBreathe 5s ease-in-out infinite alternate;
}

@keyframes spotlightPoolBreathe {
  0% { transform: translateX(-50%) scale(0.96); opacity: 0.85; }
  100% { transform: translateX(-50%) scale(1.04); opacity: 1.0; }
}

/* 3. 黑曜石微晶镜面反射倒影 (Mirror Reflection) */
.pedestal-mirror-reflection {
  position: absolute;
  top: 66rpx;
  left: 50%;
  transform: translateX(-50%) scaleY(-0.32);
  width: 300rpx;
  height: 110rpx;
  background: var(--box-grad, linear-gradient(180deg, #1e293b, #0f172a));
  border-radius: 8rpx;
  opacity: 0.18;
  filter: blur(5px);
  mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.85), transparent);
  -webkit-mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.85), transparent);
}

/* 4. 黑曜石微晶主展盘 (Obsidian Crystal Tier with Chamfered Rim) */
.pedestal-obsidian-tier {
  position: absolute;
  top: 46rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 440rpx;
  height: 104rpx;
  border-radius: 50%;
  background: radial-gradient(ellipse at center, #1e293b 0%, #0f172a 58%, #030712 100%);
  border: 2rpx solid rgba(251, 191, 36, 0.55);
  box-shadow:
    0 16rpx 42rpx rgba(0, 0, 0, 0.95),
    inset 0 3rpx 10rpx rgba(255, 255, 255, 0.4),
    inset 0 -5rpx 16rpx rgba(0, 0, 0, 0.85),
    0 0 28rpx rgba(251, 191, 36, 0.22);
}

.pedestal-tier-bevel {
  position: absolute;
  top: 6rpx;
  left: 8rpx;
  right: 8rpx;
  bottom: 6rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(254, 240, 138, 0.35);
  background: radial-gradient(ellipse at center, rgba(30, 41, 59, 0.6) 0%, rgba(15, 23, 42, 0.9) 100%);
}

.pedestal-tier-surface {
  position: absolute;
  top: 14rpx;
  left: 18rpx;
  right: 18rpx;
  bottom: 14rpx;
  border-radius: 50%;
  background: radial-gradient(ellipse at center, rgba(255, 255, 255, 0.08) 0%, transparent 60%);
}

/* 5. 外层日晷星轨刻度环 (Outer Astrolabe Sundial Orbit - 36s 顺时针微旋) */
.pedestal-astrolabe-orbit {
  position: absolute;
  top: 32rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 500rpx;
  height: 130rpx;
  border-radius: 50%;
  border: 1.5rpx dashed rgba(253, 224, 71, 0.48);
  box-shadow: 0 0 20rpx rgba(251, 191, 36, 0.25);
  animation: astrolabeClockwise 36s linear infinite;
}

.astrolabe-mark {
  position: absolute;
  width: 4rpx;
  height: 10rpx;
  background: #fde047;
  border-radius: 2rpx;
  box-shadow: 0 0 6rpx #fde047;
}

.astrolabe-mark.am-1 { top: -5rpx; left: 50%; margin-left: -2rpx; }
.astrolabe-mark.am-2 { bottom: -5rpx; left: 50%; margin-left: -2rpx; }
.astrolabe-mark.am-3 { top: 50%; left: -2rpx; margin-top: -5rpx; }
.astrolabe-mark.am-4 { top: 50%; right: -2rpx; margin-top: -5rpx; }

.astrolabe-star {
  position: absolute;
  font-size: 16rpx;
  line-height: 1;
  color: #fef08a;
  text-shadow: 0 0 8rpx #f59e0b;
}

.astrolabe-star.as-1 { top: 12%; left: 16%; }
.astrolabe-star.as-2 { top: 12%; right: 16%; }
.astrolabe-star.as-3 { bottom: 12%; left: 16%; }
.astrolabe-star.as-4 { bottom: 12%; right: 16%; }

@keyframes astrolabeClockwise {
  0%   { transform: translateX(-50%) rotate(0deg); }
  100% { transform: translateX(-50%) rotate(360deg); }
}

/* 6. 内层流金天圆符文环 (Inner Runic Gold Orbit - 28s 逆时针微旋) */
.pedestal-runic-orbit {
  position: absolute;
  top: 50rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 400rpx;
  height: 94rpx;
  border-radius: 50%;
  border: 1.5rpx dotted rgba(56, 189, 248, 0.65);
  box-shadow: inset 0 0 16rpx rgba(56, 189, 248, 0.3);
  animation: astrolabeCounterClockwise 28s linear infinite;
}

@keyframes astrolabeCounterClockwise {
  0%   { transform: translateX(-50%) rotate(0deg); }
  100% { transform: translateX(-50%) rotate(-360deg); }
}

/* 7. 悬浮微晶呼吸流光透镜环 (Floating Crystal Rim with Dynamic Glow) */
.pedestal-crystal-lens {
  position: absolute;
  top: 22rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 540rpx;
  height: 152rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  background: radial-gradient(
    ellipse at center,
    transparent 62%,
    rgba(251, 191, 36, 0.08) 82%,
    rgba(255, 255, 255, 0.22) 100%
  );
  box-shadow: 0 0 32rpx rgba(251, 191, 36, 0.32);
  animation: crystalLensBreathe 5.5s ease-in-out infinite alternate;
}

@keyframes crystalLensBreathe {
  0% {
    opacity: 0.72;
    box-shadow: 0 0 24rpx rgba(251, 191, 36, 0.22);
    transform: translateX(-50%) scale(0.97);
  }
  100% {
    opacity: 1.0;
    box-shadow: 0 0 44rpx rgba(251, 191, 36, 0.45);
    transform: translateX(-50%) scale(1.02);
  }
}

/* 8. 抽烟触发时的多重同心能量脉冲波纹 (Launch Ripple Waves) */
.pedestal-ripple-pulse {
  position: absolute;
  top: 52rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 260rpx;
  height: 74rpx;
  border-radius: 50%;
  border: 3rpx solid #38bdf8;
  box-shadow: 0 0 26rpx #38bdf8, inset 0 0 16rpx #fde047;
  opacity: 0;
  pointer-events: none;
}

.pack-master-pedestal.pedestal-rippling .pedestal-ripple-pulse.pr-1,
.pack-master-pedestal.is-rippling .pedestal-ripple-pulse.pr-1 {
  animation: pedestalPulseWaveOut 0.62s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

.pack-master-pedestal.pedestal-rippling .pedestal-ripple-pulse.pr-2,
.pack-master-pedestal.is-rippling .pedestal-ripple-pulse.pr-2 {
  border-color: #fde047;
  box-shadow: 0 0 32rpx #fde047, inset 0 0 20rpx #38bdf8;
  animation: pedestalPulseWaveOut 0.74s cubic-bezier(0.16, 1, 0.3, 1) 0.08s forwards;
}

.pack-master-pedestal.pedestal-rippling .pedestal-ripple-pulse.pr-3,
.pack-master-pedestal.is-rippling .pedestal-ripple-pulse.pr-3 {
  border-color: #22d3ee;
  animation: pedestalPulseWaveOut 0.86s cubic-bezier(0.16, 1, 0.3, 1) 0.16s forwards;
}

@keyframes pedestalPulseWaveOut {
  0% {
    opacity: 1;
    transform: translateX(-50%) scale(0.45);
  }
  70% {
    opacity: 0.85;
  }
  100% {
    opacity: 0;
    transform: translateX(-50%) scale(2.45);
  }
}

/* 保留旧类名兼容占位 */
.pack-ripple-pedestal {
  display: none;
}

/* ---------- Stage 02: 盒内选中烟支发光波纹与垂直拔起动效 ---------- */
.cig-filter-slot.is-slot-launching {
  z-index: 45;
  overflow: visible !important;
}

.slot-launch-fx {
  position: absolute;
  inset: -24rpx -18rpx;
  pointer-events: none;
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: center;
}

.slot-launch-ripple {
  position: absolute;
  bottom: 16rpx;
  width: 44rpx;
  height: 20rpx;
  border-radius: 50%;
  border: 2.5rpx solid #38bdf8;
  box-shadow: 0 0 16rpx #38bdf8, 0 0 24rpx #fde047;
  animation: slotRippleExpand 0.36s ease-out infinite;
}

.slot-launch-ripple.sr-2 {
  border-color: #fde047;
  animation-delay: 0.1s;
}

@keyframes slotRippleExpand {
  0% { opacity: 1; transform: scale(0.5); }
  100% { opacity: 0; transform: scale(2.6); }
}

.slot-launch-beam {
  position: absolute;
  bottom: 0;
  width: 26rpx;
  height: 220rpx;
  background: linear-gradient(180deg, rgba(56, 189, 248, 0) 0%, rgba(56, 189, 248, 0.85) 55%, #ffffff 100%);
  filter: blur(3rpx);
  animation: slotBeamFlash 0.34s ease-out forwards;
}

@keyframes slotBeamFlash {
  0% { opacity: 0; transform: scaleY(0.2); }
  40% { opacity: 1; transform: scaleY(1.1); }
  100% { opacity: 0; transform: scaleY(1.4); }
}

.slot-cigarette-stick.stick-rising-out {
  box-shadow: 0 0 24rpx #38bdf8, 0 0 42rpx #fde047 !important;
  animation: slotStickAscendOut 0.32s cubic-bezier(0.22, 1, 0.36, 1) forwards !important;
}

@keyframes slotStickAscendOut {
  0% {
    transform: translateY(0) scale(1);
    filter: brightness(1.1);
  }
  45% {
    transform: translateY(-58rpx) scale(1.04);
    filter: brightness(1.35);
  }
  100% {
    transform: translateY(-155rpx) scale(1.06);
    filter: brightness(1.5);
  }
}

.filter-oriental-swirl {
  position: absolute;
  top: 22%;
  left: 12%;
  right: 12%;
  height: 12rpx;
  border-top: 1rpx solid rgba(253, 224, 71, 0.55);
  border-bottom: 1rpx solid rgba(253, 224, 71, 0.55);
  border-radius: 50%;
  pointer-events: none;
}

/* ---------- 全屏 60fps 2D/3D 银河星云 S 型轨迹粒子画布 ---------- */
.pack-flight-canvas {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 306;
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.18s ease-out;
}

.pack-flight-canvas.is-canvas-visible {
  opacity: 1;
}

/* ---------- 1. 渐进深空星云暗场 (保持后方烟盒与空槽清晰可辨) ---------- */
.ssr-stage-backdrop {
  position: fixed;
  inset: 0;
  z-index: 302;
  background: radial-gradient(
    circle at 50% 44%,
    rgba(30, 58, 138, 0.28) 0%,
    rgba(15, 23, 42, 0.72) 52%,
    rgba(4, 7, 17, 0.88) 100%
  );
  backdrop-filter: blur(3px);
  -webkit-backdrop-filter: blur(3px);
  opacity: 0;
  pointer-events: none;
}

.ssr-stage-backdrop.ssr-active {
  animation: ssrBackdropProgressive 2.05s ease-out forwards;
}

@keyframes ssrBackdropProgressive {
  0% { opacity: 0.06; }
  25% { opacity: 0.26; }
  50% { opacity: 0.68; }
  100% { opacity: 0.82; }
}

/* ---------- 顶层特效舞台容器 ---------- */
.ssr-awaken-overlay {
  position: fixed;
  inset: 0;
  z-index: 310;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  pointer-events: auto;
}

/* 顶部全息分镜状态铭牌 (02 [点击触发] ~ 06 [屏幕呈现]) */
.ssr-stage-hud-pill {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  z-index: 35;
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 28rpx;
  border-radius: 999rpx;
  background: rgba(9, 14, 28, 0.82);
  border: 1.5rpx solid rgba(56, 189, 248, 0.65);
  box-shadow: 0 0 24rpx rgba(56, 189, 248, 0.35), inset 0 0 12rpx rgba(253, 224, 71, 0.22);
}

.hud-scan-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #38bdf8;
  box-shadow: 0 0 12rpx #38bdf8, 0 0 20rpx #fde047;
  animation: hudDotPulse 0.6s ease-in-out infinite alternate;
}

@keyframes hudDotPulse {
  from { transform: scale(0.85); opacity: 0.7; }
  to { transform: scale(1.25); opacity: 1; }
}

.hud-stage-label {
  font-size: 22rpx;
  font-weight: 800;
  color: #fef08a;
  letter-spacing: 3rpx;
  text-shadow: 0 0 12rpx rgba(56, 189, 248, 0.85);
}

/* ---------- 2. CSS 3D S-Curve 银河星云三色流光绶带 (与 60fps Canvas 协同辉映) ---------- */
.ssr-scurve-galaxy-layer {
  position: absolute;
  inset: 0;
  z-index: 5;
  pointer-events: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.scurve-ribbon-arc {
  position: absolute;
  border-radius: 50%;
  opacity: 0;
  pointer-events: none;
}

/* 上回环星云弧 (对应 04 破空盘旋上拐点) */
.scurve-ribbon-arc.arc-upper {
  width: 440rpx;
  height: 220rpx;
  top: 22%;
  left: 24%;
  border-top: 8rpx solid #38bdf8;
  border-left: 12rpx solid #fde047;
  filter: drop-shadow(0 0 18rpx #38bdf8) drop-shadow(0 0 28rpx #a855f7);
  transform: rotate(-16deg) scale(0.8);
}

/* 中段横贯大S金紫星河绶带 (对应 04 破空盘旋主轨迹) */
.scurve-ribbon-arc.arc-middle {
  width: 580rpx;
  height: 290rpx;
  top: 33%;
  right: 8%;
  border-right: 16rpx solid #fde047;
  border-bottom: 12rpx solid #38bdf8;
  filter: drop-shadow(0 0 24rpx #fde047) drop-shadow(0 0 38rpx #8b5cf6);
  transform: rotate(14deg) scale(0.85);
}

/* 下回环螺旋放大星河弧 (对应 05 弧线放大) */
.scurve-ribbon-arc.arc-lower {
  width: 620rpx;
  height: 310rpx;
  bottom: 24%;
  left: 6%;
  border-bottom: 16rpx solid #fde047;
  border-left: 12rpx solid #c084fc;
  filter: drop-shadow(0 0 24rpx #38bdf8) drop-shadow(0 0 36rpx #fde047);
  transform: rotate(-12deg) scale(0.85);
}

.ssr-awaken-overlay.ssr-active .scurve-ribbon-arc.arc-upper {
  animation: scurveRibbonSweep 1.35s ease-out 0.24s forwards;
}

.ssr-awaken-overlay.ssr-active .scurve-ribbon-arc.arc-middle {
  animation: scurveRibbonSweep 1.35s ease-out 0.42s forwards;
}

.ssr-awaken-overlay.ssr-active .scurve-ribbon-arc.arc-lower {
  animation: scurveRibbonSweep 1.35s ease-out 0.62s forwards;
}

@keyframes scurveRibbonSweep {
  0% {
    opacity: 0;
    transform: scale(0.55) rotate(-8deg);
  }
  30% {
    opacity: 0.92;
    transform: scale(1.02) rotate(0deg);
  }
  75% {
    opacity: 0.75;
    transform: scale(1.06) rotate(4deg);
  }
  100% {
    opacity: 0.18;
    transform: scale(1.12) rotate(6deg);
  }
}

/* ---------- 3. 冲霄能量光柱与 Stage 06 星芒大爆发法阵 ---------- */
.ssr-sky-pillar {
  position: absolute;
  top: 6%;
  bottom: 14%;
  left: 50%;
  width: 170rpx;
  transform: translateX(-50%);
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(56, 189, 248, 0.14) 18%,
    rgba(254, 240, 138, 0.46) 50%,
    rgba(56, 189, 248, 0.14) 82%,
    transparent 100%
  );
  -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 20%, #000 80%, transparent 100%);
  mask-image: linear-gradient(180deg, transparent 0%, #000 20%, #000 80%, transparent 100%);
  filter: blur(6rpx);
  opacity: 0;
  z-index: 2;
  pointer-events: none;
}

.ssr-awaken-overlay.ssr-active .ssr-sky-pillar {
  animation: ssrPillarStageFlow 2.0s ease-in-out forwards;
}

@keyframes ssrPillarStageFlow {
  0% { opacity: 0; transform: translateX(-50%) scaleX(0.4); }
  18% { opacity: 0.95; transform: translateX(-50%) scaleX(0.65); }
  55% { opacity: 0.25; transform: translateX(-50%) scaleX(0.5); }
  78% { opacity: 0.95; transform: translateX(-50%) scaleX(1.15); }
  100% { opacity: 0.75; transform: translateX(-50%) scaleX(1.0); }
}

/* 双层破空震波环 (3D Perspective Shockwaves) */
.ssr-shockwave-ring {
  position: absolute;
  top: 44%;
  left: 50%;
  width: 480rpx;
  height: 480rpx;
  margin-left: -240rpx;
  margin-top: -240rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(254, 240, 138, 0.88);
  box-shadow: 0 0 32rpx rgba(56, 189, 248, 0.8), inset 0 0 22rpx rgba(245, 158, 11, 0.55);
  opacity: 0;
  z-index: 3;
  pointer-events: none;
}

.ssr-awaken-overlay.ssr-active .ssr-shockwave-ring.ring-1 {
  animation: ssrShockwaveExpand 0.82s cubic-bezier(0.16, 1, 0.3, 1) 1.18s forwards;
}

.ssr-awaken-overlay.ssr-active .ssr-shockwave-ring.ring-2 {
  border-color: #38bdf8;
  animation: ssrShockwaveExpand 0.95s cubic-bezier(0.16, 1, 0.3, 1) 1.28s forwards;
}

@keyframes ssrShockwaveExpand {
  0% {
    opacity: 0.95;
    transform: scale(0.25);
  }
  70% {
    opacity: 0.65;
  }
  100% {
    opacity: 0;
    transform: scale(1.42);
  }
}

/* Stage 06 [屏幕呈现]: 360° 璀璨鎏金与赛博青星芒轮盘 */
.ssr-celestial-wheel {
  position: absolute;
  top: 43%;
  left: 50%;
  width: 560rpx;
  height: 560rpx;
  margin-left: -280rpx;
  margin-top: -280rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  z-index: 4;
  pointer-events: none;
}

.ssr-awaken-overlay.ssr-active .ssr-celestial-wheel {
  animation: ssrWheelFinalBurst 0.95s cubic-bezier(0.16, 1, 0.3, 1) 1.12s forwards;
}

@keyframes ssrWheelFinalBurst {
  0% { opacity: 0; transform: scale(0.35) rotate(-25deg); }
  45% { opacity: 1; transform: scale(1.08) rotate(0deg); }
  100% { opacity: 0.92; transform: scale(1.0) rotate(8deg); }
}

.ssr-god-rays {
  position: absolute;
  inset: -60rpx;
  border-radius: 50%;
  background: repeating-conic-gradient(
    from 0deg,
    rgba(253, 224, 71, 0.32) 0deg 8deg,
    rgba(56, 189, 248, 0.24) 8deg 16deg,
    transparent 16deg 30deg
  );
  -webkit-mask-image: radial-gradient(circle, #000 0%, rgba(0, 0, 0, 0.72) 48%, transparent 74%);
  mask-image: radial-gradient(circle, #000 0%, rgba(0, 0, 0, 0.72) 48%, transparent 74%);
  animation: ssrWheelSpinCw 12s linear infinite;
}

.ssr-radial-starburst {
  position: absolute;
  inset: -40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.starburst-ray {
  position: absolute;
  width: 620rpx;
  height: 4rpx;
  background: linear-gradient(90deg, transparent 0%, #38bdf8 22%, #fde047 45%, #ffffff 50%, #fde047 55%, #38bdf8 78%, transparent 100%);
  box-shadow: 0 0 18rpx #fde047;
}
.starburst-ray.sr-1 { transform: rotate(0deg); }
.starburst-ray.sr-2 { transform: rotate(30deg); }
.starburst-ray.sr-3 { transform: rotate(60deg); }
.starburst-ray.sr-4 { transform: rotate(90deg); }
.starburst-ray.sr-5 { transform: rotate(120deg); }
.starburst-ray.sr-6 { transform: rotate(150deg); }

.ssr-sacred-halo {
  position: absolute;
  width: 420rpx;
  height: 420rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(56, 189, 248, 0.55);
  box-shadow: 0 0 38rpx rgba(56, 189, 248, 0.38), inset 0 0 28rpx rgba(251, 191, 36, 0.32);
  animation: ssrWheelSpinCcw 16s linear infinite;
}

.halo-diamond {
  position: absolute;
  font-size: 22rpx;
  color: #fde047;
  text-shadow: 0 0 12rpx #38bdf8;
  line-height: 1;
}
.halo-diamond.d-top { top: -14rpx; left: 50%; transform: translateX(-50%); }
.halo-diamond.d-bottom { bottom: -14rpx; left: 50%; transform: translateX(-50%); }
.halo-diamond.d-left { left: -14rpx; top: 50%; transform: translateY(-50%); }
.halo-diamond.d-right { right: -14rpx; top: 50%; transform: translateY(-50%); }

.ssr-inner-energy-ring {
  position: absolute;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  border: 2rpx dashed rgba(254, 240, 138, 0.55);
  animation: ssrWheelSpinCw 9s linear infinite;
}

@keyframes ssrWheelSpinCw {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

@keyframes ssrWheelSpinCcw {
  from { transform: rotate(360deg); }
  to { transform: rotate(0deg); }
}

/* ---------- 4. 螺旋飞升星尘粒子与垂直拔升速度光束 ---------- */
.ssr-particles-field {
  position: absolute;
  inset: 0;
  z-index: 6;
  pointer-events: none;
}

.ssr-ember-particle {
  position: absolute;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: radial-gradient(circle, #ffffff 0%, #38bdf8 45%, #fde047 100%);
  box-shadow: 0 0 16rpx #38bdf8, 0 0 28rpx #fde047;
  opacity: 0;
}

.ssr-awaken-overlay.ssr-active .ssr-ember-particle {
