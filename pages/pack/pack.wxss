}

/* ==================== 表面高光反射与游戏级动态扫光层 (Cellophane Shimmer Sweep) ==================== */
.facade-sheen-overlay {
  position: absolute;
  inset: 0;
  overflow: hidden;
  pointer-events: none;
  z-index: 5;
  border-radius: inherit;
}

/* 腾讯设计级 12° 微倾发丝全息光刃 (默认静止，进入页面静置聚焦后再低频启动) */
.facade-sheen-overlay::after {
  content: '';
  position: absolute;
  top: -40%;
  left: -80%;
  width: 48%;
  height: 180%;
  background: linear-gradient(
    90deg,
    transparent 0%,
    transparent 46%,
    rgba(255, 255, 255, 0.22) 49%,
    rgba(255, 255, 255, 0.62) 50%,
    rgba(255, 255, 255, 0.22) 51%,
    transparent 54%,
    transparent 100%
  );
  transform: rotate(12deg);
  opacity: 0;
  will-change: transform, opacity;
  animation: none;
}

/* 静置期过后启动全货架低频舒缓流光 (10s 长周期：前段静置留白，中段轻扫，后段静置) */
.shelf-pack-card .facade-sheen-overlay.is-sheen-active::after {
  animation: cardSheenSweep 10s cubic-bezier(0.25, 1, 0.5, 1) infinite;
  animation-delay: 0s;
}

/* 当前使用中的烟：SSR 尊享香槟金温润发丝光刃 */
.shelf-pack-card.is-currently-equipped .facade-sheen-overlay::after {
  background: linear-gradient(
    90deg,
    transparent 0%,
    transparent 46%,
    rgba(245, 158, 11, 0.30) 49%,
    rgba(254, 240, 138, 0.75) 50%,
    rgba(245, 158, 11, 0.30) 51%,
    transparent 54%,
    transparent 100%
  );
  animation: none;
}

.shelf-pack-card.is-currently-equipped .facade-sheen-overlay.is-sheen-active::after {
  animation: cardSheenSweep 10s cubic-bezier(0.25, 1, 0.5, 1) infinite;
  animation-delay: 0s;
}

/* 触控交互：点击时无缩放抖动，仅高亮边框，保持全局扫光时间轴同步不失步 */
.shelf-pack-card:active {
  transform: none;
}

/* 3D 舞台开盒视图彻底关闭扫光 */
.pack-3d-stage .facade-sheen-overlay {
  display: none !important;
}

@keyframes cardSheenSweep {
  0%, 35% {
    transform: translateX(0) rotate(12deg);
    opacity: 0;
  }
  40% {
    opacity: 1;
  }
  68% {
    transform: translateX(380%) rotate(12deg);
    opacity: 1;
  }
  74%, 100% {
    transform: translateX(380%) rotate(12deg);
    opacity: 0;
  }
}

@keyframes cardSheenQuickSweep {
  0% {
    transform: translateX(0) rotate(12deg);
    opacity: 0.8;
  }
  100% {
    transform: translateX(380%) rotate(12deg);
    opacity: 1;
  }
}

