.tiga-silver-font {
  color: #f8fafc !important;
  text-shadow: 0 0 10rpx rgba(56, 189, 248, 0.8), 0 2rpx 4rpx rgba(0, 0, 0, 0.9);
}

.tiga-sub {
  font-size: 11rpx;
  color: #7dd3fc;
  letter-spacing: 1rpx;
}

.emblem-tiga {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.tiga-chest-crest {
  width: 110rpx;
  height: 48rpx;
  border-top: 6rpx solid #fbbf24;
  border-left: 4rpx solid #f59e0b;
  border-right: 4rpx solid #f59e0b;
  border-radius: 12rpx 12rpx 48rpx 48rpx;
  background: linear-gradient(135deg, #3b0764 0%, #1e1b4b 48%, #991b1b 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  box-shadow: 0 4rpx 16rpx rgba(56, 189, 248, 0.45), inset 0 0 12rpx rgba(251, 191, 36, 0.35);
}

.tiga-color-timer-orb {
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background: radial-gradient(circle, #ffffff 0%, #7dd3fc 45%, #0284c7 100%);
  border: 2rpx solid #fde047;
  box-shadow: 0 0 16rpx #38bdf8, 0 0 28rpx rgba(56, 189, 248, 0.8);
}

.tiga-font {
  color: #f8fafc !important;
  text-shadow: 0 0 14rpx rgba(56, 189, 248, 0.85), 0 2rpx 8rpx rgba(0, 0, 0, 0.9);
}

.tiga-light-seal {
  margin-top: 4rpx;
  padding: 2rpx 14rpx;
  font-size: 16rpx;
  font-weight: 800;
  color: #e0f2fe;
  background: linear-gradient(90deg, rgba(2, 132, 199, 0.65), rgba(56, 189, 248, 0.45));
  border: 1px solid rgba(125, 211, 252, 0.75);
  border-radius: 999rpx;
  letter-spacing: 2rpx;
}