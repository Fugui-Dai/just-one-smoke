/* 1. 穹顶赛博流金光学翼轨 (Cyber-Gold Optical Wing Bar) */
.spotlight-luminaire-bar {
  position: absolute;
  top: -2rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 560rpx;
  height: 4rpx;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(45, 212, 191, 0.65) 14%,
    #fbbf24 36%,
    #ffffff 50%,
    #fbbf24 64%,
    rgba(45, 212, 191, 0.65) 86%,
    transparent 100%
  );
