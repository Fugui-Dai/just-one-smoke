/* pages/pack/pack.wxss */

/* ==================== 1. 全局容器与暗黑舞台背景 ==================== */
.pack-page-container {
  width: 100vw;
  height: 100vh;
  background: radial-gradient(circle at 50% 18%, #161b26 0%, #080a0f 75%);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  position: relative;
  box-sizing: border-box;
}

/* ==================== 2. 自定义导航栏 ==================== */
.custom-navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  background: rgba(8, 10, 15, 0.85);
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  box-sizing: border-box;
}

.navbar-content {
  position: relative;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-left: 20rpx;
  box-sizing: border-box;
}

.nav-back-btn {
  position: relative;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 50%;
  color: #e2e8f0;
  transition: all 0.2s ease;
  padding: 0;
}

.nav-back-btn:active {
  transform: scale(0.92);
  background: rgba(255, 255, 255, 0.16);
}

.nav-title-box {
  display: flex;
  align-items: center;
}

.nav-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #f8fafc;
  letter-spacing: 1rpx;
}

.nav-center-title-box {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  margin: auto;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  z-index: 5;
}

.nav-center-title-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 1rpx;
  max-width: 420rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: center;
}

.nav-sound-btn {
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 50%;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  margin-right: 12rpx;
}

.nav-sound-btn.muted {
  opacity: 0.5;
}

.nav-placeholder {
  width: 80rpx;
}


/* ==================== 3. 主内容区域 ==================== */
.pack-main-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
}

/* 顶部浪漫流金名牌 (Museum Plaque) + 烟盒剩余数量胶囊 */
.pack-meta-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 10rpx 32rpx 4rpx;
  z-index: 30;
}

.pack-romantic-plaque {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  background: linear-gradient(135deg, rgba(251, 191, 36, 0.14) 0%, rgba(15, 23, 42, 0.85) 50%, rgba(251, 191, 36, 0.10) 100%);
  border: 1px solid rgba(251, 191, 36, 0.38);
  padding: 8rpx 26rpx;
  border-radius: 999rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.45), inset 0 1rpx 2rpx rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
}

.plaque-ornament {
  font-size: 20rpx;
  color: #fbbf24;
  text-shadow: 0 0 8rpx rgba(251, 191, 36, 0.6);
}

.plaque-brand-name {
  font-size: 28rpx;
  font-weight: 800;
  color: #fef08a;
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.6);
}

.plaque-divider {
  font-size: 22rpx;
  color: rgba(251, 191, 36, 0.45);
  font-weight: 700;
}

.plaque-price {
  font-size: 24rpx;
  font-weight: 800;
  color: #f8fafc;
}

.plaque-spec {
  font-size: 22rpx;
  color: #cbd5e1;
  font-weight: 500;
}

.brand-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.brand-main-name {
  font-size: 32rpx;
  font-weight: 800;
  color: #f8fafc;
}

.brand-badge-tag {
  font-size: 18rpx;
  color: #f59e0b;
  background: rgba(245, 158, 11, 0.15);
  border: 1px solid rgba(245, 158, 11, 0.35);
  padding: 2rpx 10rpx;
  border-radius: 12rpx;
  font-weight: 600;
}

.brand-tagline {
  font-size: 20rpx;
  color: #94a3b8;
  margin-top: 4rpx;
}

/* 烟盒余量胶囊行 */
.pack-inventory-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
}

.pack-inventory-pill {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  background: rgba(16, 185, 129, 0.16);
  border: 1px solid rgba(16, 185, 129, 0.45);
  padding: 6rpx 22rpx;
  border-radius: 999rpx;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.38);
}

.inv-pulse-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #10b981;
  box-shadow: 0 0 12rpx #10b981;
}

.inv-text {
  font-size: 22rpx;
  color: #6ee7b7;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.pack-inventory-pill.pill-low {
  background: rgba(245, 158, 11, 0.18);
  border-color: rgba(245, 158, 11, 0.48);
}
.pack-inventory-pill.pill-low .inv-pulse-dot { background: #f59e0b; box-shadow: 0 0 12rpx #f59e0b; }
.pack-inventory-pill.pill-low .inv-text { color: #fde047; }

.pack-inventory-pill.pill-empty {
  background: rgba(239, 68, 68, 0.18);
  border-color: rgba(239, 68, 68, 0.48);
}
.pack-inventory-pill.pill-empty .inv-pulse-dot { background: #ef4444; box-shadow: 0 0 12rpx #ef4444; }
.pack-inventory-pill.pill-empty .inv-text { color: #fca5a5; }

.pack-unwrap-mini-btn {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(251, 191, 36, 0.16);
  border: 1px solid rgba(251, 191, 36, 0.48);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.35);
  transition: transform 0.18s ease, background 0.18s ease;
}

.pack-unwrap-mini-btn:active {
  transform: scale(0.94);
  background: rgba(251, 191, 36, 0.28);
}

.unwrap-mini-text {
  font-size: 20rpx;
  font-weight: 800;
  color: #fef08a;
  letter-spacing: 1rpx;
}


/* ==================== 4. 3D 拟真烟盒舞台 (3D Pack Stage) ==================== */
.pack-3d-stage {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  perspective: 2400px;
  -webkit-perspective: 2400px;
  margin-top: 20rpx;
}

/* 舞台背部浪漫星芒光晕 */
.stage-romantic-halo {
  position: absolute;
  width: 580rpx;
  height: 580rpx;
  border-radius: 50%;
  top: 46%;
  left: 50%;
  transform: translate(-50%, -50%);
  filter: blur(45px);
  pointer-events: none;
  z-index: 1;
}

/* 3D 烟盒主体外壳容器 (严格 360x580，1:1 恒定比例，严禁忽大忽小缩放抖动) */
.pack-box-wrapper {
  position: relative;
  width: 360rpx;
  height: 580rpx;
  z-index: 5;
  margin-top: 76rpx;
  border-radius: 12rpx;
  box-shadow: 0 32rpx 64rpx rgba(0, 0, 0, 0.88);
}

/* 盒盖打开状态：保持 1:1 原尺寸静止，盒盖朝上后仰立于顶端，完全展露第一排与第二排烟 */
.pack-box-wrapper.lid-open {
  transform: none;
  margin-bottom: 0;
  box-shadow: 0 32rpx 64rpx rgba(0, 0, 0, 0.88);
}

/* 细支烟盒比例 (保持 360x580 纯画幅统一，无拉伸畸变) */
.pack-box-wrapper.slender-box {
  width: 360rpx;
  height: 580rpx;
}

/* 雪茄大号木盒比例 (保持 360x580 纯画幅统一，无拉伸畸变) */
.pack-box-wrapper.cigar-box {
  width: 360rpx;
  height: 580rpx;
}

/* ==================== 盒内内胆与烟支展示仓 (Open Pack Upper Chamber - 100% 无遮挡全显烟支) ==================== */
/* ==================== 盒内内胆与烟支展示仓 (Open Pack Upper Chamber - 100% 无遮挡全显烟支) ==================== */
.pack-inner-chamber {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  width: 360rpx;
  height: calc(var(--lid-h, 168rpx) + 20rpx);
  box-sizing: border-box;
  overflow: visible;
  z-index: 6;
  transition: opacity 0.22s ease;
}

/* 盒盖闭合时隐藏内胆，确保非当前抽的烟在合盖状态下边角 100% 严丝合缝 */
.pack-box-wrapper.lid-closed .pack-inner-chamber {
  opacity: 0;
  pointer-events: none;
}

/* 烟支后方真实金属铝箔/金箔压纹衬底 (还原高档名烟原厂金箔/银箔质感，彻底消除黑洞断层) */
.foil-paper-liner {
  position: absolute;
  inset: 0;
  background: var(--foil-color, #d97706);
  border-radius: 8rpx 8rpx 0 0;
  z-index: 1;
  pointer-events: none;
  background-image: repeating-linear-gradient(
    45deg,
    rgba(255, 255, 255, 0.22) 0px,
    rgba(255, 255, 255, 0.22) 2px,
    transparent 2px,
    transparent 6px
  ),
  repeating-linear-gradient(
    -45deg,
    rgba(0, 0, 0, 0.1) 0px,
    rgba(0, 0, 0, 0.1) 2px,
    transparent 2px,
    transparent 6px
  );
  box-shadow: inset 0 4rpx 14rpx rgba(0, 0, 0, 0.45);
}

.foil-notch-cutout,
.foil-texture-shimmer,
.inner-collar-frame,
.collar-u-notch,
.collar-card-rim {
  display: none;
}

/* ==================== 盒内立体香烟真实双排阶梯陈列 (第一排 0..9 + 第二排 10..19 两排独立网格同时清晰呈现) ==================== */
.cigarettes-matrix {
  position: absolute;
  top: 2rpx;
  left: 10rpx;
  right: 10rpx;
  height: var(--lid-h, 168rpx);
  display: grid;
  align-items: start;
  justify-content: center;
  z-index: 10;
  box-sizing: border-box;
}

/* 第二排前方的锡箔阶梯分隔金边（位于第一排与第二排交界处，一眼区分上下两排） */
.cigarettes-matrix.standard-matrix::after,
.cigarettes-matrix.slender-matrix::after {
  content: '';
  position: absolute;
  top: 76rpx;
  left: -2rpx;
  right: -2rpx;
  height: 6rpx;
  background: linear-gradient(90deg, rgba(251, 191, 36, 0.35) 0%, rgba(254, 240, 138, 0.92) 50%, rgba(251, 191, 36, 0.35) 100%);
  box-shadow: 0 -3rpx 8rpx rgba(0, 0, 0, 0.72), 0 3rpx 8rpx rgba(0, 0, 0, 0.65);
  border-radius: 4rpx;
  z-index: 9;
  pointer-events: none;
}

/* 常规 20 支排列：真实 2 排 × 10 列双排独立网格，第 1 排在上方行 (74rpx)，第 2 排在下方行 (82rpx)，两排同时完整独立呈现，绝不叠成一排 */
.cigarettes-matrix.standard-matrix {
  grid-template-columns: repeat(10, 1fr);
  grid-template-rows: 74rpx 84rpx;
  column-gap: 4rpx;
  row-gap: 6rpx;
}

/* 细支 20 支排列：2 排 × 10 列双排独立网格 */
.cigarettes-matrix.slender-matrix {
  grid-template-columns: repeat(10, 1fr);
  grid-template-rows: 74rpx 84rpx;
  column-gap: 5rpx;
  row-gap: 6rpx;
}

/* 雪茄 5 支排列 (单排 5 支大雪茄) */
.cigarettes-matrix.cigar-matrix {
  top: 10rpx;
  left: 18rpx;
  right: 18rpx;
  grid-template-columns: repeat(5, 1fr);
  grid-template-rows: 152rpx;
  gap: 10rpx;
}

.cig-filter-slot {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  position: relative;
  transition: transform 0.2s ease, filter 0.2s ease;
  box-sizing: border-box;
}

/* 第一排 10 支 (index 0..9)：独立居于第 1 行 (grid-row: 1)，完整露出圆烟嘴 + 滤嘴 + 金箍 + 白烟身，下方留出 6rpx 阶梯分界，100% 不被第二排遮挡 */
.standard-matrix .cig-filter-slot.back-row-slot,
.slender-matrix .cig-filter-slot.back-row-slot {
  grid-row: 1;
  top: 0;
  height: 74rpx;
  z-index: 6;
  transform: none;
  filter: brightness(0.95) contrast(1.05) drop-shadow(0 3rpx 5rpx rgba(0, 0, 0, 0.55));
}

/* 第二排 10 支 (index 10..19)：独立居于第 2 行 (grid-row: 2)，排在第一排正下方，同样完整露出圆烟嘴 + 滤嘴 + 金箍 + 白烟身，两排上下同屏一目了然 */
.standard-matrix .cig-filter-slot.front-row-slot,
.slender-matrix .cig-filter-slot.front-row-slot {
  grid-row: 2;
  top: 0;
  height: 84rpx;
  z-index: 12;
  transform: none;
  filter: brightness(1.04) drop-shadow(0 -3rpx 6rpx rgba(0, 0, 0, 0.68));
}

/* 雪茄单排 5 支高度 */
.cigar-matrix .cig-filter-slot.cigar-row-slot {
  grid-row: 1;
  top: 0;
  height: 152rpx;
  z-index: 8;
}

/* 第二排 10 支列映射：10..19 分别对应第 1..10 列 */
.standard-matrix .cig-filter-slot:nth-child(11),
.slender-matrix .cig-filter-slot:nth-child(11) { grid-column: 1; }
.standard-matrix .cig-filter-slot:nth-child(12),
.slender-matrix .cig-filter-slot:nth-child(12) { grid-column: 2; }
.standard-matrix .cig-filter-slot:nth-child(13),
.slender-matrix .cig-filter-slot:nth-child(13) { grid-column: 3; }
.standard-matrix .cig-filter-slot:nth-child(14),
.slender-matrix .cig-filter-slot:nth-child(14) { grid-column: 4; }
.standard-matrix .cig-filter-slot:nth-child(15),
.slender-matrix .cig-filter-slot:nth-child(15) { grid-column: 5; }
.standard-matrix .cig-filter-slot:nth-child(16),
.slender-matrix .cig-filter-slot:nth-child(16) { grid-column: 6; }
.standard-matrix .cig-filter-slot:nth-child(17),
.slender-matrix .cig-filter-slot:nth-child(17) { grid-column: 7; }
.standard-matrix .cig-filter-slot:nth-child(18),
.slender-matrix .cig-filter-slot:nth-child(18) { grid-column: 8; }
.standard-matrix .cig-filter-slot:nth-child(19),
.slender-matrix .cig-filter-slot:nth-child(19) { grid-column: 9; }
.standard-matrix .cig-filter-slot:nth-child(20),
.slender-matrix .cig-filter-slot:nth-child(20) { grid-column: 10; }

.standard-matrix .cig-filter-slot.back-row-slot .slot-cigarette-stick,
.slender-matrix .cig-filter-slot.back-row-slot .slot-cigarette-stick {
  height: 74rpx;
}

.standard-matrix .cig-filter-slot.front-row-slot .slot-cigarette-stick,
.slender-matrix .cig-filter-slot.front-row-slot .slot-cigarette-stick {
  height: 84rpx;
}

.cigar-matrix .cig-filter-slot.cigar-row-slot .slot-cigarette-stick {
  height: 152rpx;
}

.standard-matrix .cig-filter-slot.back-row-slot .slot-filter-cylinder,
.slender-matrix .cig-filter-slot.back-row-slot .slot-filter-cylinder {
  height: 46rpx;
}

.standard-matrix .cig-filter-slot.front-row-slot .slot-filter-cylinder,
.slender-matrix .cig-filter-slot.front-row-slot .slot-filter-cylinder {
  height: 48rpx;
}

.standard-matrix .cig-filter-slot.back-row-slot .slot-paper-cylinder,
.slender-matrix .cig-filter-slot.back-row-slot .slot-paper-cylinder {
  height: 28rpx;
}

.standard-matrix .cig-filter-slot.front-row-slot .slot-paper-cylinder,
.slender-matrix .cig-filter-slot.front-row-slot .slot-paper-cylinder {
  height: 36rpx;
}

.cigar-matrix .cig-filter-slot.cigar-row-slot .slot-paper-cylinder {
  height: 100rpx;
}

.standard-matrix .cig-filter-slot.back-row-slot .slot-hanyan-stick,
.slender-matrix .cig-filter-slot.back-row-slot .slot-hanyan-stick {
  height: 74rpx;
}

.standard-matrix .cig-filter-slot.front-row-slot .slot-hanyan-stick,
.slender-matrix .cig-filter-slot.front-row-slot .slot-hanyan-stick {
  height: 84rpx;
}

.standard-matrix .cig-filter-slot.back-row-slot:active,
.slender-matrix .cig-filter-slot.back-row-slot:active {
  transform: translateY(-8rpx);
}

.standard-matrix .cig-filter-slot.front-row-slot:active,
.slender-matrix .cig-filter-slot.front-row-slot:active {
  transform: translateY(-8rpx);
}

.standard-matrix .cig-filter-slot.back-row-slot.slot-pulled-out,
.slender-matrix .cig-filter-slot.back-row-slot.slot-pulled-out {
  transform: translateY(-68rpx);
  transition: transform 1.1s cubic-bezier(0.18, 0.89, 0.32, 1.15);
  filter: drop-shadow(0 0 14rpx rgba(251, 191, 36, 0.85));
}

.standard-matrix .cig-filter-slot.front-row-slot.slot-pulled-out,
.slender-matrix .cig-filter-slot.front-row-slot.slot-pulled-out {
  transform: translateY(-68rpx);
  transition: transform 1.1s cubic-bezier(0.18, 0.89, 0.32, 1.15);
  filter: drop-shadow(0 0 14rpx rgba(251, 191, 36, 0.85));
}

/* 槽位内部完整烟支微缩模型 */
.slot-cigarette-stick {
  width: 100%;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 立体圆柱水松纸过滤嘴 */
.slot-filter-cylinder {
  width: 100%;
  height: 48rpx;
  border-radius: 7rpx 7rpx 0 0;
  position: relative;
  background-image: linear-gradient(
    90deg,
    rgba(0, 0, 0, 0.34) 0%,
    rgba(255, 255, 255, 0.28) 32%,
    rgba(255, 255, 255, 0.06) 66%,
    rgba(0, 0, 0, 0.4) 100%
  );
  box-shadow: 0 3rpx 8rpx rgba(0, 0, 0, 0.55);
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
  z-index: 2;
}

/* 下方延伸白色烟身纸管 */
.slot-paper-cylinder {
  width: 100%;
  border-radius: 0;
  background-image: linear-gradient(
    90deg,
    rgba(0, 0, 0, 0.22) 0%,
    rgba(255, 255, 255, 0.45) 34%,
    rgba(0, 0, 0, 0.05) 68%,
    rgba(0, 0, 0, 0.28) 100%
  );
  position: relative;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1;
}

.slot-paper-ribbing {
  position: absolute;
  inset: 0;
  background-image: repeating-linear-gradient(
    0deg,
    rgba(0, 0, 0, 0.05) 0px,
    rgba(0, 0, 0, 0.05) 1px,
    transparent 1px,
    transparent 5px
  );
}

/* 老辈白纸手卷旱烟槽位：通体纯白手卷纸圆锥尖，无过滤嘴与金箍 */
.slot-hanyan-stick {
  width: 100%;
  height: 104rpx;
  background: linear-gradient(90deg, #dfdacd 0%, #faf8f2 25%, #ffffff 50%, #faf8f2 75%, #d5cfc0 100%);
  clip-path: polygon(15% 0, 85% 0, 65% 100%, 35% 100%);
  -webkit-clip-path: polygon(15% 0, 85% 0, 65% 100%, 35% 100%);
  border-radius: 4rpx 4rpx 0 0;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.45);
  position: relative;
}

.slot-hanyan-top {
  position: absolute;
  top: 0;
  left: 10%;
  right: 10%;
  height: 6rpx;
  background: rgba(255, 255, 255, 0.65);
  border-radius: 50%;
}

.slot-hanyan-body {
  position: absolute;
  top: 18rpx;
  width: 100%;
  height: 1.5rpx;
  background: rgba(168, 162, 158, 0.45);
  transform: rotate(20deg);
}

/* 顶部圆形烟嘴 3D 截面（外圈水松纸包边 + 内部纯白醋酸纤维滤芯圆截面，一眼还原真烟俯视切面） */
.filter-top-bevel {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 10rpx;
  border-radius: 50%;
  background: radial-gradient(
    ellipse at center,
    #ffffff 0%,
    #f1f5f9 54%,
    #cbd5e1 72%,
    rgba(0, 0, 0, 0.25) 100%
  );
  border: 2rpx solid rgba(255, 255, 255, 0.45);
  box-shadow: inset 0 1rpx 2rpx rgba(0, 0, 0, 0.25);
  box-sizing: border-box;
}

.filter-mini-band {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 7rpx;
  box-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.45);
}

.filter-bead-spark {
  width: 9rpx;
  height: 9rpx;
  border-radius: 50%;
  position: absolute;
  top: 42%;
  border: 1.5rpx solid rgba(255, 255, 255, 0.95);
  box-shadow: 0 0 0 2rpx rgba(9, 13, 22, 0.75), 0 0 8rpx rgba(255, 255, 255, 0.85);
  box-sizing: border-box;
  animation: pulse-bead-spark 2s infinite ease-in-out;
}

@keyframes pulse-bead-spark {
  0%, 100% { opacity: 0.88; transform: scale(0.95); }
  50% { opacity: 1; transform: scale(1.18); }
}

/* 被抽走烟支后的独立空槽（位置清晰留空，呈现深邃立体金箔凹槽与顶部圆孔虚线环） */
.slot-empty-groove {
  width: 100%;
  height: 100%;
  border-radius: 8rpx 8rpx 2rpx 2rpx;
  background: linear-gradient(
    90deg,
    rgba(6, 9, 16, 0.78) 0%,
    rgba(15, 23, 42, 0.48) 50%,
    rgba(6, 9, 16, 0.82) 100%
  );
  border-left: 1rpx solid rgba(255, 255, 255, 0.08);
  border-right: 1rpx solid rgba(0, 0, 0, 0.45);
  box-shadow: inset 0 8rpx 14rpx rgba(0, 0, 0, 0.78);
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
}

.empty-socket-rim {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 10rpx;
  border-radius: 50%;
  background: radial-gradient(ellipse at center, rgba(2, 6, 15, 0.92) 0%, rgba(15, 23, 42, 0.65) 100%);
  border: 1.5rpx dashed rgba(253, 224, 71, 0.42);
  box-sizing: border-box;
}

.empty-shadow {
  position: absolute;
  top: 10rpx;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.55) 0%, transparent 100%);
}


/* ==================== 3D 翻盖盒盖 (Flip-Top Lid) ==================== */
.pack-flip-lid {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  width: 360rpx;
  height: var(--lid-h, 168rpx);
  z-index: 30;
  transform-origin: top center;
  transform-style: preserve-3d;
  -webkit-transform-style: preserve-3d;
  transition: top 0.46s cubic-bezier(0.22, 1, 0.36, 1), height 0.46s cubic-bezier(0.22, 1, 0.36, 1), transform 0.46s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.46s ease;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.45);
  box-sizing: border-box;
}

/* 盒盖打开状态：以烟盒背侧顶端为铰链，呈现鲜明的朝上后仰 3D 透视折角 (top: -108rpx, height: 96rpx)，完全立于第一排与第二排烟上方，100% 绝不挡烟 */
.pack-box-wrapper.lid-open .pack-flip-lid {
  top: -108rpx;
  height: 96rpx;
  z-index: 4;
  transform-origin: bottom center;
  transform: perspective(260px) rotateX(38deg);
  filter: drop-shadow(0 -8rpx 20rpx rgba(0, 0, 0, 0.72)) drop-shadow(0 0 18rpx rgba(254, 240, 138, 0.22));
  box-shadow: none;
  pointer-events: auto;
  cursor: pointer;
}

/* 盒盖打开时的顶部热区扩展，方便手指在朝上后仰的烟盖区域轻松点击合盖 */
.pack-box-wrapper.lid-open .pack-flip-lid::before {
  content: '';
  position: absolute;
  top: -40rpx;
  left: -20rpx;
  right: -20rpx;
  bottom: 0;
  z-index: 40;
  pointer-events: auto;
}

.lid-face-outer {
  position: absolute;
  inset: 0;
  background: var(--lid-grad, #991b1b);
  border-radius: 12rpx 12rpx 0 0;
  border: 1px solid rgba(255, 255, 255, 0.18);
  border-bottom: none;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 14rpx;
  overflow: hidden;
  box-shadow: inset 0 2rpx 6rpx rgba(255, 255, 255, 0.35);
  transition: opacity 0.2s ease;
}

/* 开盖时隐藏正面外盖，彻底杜绝外盖贴图倒置穿模 */
.pack-box-wrapper.lid-open .lid-face-outer {
  opacity: 0;
  pointer-events: none;
}

.lid-bevel-edge {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: rgba(255, 255, 255, 0.4);
}

.lid-seal-tape {
  align-self: center;
  background: rgba(255, 255, 255, 0.9);
  padding: 2rpx 16rpx;
  border-radius: 6rpx;
  border: 1px solid #ffffff;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.3);
}

.seal-text {
  font-size: 16rpx;
  font-weight: 800;
  color: #1e293b;
  letter-spacing: 2rpx;
}

.lid-brand-print {
  display: flex;
  justify-content: center;
}

.lid-sub-text {
  font-size: 20rpx;
  font-weight: 700;
  color: #fef08a;
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.5);
}

/* 真实名烟盖顶大图切片 (闭合时 100% 严丝合缝) */
.lid-face-outer.has-real-lid {
  padding: 0;
  background: var(--lid-grad, #161b26);
  border: none;
  border-radius: 12rpx 12rpx 0 0;
  overflow: hidden;
  box-shadow: none;
}

.pack-lid-real-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 360rpx;
  height: 580rpx;
  display: block;
  pointer-events: none;
  filter: contrast(1.03) brightness(1.02);
  image-rendering: -webkit-optimize-contrast;
  image-rendering: crisp-edges;
  transform: translateZ(0);
  -webkit-transform: translateZ(0);
}

/* 闭合时底部极细物理缝隙阴影 */
.lid-bottom-slit-shadow {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 2rpx;
  background: rgba(0, 0, 0, 0.45);
  pointer-events: none;
}

/* 盒盖朝上后仰翻转时的 3D 立体梯形内壁 (近宽远窄后仰透视 + 顶盖斜切厚度沿 + 两侧立体斜折耳 + 底部铰链折痕深影) */
.lid-face-inner {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, #f8fafc 0%, #e2e8f0 36%, #94a3b8 76%, #334155 100%);
  border-radius: 16rpx 16rpx 4rpx 4rpx;
  clip-path: polygon(7% 0%, 93% 0%, 100% 100%, 0% 100%);
  -webkit-clip-path: polygon(7% 0%, 93% 0%, 100% 100%, 0% 100%);
  overflow: hidden;
  border-top: 4rpx solid var(--accent-color, #fbbf24);
  box-shadow:
    inset 0 8rpx 16rpx rgba(255, 255, 255, 0.92),
    inset 0 -26rpx 36rpx rgba(9, 13, 22, 0.78);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.2s ease;
}

.pack-box-wrapper.lid-open .lid-face-inner {
  opacity: 1;
  pointer-events: auto;
}

/* 朝上后仰时可见的盒盖顶部 3D 斜切外沿厚度面 */
.lid-open-top-bevel {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 14rpx;
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.75);
  box-shadow: 0 3rpx 8rpx rgba(0, 0, 0, 0.38);
  z-index: 4;
}

/* 盒盖顶口内卷卡纸金箔折边 */
.lid-inner-foil-strip {
  position: absolute;
  top: 14rpx;
  left: 0;
  right: 0;
  height: 12rpx;
  opacity: 0.92;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.32);
  background-image: linear-gradient(180deg, rgba(255, 255, 255, 0.52) 0%, rgba(0, 0, 0, 0.22) 100%);
  z-index: 3;
}

/* 盒盖白卡纸内壁与暗纹钢印 */
.lid-inner-cardstock {
  position: absolute;
  top: 26rpx;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding-top: 8rpx;
}

.lid-inner-watermark {
  font-size: 13rpx;
  font-weight: 800;
  color: #475569;
  letter-spacing: 3rpx;
  opacity: 0.62;
  text-transform: uppercase;
  z-index: 2;
}

/* 盒盖内侧左右立体三角折翼阴影 (还原真实翻盖烟盒朝上后仰时两侧斜立的防尘翼) */
.lid-dust-flap {
  position: absolute;
  top: -10rpx;
  bottom: 0;
  width: 54rpx;
  background: linear-gradient(110deg, #f1f5f9 0%, #cbd5e1 52%, #64748b 100%);
  border-right: 2rpx solid rgba(255, 255, 255, 0.82);
  box-shadow: 8rpx 0 16rpx rgba(15, 23, 42, 0.32);
  transform: skewX(-16deg);
  left: -10rpx;
  z-index: 3;
}
.lid-dust-flap.right {
  left: auto;
  right: -10rpx;
  background: linear-gradient(-110deg, #f1f5f9 0%, #cbd5e1 52%, #64748b 100%);
  border-right: none;
  border-left: 2rpx solid rgba(255, 255, 255, 0.82);
  box-shadow: -8rpx 0 16rpx rgba(15, 23, 42, 0.32);
  transform: skewX(16deg);
}

/* 底部与烟盒顶端连接的后仰铰链折痕深影 */
.lid-hinge-shadow {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 22rpx;
  background: linear-gradient(180deg, transparent 0%, rgba(9, 13, 22, 0.72) 100%);
  pointer-events: none;
  z-index: 4;
}

/* ==================== 烟盒主体箱体 (Pack Main Body) ==================== */
.pack-main-body {
  position: absolute;
  top: var(--lid-h, 168rpx);
  left: 0;
  right: 0;
  bottom: 0;
  width: 360rpx;
  z-index: 15;
  border-radius: 0 0 12rpx 12rpx;
  box-sizing: border-box;
  overflow: hidden;
  box-shadow: 0 24rpx 48rpx rgba(0, 0, 0, 0.82), 0 -3rpx 10rpx rgba(0, 0, 0, 0.45);
}

/* 盒身切口白色卡纸厚度剖面光边缘 */
.body-top-rim-edge {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3rpx;
  background: linear-gradient(90deg, rgba(255, 255, 255, 0.45) 0%, #ffffff 50%, rgba(255, 255, 255, 0.45) 100%);
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.55);
  z-index: 18;
}

.body-face-outer {
  position: absolute;
  inset: 0;
  background: var(--box-grad, #7f1d1d);
  border-radius: 0 0 12rpx 12rpx;
  border: 1px solid rgba(255, 255, 255, 0.16);
  border-top: none;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 20rpx 18rpx 16rpx 18rpx;
  box-shadow: inset 0 2rpx 4rpx rgba(255, 255, 255, 0.25);
  overflow: hidden;
}

.body-face-outer.has-real-body {
  padding: 0;
  background: var(--box-grad, #161b26);
  border: none;
  border-radius: 0 0 12rpx 12rpx;
  overflow: hidden;
  box-shadow: none;
}

.pack-body-real-img {
  position: absolute;
  top: calc(-1 * var(--lid-h, 168rpx));
  left: 0;
  width: 360rpx;
  height: 580rpx;
  display: block;
  pointer-events: none;
  filter: contrast(1.03) brightness(1.02);
  image-rendering: -webkit-optimize-contrast;
  image-rendering: crisp-edges;
  transform: translateZ(0);
  -webkit-transform: translateZ(0);
}

