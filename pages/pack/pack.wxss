  padding: 14rpx;
  overflow: hidden;
  box-shadow: inset 0 2rpx 6rpx rgba(255, 255, 255, 0.35);
  opacity: 1 !important;
  pointer-events: auto;
}

/* 开盖时保持原本盖子外观与颜色不变，100% 实心不透明 */
.pack-box-wrapper.lid-open .lid-face-outer {
  opacity: 1 !important;
  pointer-events: auto;
}

.lid-bevel-edge {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
