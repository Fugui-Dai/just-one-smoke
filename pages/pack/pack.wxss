}

.lid-sub-text {
  font-size: 20rpx;
  font-weight: 700;
  color: #fef08a;
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.5);
}

/* 真实名烟盖顶大图切片 (闭合时 100% 严丝合缝，实心不透明底板) */
.lid-face-outer.has-real-lid {
  padding: 0;
  background-color: #161b26;
  background-image: var(--lid-grad, linear-gradient(180deg, #991b1b, #7f1d1d));
  border: none;
  border-radius: 12rpx 12rpx 0 0;
  overflow: hidden;
  box-shadow: none;
  opacity: 1 !important;
}

.pack-lid-real-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 360rpx;
  height: 580rpx;
  display: block;
  pointer-events: none;
  opacity: 1 !important;
}

/* 闭合时底部极细物理缝隙阴影（开盖时隐去） */
.lid-bottom-slit-shadow {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 2rpx;
  background: rgba(0, 0, 0, 0.45);
  pointer-events: none;
  transition: opacity 0.25s ease;
}

.pack-box-wrapper.lid-open .lid-bottom-slit-shadow {
  opacity: 0;
}

/* 彻底禁用白色变色内壁与 20 FILTER CIGARETTES 字样，翻盖保持原盖外观 */
.lid-face-inner,
.pack-box-wrapper.lid-open .lid-face-inner {
  display: none !important;
}

/* 朝上后仰时可见的盒盖顶部 3D 斜切外沿厚度面 (真实 3D 顶盖外表面，呈现向后倾斜的红色顶板) */
.lid-open-top-bevel {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 28rpx;
  background: var(--lid-grad, #991b1b);
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.85);
  box-shadow: inset 0 2rpx 6rpx rgba(255, 255, 255, 0.65), 0 4rpx 12rpx rgba(0, 0, 0, 0.55);
  z-index: 5;
}

/* 盒盖顶口内卷卡纸金箔折边 */
.lid-inner-foil-strip {
  position: absolute;
  top: 28rpx;
  left: 0;
  right: 0;
  height: 14rpx;
  opacity: 0.95;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.45);
  background-image: linear-gradient(180deg, rgba(255, 255, 255, 0.6) 0%, rgba(0, 0, 0, 0.25) 100%);
  z-index: 4;
}

/* 盒盖白卡纸内壁与暗纹钢印 (纯净挺括卡纸，无底部黑影干扰第二排烟) */
.lid-inner-cardstock {
  position: absolute;
  top: 42rpx;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding-top: 10rpx;
  background: linear-gradient(180deg, #ffffff 0%, #f1f5f9 55%, #e2e8f0 100%);
  box-shadow: none;
}

.lid-inner-watermark {
  font-size: 13rpx;
  font-weight: 800;
  color: #475569;
  letter-spacing: 3rpx;
  opacity: 0.68;
  text-transform: uppercase;
  z-index: 2;
}

/* 盒盖内侧左右立体三角折翼阴影 (还原真实翻盖烟盒朝上后仰时两侧斜立的立体侧翼) */
.lid-dust-flap {
  position: absolute;
  top: -42rpx;
  bottom: 0;
  width: 68rpx;
  background: linear-gradient(115deg, #ffffff 0%, #e2e8f0 55%, #cbd5e1 100%);
  border-right: 2rpx solid rgba(255, 255, 255, 0.95);
  box-shadow: 6rpx 0 12rpx rgba(15, 23, 42, 0.18);
  transform: skewX(-18deg);
  left: -12rpx;
  z-index: 3;
}
.lid-dust-flap.right {
  left: auto;
  right: -12rpx;
  background: linear-gradient(-115deg, #ffffff 0%, #e2e8f0 55%, #cbd5e1 100%);
  border-right: none;
  border-left: 2rpx solid rgba(255, 255, 255, 0.95);
  box-shadow: -6rpx 0 12rpx rgba(15, 23, 42, 0.18);
  transform: skewX(18deg);
}

/* 移除底部深黑铰链折痕阴影，避免在第二排烟支后方形成黑影色带 */
.lid-hinge-shadow {
  display: none;
}

/* ==================== 烟盒主体箱体 (Pack Main Body) ==================== */
.pack-main-body {
  position: absolute;
  top: var(--lid-h, 168rpx);
  left: 0;
  right: 0;
  bottom: 0;
  width: 360rpx;
  z-index: 20;
  border-radius: 0 0 12rpx 12rpx;
  box-sizing: border-box;
  overflow: hidden;
  box-shadow: 0 24rpx 48rpx rgba(0, 0, 0, 0.82), 0 -3rpx 10rpx rgba(0, 0, 0, 0.45);
}

/* 盒身切口白色卡纸厚度剖面光边缘 */
.body-top-rim-edge {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3rpx;
  background: linear-gradient(90deg, rgba(255, 255, 255, 0.45) 0%, #ffffff 50%, rgba(255, 255, 255, 0.45) 100%);
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.55);
  z-index: 18;
}

.body-face-outer {
  position: absolute;
  inset: 0;
  background: var(--box-grad, #7f1d1d);
  border-radius: 0 0 12rpx 12rpx;
  border: 1px solid rgba(255, 255, 255, 0.16);
  border-top: none;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 20rpx 18rpx 16rpx 18rpx;
  box-shadow: inset 0 2rpx 4rpx rgba(255, 255, 255, 0.25);
  overflow: hidden;
}

.body-face-outer.has-real-body {
  padding: 0;
  background: var(--box-grad, #161b26);
  border: none;
  border-radius: 0 0 12rpx 12rpx;
  overflow: hidden;
  box-shadow: none;
}

.pack-body-real-img {
  position: absolute;
  top: calc(-1 * var(--lid-h, 168rpx));
  left: 0;
  width: 360rpx;
  height: 580rpx;
  display: block;
  pointer-events: none;
  filter: contrast(1.03) brightness(1.02);
  image-rendering: -webkit-optimize-contrast;
  image-rendering: crisp-edges;
  transform: translateZ(0);
  -webkit-transform: translateZ(0);
}

/* 锁定磨砂遮罩 */
.pack-locked-overlay {
  position: absolute;
  inset: 0;
  background: rgba(10, 14, 22, 0.82);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 25;
}

.lock-shield-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 24rpx;
}

.lock-shield-icon {
  font-size: 52rpx;
  margin-bottom: 8rpx;
}

.lock-shield-title {
  font-size: 26rpx;
  font-weight: 800;
  color: #f8fafc;
  margin-bottom: 6rpx;
}

.lock-shield-desc {
  font-size: 20rpx;
  color: #f87171;
}


/* 底座下方专属品牌经典标语 (双翼星芒黑金博物馆诗笺铭牌) */
.pack-slogan-card {
  margin-top: 24rpx;
  width: 96%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 20;
}

.slogan-wing {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  pointer-events: none;
}

.slogan-wing.wing-left {
  margin-right: -6rpx;
}

.slogan-wing.wing-right {
  margin-left: -6rpx;
}

.wing-hairline {
  width: 64rpx;
  height: 2rpx;
}

.wing-left .wing-hairline {
  background: linear-gradient(90deg, transparent 0%, rgba(245, 158, 11, 0.7) 100%);
}

.wing-right .wing-hairline {
  background: linear-gradient(270deg, transparent 0%, rgba(245, 158, 11, 0.7) 100%);
}

.wing-star {
  color: #fbbf24;
  line-height: 1;
  text-shadow: 0 0 10rpx rgba(245, 158, 11, 0.6);
}

.wing-star.star-outer {
  font-size: 16rpx;
  opacity: 0.85;
  margin: 0 6rpx;
}

.wing-star.star-edge {
  font-size: 24rpx;
  color: #f59e0b;
  text-shadow: 0 0 12rpx rgba(251, 191, 36, 0.7);
  z-index: 2;
}

.slogan-ribbon {
  position: relative;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background: linear-gradient(135deg, rgba(34, 48, 74, 0.85) 0%, rgba(24, 35, 56, 0.90) 50%, rgba(16, 24, 40, 0.94) 100%);
  border: 1.5rpx solid rgba(251, 191, 36, 0.55);
  box-shadow: 0 8rpx 32rpx rgba(10, 16, 28, 0.55), 0 0 18rpx rgba(251, 191, 36, 0.22);
  border-radius: 999rpx;
  padding: 14rpx 38rpx;
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  animation: fadeInSlogan 0.35s ease;
}

.slogan-ribbon::before {
  content: '';
  position: absolute;
  inset: 4rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(254, 240, 138, 0.3);
  pointer-events: none;
}

.slogan-quote {
  font-size: 26rpx;
  color: #fbbf24;
  font-weight: 800;
  line-height: 1;
  text-shadow: 0 0 10rpx rgba(251, 191, 36, 0.7);
}

.slogan-text {
  font-size: 24rpx;
  background: linear-gradient(180deg, #ffffff 0%, #fff7ed 35%, #fef08a 70%, #f59e0b 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  color: #fef08a;
  font-weight: 800;
  letter-spacing: 2rpx;
  text-align: center;
  text-shadow: 0 2rpx 8rpx rgba(10, 16, 28, 0.7);
}

@keyframes fadeInSlogan {
  from { opacity: 0; transform: translateY(12rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* 底部操作提示标签 */
.pack-interaction-hint {
  margin-top: 18rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.12);
  padding: 8rpx 26rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  position: relative;
  z-index: 20;
}
.hint-icon { font-size: 20rpx; }
.hint-text { font-size: 20rpx; color: #cbd5e1; font-weight: 500; letter-spacing: 1rpx; }


/* ==================== 5. 底部立体选烟操作区 (Bottom Dock - 去除黑色底框，纯净悬浮，高度绝对居中) ==================== */
.pack-bottom-dock {
  background: transparent;
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
  border-top: none;
  border-radius: 0;
  padding: 0 44rpx;
  /* 运用 flex 自动分配上下间距，使“我抽一支”按钮在诗笺标语和屏幕安全区底部之间完美垂直居中 */
  margin-top: auto;
  margin-bottom: auto;
  padding-bottom: env(safe-area-inset-bottom, 0px);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  box-sizing: border-box;
  position: relative;
  z-index: 25;
}

.brand-scroll-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.scroll-heading {
  font-size: 24rpx;
  font-weight: 700;
  color: #e2e8f0;
}

.scroll-count-tag {
  font-size: 20rpx;
  color: #94a3b8;
}

/* 品牌横滑预览栏 */
.brand-coverflow-scroll {
  white-space: nowrap;
  display: flex;
  gap: 16rpx;
  padding-bottom: 16rpx;
}

.brand-card-item {
  display: inline-flex;
  align-items: center;
  gap: 14rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.1);
  padding: 12rpx 18rpx;
  border-radius: 20rpx;
  transition: all 0.2s ease;
  flex-shrink: 0;
}

.brand-card-item.is-active-brand {
  background: rgba(245, 158, 11, 0.16);
  border-color: #f59e0b;
  box-shadow: 0 0 16rpx rgba(245, 158, 11, 0.35);
}

.brand-card-item.is-locked-brand {
  opacity: 0.55;
}

.mini-pack-preview {
  width: 36rpx;
  height: 52rpx;
  border-radius: 6rpx;
  position: relative;
  overflow: hidden;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
}

.mini-lid {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 14rpx;
  border-bottom: 1px solid rgba(255, 255, 255, 0.2);
}

.mini-logo-text {
  font-size: 12rpx;
  font-weight: 900;
  color: #ffffff;
}

.mini-meta-block {
  display: flex;
  flex-direction: column;
}

.mini-brand-name {
  font-size: 22rpx;
  font-weight: 700;
  color: #f8fafc;
}

.mini-bottom-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 4rpx;
}

.mini-price {
  font-size: 22rpx;
  font-weight: 700;
  color: #fbbf24;
}

.mini-active-status {
  font-size: 20rpx;
  color: #34d399;
}

.mini-lock-status {
  font-size: 20rpx;
  color: #ef4444;
}

/* 核心操作三连键 */
.action-buttons-row {
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 16rpx;
  margin: 0;
}

.action-btn-card {
  flex: 1;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 24rpx;
  padding: 16rpx 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  transition: all 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.action-btn-card:active {
  transform: scale(0.97);
}

.btn-icon {
  font-size: 36rpx;
}

.btn-text-wrap {
  position: relative;
  z-index: 5;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.btn-main-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #f8fafc;
}

.btn-sub-note {
  font-size: 18rpx;
  color: #94a3b8;
  margin-top: 2rpx;
}

/* 核心抽烟大按键 (腾讯总监级高定：温润流光香槟琉璃胶囊 · Radiant Champagne Gold Crystal Capsule) */
.action-btn-card.pull-btn {
  position: relative;
  flex: 1;
  width: 100%;
  max-width: 440rpx;
  padding: 16rpx 36rpx 18rpx;
  /* 告别暗黑死板与生硬白边：采用纯净无界通透的香槟金-琥珀蜜糖琉璃质感，明快晶莹、高奢且亲和 */
  background: linear-gradient(180deg, #fef3c7 0%, #fde68a 22%, #f59e0b 68%, #d97706 100%);
  border: none;
  border-radius: 999rpx;
  box-shadow:
    0 12rpx 36rpx rgba(217, 119, 6, 0.42),
    0 4rpx 12rpx rgba(245, 158, 11, 0.35),
    0 0 28rpx rgba(253, 230, 138, 0.45),
    inset 0 2rpx 3rpx rgba(254, 240, 138, 0.65),
    inset 0 -3rpx 6rpx rgba(180, 83, 9, 0.45);
  overflow: visible;
  /* 仅对底部按钮自身向上平移抬高 80rpx，完全脱离文档流推挤，100% 保证上方的诗笺、展台、烟盒零位移零影响 */
  transform: translateY(-80rpx);
  animation: pullBtnAuraPulse 3.2s ease-in-out infinite alternate;
}

/* 底部扩展式环境背光辉光 (柔和温暖香槟晨曦漫射晕) */
.pull-btn-backlight {
  position: absolute;
  inset: -14rpx -20rpx;
  border-radius: 999rpx;
  background: radial-gradient(ellipse at 50% 50%, rgba(251, 191, 36, 0.38) 0%, rgba(245, 158, 11, 0.22) 50%, transparent 75%);
  filter: blur(14rpx);
  pointer-events: none;
  z-index: 0;
  animation: pullBtnBacklightBreathe 3.2s ease-in-out infinite alternate;
}

/* 外层悬浮精致晨曦金晕细环 */
.pull-btn-outer-ring {
  position: absolute;
  inset: -6rpx;
  border-radius: 999rpx;
  border: 1.5rpx solid rgba(254, 240, 138, 0.45);
  box-shadow:
    0 0 16rpx rgba(251, 191, 36, 0.30),
    inset 0 0 10rpx rgba(254, 243, 199, 0.35);
  pointer-events: none;
  z-index: 1;
  animation: pullBtnRingPulse 3.2s ease-in-out infinite alternate;
}

/* 顶部微弧温润金光丝 */
.pull-btn-top-crest,
.pull-btn-top-gloss {
  position: absolute;
  top: 2rpx;
  left: 28rpx;
  right: 28rpx;
  height: 14rpx;
  border-radius: 999rpx 999rpx 0 0;
  background: linear-gradient(180deg, rgba(254, 240, 138, 0.45) 0%, rgba(254, 240, 138, 0) 100%);
  pointer-events: none;
  z-index: 2;
}

/* 按钮内层白金动态掠光层 */
.pull-btn-sheen {
  position: absolute;
  inset: 0;
  border-radius: 999rpx;
  overflow: hidden;
  pointer-events: none;
  z-index: 3;
}

.pull-btn-sheen::after {
  content: '';
  position: absolute;
  top: -50%;
  left: -70%;
  width: 48%;
  height: 200%;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(255, 255, 255, 0.15) 25%,
    rgba(255, 255, 255, 0.75) 50%,
    rgba(255, 255, 255, 0.15) 75%,
    transparent 100%
  );
  filter: drop-shadow(0 0 8rpx rgba(255, 255, 255, 0.8));
  transform: translate3d(0, 0, 0) skewX(-24deg);
  animation: pullBtnSheenSweep 3.8s cubic-bezier(0.22, 1, 0.36, 1) infinite;
}

/* 左右两侧弧边十字星芒 */
.btn-edge-flare {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  font-size: 22rpx;
  line-height: 1;
  color: #ffffff;
  text-shadow:
    0 0 8rpx #ffffff,
    0 0 18rpx #fbbf24;
  pointer-events: none;
  z-index: 6;
  animation: pullBtnFlareTwinkle 2.5s ease-in-out infinite alternate;
}

.btn-edge-flare.flare-left {
  left: -8rpx;
}

.btn-edge-flare.flare-right {
  right: -8rpx;
  animation-delay: -1.2s;
}

/* 主副标题：深邃琥珀咖啡金刻字，对比鲜明、温润清晰，彻底告别反白发虚 */
.action-btn-card.pull-btn .btn-main-title {
  background: linear-gradient(180deg, #451a03 0%, #78350f 55%, #451a03 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  color: #451a03;
  font-size: 31rpx;
  font-weight: 900;
  letter-spacing: 3rpx;
  line-height: 1.2;
  filter: drop-shadow(0 1rpx 1rpx rgba(255, 255, 255, 0.65));
}

.action-btn-card.pull-btn .btn-sub-note {
  color: #92400e;
  font-size: 19rpx;
  font-weight: 700;
  letter-spacing: 1.5rpx;
  margin-top: 3rpx;
  text-shadow: 0 1rpx 1rpx rgba(255, 255, 255, 0.55);
}

.action-btn-card.btn-disabled {
  opacity: 0.45;
  filter: grayscale(1);
  box-shadow: none !important;
  animation: none !important;
}

.action-btn-card.btn-disabled .pull-btn-backlight,
.action-btn-card.btn-disabled .pull-btn-outer-ring,
.action-btn-card.btn-disabled .btn-edge-flare,
.action-btn-card.btn-disabled .pull-btn-sheen::after {
  display: none !important;
  animation: none !important;
}

/* 动效关键帧 */
@keyframes pullBtnAuraPulse {
  0% {
    box-shadow:
      0 12rpx 36rpx rgba(217, 119, 6, 0.38),
      0 4rpx 12rpx rgba(245, 158, 11, 0.30),
      0 0 24rpx rgba(253, 230, 138, 0.40),
      inset 0 2.5rpx 3rpx rgba(255, 255, 255, 0.95),
      inset 0 -3rpx 6rpx rgba(180, 83, 9, 0.40);
  }
  100% {
    box-shadow:
      0 16rpx 42rpx rgba(217, 119, 6, 0.52),
      0 6rpx 16rpx rgba(245, 158, 11, 0.42),
      0 0 36rpx rgba(253, 230, 138, 0.60),
      inset 0 2.5rpx 3rpx rgba(255, 255, 255, 1),
      inset 0 -3rpx 6rpx rgba(180, 83, 9, 0.45);
  }
}

@keyframes pullBtnRingPulse {
  0% {
    border-color: rgba(254, 240, 138, 0.50);
    box-shadow:
      0 0 14rpx rgba(251, 191, 36, 0.25),
      inset 0 0 8rpx rgba(254, 243, 199, 0.30);
  }
  100% {
    border-color: rgba(254, 240, 138, 0.85);
    box-shadow:
      0 0 24rpx rgba(251, 191, 36, 0.45),
      inset 0 0 14rpx rgba(254, 243, 199, 0.55);
  }
}

@keyframes pullBtnBacklightBreathe {
  0% {
    opacity: 0.7;
    transform: scale(0.97);
  }
  100% {
    opacity: 1;
    transform: scale(1.03);
  }
}

@keyframes pullBtnFlareTwinkle {
  0% {
