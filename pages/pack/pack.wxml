<!-- pages/pack/pack.wxml -->
<view class="pack-page-container {{ vipTheme ? 'theme-' + vipTheme : '' }}">

  <!-- 动态奢华极光天幕与 3D 烟盒背光星尘舞台 (全员常驻基础轻奢氛围，VIP 增强专属色谱) -->
  <view class="vip-ambient-stage">
    <view class="vip-aurora-orb orb-primary"></view>
    <view class="vip-aurora-orb orb-center-halo"></view>
    <view class="vip-aurora-orb orb-bottom-glow"></view>
    <view class="vip-spark s1"></view>
    <view class="vip-spark s2"></view>
    <view class="vip-spark s3"></view>
    <view class="vip-spark s4"></view>
  </view>

  <!-- ==================== 顶部自定义导航栏 (品鉴全透明沉浸顶栏) ==================== -->
  <view class="custom-navbar navbar-stage-immersive" style="padding-top: {{ statusBarHeight }}px; height: {{ statusBarHeight + navBarHeight }}px;">
    <view class="navbar-content" style="height: {{ navBarHeight }}px; padding-right: {{ capsuleRightSpace }}px;">
      
      <!-- 返回按钮 -->
      <view class="nav-back-btn" bindtap="onNavigateBack">
        <view class="back-chevron-arrow"></view>
      </view>

      <!-- 导航中心标题：与全站统一高雅银白字色 -->
      <view class="nav-center-title-box">
        <text class="nav-center-title-text">名烟品鉴</text>
      </view>

      <!-- 右侧占位保持对称 -->
      <view class="nav-placeholder"></view>

    </view>
  </view>


  <!-- ==================== 单盒 3D 深度开盒与抽烟视图 (The 3D Flip-top Pack Stage) ==================== -->
  <view 
    class="pack-3d-stage-container" 
    style="padding-top: {{ statusBarHeight + navBarHeight + 6 }}px;"
  >
    
    <!-- 顶部浪漫流金名牌 + 烟盒剩余烟支数量胶囊 (与顶栏呼应，留出超宽天顶画幅，绝不碰盖) -->
    <view class="pack-meta-header">
      <view class="pack-romantic-plaque">
        <text class="plaque-ornament">✦</text>
        <text class="plaque-brand-name">{{ currentCigarette.name }}</text>
        <text class="plaque-divider">·</text>
        <text class="plaque-price">¥{{ currentCigarette.price }}/{{ currentCigarette.isCigar ? '支' : '盒' }}</text>
        <text class="plaque-divider">·</text>
        <text class="plaque-spec">焦油 {{ currentCigarette.packTheme.tar || '10mg' }}</text>
        <text class="plaque-ornament">✦</text>
      </view>
      <!-- 盒内剩余数量实时铭牌胶囊 + 特效1 / 特效2 切换胶囊 -->
      <view class="pack-inventory-row">
        <view class="pack-inventory-pill {{ packCount === 0 ? 'pill-empty' : (packCount <= 5 ? 'pill-low' : '') }}">
          <view class="inv-pulse-dot"></view>
          <text class="inv-text">剩余 {{ packCount }} / {{ packCapacity }} 支</text>
        </view>
        <view class="pack-unwrap-mini-btn" wx:if="{{ isCurrentUnlocked && !isTrialMode && packCount < packCapacity }}" bindtap="onUnwrapNewPack">
          <text class="unwrap-mini-text">↻ 换新盒</text>
        </view>
        <!-- 特效选择胶囊 (特效1 经典出鞘 360° | 特效2 九天游龙 720°) -->
        <view class="pack-vfx-selector-pill">
          <view 
            class="vfx-pill-btn {{ pullVfxType === 'vfx1' ? 'vfx-pill-active' : '' }}" 
            catchtap="onSwitchPullVfx" 
            data-vfx="vfx1"
          >
            <text class="vfx-pill-text">特效1</text>
          </view>
          <view 
            class="vfx-pill-btn {{ pullVfxType === 'vfx2' ? 'vfx-pill-active' : '' }}" 
            catchtap="onSwitchPullVfx" 
            data-vfx="vfx2"
          >
            <text class="vfx-pill-text">特效2</text>
          </view>
        </view>
      </view>
    </view>


    <!-- 3D 拟真烟盒舞台 (The 3D Cigarette Pack Stage) -->
    <view class="pack-3d-stage">

      <!-- ==================== 1. 腾讯获奖级：天顶星穹棱镜追光 + 双翼流金几何法阵 + 璀璨金青星尘矩阵 ==================== -->
      <view class="pack-spotlight-rig" style="--accent-tint: {{ currentCigarette.packTheme.accentColor || '#f59e0b' }};">
        <!-- 穹顶流金光学翼轨与电影级宽银幕变形拉丝光刃 -->
        <view class="spotlight-luminaire-bar"></view>
        <view class="spotlight-anamorphic-streak"></view>

        <!-- 天顶三联光学追光灯头与中心星芒核 -->
        <view class="spotlight-emitter emitter-left"></view>
        <view class="spotlight-emitter emitter-right"></view>
        <view class="spotlight-emitter emitter-center"></view>
        <view class="spotlight-crown-star">✦</view>

        <!-- 扇形辐射丁达尔五路舞台追光幕 + 四道锐利流金几何射线 -->
        <view class="spotlight-godray-fan"></view>
        <view class="spotlight-beam beam-far-left"></view>
        <view class="spotlight-beam beam-left"></view>
        <view class="spotlight-beam beam-center"></view>
        <view class="spotlight-beam beam-right"></view>
        <view class="spotlight-beam beam-far-right"></view>
        <view class="spotlight-laser-edge laser-outer-left"></view>
        <view class="spotlight-laser-edge laser-left"></view>
        <view class="spotlight-laser-edge laser-right"></view>
        <view class="spotlight-laser-edge laser-outer-right"></view>
        <view class="spotlight-prism-veil"></view>

        <!-- 左右对称双线流金菱形几何翼框 (参考图标志性双翼几何边框) -->
        <view class="stage-geometric-wings">
          <view class="geo-wing-diamond wing-left">
            <view class="geo-wing-inner"></view>
          </view>
          <view class="geo-wing-diamond wing-right">
            <view class="geo-wing-inner"></view>
          </view>
        </view>

        <!-- 聚光灯束内的璀璨金青双色悬浮星尘粒子 -->
        <view class="spotlight-motes-field">
          <view class="tyndall-mote mote-gold m1"></view>
          <view class="tyndall-mote mote-cyan m2"></view>
          <view class="tyndall-mote mote-gold m3"></view>
          <view class="tyndall-mote mote-cyan m4"></view>
          <view class="tyndall-mote mote-gold m5"></view>
          <view class="tyndall-mote mote-gold m6"></view>
          <view class="tyndall-mote mote-cyan m7"></view>
          <view class="tyndall-mote mote-gold m8"></view>
          <view class="tyndall-mote mote-cyan m9"></view>
          <view class="tyndall-mote mote-gold m10"></view>
          <view class="tyndall-mote mote-cyan m11"></view>
          <view class="tyndall-mote mote-gold m12"></view>
          <view class="tyndall-mote mote-cyan m13"></view>
          <view class="tyndall-mote mote-gold m14"></view>
          <view class="tyndall-mote mote-gold m15"></view>
          <view class="tyndall-mote mote-cyan m16"></view>
        </view>
      </view>

      <!-- 3D 烟盒主体容器 (烟壳图片与翻盖结构保持不变，叠加高定舞台边光与顶角星芒) -->
      <view 
        class="pack-box-wrapper {{ isLidOpen ? 'lid-open' : 'lid-closed' }} {{ currentCigarette.packType }}-box {{ isPulling ? 'pulling-animation' : '' }}"
        style="--box-grad: {{ currentCigarette.packTheme.boxGradient }}; --lid-grad: {{ currentCigarette.packTheme.lidGradient }}; --foil-color: {{ currentCigarette.packTheme.foilColor }}; --accent-color: {{ currentCigarette.packTheme.accentColor }}; --lid-h: {{ currentCigarette.lidLine || 168 }}rpx;"
      >
        <!-- 聚光灯倾泻在烟壳顶冠、右顶角星芒、翻盖折痕与双肩的高光流线 -->
        <view class="pack-spotlight-top-crown"></view>
        <view class="pack-spotlight-rim-highlight"></view>
        <view class="pack-corner-star star-top-right">✦</view>
        <view class="pack-lid-crease-glow"></view>
        <view class="pack-shoulder-cascade left"></view>
        <view class="pack-shoulder-cascade right"></view>
        <view class="pack-spotlight-surface-sheen"></view>
        
        <!-- ==================== 盒内烟支与金箔层 (内胆) ==================== -->
        <view class="pack-inner-chamber" bindtap="togglePackLid">
          
          <!-- 金锡箔撕口内衬 (Golden Foil Liner) -->
          <view class="foil-paper-liner">
            <view class="foil-notch-cutout"></view>
            <view class="foil-texture-shimmer"></view>
          </view>

          <!-- 真实硬盒内衬领口卡纸 (Inner Collar Frame) -->
          <view class="inner-collar-frame">
            <view class="collar-u-notch"></view>
            <view class="collar-card-rim"></view>
          </view>

          <!-- 盒内整齐排布的立体香烟过滤嘴与延伸烟身: 支持模式 A (6支宽幕轻奢单排) 与模式 B (20支双排阶梯，原20支代码无损保留备用) -->
          <view class="cigarettes-matrix {{ (packLayoutMode === 'row6' && !currentCigarette.isCigar) ? 'row6-matrix' : (currentCigarette.packType + '-matrix') }}">
            <view 
              class="cig-filter-slot {{ currentCigarette.isCigar ? 'cigar-row-slot' : (packLayoutMode === 'row6' ? 'row6-slot' : (index < 10 ? 'back-row-slot' : 'front-row-slot')) }} {{ (slotStates[index] && (pulledSlotIndex !== index || !isSlotEjected)) ? 'has-cigarette' : 'empty-slot' }} {{ (pulledSlotIndex === index && !isSlotEjected) ? 'is-slot-launching' : '' }}"
              wx:for="{{ slotArray }}"
              wx:key="*this"
              catchtap="onTapCigaretteSlot"
              data-index="{{ index }}"
            >
              <!-- Stage 02 [点击触发]: 选中烟支底座全息波纹与垂直电光拔升光束 -->
              <view class="slot-launch-fx" wx:if="{{ pulledSlotIndex === index && !isSlotEjected }}">
                <view class="slot-launch-ripple sr-1"></view>
                <view class="slot-launch-ripple sr-2"></view>
                <view class="slot-launch-beam"></view>
              </view>

              <!-- 当该槽位有烟且尚未离盒腾空时：展示完整烟支微缩模型，点击时先在槽内发光拔升再无缝飞出 -->
              <view 
                class="slot-cigarette-stick {{ (pulledSlotIndex === index && !isSlotEjected) ? 'stick-rising-out' : '' }}" 
                wx:if="{{ slotStates[index] && (pulledSlotIndex !== index || !isSlotEjected) }}"
              >
                <!-- 老辈白纸手卷旱烟：通体纯白一体手卷纸，绝无工业过滤嘴与金箍 -->
                <block wx:if="{{ currentCigarette.widthType === 'hand_rolled' }}">
                  <view class="slot-hanyan-stick">
                    <view class="slot-hanyan-top"></view>
                    <view class="slot-hanyan-body"></view>
                  </view>
                </block>
                <!-- 普通名烟 / 细支 / 雪茄：上方过滤嘴 + 下方白色/雪茄烟身纸管 -->
                <block wx:else>
                  <view 
                    class="slot-filter-cylinder" 
                    style="background: {{ currentCigarette.filterColor }};"
                  >
                    <!-- 顶部圆形滤嘴切面光泽 -->
                    <view class="filter-top-bevel"></view>
                    <!-- 东方鎏金云纹微雕装饰圈 -->
                    <view class="filter-oriental-swirl"></view>
                    <!-- 滤嘴金箍饰圈 -->
                    <view class="filter-mini-band" style="background: {{ currentCigarette.bandColor }};"></view>
                    <!-- 爆珠专属微型发光晶体点 -->
                    <view class="filter-bead-spark" wx:if="{{ currentCigarette.hasBead }}" style="background: {{ currentCigarette.beadColor }};"></view>
                  </view>
                  <!-- 下方真实白色烟身纸管（阶梯式双排清晰露出） -->
                  <view class="slot-paper-cylinder" style="background: {{ currentCigarette.paperColor || '#fffdf5' }};">
                    <view class="slot-paper-ribbing"></view>
                  </view>
                </block>
              </view>

              <!-- 当该位置烟支已被抽走时：原位置保持空着，露出立体深色空槽位 -->
              <view class="slot-empty-groove" wx:else>
                <view class="empty-socket-rim"></view>
                <view class="empty-shadow"></view>
              </view>
            </view>
          </view>

        </view>

        <!-- ==================== 3D 翻盖盒盖 (Flip-Top Lid - 开盖时朝上后仰呈立体角度，绝不挡烟) ==================== -->
        <view class="pack-flip-lid" catchtap="togglePackLid">
          <!-- 盒盖外立面 -->
          <view class="lid-face-outer {{ currentCigarette.packImage ? 'has-real-lid' : '' }}">
            <!-- 真实名烟盖顶大图切片 (100% 还原真实名烟) -->
            <image 
              class="pack-lid-real-img" 
              src="{{ currentCigarette.packImage }}" 
              mode="scaleToFill" 
              wx:if="{{ currentCigarette.packImage }}" 
            />
            <!-- 表面高光反光涂层 -->
            <view class="facade-sheen-overlay"></view>
            <!-- 闭合时底部极细物理缝隙阴影 -->
            <view class="lid-bottom-slit-shadow"></view>
          </view>
          <!-- 盒盖朝上后仰翻转时的 3D 立体结构 (顶部斜切厚度面 + 铝箔压边 + 内壁凹槽 + 左右立体三角斜翼 + 后仰铰链深影) -->
          <view class="lid-face-inner">
            <!-- 朝上后仰时可见的盒盖顶部 3D 斜切外沿厚度面 -->
            <view class="lid-open-top-bevel" style="background: {{ currentCigarette.packTheme.lidGradient || '#991b1b' }};"></view>
            <!-- 盒盖内翻折铝箔金边 -->
            <view class="lid-inner-foil-strip" style="background: {{ currentCigarette.packTheme.foilColor || '#f59e0b' }};"></view>
            <!-- 白卡纸立体凹槽内衬与品牌钢印 -->
            <view class="lid-inner-cardstock">
              <view class="lid-inner-watermark">★ 20 FILTER CIGARETTES ★</view>
              <view class="lid-dust-flap left"></view>
              <view class="lid-dust-flap right"></view>
              <view class="lid-hinge-shadow"></view>
            </view>
          </view>
        </view>

        <!-- ==================== 烟盒主体箱体 (Pack Main Body) ==================== -->
        <view class="pack-main-body" bindtap="togglePackLid">
          <!-- 盒身切口白色卡纸厚度剖面光边缘 -->
          <view class="body-top-rim-edge"></view>

          <!-- 盒体外立面 -->
          <view class="body-face-outer {{ currentCigarette.packImage ? 'has-real-body' : '' }}">
            <!-- 真实名烟盒身主体艺术图 (100% 还原真实名烟) -->
            <image 
              class="pack-body-real-img" 
              src="{{ currentCigarette.packImage }}" 
              mode="scaleToFill" 
              wx:if="{{ currentCigarette.packImage }}" 
            />

            <!-- 表面高光反光涂层 -->
            <view class="facade-sheen-overlay"></view>

            <!-- 未解锁时的磨砂锁罩 -->
            <view class="pack-locked-overlay" wx:if="{{ !isCurrentUnlocked }}">
              <view class="lock-shield-box">
                <text class="lock-shield-icon">🔒</text>
                <text class="lock-shield-title">名烟尚在锁定中</text>
                <text class="lock-shield-desc">{{ currentCigarette.unlockDesc }}</text>
              </view>
            </view>

          </view>
        </view>

      </view>

      <!-- 底部 3D 流金双环能量底座与暗夜黑曜晶石台面 -->
      <view class="pack-master-pedestal {{ isPulling ? 'pedestal-rippling' : '' }}">
        <view class="pedestal-obsidian-terrace"></view>
        <view class="pedestal-contact-shadow"></view>
        <view class="pedestal-spotlight-pool"></view>
        <view class="pedestal-outer-halo-ring"></view>
        <view class="pedestal-inner-halo-ring"></view>
        <view class="pedestal-front-flare">
          <view class="front-flare-core"></view>
          <view class="front-flare-streak"></view>
        </view>
        <view class="pedestal-ripple-pulse pr-1"></view>
        <view class="pedestal-ripple-pulse pr-2"></view>
      </view>

      <!-- 底座下方：双翼星芒黑金诗笺铭牌 -->
      <view class="pack-slogan-card">
        <view class="slogan-wing wing-left">
          <view class="wing-hairline"></view>
          <text class="wing-star star-outer">✦</text>
          <text class="wing-star star-edge">✦</text>
        </view>
        <view class="slogan-ribbon">
          <text class="slogan-text">{{ currentCigarette.slogan || currentCigarette.description || '告别焦油毒素，拥抱大自然纯净呼吸' }}</text>
        </view>
        <view class="slogan-wing wing-right">
          <text class="wing-star star-edge">✦</text>
          <text class="wing-star star-outer">✦</text>
          <view class="wing-hairline"></view>
        </view>
      </view>

    </view>

    <!-- 1. 渐进深空暗场 (z-index: 302，位于 Canvas 下方，绝不压暗星河轨迹粒子) -->
    <view 
      class="ssr-stage-backdrop {{ isFlightActive ? 'ssr-active' : '' }}" 
      wx:if="{{ isFlightVisible }}"
    ></view>

    <!-- 2. 预挂载 60fps 全屏 2D/3D 九天游龙御剑大回环粒子画布 (z-index: 306，常驻挂载 0ms 零延迟启动) -->
    <canvas 
      type="2d" 
      id="packFlightCanvas" 
      class="pack-flight-canvas {{ isFlightVisible ? 'is-canvas-visible' : '' }}"
    ></canvas>

    <!-- ==================== 腾讯游戏 CG / UE5 级：6阶名烟拔升与S型星河轨迹全屏舞台 (z-index: 310) ==================== -->
    <view 
      class="ssr-awaken-overlay {{ isFlightActive ? 'ssr-active' : '' }} {{ pullVfxType === 'vfx1' ? 'vfx-mode-1' : 'vfx-mode-2' }}" 
      wx:if="{{ isFlightVisible }}"
      bindtap="onTapAwakenOverlay"
      catchtouchmove="preventTouchMove"
    >

      <!-- 2. CSS 3D S-Curve 银河星云三色流光绶带 (与 60fps Canvas 双擎叠加，复刻 04破空盘旋 & 05弧线放大) -->
      <view class="ssr-scurve-galaxy-layer">
        <view class="scurve-ribbon-arc arc-upper"></view>
        <view class="scurve-ribbon-arc arc-middle"></view>
        <view class="scurve-ribbon-arc arc-lower"></view>
      </view>

      <!-- 3. Stage 06 [屏幕呈现] 360° 璀璨鎏金与电光青星芒爆炸法阵 -->
      <view class="ssr-sky-pillar" style="--brand-accent: {{ currentCigarette.packTheme.accentColor || '#fbbf24' }};"></view>
      <view class="ssr-shockwave-ring ring-1"></view>
      <view class="ssr-shockwave-ring ring-2"></view>

      <view class="ssr-celestial-wheel">
        <view class="ssr-god-rays"></view>
        <view class="ssr-radial-starburst">
          <view class="starburst-ray sr-1"></view>
          <view class="starburst-ray sr-2"></view>
          <view class="starburst-ray sr-3"></view>
          <view class="starburst-ray sr-4"></view>
          <view class="starburst-ray sr-5"></view>
          <view class="starburst-ray sr-6"></view>
        </view>
        <view class="ssr-sacred-halo">
          <view class="halo-diamond d-top">✦</view>
          <view class="halo-diamond d-right">✦</view>
          <view class="halo-diamond d-bottom">✦</view>
          <view class="halo-diamond d-left">✦</view>
        </view>
        <view class="ssr-inner-energy-ring"></view>
      </view>

      <!-- 4. 漫天星河微粒与垂直拔升光羽流线 -->
      <view class="ssr-particles-field">
        <view class="ssr-ember-particle p1"></view>
        <view class="ssr-ember-particle p2"></view>
        <view class="ssr-ember-particle p3"></view>
        <view class="ssr-ember-particle p4"></view>
        <view class="ssr-ember-particle p5"></view>
        <view class="ssr-ember-particle p6"></view>
        <view class="ssr-ember-particle p7"></view>
        <view class="ssr-ember-particle p8"></view>
        <view class="ssr-light-streamer st1"></view>
        <view class="ssr-light-streamer st2"></view>
        <view class="ssr-light-streamer st3"></view>
        <view class="ssr-light-streamer st4"></view>
      </view>

      <!-- 5. 主角名烟【宝刀出鞘 · 游龙惊鸿 · 3D剑气星轨环绕】舞台 -->
      <view 
        class="ssr-hero-cigarette-stage"
        style="--filter-bg: {{ currentCigarette.filterColor || '#d97706' }}; --paper-bg: {{ currentCigarette.paperColor || '#fffdf5' }}; --band-bg: {{ currentCigarette.bandColor || '#fbbf24' }}; --bead-color: {{ currentCigarette.beadColor || '#38bdf8' }}; --hero-w: {{ flightStyles.heroW || 38 }}rpx; --hero-h: {{ flightStyles.heroH || 400 }}rpx; --hero-filter-h: {{ flightStyles.heroFilterH || 116 }}rpx; --slot-offset-x: {{ slotOffsetX || 0 }}rpx;"
      >
        <!-- 破鞘与腾空阶段：尾部剑气尾焰 (定格前完全消散，绝不染色烟头) -->
        <view class="ssr-tail-thruster-plume">
          <view class="thruster-core-beam"></view>
          <view class="thruster-side-streak ts-left"></view>
          <view class="thruster-side-streak ts-right"></view>
        </view>

        <!-- 剑气星芒环绕法阵 -->
        <view class="ssr-sword-orbit-system">
          <text class="ssr-blade-sigil sigil-1">✦</text>
          <text class="ssr-blade-sigil sigil-2">❖</text>
          <text class="ssr-blade-sigil sigil-3">✦</text>
          <text class="ssr-blade-sigil sigil-4">❖</text>
        </view>

        <!-- 定格瞬间刀光十字寒芒斩 (X-Slash Starburst Flare) -->
        <view class="ssr-cross-slash">
          <view class="slash-beam beam-a"></view>
          <view class="slash-beam beam-b"></view>
          <view class="slash-core-star">✦</view>
        </view>

        <!-- 香烟 3D 实体 (100% 纯正完整烟支还原，烟头与滤嘴干净纯粹无杂色) -->
        <view class="ssr-hero-cigarette-body {{ currentCigarette.widthType === 'hand_rolled' ? 'is-hanyan-body' : '' }}">
          <!-- 分支 A: 老辈白纸手卷旱烟专属一体式白纸喇叭筒 (与首页 1:1 严密对齐) -->
          <block wx:if="{{ currentCigarette.widthType === 'hand_rolled' }}">
            <view class="ssr-hanyan-cone">
              <view class="ssr-hanyan-paper-cone">
                <view class="ssr-hanyan-top-cut"></view>
                <view class="ssr-hanyan-notebook-lines"></view>
                <view class="ssr-hanyan-spiral-seam"></view>
                <view class="ssr-hanyan-spiral-seam seam-lower"></view>
                <text class="ssr-hanyan-red-stamp">{{ currentCigarette.stampText || '老辈旱烟' }}</text>
                <view class="ssr-blade-sheen"></view>
              </view>
            </view>
          </block>

          <!-- 分支 B: 标准名烟 / 细支爆珠 / 古巴雪茄 3D 纯正完整模型 -->
          <block wx:else>
            <!-- 上段：纯正过滤嘴 (真实本色 + 圆柱光影 + 爆珠标识 + 烫金箍圈) -->
            <view class="ssr-cig-filter">
              <view class="ssr-filter-cylinder-shine"></view>
              <!-- 爆珠璀璨晶核 (仅带爆珠款式显示) -->
              <view class="ssr-bead-gem" wx:if="{{ currentCigarette.hasBead }}">
                <view class="ssr-bead-core"></view>
              </view>
              <!-- 滤嘴烫金箍圈 -->
              <view class="ssr-filter-gold-band"></view>
            </view>

            <!-- 下段：修长纯净烟身纸管 (通体纯净延伸至底端，零杂色色块) -->
            <view class="ssr-cig-paper">
              <view class="ssr-paper-cylinder-shine"></view>
              <text class="ssr-paper-brand-stamp" wx:if="{{ currentCigarette.stampText }}">{{ currentCigarette.stampText }}</text>
            </view>

            <!-- 贯穿全烟身的宝刀寒芒流光 -->
            <view class="ssr-blade-sheen"></view>
          </block>
        </view>
      </view>

      <!-- 6. 腾讯游戏 SSR 传说级黑金铭牌横幅 -->
      <view class="ssr-mythic-banner">
        <view class="ssr-banner-top-tag">
          <text class="ssr-tag-ornament">❖</text>
          <text class="ssr-tag-text">臻品出匣 · 星河就绪</text>
          <text class="ssr-tag-ornament">❖</text>
        </view>
        <view class="ssr-banner-main-box">
          <view class="ssr-banner-wing left-wing"></view>
          <text class="ssr-banner-cig-name">{{ currentCigarette.name }}</text>
          <view class="ssr-banner-wing right-wing"></view>
        </view>
        <view class="ssr-banner-sub-hint">
          <text class="ssr-ignite-dot">✦</text>
          <text class="ssr-ignite-text">轻触屏幕任意位置 · 携烟进入品吸席</text>
          <text class="ssr-ignite-dot">✦</text>
        </view>
      </view>
    </view>


    <!-- 底部操作区 (我抽一支 · 3D 流金金砖胶囊大按键 + 动态扫光) -->
    <view class="pack-bottom-dock">
      <view class="action-buttons-row">
        <view 
          class="action-btn-card pull-btn {{ !isCurrentUnlocked ? 'btn-disabled' : '' }}" 
          bindtap="onTriggerPullCigarette"
        >
          <!-- 底层背光呼吸炽金辉光 -->
          <view class="pull-btn-backlight"></view>
          <view class="pull-btn-outer-ring"></view>
          <view class="btn-edge-flare flare-left">✦</view>
          <view class="btn-edge-flare flare-right">✦</view>
          <view class="pull-btn-top-crest"></view>
          <view class="pull-btn-sheen"></view>
          <view class="btn-text-wrap">
            <text class="btn-main-title">{{ packCount > 0 ? '我抽一支' : '拆封新盒并抽出一支' }}</text>
            <text class="btn-sub-note">{{ packCount > 0 ? '点选盒内烟支 · 直接抽取' : '本盒已空 · 轻触立即拆开新盒' }}</text>
          </view>
        </view>
      </view>
    </view>

  </view>


  <!-- 全局腾讯级灵动微胶囊 Toast HUD -->
  <custom-toast id="customToast" />

</view>
