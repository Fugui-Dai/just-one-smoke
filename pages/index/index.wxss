/* pages/index/index.wxss */

/* ==================== 1. 全局容器与通透曜石微光底色 ==================== */
.app-container {
  position: relative;
  width: 100vw;
  height: 100vh;
  background: radial-gradient(circle at 50% -10%, #182030 0%, #101520 50%, #0b0e16 100%);
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.tab-page {
  display: none;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
}

.tab-page.active {
  display: flex;
  flex-direction: column;
}

/* ==================== 禅意心流：赛博贤者时刻 · 动态灵动浮岛 (Dynamic Zen Island HUD) ==================== */
.zen-hud-capsule {
  position: fixed;
  left: 50%;
  transform: translateX(-50%) translateY(-40rpx) scale(0.92);
  z-index: 999;
  width: 660rpx;
  background: radial-gradient(ellipse at 50% 0%, rgba(36, 30, 24, 0.96) 0%, rgba(18, 16, 14, 0.98) 100%);
  border: 1rpx solid rgba(245, 158, 11, 0.4);
  border-radius: 44rpx;
  box-shadow: 0 20rpx 48rpx rgba(0, 0, 0, 0.85), 0 0 32rpx rgba(245, 158, 11, 0.2), inset 0 1rpx 2rpx rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(28px);
  -webkit-backdrop-filter: blur(28px);
  opacity: 0;
  pointer-events: none;
  transition: all 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  overflow: hidden;
}

.zen-hud-capsule.zen-hud-visible {
  opacity: 1;
  pointer-events: auto;
  transform: translateX(-50%) translateY(0) scale(1);
}

.zen-hud-capsule:active {
  transform: translateX(-50%) scale(0.97);
}

.zhc-ambient-glow {
  position: absolute;
  top: -20rpx;
  left: 20%;
  width: 60%;
  height: 40rpx;
  background: radial-gradient(ellipse, rgba(245, 158, 11, 0.35) 0%, transparent 70%);
  filter: blur(8px);
  pointer-events: none;
}

.zhc-aura-border {
  position: absolute;
  inset: 0;
  border-radius: 44rpx;
  background: linear-gradient(90deg, transparent 0%, rgba(254, 240, 138, 0.25) 50%, transparent 100%);
  pointer-events: none;
}

.zhc-inner-layout {
  position: relative;
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 16rpx 24rpx;
}

.zhc-icon-badge {
  position: relative;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 30%, #3a3228 0%, #1c1814 100%);
  border: 1rpx solid rgba(245, 158, 11, 0.45);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.zib-icon {
  font-size: 30rpx;
}

.zib-breath-dot {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #10b981;
  box-shadow: 0 0 8rpx #10b981;
  border: 2rpx solid #1c1814;
  animation: zibDotPulse 2s infinite ease-in-out;
}

@keyframes zibDotPulse {
  0%, 100% { transform: scale(1); opacity: 0.9; }
  50% { transform: scale(1.3); opacity: 0.5; }
}

.zhc-content-col {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  flex: 1;
  min-width: 0;
}

.zhc-headline-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.zhr-title {
  font-size: 24rpx;
  font-weight: 800;
  color: #fef08a;
  letter-spacing: 0.8rpx;
}

.zhr-tag {
  font-size: 18rpx;
  font-weight: 700;
  color: #10b981;
  background: rgba(16, 185, 129, 0.16);
  border: 1rpx solid rgba(16, 185, 129, 0.35);
  padding: 1rpx 10rpx;
  border-radius: 8rpx;
  line-height: 1.2;
}

.zhc-subtext-row {
  display: flex;
  align-items: center;
}

.zsr-text {
  font-size: 21rpx;
  color: #cbd5e1;
  line-height: 1.35;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  letter-spacing: 0.5rpx;
}

.zhc-arrow-action {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 14rpx;
  background: rgba(245, 158, 11, 0.12);
  border: 1rpx solid rgba(245, 158, 11, 0.28);
  border-radius: 20rpx;
  flex-shrink: 0;
  transition: all 0.2s ease;
}

.zaa-text {
  font-size: 20rpx;
  font-weight: 700;
  color: #fbbf24;
}

.zaa-arrow {
  font-size: 18rpx;
  color: #f59e0b;
}


/* ==================== 🪙 桌面极简冷淡风微距铜托盘/烟灰缸 ==================== */
.desk-ashtray-wrap {
  position: fixed;
  bottom: 38rpx;
  left: 28rpx;
  z-index: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
}

.desk-ashtray-wrap:active {
  transform: scale(0.92);
}

.ashtray-dish {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 40% 35%, #2a2826 0%, #171615 65%, #0a0908 100%);
  border: 2rpx solid rgba(140, 120, 95, 0.3);
  box-shadow: 0 12rpx 28rpx rgba(0, 0, 0, 0.85), inset 0 2rpx 4rpx rgba(255, 255, 255, 0.12);
}

.ashtray-rim {
  position: absolute;
  inset: 8rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  pointer-events: none;
}

.ashtray-bed {
  position: absolute;
  inset: 12rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 50% 50%, #11100f 0%, #080807 100%);
  box-shadow: inset 0 4rpx 10rpx rgba(0, 0, 0, 0.95);
  overflow: hidden;
}

/* 缸底沉淀微距灰渣底晕与散落炭灰粒 */
.ashtray-ash-layer {
  position: absolute;
  inset: 6rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 45% 55%, #1c1917 0%, #292524 45%, #44403c 75%, transparent 100%);
  filter: blur(2px);
  pointer-events: none;
  transition: opacity 0.5s ease-out;
}

.ashtray-ash-flake {
  position: absolute;
  border-radius: 40% 60% 70% 30% / 40% 50% 60% 50%;
  box-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.85);
  pointer-events: none;
  transition: opacity 0.3s ease-out;
}

/* 缸内沉淀微距烟蒂模型 */
.ashtray-butt {
  position: absolute;
  width: 28rpx;
  height: 8rpx;
  border-radius: 2rpx;
  display: flex;
  pointer-events: none;
}

.butt-filter {
  width: 12rpx;
  height: 100%;
  background: var(--butt-filter-color, #ca8a04);
  border-radius: 2rpx 0 0 2rpx;
}

.butt-stub {
  width: 10rpx;
  height: 100%;
  background: #d4d4d8;
}

.butt-ash-tip {
  flex: 1;
  height: 100%;
  background: #27272a;
  border-radius: 0 2rpx 2rpx 0;
}

