.gift-dialog-card {
  position: relative;
  width: 650rpx;
  max-width: 90vw;
  background: radial-gradient(circle at 50% 0%, rgba(16, 185, 129, 0.18) 0%, rgba(15, 23, 42, 0.96) 65%);
