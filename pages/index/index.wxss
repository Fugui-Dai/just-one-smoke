/* 余温袅袅冷烟 */
.ashtray-cold-smoke {
  position: absolute;
  top: 10rpx;
  left: 50%;
  width: 6rpx;
  height: 36rpx;
  background: linear-gradient(180deg, transparent 0%, rgba(148, 163, 184, 0.25) 50%, transparent 100%);
  border-radius: 50%;
  filter: blur(2px);
  animation: coldSmokeRise 3.5s infinite ease-in-out;
  pointer-events: none;
}

@keyframes coldSmokeRise {
  0% { transform: translateX(-50%) translateY(10rpx) scaleX(0.8); opacity: 0; }
  50% { transform: translateX(-40%) translateY(-10rpx) scaleX(1.4); opacity: 0.6; }
  100% { transform: translateX(-60%) translateY(-28rpx) scaleX(2.2); opacity: 0; }
}

.ashtray-badge {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  min-width: 28rpx;
  height: 28rpx;
  border-radius: 14rpx;
  background: #d97706;
  color: #fff;
  font-size: 18rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 6rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.6);
}

/* ==================== 🍂 桌面雅致心绪笺 (写下心事 · 随烟散尽) ==================== */
.desk-mood-note-wrap {
  position: fixed;
  bottom: 38rpx;
  right: 28rpx;
  z-index: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

.desk-mood-note-wrap:active {
  transform: scale(0.92);
}

.mood-note-paper {
  position: relative;
  min-width: 96rpx;
  height: 96rpx;
  padding: 0 16rpx;
  border-radius: 48rpx;
  background: radial-gradient(circle at 35% 30%, #2a2521 0%, #171513 65%, #0e0c0b 100%);
  border: 1rpx solid rgba(212, 175, 125, 0.28);
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.8), inset 0 1rpx 2rpx rgba(255, 255, 255, 0.12);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  transition: all 0.3s ease;
}

.has-mood-note .mood-note-paper {
  min-width: 150rpx;
  height: 76rpx;
  border-radius: 38rpx;
  background: radial-gradient(ellipse at 50% 30%, #352b22 0%, #1e1814 65%, #0f0c0a 100%);
  border: 1rpx solid rgba(245, 158, 11, 0.45);
  box-shadow: 0 0 16rpx rgba(245, 158, 11, 0.25), inset 0 1rpx 2rpx rgba(255, 255, 255, 0.2);
}

.mood-note-icon {
  font-size: 28rpx;
}

.mood-note-label {
  font-size: 20rpx;
  color: #d6cfc7;
  letter-spacing: 1rpx;
  margin-top: 2rpx;
}

.mood-note-tag {
  font-size: 22rpx;
  font-weight: 600;
  color: #fde68a;
  letter-spacing: 1rpx;
  max-width: 160rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mood-note-sub {
  font-size: 16rpx;
  color: rgba(253, 230, 138, 0.65);
  letter-spacing: 0.5rpx;
}

/* 吸烟中：心绪文字随烟雾微粒散化 */
.mood-dissolving .mood-note-paper {
  border-color: rgba(245, 158, 11, 0.8);
  box-shadow: 0 0 24rpx rgba(245, 158, 11, 0.6), inset 0 0 10rpx rgba(245, 158, 11, 0.4);
  animation: moodPulseGlow 1.8s infinite ease-in-out;
}

@keyframes moodPulseGlow {
  0%, 100% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.05); opacity: 0.8; }
}

/* ==================== 🪙 桌面青铜/紫砂烟灰缸 · 岁月留痕微距展台弹窗 ==================== */
.ashtray-dialog-card {
  width: 650rpx;
  border-radius: 40rpx;
  background: radial-gradient(circle at 50% 15%, rgba(32, 28, 24, 0.96) 0%, rgba(18, 16, 14, 0.98) 100%);
  backdrop-filter: blur(32px);
  -webkit-backdrop-filter: blur(32px);
  border: 1rpx solid rgba(212, 175, 125, 0.28);
  box-shadow: 0 32rpx 80rpx rgba(0, 0, 0, 0.95), inset 0 1rpx 2rpx rgba(255, 255, 255, 0.15);
  padding: 36rpx 36rpx 42rpx;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.adc-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.adc-title-box {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.adc-icon-svg {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
}

.adc-icon {
  font-size: 38rpx;
}

.adc-title-col {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.adc-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #fef08a;
  letter-spacing: 1rpx;
}

.adc-sub-tag {
  font-size: 20rpx;
  color: #94a3b8;
  letter-spacing: 0.5rpx;
}

.adc-close-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  color: #94a3b8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

/* 微距微观展台 */
.adc-visual-stage {
  margin: 28rpx auto 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.adc-tray-mock {
  position: relative;
  width: 190rpx;
  height: 190rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 30%, #3a322a 0%, #1e1b17 65%, #0e0c0a 100%);
  border: 3rpx solid rgba(212, 175, 125, 0.45);
  box-shadow: 0 16rpx 36rpx rgba(0, 0, 0, 0.85), inset 0 2rpx 4rpx rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.atm-ring-glow {
  position: absolute;
  inset: 12rpx;
  border-radius: 50%;
  border: 1rpx dashed rgba(245, 158, 11, 0.25);
  pointer-events: none;
}

.atm-inner-bed {
  position: absolute;
  inset: 20rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 50% 50%, #12100e 0%, #080706 100%);
  box-shadow: inset 0 6rpx 16rpx rgba(0, 0, 0, 0.98);
  overflow: hidden;
}

.atm-sweep-brush {
  position: absolute;
  top: 0;
  bottom: 0;
  left: -40%;
  width: 180%;
  pointer-events: none;
  z-index: 25;
  background: linear-gradient(90deg, transparent 0%, rgba(251, 191, 36, 0.2) 30%, rgba(255, 255, 255, 0.85) 50%, rgba(251, 191, 36, 0.3) 70%, transparent 100%);
  transform: skewX(-25deg);
  opacity: 0;
}
.atm-sweep-brush.sweep-active {
  animation: sweepTrayGleam 0.55s cubic-bezier(0.22, 1, 0.36, 1) forwards;
}
@keyframes sweepTrayGleam {
  0% { transform: translateX(-120%) skewX(-25deg); opacity: 0; }
  30% { opacity: 1; }
  100% { transform: translateX(120%) skewX(-25deg); opacity: 0; }
}

.atm-ash-shadow {
  position: absolute;
  inset: 8rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 45% 55%, #1c1917 0%, #292524 45%, #44403c 75%, transparent 100%);
  filter: blur(3px);
  pointer-events: none;
}

.atm-ash-flake {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  filter: blur(0.5px);
  z-index: 1;
}

.atm-butt-item {
  position: absolute;
  width: 44rpx;
  height: 12rpx;
  border-radius: 3rpx;
  display: flex;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.9);
  pointer-events: none;
}

.atm-butt-item .butt-filter {
  width: 18rpx;
  height: 100%;
  background: var(--butt-filter-color, #ca8a04);
  border-radius: 3rpx 0 0 3rpx;
}

.atm-butt-item .butt-stub {
  width: 16rpx;
  height: 100%;
  background: #e4e4e7;
}

.atm-butt-item .butt-ash-tip {
  flex: 1;
  height: 100%;
  background: #18181b;
  border-radius: 0 3rpx 3rpx 0;
}

