/* pages/index/index.wxss */

/* ==================== 1. 全局容器与暗黑微光底色 ==================== */
.app-container {
  position: relative;
  width: 100vw;
  height: 100vh;
  background: #000000;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.tab-page {
  display: none;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
}

.tab-page.active {
  display: flex;
  flex-direction: column;
}


/* ==================== 2. 顶部统一自定义导航栏 (适配微信胶囊) ==================== */
.custom-navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: none;
  border-bottom: none;
  box-sizing: border-box;
  pointer-events: none;
}

.navbar-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-left: 28rpx;
  box-sizing: border-box;
}

.nav-brand {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.brand-ember-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #ff6600;
  box-shadow: 0 0 14rpx #ff6600;
  animation: pulse-ember 2s infinite ease-in-out;
}

@keyframes pulse-ember {
  0%, 100% { opacity: 0.8; transform: scale(1); }
  50% { opacity: 1; transform: scale(1.25); box-shadow: 0 0 20rpx #ff7700; }
}

.brand-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #f9fafb;
  letter-spacing: 1rpx;
}

.brand-tag {
  font-size: 20rpx;
  color: #ff9944;
  background: rgba(255, 102, 0, 0.15);
  border: 1px solid rgba(255, 102, 0, 0.3);
  padding: 2rpx 10rpx;
  border-radius: 12rpx;
  font-weight: 500;
}

/* 实机同款：顶栏独立胶囊按钮 [ ··· 抽烟环境 ] */
.top-capsule-single {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  background: rgba(18, 14, 10, 0.75);
  border: 1px solid rgba(255, 255, 255, 0.18);
  border-radius: 36rpx;
  height: 64rpx;
  padding: 0 24rpx;
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.45);
  transition: all 0.2s ease;
  pointer-events: auto;
}

.top-capsule-single:active {
  background: rgba(255, 255, 255, 0.15);
  transform: scale(0.97);
}

.top-capsule-row {
  display: inline-flex;
  align-items: center;
  background: rgba(18, 14, 10, 0.75);
  border: 1px solid rgba(255, 255, 255, 0.18);
  border-radius: 36rpx;
  height: 64rpx;
  padding: 0 4rpx;
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.45);
}

.capsule-half {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 18rpx;
  height: 100%;
  box-sizing: border-box;
  transition: all 0.2s ease;
}

.capsule-half:active {
  background: rgba(255, 255, 255, 0.12);
  border-radius: 30rpx;
}

.capsule-dots {
  font-size: 26rpx;
  font-weight: 900;
  color: #e2e8f0;
  letter-spacing: -2rpx;
}

.capsule-dot-icon {
  font-size: 22rpx;
  color: #fbbf24;
}

.capsule-label {
  font-size: 22rpx;
  font-weight: 700;
  color: #f8fafc;
  letter-spacing: 0.5rpx;
}

.capsule-divider {
  width: 1px;
  height: 26rpx;
  background: rgba(255, 255, 255, 0.18);
}

.navbar-back-btn {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.16);
  padding: 6rpx 20rpx;
  border-radius: 30rpx;
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
}

.navbar-back-btn:active {
  transform: scale(0.96);
  background: rgba(255, 255, 255, 0.14);
}

.back-arrow {
  font-size: 32rpx;
  color: #fbbf24;
  line-height: 1;
}

.back-text {
  font-size: 22rpx;
  color: #f8fafc;
  font-weight: 700;
}

.day-pill {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(16, 185, 129, 0.15);
  border: 1px solid rgba(16, 185, 129, 0.35);
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #34d399;
  font-weight: 600;
}

.day-pulse {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #10b981;
  box-shadow: 0 0 10rpx #10b981;
}

.achieve-pill {
  background: rgba(245, 158, 11, 0.15);
  border: 1px solid rgba(245, 158, 11, 0.3);
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #fbbf24;
  font-weight: 600;
}

.nav-setting-btn {
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.12);
  color: #e5e7eb;
  padding: 8rpx 18rpx;
  border-radius: 28rpx;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-right: 16rpx;
  transition: all 0.2s ease;
}

.nav-setting-btn:active {
  transform: scale(0.96);
  background: rgba(255, 255, 255, 0.14);
}


/* ==================== 3. TAB 1: 沉浸式模拟器主页 ==================== */
.simulator-tab {
  display: none;
  width: 100%;
  height: 100%;
  position: relative;
  box-sizing: border-box;
}

.simulator-tab.active {
  display: block;
}

/* 画布容器 (全屏无界 100% 覆盖) */
.canvas-wrapper {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
  z-index: 1;
}

.smoke-canvas {
  width: 100%;
  height: 100%;
}

/* 悬浮提示胶囊 */
.hint-pill {
  position: absolute;
  top: 240rpx;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(17, 24, 39, 0.88);
  border: 1px solid rgba(255, 255, 255, 0.15);
  color: #9ca3af;
  font-size: 24rpx;
  padding: 10rpx 28rpx;
  border-radius: 30rpx;
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  z-index: 10;
  white-space: nowrap;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.4);
}

.hint-pill.unlit {
  border-color: rgba(255, 102, 0, 0.4);
  color: #ff9944;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.pulse-spark {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #ff6600;
  box-shadow: 0 0 10rpx #ff6600;
  animation: pulse-ember 1.5s infinite;
}

.pulse-spark.green {
  background: #10b981;
  box-shadow: 0 0 10rpx #10b981;
}

.hint-pill.sos-pill {
  border-color: rgba(16, 185, 129, 0.5);
  background: rgba(6, 78, 59, 0.85);
  color: #6ee7b7;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 10rpx;
  animation: pulse-breathing 2s infinite ease-in-out;
}

.hint-pill.burning {
  border-color: rgba(255, 255, 255, 0.18);
  color: #e5e7eb;
}

.hint-pill.inhaling {
  border-color: rgba(56, 189, 248, 0.4);
  color: #7dd3fc;
  background: rgba(12, 74, 110, 0.88);
}

.hint-pill.exhaling {
  border-color: rgba(16, 185, 129, 0.4);
  color: #6ee7b7;
}

.hint-pill.breathing {
  animation: pulse-breathing 2s infinite ease-in-out;
}

.hint-pill.breathing.inhale {
  border-color: #38bdf8;
  color: #7dd3fc;
  background: rgba(14, 116, 144, 0.88);
  box-shadow: 0 0 24rpx rgba(56, 189, 248, 0.45);
}

.hint-pill.breathing.hold {
  border-color: #2dd4bf;
  color: #5eead4;
  background: rgba(13, 148, 136, 0.88);
  box-shadow: 0 0 24rpx rgba(45, 212, 191, 0.45);
}

.hint-pill.breathing.exhale {
  border-color: #a855f7;
  color: #d8b4fe;
  background: rgba(88, 28, 135, 0.88);
  box-shadow: 0 0 24rpx rgba(168, 85, 247, 0.45);
}

@keyframes pulse-breathing {
  0%, 100% { transform: translateX(-50%) scale(1); }
  50% { transform: translateX(-50%) scale(1.05); }
}


/* ==================== 4. 顶部沉浸状态栏 (右侧排行榜徽章靠右对齐，左侧完全留白呼吸) ==================== */
.simulator-top-bar {
  position: absolute;
  right: 24rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  z-index: 30;
  pointer-events: none;
}

.top-stats-pill {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 20rpx;
  background: rgba(15, 23, 42, 0.75);
  border: 1px solid rgba(52, 211, 153, 0.35);
  border-radius: 30rpx;
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.4);
}

.tsp-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #10b981;
  box-shadow: 0 0 8rpx #10b981;
}

.tsp-text {
  font-size: 22rpx;
  color: #94a3b8;
  font-weight: 600;
  letter-spacing: 0.3rpx;
}

.tsp-num {
  color: #34d399;
  font-weight: 700;
  font-family: monospace;
}




/* ==================== 底部核心操作栏 (3个按钮) ==================== */
.bottom-action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom, 0px));
  background: rgba(14, 18, 28, 0.92);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border-top: 1px solid rgba(255, 255, 255, 0.1);
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: center;
  justify-content: space-around;
  gap: 16rpx;
  z-index: 100;
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  flex: 1;
  background: transparent;
  border: none;
  padding: 0;
  line-height: normal;
}

.action-btn:active {
  transform: scale(0.92);
  transition: transform 0.15s ease;
}

/* 重置微信button样式 */
.action-btn::after {
  border: none;
}

.btn-icon-circle {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  border: 2px solid rgba(255, 255, 255, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.25s ease;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
}

.btn-emoji {
  font-size: 38rpx;
  line-height: 1;
}

.btn-label {
  font-size: 22rpx;
  font-weight: 600;
  color: #cbd5e1;
  letter-spacing: 0.5rpx;
}

/* 主按钮(猛吸) */
.action-btn-primary .btn-icon-circle {
  background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
  border-color: #fbbf24;
  box-shadow: 0 6rpx 20rpx rgba(245, 158, 11, 0.4);
  width: 100rpx;
  height: 100rpx;
}

.action-btn-primary .btn-label {
  color: #fbbf24;
  font-weight: 800;
}

/* 点燃状态 */
.btn-icon-circle.is-lit {
  border-color: rgba(245, 158, 11, 0.7);
  box-shadow: 0 0 18rpx rgba(245, 158, 11, 0.5);
  background: rgba(245, 158, 11, 0.16);
}

/* 吸气激活状态 */
.btn-icon-circle.is-active {
  border-color: #38bdf8;
  background: linear-gradient(135deg, #38bdf8 0%, #0ea5e9 100%);
  box-shadow: 0 0 24rpx rgba(56, 189, 248, 0.6);
  transform: scale(1.08);
}



/* ==================== 右上角音效开关 ==================== */
.top-right-mute-btn {
  position: absolute;
  right: 32rpx;
  top: 32rpx;
  z-index: 60;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(14, 18, 28, 0.95) 0%, rgba(20, 25, 38, 0.92) 100%);
  backdrop-filter: blur(32px);
  -webkit-backdrop-filter: blur(32px);
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  box-shadow:
    0 8rpx 32rpx rgba(0, 0, 0, 0.6),
    inset 1rpx 1rpx 2rpx rgba(255, 255, 255, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.top-right-mute-btn:active {
  transform: scale(0.88);
  background: linear-gradient(135deg, rgba(245, 158, 11, 0.2) 0%, rgba(217, 119, 6, 0.15) 100%);
  border-color: rgba(245, 158, 11, 0.4);
}

.mute-icon {
  font-size: 32rpx;
  line-height: 1;
  filter: drop-shadow(0 2rpx 4rpx rgba(0, 0, 0, 0.3));
}





/* ==================== 6. 右侧暗黑奇幻异形 DOCK 栏 (古典 S 形曲线 · 纤巧双层金线 · 完美裹覆) ==================== */
.right-arc-dock {
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-48%);
  width: 116rpx;
  box-sizing: border-box;
  background: transparent;
  border: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 86rpx 0 78rpx 14rpx;
  gap: 12rpx;
  z-index: 45;
  overflow: visible;
}

/* 一体化数学相切流体外壳底衬 (SVG 矢量精确贴合 · 绝对零接缝) */
.dock-fluid-shell-bg {
  position: absolute;
  top: 0;
  right: 0;
  width: 116rpx;
  height: 100%;
  pointer-events: none;
  z-index: 1;
}

/* 每一个操作按钮胶囊单元 */
.dock-btn-wrap {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  cursor: pointer;
  background: transparent;
  border: none;
  padding: 0;
  margin: 0;
  line-height: normal;
  transition: transform 0.18s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.dock-btn-wrap:active {
  transform: scale(0.90);
}

/* 针对微信 button.share-dock-item 的样式重置 */
button.dock-btn-wrap.share-dock-item {
  width: 100% !important;
  min-height: 0 !important;
  padding: 0 !important;
  margin: 0 !important;
  background: transparent !important;
  border: none !important;
  border-radius: 0 !important;
  outline: none !important;
  line-height: normal !important;
  font-weight: normal;
}
button.dock-btn-wrap.share-dock-item::after {
  border: none !important;
}

/* 圆形按钮实体 (新一代高质感黑曜晶碟 · 1.5px 凝光微倒角丝印 · 实体色彩防透明) */
.dock-circle-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(22, 28, 42, 0.96);
  border: 1.5rpx solid rgba(255, 255, 255, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.55), inset 0 1rpx 1rpx rgba(255, 255, 255, 0.20);
  transition: all 0.22s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.dock-icon {
  font-size: 34rpx;
  line-height: 1;
}

.dock-svg-icon {
  width: 48rpx;
  height: 48rpx;
  display: block;
  transition: transform 0.22s cubic-bezier(0.34, 1.56, 0.64, 1), filter 0.22s ease;
  pointer-events: none;
}

.dock-svg-icon.sound-svg-icon {
  width: 44rpx;
  height: 44rpx;
  filter: drop-shadow(0 2rpx 10rpx rgba(56, 189, 248, 0.55));
}

.dock-svg-icon.scene-svg-icon {
  width: 46rpx;
  height: 46rpx;
  filter: drop-shadow(0 2rpx 10rpx rgba(52, 211, 153, 0.55));
}

.dock-svg-icon.ignite-svg-icon {
  width: 48rpx;
  height: 48rpx;
  filter: drop-shadow(0 2rpx 12rpx rgba(245, 158, 11, 0.65));
}

.dock-svg-icon.extinguish-svg-icon {
  width: 48rpx;
  height: 48rpx;
  filter: drop-shadow(0 2rpx 12rpx rgba(244, 63, 94, 0.75));
}

.dock-svg-icon.inhale-svg-icon {
  width: 46rpx;
  height: 46rpx;
  filter: drop-shadow(0 2rpx 10rpx rgba(56, 189, 248, 0.50));
}

.dock-svg-icon.vfx-svg-icon {
  width: 46rpx;
  height: 46rpx;
  filter: drop-shadow(0 2rpx 12rpx rgba(192, 132, 252, 0.60));
}

.dock-svg-icon.ash-svg-icon {
  width: 42rpx;
  height: 42rpx;
  filter: drop-shadow(0 2rpx 10rpx rgba(245, 158, 11, 0.45));
}

.dock-svg-icon.share-svg-icon {
  width: 44rpx;
  height: 44rpx;
  filter: drop-shadow(0 2rpx 10rpx rgba(52, 211, 153, 0.50));
}

.dock-svg-icon.store-svg-icon {
  width: 44rpx;
  height: 44rpx;
  filter: drop-shadow(0 2rpx 10rpx rgba(251, 191, 36, 0.45));
}

.dock-svg-icon.rank-svg-icon {
  width: 46rpx;
  height: 46rpx;
  filter: drop-shadow(0 2rpx 12rpx rgba(251, 191, 36, 0.60));
}

.dock-svg-icon.my-svg-icon {
  width: 46rpx;
  height: 46rpx;
  filter: drop-shadow(0 2rpx 12rpx rgba(192, 132, 252, 0.55));
}

.dock-char-icon {
  font-size: 30rpx;
  font-weight: 800;
  color: #e2e8f0;
  line-height: 1;
}

.dock-char-icon.scene-char-icon {
  font-size: 32rpx;
  line-height: 1;
  display: block;
  filter: drop-shadow(0 2rpx 8rpx rgba(0, 0, 0, 0.65));
}

.dock-char-icon.my-char {
  color: #fbbf24;
  font-weight: 900;
  font-size: 32rpx;
}

.dock-circle-btn.my-btn-circle.is-vip-my-btn {
  border-color: rgba(251, 191, 36, 0.78);
  background: radial-gradient(circle, rgba(251, 191, 36, 0.22) 0%, rgba(28, 22, 12, 0.90) 100%);
  box-shadow: 0 0 18rpx rgba(251, 191, 36, 0.42), inset 0 0 10rpx rgba(254, 240, 138, 0.22);
}

.my-vip-crown-badge {
  position: absolute;
  top: -10rpx;
  right: -8rpx;
  font-size: 22rpx;
  line-height: 1;
  filter: drop-shadow(0 2rpx 6rpx rgba(0, 0, 0, 0.85));
  pointer-events: none;
  z-index: 6;
}


.dock-title {
  font-size: 19rpx;
  font-weight: 500;
  color: rgba(248, 242, 230, 0.92);
  margin-top: 3rpx;
  letter-spacing: 0.6rpx;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.95);
  white-space: nowrap;
}

.dock-sub-title {
  font-size: 20rpx;
  color: #d97706;
  margin-top: 1rpx;
  letter-spacing: 0.3rpx;
}

/* 1. 点燃 / 掐灭状态 (温润炽焰金晶 · 燃时余烬呼吸与掐熄微光) */
.dock-circle-btn.ignite-btn {
  border: 1.5rpx solid rgba(251, 191, 36, 0.75);
  background: radial-gradient(circle at 35% 28%, #fbbf24 0%, #ea580c 48%, #431407 100%);
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.60), 0 0 18rpx rgba(234, 88, 12, 0.45), inset 0 2rpx 3rpx rgba(254, 240, 138, 0.55);
}

.dock-circle-btn.ignite-btn.is-lit {
  border-color: rgba(239, 68, 68, 0.85);
  box-shadow: 0 0 20rpx rgba(239, 68, 68, 0.65), inset 0 0 10rpx rgba(245, 158, 11, 0.35);
  background: radial-gradient(circle, rgba(239, 68, 68, 0.32) 0%, rgba(245, 158, 11, 0.15) 50%, rgba(20, 22, 32, 0.96) 100%);
  animation: extinguish-breathe 2.4s infinite ease-in-out;
}

.dock-circle-btn.ignite-btn.is-lit .dock-svg-icon {
  filter: drop-shadow(0 2rpx 10rpx rgba(239, 68, 68, 0.75));
}

.dock-circle-btn.ignite-btn.is-lit:active {
  transform: scale(0.92);
  box-shadow: 0 0 10rpx rgba(239, 68, 68, 0.8);
}

@keyframes extinguish-breathe {
  0%, 100% {
    box-shadow: 0 0 16rpx rgba(239, 68, 68, 0.5), inset 0 0 8rpx rgba(245, 158, 11, 0.25);
    transform: scale(1);
  }
  50% {
    box-shadow: 0 0 26rpx rgba(239, 68, 68, 0.85), inset 0 0 14rpx rgba(245, 158, 11, 0.45);
    transform: scale(1.05);
  }
}

/* 2. 猛吸状态 */
.dock-circle-btn.inhale-btn.is-active-inhale {
  border-color: #38bdf8;
  background: rgba(56, 189, 248, 0.25);
  box-shadow: 0 0 20rpx rgba(56, 189, 248, 0.65);
  transform: scale(1.08);
}

/* 3. 烟雾特效：幻境星云紫晶宝玉 (高奢幻紫与星光微晕) */
.dock-circle-btn.smoke-effect-btn {
  border: 1.5rpx solid rgba(192, 132, 252, 0.75);
  background: radial-gradient(circle at 35% 28%, #c084fc 0%, #7c3aed 48%, #2e0854 100%);
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.60), 0 0 16rpx rgba(124, 58, 237, 0.40), inset 0 2rpx 3rpx rgba(255, 255, 255, 0.50);
}

/* 4. 抖灰：圆形烟灰进度条 (黑曜实色底盘 · 防透明 · 顺时针高精度圆弧进度) */
.dock-circle-btn.ash-btn-circle {
  position: relative;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 1.5rpx solid rgba(255, 255, 255, 0.24);
  background: rgba(20, 26, 40, 0.96);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.55), inset 0 1rpx 1rpx rgba(255, 255, 255, 0.18);
  transition: transform 0.15s cubic-bezier(0.34, 1.56, 0.64, 1);
}

/* 点击弹灰物理轻压微下陷回弹 */
.dock-circle-btn.ash-btn-circle.is-tapping {
  transform: scale(0.92);
}

.ash-progress-ring {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  pointer-events: none;
  box-shadow: 0 0 14rpx rgba(245, 158, 11, 0.35);
  transition: background 0.25s ease-out, box-shadow 0.25s ease-out;
}

.dock-circle-btn.ash-btn-circle.has-ash {
  border-color: rgba(245, 158, 11, 0.60);
  box-shadow: 0 0 16rpx rgba(245, 158, 11, 0.40);
}

.dock-circle-btn.ash-btn-circle.has-ash .ash-progress-ring {
  box-shadow: 0 0 16rpx rgba(245, 158, 11, 0.65);
}

.dock-circle-btn.ash-btn-circle.alert-ash {
  border-color: rgba(239, 68, 68, 0.85);
  box-shadow: 0 0 20rpx rgba(239, 68, 68, 0.65);
}

.dock-circle-btn.ash-btn-circle.alert-ash .ash-progress-ring {
  box-shadow: 0 0 22rpx rgba(239, 68, 68, 0.85);
  animation: pulseAsh 1s infinite alternate;
}

.ash-btn-inner {
  position: relative;
  z-index: 2;
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 28%, #475569 0%, #1e293b 48%, #090d16 100%);
  border: 1px solid rgba(148, 163, 184, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 2rpx 4rpx rgba(255, 255, 255, 0.25);
  transition: all 0.22s ease;
}

.dock-circle-btn.ash-btn-circle.has-ash .ash-btn-inner {
  border-color: rgba(245, 158, 11, 0.60);
}

.dock-circle-btn.ash-btn-circle.alert-ash .ash-btn-inner {
  border-color: rgba(239, 68, 68, 0.85);
}

.dock-char-icon.ash-char {
  font-size: 28rpx;
  font-weight: 900;
  color: #94a3b8;
  line-height: 1;
  transition: color 0.2s ease, text-shadow 0.2s ease;
}

.dock-circle-btn.ash-btn-circle.has-ash .ash-char {
  color: #fbbf24;
  text-shadow: 0 0 10rpx rgba(245, 158, 11, 0.75);
}

.dock-circle-btn.ash-btn-circle.alert-ash .ash-char {
  color: #ef4444;
  text-shadow: 0 0 14rpx rgba(239, 68, 68, 0.85);
}

@keyframes pulseAsh {
  from { transform: scale(1); }
  to { transform: scale(1.06); }
}

/* 5. 递烟：纯净黑曜晶碟 · 仅外圈进度环显示烟盒余量 · 就跟抖灰完全一致 */
.dock-circle-btn.share-btn-circle {
  position: relative;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 1.5rpx solid rgba(255, 255, 255, 0.24);
  background: rgba(20, 26, 40, 0.96);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.55), inset 0 1rpx 1rpx rgba(255, 255, 255, 0.18);
  transition: transform 0.15s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.share-progress-ring {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  pointer-events: none;
  box-shadow: 0 0 14rpx rgba(52, 211, 153, 0.35);
  transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.share-btn-inner {
  position: relative;
  z-index: 2;
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 28%, #2dd4bf 0%, #0d9488 48%, #042f2e 100%);
  border: 1px solid rgba(94, 234, 212, 0.65);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 2rpx 3rpx rgba(255, 255, 255, 0.45);
  transition: all 0.22s ease;
}

/* 1. 音效：深海蓝宝微光晶碟 */
.dock-circle-btn.sound-btn-circle {
  border: 1.5rpx solid rgba(56, 189, 248, 0.45);
  background: radial-gradient(circle at 50% 35%, rgba(56, 189, 248, 0.22) 0%, rgba(15, 23, 42, 0.94) 80%);
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.65), 0 0 14rpx rgba(56, 189, 248, 0.22), inset 0 1rpx 1.5rpx rgba(255, 255, 255, 0.20);
}

.dock-circle-btn.sound-btn-circle.is-muted-btn {
  border: 1.5rpx solid rgba(148, 163, 184, 0.35);
  background: radial-gradient(circle at 50% 35%, rgba(148, 163, 184, 0.12) 0%, rgba(15, 23, 42, 0.94) 80%);
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.65), inset 0 1rpx 1.5rpx rgba(255, 255, 255, 0.12);
}

/* 2. 抽烟环境：黑曜灵动晶碟 (微光内晕 + 呼吸光环) */
.dock-circle-btn.scene-btn-circle {
  border: 1.5rpx solid rgba(52, 211, 153, 0.45);
  background: radial-gradient(circle at 50% 35%, rgba(52, 211, 153, 0.20) 0%, rgba(15, 23, 42, 0.94) 80%);
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.65), 0 0 14rpx rgba(52, 211, 153, 0.22), inset 0 1rpx 1.5rpx rgba(255, 255, 255, 0.20);
}

/* 6. 商店：黑曜琥珀微金晶碟 (高阶温润琥珀微晕) */
.dock-circle-btn.store-btn-circle {
  border: 1.5rpx solid rgba(245, 158, 11, 0.50);
  background: radial-gradient(circle at 50% 35%, rgba(245, 158, 11, 0.22) 0%, rgba(20, 24, 38, 0.94) 80%);
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.65), 0 0 14rpx rgba(245, 158, 11, 0.25), inset 0 1rpx 1.5rpx rgba(255, 255, 255, 0.20);
}

/* 7. 排行榜：星夜曜石黑紫天鹅绒 (高对比度深邃底盘，冠军金杯熠熠生辉) */
.dock-circle-btn.rank-btn-circle {
  border: 1.5rpx solid rgba(251, 191, 36, 0.65);
  background: radial-gradient(circle at 50% 30%, rgba(129, 140, 248, 0.30) 0%, rgba(49, 46, 129, 0.40) 45%, rgba(15, 20, 36, 0.96) 85%);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.70), 0 0 18rpx rgba(129, 140, 248, 0.32), inset 0 1rpx 2rpx rgba(254, 240, 138, 0.45);
}

/* 8. 我的：深曜玄金晶碟 */
.dock-circle-btn.my-btn-circle {
  border: 1.5rpx solid rgba(251, 191, 36, 0.50);
  background: radial-gradient(circle at 50% 35%, rgba(254, 240, 138, 0.15) 0%, rgba(24, 22, 34, 0.94) 80%);
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.65), 0 0 14rpx rgba(251, 191, 36, 0.22), inset 0 1rpx 1.5rpx rgba(255, 255, 255, 0.20);
}


/* ==================== 5. 居中点火器具工坊 (The Ignition Arsenal Deck) ==================== */
.center-ignition-hub {
  pointer-events: auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  margin-bottom: 2rpx;
  gap: 10rpx;
}

/* 顶部点火器切换微胶囊 */
.ignition-tool-chips {
  display: flex;
  align-items: center;
  background: rgba(15, 23, 42, 0.88);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 30rpx;
  padding: 4rpx 6rpx;
  gap: 6rpx;
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.4);
}

.tool-chip {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 6rpx 14rpx;
  border-radius: 24rpx;
  font-size: 20rpx;
  color: #94a3b8;
  transition: all 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.tool-chip.active-tool-chip {
  background: linear-gradient(90deg, #d97706 0%, #f59e0b 100%);
  color: #0b0f19;
  font-weight: 800;
  box-shadow: 0 2rpx 8rpx rgba(245, 158, 11, 0.35);
}

.chip-icon {
  font-size: 22rpx;
}

.chip-name {
  font-size: 20rpx;
  white-space: nowrap;
}

/* 点火器动态互动实体机身 */
.ignition-device-casing {
  position: relative;
  width: 260rpx;
  min-height: 130rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  user-select: none;
  background: linear-gradient(145deg, #1e293b 0%, #0f172a 60%, #1e293b 100%);
  border-radius: 20rpx;
  border: 1px solid rgba(255, 255, 255, 0.16);
  padding: 12rpx 16rpx;
  box-sizing: border-box;
  box-shadow: 0 10rpx 28rpx rgba(0, 0, 0, 0.6), inset 0 1px 2px rgba(255, 255, 255, 0.2);
  transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.ignition-device-casing:active {
  transform: scale(0.97);
}

.ignition-device-casing.is-lit {
  opacity: 0.92;
}

/* A. 经典打火机 */
.lighter-hood {
  position: relative;
  width: 76rpx;
  height: 34rpx;
  background: linear-gradient(180deg, #d1d5db 0%, #4b5563 60%, #374151 100%);
  border-radius: 8rpx 8rpx 0 0;
  border: 1px solid rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 6rpx;
}

.hood-vent-row {
  display: flex;
  gap: 6rpx;
}

.vent-hole {
  width: 6rpx;
  height: 12rpx;
  background: #111827;
  border-radius: 3rpx;
}

.knurled-flint-wheel {
  position: absolute;
  top: 10rpx;
  right: 28rpx;
  width: 36rpx;
  height: 36rpx;
}

.flint-teeth {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: radial-gradient(circle, #78350f 30%, #1f2937 80%);
  border: 2px dashed #f59e0b;
}

.wheel-spin {
  animation: wheel-spin-anim 0.35s ease-out;
}

@keyframes wheel-spin-anim {
  from { transform: rotate(0deg); }
  to { transform: rotate(240deg); }
}

.spark-flare {
  position: absolute;
  top: -24rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 44rpx;
  height: 44rpx;
  pointer-events: none;
}

.spark-flame-cone {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 18rpx;
  height: 32rpx;
  background: radial-gradient(ellipse at 50% 80%, #ffffff 0%, #ffbe3b 40%, #ff4500 80%, transparent 100%);
  border-radius: 50% 50% 35% 35%;
  animation: flicker-flame 0.2s infinite alternate;
}

.spark-particle {
  position: absolute;
  width: 4rpx;
  height: 4rpx;
  background: #ffea79;
  border-radius: 50%;
}
.sp1 { top: 4rpx; left: 6rpx; animation: sp-anim-1 0.35s ease-out forwards; }
.sp2 { top: 0rpx; right: 8rpx; animation: sp-anim-2 0.35s ease-out forwards; }
@keyframes sp-anim-1 { to { transform: translate(-14rpx, -18rpx) scale(0); opacity: 0; } }
@keyframes sp-anim-2 { to { transform: translate(16rpx, -22rpx) scale(0); opacity: 0; } }

/* B. 红头木柴立面 (Match) */
.match-head-hood {
  position: relative;
  width: 120rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 6rpx;
}

.match-wood-stick {
  width: 60rpx;
  height: 8rpx;
  background: #d4a373;
  border-radius: 3rpx;
}

.match-sulfur-head {
  width: 16rpx;
  height: 16rpx;
  background: radial-gradient(circle, #ef4444 40%, #991b1b 100%);
  border-radius: 50%;
  margin-left: -4rpx;
  box-shadow: 0 0 6rpx rgba(239, 68, 68, 0.4);
}

.match-sulfur-head.head-lit {
  background: radial-gradient(circle, #ffffff 30%, #f59e0b 80%);
  box-shadow: 0 0 16rpx #f59e0b;
}

.match-spark-flare {
  position: absolute;
  top: -20rpx;
  right: 28rpx;
}

.match-flame-tear {
  width: 16rpx;
  height: 28rpx;
  background: radial-gradient(ellipse at 50% 80%, #ffffff 0%, #f97316 70%, transparent 100%);
  border-radius: 50% 50% 35% 35%;
  animation: flicker-flame 0.18s infinite alternate;
}

/* C. 雪茄三喷蓝焰喷枪 (Blue Torch) */
.torch-nozzle-hood {
  position: relative;
  width: 90rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 6rpx;
}

.torch-triple-ports {
  display: flex;
  gap: 8rpx;
  align-items: center;
}

.t-port {
  width: 10rpx;
  height: 18rpx;
  background: #0f172a;
  border: 1px solid #06b6d4;
  border-radius: 4rpx;
}

.t-port.main {
  height: 24rpx;
  border-color: #38bdf8;
}

.torch-blue-plasma {
  position: absolute;
  top: -26rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 6rpx;
}

.plasma-cone {
  width: 8rpx;
  height: 30rpx;
  background: linear-gradient(180deg, #ffffff 0%, #06b6d4 40%, #2563eb 100%);
  border-radius: 50% 50% 20% 20%;
  box-shadow: 0 0 12rpx #06b6d4;
  animation: flicker-flame 0.12s infinite alternate;
}

/* D. 车载螺旋电热丝 (Car Lighter) */
.car-plug-hood {
  position: relative;
  width: 50rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 6rpx;
}

.car-coil-spiral {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 3px double #64748b;
  background: #1e293b;
  transition: all 0.3s ease;
}

.car-coil-spiral.coil-glow {
  border-color: #f97316;
  background: radial-gradient(circle, #fffbeb 20%, #ef4444 80%);
  box-shadow: 0 0 20rpx #f97316;
}

.car-plug-hood.is-heating {
  transform: scale(0.9);
}

/* E. Zippo 纯铜机 (Classic Zippo) */
.zippo-hood {
  position: relative;
  width: 80rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 6rpx;
}

.zippo-chimney {
  width: 44rpx;
  height: 34rpx;
  background: #334155;
  border: 1px solid #e2e8f0;
  border-radius: 4rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 4rpx;
  padding: 4rpx;
  box-sizing: border-box;
}

.chimney-hole {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #0f172a;
}

.zippo-gold-flame {
  position: absolute;
  top: -24rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 20rpx;
  height: 34rpx;
  background: radial-gradient(ellipse at 50% 80%, #ffffff 0%, #fbbf24 50%, #f59e0b 85%, transparent 100%);
  border-radius: 50% 50% 35% 35%;
  animation: flicker-flame 0.22s infinite alternate;
}

/* 统一触控触发条 */
.ignition-trigger-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 8rpx 14rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.12);
  width: 100%;
  box-sizing: border-box;
}

.ignition-trigger-bar.trigger-active {
  border-color: rgba(245, 158, 11, 0.6);
  background: rgba(245, 158, 11, 0.15);
}

.trigger-icon {
  font-size: 22rpx;
}

.trigger-status-text {
  font-size: 18rpx;
  color: #cbd5e1;
  font-weight: 600;
  white-space: nowrap;
}


/* ==================== 8. 结算弹窗 (Reward Modal) ==================== */
.glass-modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 150;
  background: rgba(0, 0, 0, 0.75);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 36rpx;
  box-sizing: border-box;
}

/* ==================== 8. 抽完结算达成弹窗 (Reward Modal - 腾讯高品质游戏化胜利战报) ==================== */
.reward-modal-backdrop {
  background: rgba(4, 7, 13, 0.85);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  padding: 32rpx;
}

.reward-dialog-card {
  position: relative;
  width: 100%;
  max-width: 650rpx;
  background: linear-gradient(165deg, rgba(26, 35, 52, 0.98) 0%, rgba(12, 17, 28, 0.99) 100%);
  border: 1.5rpx solid rgba(251, 191, 36, 0.38);
  border-radius: 40rpx;
  padding: 44rpx 32rpx 36rpx;
  box-shadow: 0 24rpx 70rpx rgba(0, 0, 0, 0.88), 0 0 36rpx rgba(245, 158, 11, 0.16), inset 0 1px 0 rgba(255, 255, 255, 0.15);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  box-sizing: border-box;
  animation: rewardCardPop 0.36s cubic-bezier(0.34, 1.56, 0.64, 1);
  overflow: hidden;
}

@keyframes rewardCardPop {
  0% { opacity: 0; transform: scale(0.86) translateY(24rpx); }
  100% { opacity: 1; transform: scale(1) translateY(0); }
}

/* 极简右上角关闭按钮 */
.dialog-close-btn {
  position: absolute;
  right: 24rpx;
  top: 24rpx;
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #94a3b8;
  font-size: 24rpx;
  font-weight: 700;
  z-index: 5;
  transition: all 0.2s ease;
}

.dialog-close-btn:active {
  background: rgba(255, 255, 255, 0.18);
  transform: scale(0.92);
}

/* 顶部荣誉徽章与胜利光晕 */
.dialog-crest-wrap {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 12rpx;
}

.crest-halo-glow {
  position: absolute;
  top: -10rpx;
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(245, 158, 11, 0.45) 0%, transparent 70%);
  animation: crestPulse 2.4s infinite ease-in-out;
  pointer-events: none;
}

@keyframes crestPulse {
  0%, 100% { opacity: 0.6; transform: scale(0.95); }
  50% { opacity: 1; transform: scale(1.15); }
}

.crest-badge-circle {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(251, 191, 36, 0.22) 0%, rgba(217, 119, 6, 0.12) 100%);
  border: 2rpx solid rgba(251, 191, 36, 0.65);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 24rpx rgba(245, 158, 11, 0.35);
  margin-bottom: 12rpx;
}

.dialog-badge-glow {
  font-size: 52rpx;
  line-height: 1;
  filter: drop-shadow(0 0 12rpx rgba(245, 158, 11, 0.6));
}

.crest-tag-pill {
  font-size: 19rpx;
  font-weight: 800;
  color: #fde047;
  background: rgba(245, 158, 11, 0.15);
  border: 1px solid rgba(245, 158, 11, 0.45);
  border-radius: 20rpx;
  padding: 4rpx 18rpx;
  letter-spacing: 1.5rpx;
}

.dialog-title {
  font-size: 36rpx;
  font-weight: 900;
  color: #f8fafc;
  margin-top: 10rpx;
  margin-bottom: 8rpx;
  letter-spacing: 0.5rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.6);
}

