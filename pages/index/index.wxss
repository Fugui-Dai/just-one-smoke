/* ==================== 3. 5 位平视机械舱卡（即点即换，紧凑工整） ==================== */
.matrix-selector-strip {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10rpx;
  height: 128rpx;
  min-height: 128rpx;
  max-height: 128rpx;
  margin: 0;
  flex-shrink: 0;
  box-sizing: border-box;
}

.matrix-slot-unit {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  position: relative;
  padding: 10rpx 2rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid rgba(255, 255, 255, 0.06);
  transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  box-sizing: border-box;
}

.matrix-slot-unit:active {
  transform: scale(0.95);
}

.slot-current-focus {
  background: rgba(255, 255, 255, 0.08) !important;
  transform: translateY(-3rpx);
}

.msu-glow-border {
  position: absolute;
  inset: -1px;
  border-radius: 16rpx;
  border: 1.5px solid;
  pointer-events: none;
}

.msu-icon-wrap {
  width: 62rpx;
  height: 62rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  transition: background 0.2s;
}

.msu-svg {
  width: 40rpx;
  height: 40rpx;
}

.msu-emoji {
  font-size: 36rpx;
  line-height: 1;
}

.msu-active-pip {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #10b981;
  box-shadow: 0 0 8rpx #10b981;
  border: 2rpx solid #000;
}

.msu-label {
  font-size: 19rpx;
  color: #94a3b8;
  font-weight: 600;
  white-space: nowrap;
  text-align: center;
  line-height: 1.2;
}

/* ==================== 4. 悬浮胶囊装配主操作键 (严格双向几何居中，绝不下沉) ==================== */
.matrix-action-dock {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
  margin: 0;
}

.matrix-equip-btn {
  width: 100%;
  height: 86rpx;
  border-radius: 43rpx;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  border: 1.5px solid;
  box-sizing: border-box;
  text-align: center;
  box-shadow: 0 10rpx 28rpx rgba(0, 0, 0, 0.5);
  transition: all 0.25s ease;
  padding: 0 !important;
  margin: 0 !important;
  position: relative;
  overflow: hidden;
}

.matrix-equip-btn:active {
  transform: scale(0.98);
  opacity: 0.92;
}

.meb-text {
  width: 100% !important;
  height: 86rpx !important;
  line-height: 84rpx !important;
  text-align: center !important;
  font-size: 28rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  white-space: nowrap !important;
  display: block !important;
  margin: 0 !important;
  padding: 0 !important;
  box-sizing: border-box;
}

/* 无论背景色切为什么颜色（深色/浅色/鲜艳色），白字+柔和暗影永远对比度拉满，绝对清晰可见！ */
.text-need-equip {
  color: #ffffff !important;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.45);
}

/* 已装配：清新翡翠绿 */
.text-is-equipped {
  color: #34d399 !important;
  text-shadow: 0 0 10rpx rgba(52, 211, 153, 0.3);
}

.meb-equipped {
  box-shadow: none !important;
  background: rgba(255, 255, 255, 0.08) !important;
}

.meb-just-equipped {
  animation: equipGlowPulse 0.85s cubic-bezier(0.16, 1, 0.3, 1) !important;
}

/* 动效 */
@keyframes matrixSpin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

@keyframes heroBlastShake {
  0% { transform: scale(1); }
  25% { transform: scale(1.28) rotate(-6deg); filter: drop-shadow(0 0 24rpx #f59e0b) brightness(1.3); }
  60% { transform: scale(1.1) rotate(4deg); }
  100% { transform: scale(1); }
}

@keyframes heroBlastShakeA {
  0% { transform: scale(0.9); }
  30% { transform: scale(1.22) rotate(-8deg); filter: drop-shadow(0 0 24rpx #f59e0b) brightness(1.35); }
  65% { transform: scale(1.06) rotate(4deg); }
  100% { transform: scale(1); }
}

@keyframes heroBlastShakeB {
  0% { transform: scale(0.9); }
  30% { transform: scale(1.22) rotate(8deg); filter: drop-shadow(0 0 24rpx #f59e0b) brightness(1.35); }
  65% { transform: scale(1.06) rotate(-4deg); }
  100% { transform: scale(1); }
}

@keyframes torchHum {
  0% { transform: scale(1.16); }
  100% { transform: scale(1.20) translateY(-2rpx); }
}

@keyframes shockwaveExpand {
  0% { transform: scale(0.6); opacity: 0.9; }
  100% { transform: scale(2.4); opacity: 0; }
}

@keyframes shockwaveExpandA {
  0% { transform: scale(0.5); opacity: 0.95; }
  100% { transform: scale(2.4); opacity: 0; }
}

@keyframes shockwaveExpandB {
  0% { transform: scale(0.5); opacity: 0.95; }
  100% { transform: scale(2.4); opacity: 0; }
}

@keyframes sparkFly1 {
  0% { transform: translate(0, 0) scale(1.2); opacity: 1; }
  100% { transform: translate(-38rpx, -44rpx) scale(0.2); opacity: 0; }
}

@keyframes sparkFly2 {
  0% { transform: translate(0, 0) scale(1.2); opacity: 1; }
  100% { transform: translate(42rpx, -36rpx) scale(0.2); opacity: 0; }
}

@keyframes sparkFly3 {
  0% { transform: translate(0, 0) scale(1.2); opacity: 1; }
  100% { transform: translate(-36rpx, 38rpx) scale(0.2); opacity: 0; }
}

@keyframes sparkFly4 {
  0% { transform: translate(0, 0) scale(1.2); opacity: 1; }
  100% { transform: translate(38rpx, 36rpx) scale(0.2); opacity: 0; }
}

@keyframes counterBump {
  0% { transform: scale(1); }
  50% { transform: scale(1.18); box-shadow: 0 0 24rpx rgba(245, 158, 11, 0.5); }
  100% { transform: scale(1); }
}

@keyframes vaultScaleIn {
  from { opacity: 0; transform: scale(0.92); }
  to { opacity: 1; transform: scale(1); }
}

@keyframes equipGlowPulse {
  0% { transform: scale(0.96); box-shadow: 0 0 0 0 rgba(245, 158, 11, 0.8); }
  50% { transform: scale(1.02); box-shadow: 0 0 40rpx 12rpx rgba(245, 158, 11, 0.4); }
  100% { transform: scale(1); box-shadow: none; }
}


/* ==================== 腾讯级：点燃按钮动态器具自适应与点火微爆动效 ==================== */
.dock-circle-btn.ignite-btn.is-unlit-tool {
  background: radial-gradient(circle at 35% 28%, rgba(255, 255, 255, 0.12) 0%, rgba(245, 158, 11, 0.25) 45%, rgba(15, 23, 42, 0.95) 100%) !important;
  transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}

.dock-circle-btn.ignite-btn.is-btn-sparking {
  transform: scale(1.15) !important;
  box-shadow: 0 0 24rpx rgba(255, 119, 0, 0.9), 0 0 48rpx rgba(245, 158, 11, 0.45), inset 0 0 14rpx rgba(255, 255, 255, 0.9) !important;
  border-color: #ffffff !important;
}

.ignite-icon-spark {
  animation: igniteJolt 0.5s ease-out;
}

@keyframes igniteJolt {
  0% { transform: scale(0.9); }
  30% { transform: scale(1.35) rotate(-8deg); filter: drop-shadow(0 0 16rpx #ffea00) brightness(1.4); }
  60% { transform: scale(1.1) rotate(6deg); }
  100% { transform: scale(1); }
}

