.atm-empty-hint {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}

.aeh-icon {
  font-size: 26rpx;
}

.aeh-text {
  font-size: 16rpx;
  color: #34d399;
  letter-spacing: 0.5rpx;
  font-weight: 600;
}

/* 状态度量指标条 */
.adc-metric-strip {
  display: grid;
  grid-template-columns: 1fr auto 1fr auto 1fr;
  align-items: center;
  background: rgba(0, 0, 0, 0.35);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 20rpx;
  padding: 16rpx 12rpx;
  margin-bottom: 22rpx;
}

.ams-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.ams-val {
  font-size: 26rpx;
  font-weight: 800;
  color: #f1f5f9;
}

.ams-unit {
  font-size: 20rpx;
  font-weight: 500;
  color: #94a3b8;
  margin-left: 2rpx;
}

.ams-val.ams-gold {
  color: #fbbf24;
}

.ams-lbl {
  font-size: 18rpx;
