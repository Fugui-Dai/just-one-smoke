  filter: drop-shadow(0 2rpx 6rpx rgba(0, 0, 0, 0.45));
}

.tfc-img-icon {
  width: 32rpx;
  height: 32rpx;
  display: inline-block;
  vertical-align: middle;
}

.ec-img-icon {
  width: 46rpx;
  height: 46rpx;
  display: block;
  filter: drop-shadow(0 2rpx 6rpx rgba(0, 0, 0, 0.45));
}

.trial-dock-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  background: #f43f5e;
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 800;
  padding: 2rpx 10rpx;
  border-radius: 12rpx;
  box-shadow: 0 0 10rpx rgba(244, 63, 94, 0.7);
  animation: pulseTrialBadge 1s infinite alternate;
}

@keyframes pulseTrialBadge {
  from { transform: scale(0.95); }
  to { transform: scale(1.1); }
}

/* 烟雾特效长按引导呼吸微气泡 (腾讯游戏新手引导高奢质感) */
.smoke-dock-wrap {
  position: relative;
}

.smoke-guide-tooltip {
  position: absolute;
  right: calc(100% + 18rpx);
  top: 38rpx;
  transform: translateY(-50%);
  background: rgba(22, 18, 14, 0.95);
  border: 1.5rpx solid rgba(245, 158, 11, 0.75);
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.8), 0 0 16rpx rgba(245, 158, 11, 0.35);
  border-radius: 20rpx;
  padding: 8rpx 18rpx;
  white-space: nowrap;
  z-index: 100;
  pointer-events: auto;
  animation: floatBreathingLeft 2.2s infinite ease-in-out;
  transition: opacity 0.4s ease, transform 0.4s ease;
}

.smoke-guide-tooltip.guide-fade-out {
  opacity: 0;
  transform: translateY(-50%) translateX(16rpx);
  pointer-events: none;
}

.sgt-text {
  font-size: 21rpx;
  font-weight: 800;
  color: #fbbf24;
  letter-spacing: 0.5rpx;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.8);
  display: flex;
  align-items: center;
}

.sgt-arrow {
  position: absolute;
  top: 50%;
  left: 100%;
  transform: translateY(-50%);
  width: 0;
  height: 0;
  border-top: 8rpx solid transparent;
  border-bottom: 8rpx solid transparent;
  border-left: 10rpx solid rgba(245, 158, 11, 0.85);
}

.scene-guide-tooltip {
  border-color: rgba(52, 211, 153, 0.75);
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.8), 0 0 16rpx rgba(52, 211, 153, 0.35);
}

.scene-guide-tooltip .sgt-text {
  color: #6ee7b7;
}

.scene-guide-tooltip .sgt-arrow {
  border-left-color: rgba(52, 211, 153, 0.85);
}

@keyframes floatBreathingLeft {
  0%, 100% {
    transform: translateY(-50%) translateX(0);
  }
  50% {
    transform: translateY(-50%) translateX(-8rpx);
  }
}

.trial-floating-capsule {
  position: absolute;
  top: calc(88rpx + 90rpx);
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: rgba(15, 23, 42, 0.92);
  border: 1px solid rgba(244, 63, 94, 0.7);
  box-shadow: 0 8rpx 24rpx rgba(244, 63, 94, 0.35);
  border-radius: 36rpx;
  padding: 8rpx 22rpx;
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  z-index: 10;
}

.tfc-icon {
  font-size: 26rpx;
}

.tfc-name {
  font-size: 20rpx;
  font-weight: 700;
  color: #f8fafc;
}

.tfc-time {
  font-size: 20rpx;
  font-weight: 800;
  color: #f43f5e;
}

.tfc-link {
  font-size: 20rpx;
  color: #fbbf24;
  font-weight: 700;
}

/* 烟雾特工坊 · 尊享展厅 (Smoke Effects Drawer) */
.smoke-effects-drawer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 80vh;
  max-height: 80vh;
  min-height: 80vh;
