/* ==================== 14. 烟雾特效工坊与动态图标样式 ==================== */
.dock-char-icon.effect-char-icon {
  font-size: 32rpx;
  line-height: 1;
}

.dock-img-icon {
  width: 44rpx;
  height: 44rpx;
