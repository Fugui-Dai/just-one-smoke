/* 连续点击交替震击动画 (左右微倾交替，打击感十足) */
.pod-blast-a {
  animation: heroBlastShakeA 0.32s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards !important;
}

.pod-blast-b {
  animation: heroBlastShakeB 0.32s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards !important;
}

/* 飞溅星火微粒 */
.fidget-spark-dots {
  position: absolute;
  width: 100%;
  height: 100%;
  top: 0;
  left: 0;
  pointer-events: none;
}

.fs-dot {
  position: absolute;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  left: 50%;
  top: 50%;
  margin: -5rpx 0 0 -5rpx;
}

.fs-d1 { animation: sparkFly1 0.36s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
.fs-d2 { animation: sparkFly2 0.36s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
.fs-d3 { animation: sparkFly3 0.36s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
.fs-d4 { animation: sparkFly4 0.36s cubic-bezier(0.16, 1, 0.3, 1) forwards; }

.fcp-bump {
  animation: counterBump 0.22s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

/* 试火手势提示底座（向下紧凑贴合，形成舞台专属状态条） */
.matrix-action-indicator-dock {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 44rpx;
  min-height: 44rpx;
  max-height: 44rpx;
  margin: -4rpx 0 0 0;
  flex-shrink: 0;
}

.matrix-action-indicator {
  position: static !important;
  height: 42rpx;
  line-height: 42rpx;
  padding: 0 20rpx;
  background: rgba(0, 0, 0, 0.75);
  border: 1px solid rgba(255, 255, 255, 0.16);
  border-radius: 21rpx;
  backdrop-filter: blur(8px);
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  box-sizing: border-box;
  transition: all 0.3s ease;
}

.mai-text {
  font-size: 20rpx;
  color: #cbd5e1;
  font-weight: 600;
  letter-spacing: 0.5rpx;
  height: 42rpx !important;
  line-height: 40rpx !important;
  text-align: center !important;
  white-space: nowrap !important;
  display: block !important;
  margin: 0 !important;
  padding: 0 !important;
}

/* ==================== 2. 悬浮解构机巧铭牌与情绪心境金句 (严格恒高118rpx，绝不跳变) ==================== */
