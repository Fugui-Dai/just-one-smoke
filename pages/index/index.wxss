}

.sst-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.sst-icon {
  font-size: 34rpx;
}

.sst-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.sst-title {
  font-size: 22rpx;
  font-weight: 700;
  color: #f8fafc;
}

.sst-desc {
  font-size: 18rpx;
  color: #94a3b8;
}

.skill-cards-grid {
