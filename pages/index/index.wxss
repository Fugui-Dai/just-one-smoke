  filter: drop-shadow(0 16rpx 28rpx rgba(0, 0, 0, 0.75)) drop-shadow(0 0 20rpx rgba(52, 211, 153, 0.3));
  animation: giftPackFloat 3.2s ease-in-out infinite;
  z-index: 2;
}

@keyframes giftPackFloat {
  0%, 100% {
    transform: translateY(0) rotate(0deg);
  }
  50% {
    transform: translateY(-12rpx) rotate(-1.5deg);
  }
}

.gift-smoke-shadow {
  position: absolute;
  bottom: 0;
  width: 140rpx;
  height: 20rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.45);
  filter: blur(6rpx);
}

.gift-headline {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  margin-bottom: 12rpx;
}

.gift-sender-tag {
  font-size: 24rpx;
  color: #94a3b8;
  margin-bottom: 6rpx;
  letter-spacing: 1rpx;
}

.gift-cig-name {
  font-size: 38rpx;
  font-weight: 800;
  color: #f8fafc;
  background: linear-gradient(135deg, #ffffff 0%, #6ee7b7 50%, #fcd34d 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  text-shadow: 0 4rpx 16rpx rgba(16, 185, 129, 0.3);
}

.gift-quote {
  font-size: 24rpx;
  color: #cbd5e1;
  text-align: center;
  font-style: italic;
  margin-bottom: 28rpx;
  line-height: 1.5;
  padding: 0 16rpx;
}

.gift-stats-row {
  width: 100%;
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 34rpx;
}

.gift-stat-box {
  flex: 1;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  padding: 16rpx 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.gsb-icon {
  font-size: 30rpx;
  margin-bottom: 4rpx;
}

.gsb-val {
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.2;
}

.gsb-unit {
  font-size: 18rpx;
  font-weight: 600;
  margin-left: 2rpx;
}

.gsb-label {
  font-size: 19rpx;
  color: #94a3b8;
  margin-top: 4rpx;
}

.gift-accept-btn {
  background: linear-gradient(135deg, #10b981 0%, #059669 100%) !important;
  box-shadow: 0 8rpx 24rpx rgba(16, 185, 129, 0.45) !important;
}

.gift-return-btn {
  background: rgba(255, 255, 255, 0.08) !important;
  border: 1px solid rgba(255, 255, 255, 0.18) !important;
  color: #f1f5f9 !important;
}


