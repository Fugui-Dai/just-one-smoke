<!-- pages/index/index.wxml -->
<view class="app-container {{ vipTheme ? 'theme-' + vipTheme : '' }}">

  <!-- 🎨 全局 VIP 尊享极光天幕与浮光星尘 (全站背景装扮) -->
  <view wx:if="{{ vipTheme }}" class="vip-ambient-stage">
    <view class="vip-aurora-orb orb-primary"></view>
    <view class="vip-aurora-orb orb-secondary"></view>
    <view class="vip-spark s1"></view>
    <view class="vip-spark s2"></view>
    <view class="vip-spark s3"></view>
  </view>

  <!-- ==================== 沉浸式模拟器主页 ==================== -->
  <view class="tab-page simulator-tab active">

    <!-- ==================== 右侧主控 DOCK 栏 (极简无界 · 纯净通透悬浮 · 零外壳边框) ==================== -->
    <view class="right-arc-dock">

      <!-- 1. 点燃 / 掐灭 / 抽新烟 (单击点燃/掐灭，UNLIT状态长按弹出器具选择) -->
      <view
        class="dock-btn-wrap ignite-dock-wrap"
        bindtap="triggerIgnite"
        bindlongpress="onIgniteLongPress"
      >
        <!-- 💡 UNLIT 状态首次进入引导气泡：长按换器具 -->
        <view
          class="smoke-guide-tooltip ignite-guide-tooltip {{ isIgniteGuideFading ? 'guide-fade-out' : '' }}"
          wx:if="{{ showIgniteGuide }}"
          catchtap="onTapIgniteGuideTooltip"
        >
          <text class="sgt-text">💡 长按换点烟器具</text>
          <view class="sgt-arrow"></view>
        </view>

        <view
          class="dock-circle-btn ignite-btn {{ simulatorState === 'FINISHED' ? 'is-draw-new' : ((simulatorState !== 'UNLIT') ? 'is-lit' : 'is-unlit-tool') }} {{ isSparking ? 'is-btn-sparking' : '' }}"
          style="{{ simulatorState === 'UNLIT' ? 'border-color: ' + currentIgnitionTool.themeColor + 'bb; box-shadow: 0 4rpx 14rpx rgba(0,0,0,0.6), 0 0 16rpx ' + currentIgnitionTool.themeColor + '66, inset 0 2rpx 3rpx rgba(255,255,255,0.4);' : '' }}"
        >
          <image class="dock-svg-icon draw-svg-icon" src="{{ drawCigIconUri }}" mode="aspectFit" wx:if="{{ simulatorState === 'FINISHED' }}" />
          <image class="dock-svg-icon extinguish-svg-icon" src="{{ extinguishIconUri }}" mode="aspectFit" wx:elif="{{ simulatorState !== 'UNLIT' }}" />
          <!-- 未点燃时：优先显示当前点火器具的高清矢量SVG或emoji图标 -->
          <image class="dock-svg-icon ignite-svg-icon {{ isSparking ? 'ignite-icon-spark' : '' }}" src="{{ currentIgnitionTool.iconImage }}" mode="aspectFit" wx:elif="{{ currentIgnitionTool.iconImage }}" />
          <text class="dock-char-icon ignite-tool-icon {{ isSparking ? 'ignite-icon-spark' : '' }}" wx:elif="{{ currentIgnitionTool.icon }}">{{ currentIgnitionTool.icon }}</text>
          <image class="dock-svg-icon ignite-svg-icon" src="{{ igniteIconUri }}" mode="aspectFit" wx:else />
        </view>
        <text class="dock-title">{{ simulatorState === 'FINISHED' ? '抽新烟' : (simulatorState === 'UNLIT' ? '点燃' : '掐灭') }}</text>
      </view>

      <!-- 3. 抖灰 (圆形烟灰进度条 + 顺时针烟灰环 + 灰图标) -->
      <view class="dock-btn-wrap" bindtap="manualTapAsh">
        <view class="dock-circle-btn ash-btn-circle {{ isAshTapping ? 'is-tapping' : '' }} {{ ashPercent >= 70 ? 'alert-ash' : (ashPercent > 0 ? 'has-ash' : '') }}">
          <!-- 圆形烟灰进度条 (根据当前烟灰长度顺时针环绕) -->
          <view 
            class="ash-progress-ring" 
            style="{{ ashProgressStyle }}"
          ></view>
          <!-- 内核灰按钮实体 -->
          <view class="ash-btn-inner">
            <image class="dock-svg-icon ash-svg-icon" src="{{ ashTapIconUri }}" mode="aspectFit" />
          </view>
        </view>
        <text class="dock-title">抖灰</text>
      </view>

      <!-- 4. 抽烟环境 (单击快速切换环境 · 长按开启列表 · 首次气泡引导) -->
      <view 
        class="dock-btn-wrap scene-dock-wrap" 
        bindtap="toggleScene" 
        bindlongpress="openSceneModal"
      >
        <!-- 💡 首次新手引导呼吸微气泡 -->
        <view 
          class="smoke-guide-tooltip scene-guide-tooltip {{ isSceneGuideFading ? 'guide-fade-out' : '' }}" 
          wx:if="{{ showSceneGuide }}"
          catchtap="onTapSceneGuideTooltip"
        >
          <text class="sgt-text">💡 长按环境开启列表</text>
          <view class="sgt-arrow"></view>
        </view>

        <view 
          class="dock-circle-btn scene-btn-circle" 
          style="{{ currentSceneInfo.accentColor ? ('border-color: ' + currentSceneInfo.accentColor + '; box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.65), 0 0 14rpx ' + currentSceneInfo.accentColor + '44;') : '' }}"
        >
          <text class="dock-char-icon scene-char-icon" wx:if="{{ currentSceneInfo.id !== 'obsidian' && currentSceneInfo.icon }}">{{ currentSceneInfo.icon }}</text>
          <image class="dock-svg-icon scene-svg-icon" wx:else src="{{ sceneAmbientIconUri }}" mode="aspectFit" />
        </view>
        <text class="dock-title">环境</text>
      </view>

      <!-- 5. 烟雾特效 (分段刻度环 + 动态字/图标 + 试抽角标) -->
      <view 
        class="dock-btn-wrap smoke-dock-wrap" 
        bindtap="toggleSmokeEffect" 
        bindlongpress="openSmokeEffectDrawer"
      >
        <!-- 💡 首次新手引导呼吸微气泡 -->
        <view 
          class="smoke-guide-tooltip {{ isGuideFading ? 'guide-fade-out' : '' }}" 
          wx:if="{{ showSmokeEffectGuide }}"
          catchtap="onTapSmokeGuideTooltip"
        >
          <text class="sgt-text">💡 长按烟雾特效开启列表</text>
          <view class="sgt-arrow"></view>
        </view>

        <view 
          class="dock-circle-btn smoke-effect-btn" 
          style="border-color: {{ currentSmokeEffect.accentBorder }};"
        >
          <image class="dock-img-icon" wx:if="{{ currentSmokeEffect.iconImage }}" src="{{ currentSmokeEffect.iconImage }}" mode="aspectFit" />
          <image class="dock-svg-icon vfx-svg-icon" wx:elif="{{ currentSmokeEffect.id === 'ring_classic' || !currentSmokeEffect.icon || currentSmokeEffect.icon === '⭕' || currentSmokeEffect.icon === '雾' }}" src="{{ smokeVfxIconUri }}" mode="aspectFit" />
          <text class="dock-char-icon effect-char-icon" wx:else>{{ currentSmokeEffect.icon }}</text>
          <!-- 30秒试抽倒计时角标 -->
          <view class="trial-dock-badge" wx:if="{{ isTrialActive }}">{{ trialSecondsLeft }}s</view>
        </view>
        <text class="dock-title">烟雾特效</text>
      </view>

      <!-- 6. 递烟 (微信原生分享 + 动态烟盒余量进度环 + 🤲 + 点击递出一支) -->
      <button class="dock-btn-wrap share-dock-item" open-type="{{ currentPackRemaining > 0 ? 'share' : '' }}" bindtap="giveCigarette">
        <view class="dock-circle-btn share-btn-circle">
          <!-- 动态烟盒余量进度圆环 -->
          <view 
            class="share-progress-ring" 
            style="background: conic-gradient(#34d399 0deg, #10b981 {{ shareProgressDeg }}deg, rgba(255, 255, 255, 0.14) {{ shareProgressDeg }}deg 360deg);"
          ></view>
          <view class="share-btn-inner">
            <image class="dock-svg-icon share-svg-icon" src="{{ giveCigIconUri }}" mode="aspectFit" />
          </view>
        </view>
        <text class="dock-title">递烟</text>
      </button>

      <!-- 7. 商店 (纯净无24字样矢量图标 + 仅显示“商店”) -->
      <view class="dock-btn-wrap store-dock-wrap" bindtap="openCigarettePicker">
        <view class="dock-circle-btn store-btn-circle">
          <image class="dock-svg-icon store-svg-icon" src="{{ storeIconUri }}" mode="aspectFit" />
        </view>
        <text class="dock-title">商店</text>
      </view>

      <!-- 8. 排行榜 (曜金奖杯图标 + 下方“排行榜”) -->
      <view class="dock-btn-wrap rank-dock-wrap" bindtap="switchToLeaderboard">
        <view class="dock-circle-btn rank-btn-circle">
          <image class="dock-svg-icon rank-svg-icon" src="{{ leaderboardIconUri }}" mode="aspectFit" />
        </view>
        <text class="dock-title">排行榜</text>
      </view>

      <!-- 9. 我的 (金字“我” + 下方“我的”) -->
      <view class="dock-btn-wrap" bindtap="switchToStats">
        <view class="dock-circle-btn my-btn-circle {{ vipTheme ? 'is-vip-my-btn' : '' }}">
          <image class="dock-svg-icon my-svg-icon" src="{{ myProfileIconUri }}" mode="aspectFit" />
        </view>
        <text class="dock-title {{ vipTheme ? 'gold-title' : '' }}">我的</text>
      </view>

    </view>

    <!-- 画布区域 (居中展示 3D 拟真卷烟/雪茄与袅袅青烟) -->
    <view class="canvas-wrapper">

      <!-- 30秒特效试抽中动态浮动胶囊 -->
      <view class="trial-floating-capsule" wx:if="{{ isTrialActive }}" bindtap="openSmokeEffectDrawer">
        <image class="tfc-img-icon" wx:if="{{ currentSmokeEffect.iconImage }}" src="{{ currentSmokeEffect.iconImage }}" mode="aspectFit" />
        <text class="tfc-icon" wx:else>{{ currentSmokeEffect.icon }}</text>
        <text class="tfc-name">尊享【{{ currentSmokeEffect.name }}】试抽中 ({{ trialSecondsLeft }}s)</text>
        <text class="tfc-link">去解锁 ➔</text>
      </view>



      <!-- 微信原生 Canvas 2D 高清画布 -->
      <canvas
        type="2d"
        id="smokeCanvas"
        class="smoke-canvas"
        bindtouchstart="onTouchStart"
        bindtouchend="onTouchEnd"
        bindtouchcancel="onTouchEnd"
      ></canvas>

    </view>

    <!-- 底部核心操作栏已移至右侧Dock -->

  </view>

  <!-- ==================== 弹窗 1: 抽完结算达成弹窗 (腾讯高品质游戏化胜利战报) ==================== -->
  <view class="glass-modal-backdrop reward-modal-backdrop" wx:if="{{ showRewardModal }}" catchtouchmove="preventTouchMove">
    <view class="reward-dialog-card">
      
      <!-- 极简右上角关闭按钮 -->
      <view class="dialog-close-btn" bindtap="closeRewardModal">✕</view>

      <!-- 顶部荣誉徽章与胜利光晕 -->
      <view class="dialog-crest-wrap">
        <view class="crest-halo-glow"></view>
        <view class="crest-badge-circle">
          <image class="dialog-medal-img" src="{{ victoryMedalSvgUri }}" mode="aspectFit" />
        </view>
        <view class="crest-tag-pill">✦ VICTORY · 替瘾战报 ✦</view>
      </view>

      <text class="dialog-title">战胜心魔！成功替瘾 1 支</text>
      <text class="dialog-subtitle">阻断焦油与尼古丁侵袭 · 身体自愈力 UP!</text>

      <!-- 每日自律打卡自动盖印闭环提示条 (腾讯大厂仪式感激励 · 消除断层) -->
      <view class="reward-punch-stamp-strip">
        <view class="rpss-left">
          <text class="rpss-dot"></text>
          <text class="rpss-title">今日自律打卡已自动盖印 ✓</text>
        </view>
        <view class="rpss-right">
          <text class="rpss-streak-label">连续自律</text>
          <text class="rpss-streak-num">{{ lastReward.streakDays || 1 }}</text>
          <text class="rpss-streak-unit">天</text>
        </view>
      </view>

      <!-- 尊享自律金券入账条 (深度联动钱包自律储备金券概念) -->
      <view class="reward-bill-deposit-box">
        <!-- 迷你自律金券 -->
        <view class="rb-mini-bill-wrap">
          <image 
            class="rb-banknote-img" 
            src="{{ goldVoucherSvgUri || '/images/cyber_gold_voucher.png' }}" 
            mode="aspectFit" 
          />
        </view>
        <!-- 入账文案 -->
        <view class="rb-deposit-desc">
          <text class="rb-deposit-title">自律金券入账！</text>
          <text class="rb-deposit-sub">少抽 1 支真烟，成功省下</text>
        </view>
        <!-- 入账金额高亮 -->
        <view class="rb-deposit-val">
          <text class="rb-val-prefix">+¥</text>
          <text class="rb-val-num">{{ lastReward.savedMoney }}</text>
        </view>
      </view>

      <!-- 4 宫格核心收益结算 (HUD 科技能量卡片) -->
      <view class="reward-grid">
        <view class="reward-cell gold-cell">
          <view class="rc-header">
            <text class="rc-icon">💰</text>
            <text class="reward-cell-label">节省开支</text>
          </view>
          <view class="rc-body">
            <text class="reward-cell-val gold-text">¥{{ lastReward.savedMoney }}</text>
          </view>
        </view>

        <view class="reward-cell green-cell">
          <view class="rc-header">
            <text class="rc-icon">🛡️</text>
            <text class="reward-cell-label">阻断焦油</text>
          </view>
          <view class="rc-body">
            <text class="reward-cell-val green-text">-{{ lastReward.tarAvoided }}<text class="unit-text">mg</text></text>
          </view>
        </view>

        <view class="reward-cell purple-cell">
          <view class="rc-header">
            <text class="rc-icon">❤️</text>
            <text class="reward-cell-label">抢回寿命</text>
          </view>
          <view class="rc-body">
            <text class="reward-cell-val purple-text">+{{ lastReward.lifeRegained }}<text class="unit-text">分</text></text>
          </view>
        </view>

        <view class="reward-cell cyan-cell">
          <view class="rc-header">
            <text class="rc-icon">⏱️</text>
            <text class="reward-cell-label">品吸时长</text>
          </view>
          <view class="rc-body">
            <text class="reward-cell-val cyan-text">{{ lastReward.durationSeconds }}<text class="unit-text">s</text> / {{ lastReward.inhaleCount }}<text class="unit-text">口</text></text>
          </view>
        </view>
      </view>

      <!-- 累计里程碑与排位战报 -->
      <view class="reward-milestone-box">
        <text class="rmb-icon">🌟</text>
        <text class="rmb-text">累计替烟 {{ totalSubstituted }} 次 · 累计已省 ¥{{ totalSavedMoney }}<block wx:if="{{ myRankInfo }}"> · 英雄榜第{{ myRankInfo.rank }}席</block></text>
      </view>

      <!-- 调皮搞笑鼓励金句气泡 -->
      <view class="reward-humor-bubble">
        <text class="rhb-emoji">💬</text>
        <text class="rhb-quote">“{{ rewardPunchline || '尼古丁骂骂咧咧地退出了群聊！' }}”</text>
      </view>

      <!-- 操作按钮阶梯 -->
      <view class="dialog-btn-stack">
        <button class="primary-gold-btn reward-confirm-btn" catchtap="closeRewardModal">
          <text class="btn-main-text">💪 收下战果 · 功德+1</text>
        </button>
        <button class="secondary-dark-btn reward-again-btn" catchtap="drawNewCigarette">
          <text class="btn-sub-text">🚬 意犹未尽 · 再抽一支</text>
        </button>
      </view>

    </view>
  </view>





  <!-- ==================== 弹窗 4: 抽烟环境面板 (底部精致抽屉布局) ==================== -->
  <view class="glass-modal-backdrop" wx:if="{{ showSceneModal }}" catchtouchmove="preventTouchMove" bindtap="closeSceneModal">
    <view class="skill-bottom-sheet scene-bottom-sheet" catchtap="stopBubble">
      <view class="sheet-top-handle"></view>
      <view class="sheet-title-row">
        <view class="sheet-title-left">
          <text class="sheet-main-title">🌿 抽烟环境 · 18大典藏声景</text>
          <text class="sheet-sub-title-tag">支持「吸烟火光映照」实时联动</text>
        </view>
        <view class="sheet-close-btn" bindtap="closeSceneModal">✕</view>
      </view>

      <!-- 场景主题分类快筛胶囊栏 -->
      <view class="scene-category-pills-row">
        <view 
          class="scene-cat-pill {{ activeSceneCategory === cat.id ? 'active-cat-pill' : '' }}"
          wx:for="{{ sceneCategories }}"
          wx:for-item="cat"
          wx:key="id"
          bindtap="onSelectSceneCategory"
          data-id="{{ cat.id }}"
        >
          <text class="scp-icon">{{ cat.icon }}</text>
          <text class="scp-text">{{ cat.name }}</text>
        </view>
      </view>

      <!-- 可滚动区域 -->
      <scroll-view class="scene-sheet-scroll" scroll-y="true" enhanced="true" show-scrollbar="false" scroll-into-view="{{ activeScrollSceneId }}">
        <!-- 声学系统主控 (全局吸烟/点火交互音效 + 环境声景伴吸) -->
        <view class="menu-tools-section">
          <text class="menu-section-title">🔊 声学氛围与交互音效</text>
          
          <!-- 1. 全局交互音效开关 (点火、吸烟、抽烟呼吸声、爆珠、抖灰等) -->
          <view class="scene-sound-toggle-bar" bindtap="toggleMute">
            <view class="sst-left">
              <image class="sst-svg-icon" src="{{ isMuted ? soundMuteIconUri : soundOnIconUri }}" mode="aspectFit" />
              <view class="sst-info">
                <text class="sst-title">真实抽吸与点火音效</text>
                <text class="sst-desc">{{ !isMuted ? '已开启 · 真实烟丝燃烧声、深呼吸、抖灰' : '已静音 · 全局静音纯净抽烟' }}</text>
              </view>
            </view>
            <switch checked="{{ !isMuted }}" color="#f59e0b" style="pointer-events: none;" />
          </view>

          <!-- 2. 环境声景白噪音开关 -->
          <view class="scene-sound-toggle-bar scene-ambient-toggle-bar" bindtap="toggleAmbientSound">
            <view class="sst-left">
              <text class="sst-icon">{{ isAmbientEnabled ? '🎧' : '🔇' }}</text>
              <view class="sst-info">
                <text class="sst-title">大师级柔绒微声景伴吸</text>
                <text class="sst-desc">{{ isAmbientEnabled ? '已开启 -26dB 暖频呼吸柔音 · 久听静心不吵耳' : '已静音 · 纯享无声' }}</text>
              </view>
            </view>
            <switch checked="{{ isAmbientEnabled }}" color="#10b981" style="pointer-events: none;" />
          </view>
        </view>

        <!-- 沉浸场景网格卡片 -->
        <view class="menu-skills-section">
          <text class="menu-section-title">沉浸声景 ({{ filteredAtmosphereScenes.length }}款)</text>
          <view class="skill-cards-grid">
            <view 
              id="scene_card_{{ item.id }}"
              class="skill-item-card scene-item-card {{ item.id === currentScene ? 'is-active-skill' : '' }}"
              wx:for="{{ filteredAtmosphereScenes }}"
              wx:key="id"
              bindtap="onSelectAtmosphereScene"
              data-id="{{ item.id }}"
            >
              <view class="skill-card-top-row">
                <view class="scene-icon-wrap">
                  <text class="skill-card-icon">{{ item.icon }}</text>
                  <view class="scene-accent-dot" style="background: {{ item.accentColor || '#10b981' }}; box-shadow: 0 0 10rpx {{ item.accentColor || '#10b981' }};"></view>
                </view>
                <view class="scene-item-badge {{ item.id === currentScene ? 'active-badge' : '' }}" wx:if="{{ item.badge }}">{{ item.badge }}</view>
              </view>
              <view class="skill-card-info">
                <view class="skill-card-title">{{ item.name }}</view>
                <view class="skill-card-sub">{{ item.subtitle }}</view>
                <view class="scene-card-sound-row">
                  <text class="scs-icon">🔊</text>
                  <text class="scs-text">{{ item.ambientDesc }}</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </scroll-view>

    </view>
  </view>





  <!-- ==================== 弹窗 7: 烟雾特工坊 · 尊享展厅 ==================== -->
  <view class="glass-modal-backdrop" wx:if="{{ showSmokeEffectDrawer }}" catchtouchmove="preventTouchMove" bindtap="closeSmokeEffectDrawer">
    <view class="smoke-effects-drawer" catchtap="stopBubble">
      <view class="sheet-top-handle"></view>
      
      <!-- 展厅头部 -->
      <view class="effects-drawer-header">
        <view class="ed-header-left">
          <view class="ed-title-row">
            <text class="ed-main-title">💨 烟雾特工坊 · 尊享展厅</text>
            <view class="ed-vip-pill">VIP EXCLUSIVE</view>
          </view>
          <text class="ed-sub-title">已替烟节省开支 ¥{{ totalSavedMoney }} · 支持替烟基金零元换购</text>
        </view>
        <view class="sheet-close-btn" bindtap="closeSmokeEffectDrawer">✕</view>
      </view>

      <!-- 特效卡片纵向滚动流 -->
      <scroll-view class="effects-cards-scroll" scroll-y scroll-into-view="{{ activeScrollEffectId }}" scroll-with-animation="false">
        <view class="effects-cards-list">
          <view 
            id="effect_card_{{ item.id }}"
            class="effect-card {{ item.id === currentSmokeEffect.id ? 'active-effect-card' : '' }} {{ !item.unlocked ? 'locked-effect-card' : '' }}"
            wx:for="{{ smokeEffectsList }}"
            wx:key="id"
          >
            <!-- 卡片左侧：大图标与动态微光 -->
            <view class="effect-card-left" style="background: {{ item.glowColor }}; border-color: {{ item.accentBorder }};">
              <image class="ec-img-icon" wx:if="{{ item.iconImage }}" src="{{ item.iconImage }}" mode="aspectFit" />
              <text class="ec-icon" wx:else>{{ item.icon }}</text>
            </view>

            <!-- 卡片中央：信息与介绍 -->
            <view class="effect-card-info">
              <view class="ec-name-row">
                <text class="ec-name">{{ item.name }}</text>
                <view class="ec-cat-badge" style="background: {{ item.badgeBg }}; color: {{ item.tagColor }}; border: 1rpx solid {{ item.badgeBorder }};">
                  {{ item.categoryTag }}
                </view>
                <view class="ec-using-badge" wx:if="{{ item.id === currentSmokeEffect.id }}">正在使用</view>
              </view>
              <text class="ec-desc">{{ item.description }}</text>
              <view class="ec-price-line">
                <text class="ec-price-tag">{{ item.priceDisplay }}</text>
                <text class="ec-need-note" wx:if="{{ !item.unlocked && item.requiredCount > 0 }}">还差 {{ item.requiredCount - totalSubstituted > 0 ? (item.requiredCount - totalSubstituted) : 1 }} 支即可免费点亮 (进度 {{ totalSubstituted }}/{{ item.requiredCount }})</text>
              </view>
            </view>

            <!-- 卡片右侧：操作区 (装配 / 试抽 / 替烟基金兑换) -->
            <view class="effect-card-actions">
              <button 
                class="ec-btn ec-equip-btn" 
                wx:if="{{ item.unlocked }}"
                bindtap="onSelectSmokeEffect"
                data-item="{{ item }}"
              >
                {{ item.id === currentSmokeEffect.id ? '已装配' : '装配' }}
              </button>

              <block wx:if="{{ !item.unlocked }}">
                <button 
                  class="ec-btn ec-trial-btn"
                  bindtap="startTrialSmokeEffect"
                  data-item="{{ item }}"
                >
                  试抽
                </button>
                <button 
                  class="ec-btn ec-unlock-btn {{ item.canBuyWithSavings ? 'can-buy-btn' : '' }}"
                  bindtap="onUnlockSmokeEffectWithSavings"
                  data-item="{{ item }}"
                >
                  {{ item.canBuyWithSavings ? '兑换' : '解锁' }}
                </button>
              </block>
            </view>
          </view>
        </view>
      </scroll-view>

      <!-- 底部提示栏 -->
      <view class="effects-drawer-footer">
        <text class="edf-tip">💡 真实承诺：每少抽 1 根实体烟省 ¥{{ singleStickSavedPrice }}，替烟基金可 100% 免费兑换全场尊享特效！</text>
      </view>

    </view>
  </view>

  <!-- ==================== 弹窗 4: 好友递烟 · 赛博敬意受赠弹窗 ==================== -->
  <view class="glass-modal-backdrop" wx:if="{{ showGiftModal }}" catchtouchmove="preventTouchMove">
    <view class="gift-dialog-card">
      <view class="gift-glow-halo"></view>
      <view class="gift-top-banner">
        <text class="gtb-badge">🤝 东方礼仪 · 赛博递烟</text>
        <view class="gift-close-icon" bindtap="closeGiftModal">✕</view>
      </view>

      <view class="gift-showcase">
        <image class="gift-pack-floating-img" src="{{ giftCigarette.packImage || '/images/packs/baisha.png' }}" mode="aspectFit" />
        <view class="gift-smoke-shadow"></view>
      </view>

      <view class="gift-headline">
        <text class="gift-sender-tag">{{ giftSenderName || '老哥' }} 递给您</text>
        <text class="gift-cig-name">【{{ giftCigarette.name || currentCigarette.name }}】</text>
      </view>
      <text class="gift-quote">“老哥，来一根电子赛博烟！少抽实体烟，健康每一天！”</text>

      <view class="gift-stats-row">
        <view class="gift-stat-box">
          <text class="gsb-icon">🛡️</text>
          <text class="gsb-val green-text">0.0<text class="gsb-unit">mg</text></text>
          <text class="gsb-label">免受焦油</text>
        </view>
        <view class="gift-stat-box">
          <text class="gsb-icon">❤️</text>
          <text class="gsb-val purple-text">+11<text class="gsb-unit">分</text></text>
          <text class="gsb-label">抢回寿命</text>
        </view>
        <view class="gift-stat-box">
          <text class="gsb-icon">✨</text>
          <text class="gsb-val gold-text">+10<text class="gsb-unit">分</text></text>
          <text class="gsb-label">社交功德</text>
        </view>
      </view>

      <view class="dialog-btn-stack">
        <button class="primary-gold-btn gift-accept-btn" bindtap="acceptGiftAndIgnite">
          <text class="btn-main-text">🔥 点燃品吸 · 收下敬意</text>
        </button>
        <button class="secondary-dark-btn gift-return-btn" open-type="{{ currentPackRemaining > 0 ? 'share' : '' }}" bindtap="giveCigarette">
          <text class="btn-sub-text">🤝 回敬老哥 · 再递一支</text>
        </button>
      </view>
    </view>
  </view>

  <!-- ==================== 💎 创新点火工坊 · 掌心 EDC 机巧把玩所 (Tactile Fidget Lab) ==================== -->
  <view class="glass-modal-backdrop matrix-vault-backdrop" wx:if="{{ showIgnitionToolDrawer }}" catchtouchmove="preventTouchMove" bindtap="closeIgnitionToolDrawer">
    <view class="matrix-vault-container" catchtap="stopBubble">

      <!-- 顶栏：赛博解压工坊标题 + 情绪解压计数勋章 + 优雅关闭按钮 -->
      <view class="matrix-top-bar">
        <view class="mtb-title-group">
          <text class="mtb-en-tag">EDC FIDGET ARSENAL // 掌心解压</text>
          <text class="mtb-main-title">🔥 掌心机巧把玩所</text>
        </view>
        <view class="mtb-right-actions">
          <view class="fidget-counter-pill {{ fidgetCounterBumping ? 'fcp-bump' : '' }}" wx:if="{{ fidgetCount > 0 }}">
            <text class="fcp-spark">✨</text>
            <text class="fcp-label">已解压 <text class="fcp-count">{{ fidgetCount }}</text> 次</text>
          </view>
          <view class="matrix-close-circle" bindtap="closeIgnitionToolDrawer">✕</view>
        </view>
      </view>

      <!-- 核心 1：中央全息悬浮机体光轮展台 (纯净通透，支持高频点击与手势物理把玩) -->
      <view
        class="matrix-halo-stage fidget-tactile-stage"
        bindtouchstart="onStageTouchStart"
        bindtouchmove="onStageTouchMove"
        bindtouchend="onStageTouchEnd"
        catchtap="onTapHeroStage"
      >
        <!-- 动态色温流光环与能量粒子线 -->
        <view class="matrix-radial-aurora" style="background: radial-gradient(circle, {{ previewIgnitionTool.themeColor }}40 0%, {{ previewIgnitionTool.themeColor }}12 55%, transparent 75%);"></view>
        <view class="matrix-reticle-ring" style="border-color: {{ previewIgnitionTool.themeColor }}55; box-shadow: 0 0 36rpx {{ previewIgnitionTool.themeColor }}25;"></view>
        
        <!-- 悬浮机体主像与点触微爆 (双态交替，连续点击每次必重新震荡爆破) -->
        <view class="matrix-hero-pod {{ isFidgetActive ? 'pod-fidget-active' : '' }} {{ fidgetBlastIndex === 1 ? 'pod-blast-a' : (fidgetBlastIndex === 2 ? 'pod-blast-b' : (isPreviewTesting ? 'pod-ignite-blast' : '')) }}">
          <image class="matrix-hero-svg" src="{{ previewIgnitionTool.iconImage }}" mode="aspectFit" wx:if="{{ previewIgnitionTool.iconImage }}" />
          <text class="matrix-hero-emoji" wx:else>{{ previewIgnitionTool.icon }}</text>
          <!-- 物理火星冲击波光环 (双波交替重绘) -->
          <view class="matrix-shockwave shockwave-a" wx:if="{{ shockwaveToggle === 1 }}" style="border-color: {{ previewIgnitionTool.themeColor }};"></view>
          <view class="matrix-shockwave shockwave-b" wx:if="{{ shockwaveToggle === 2 }}" style="border-color: {{ previewIgnitionTool.themeColor }};"></view>
          <!-- 飞溅星火微粒 -->
          <view class="fidget-spark-dots" wx:if="{{ fidgetSparksVisible }}">
            <view class="fs-dot fs-d1" style="background: {{ previewIgnitionTool.themeColor }}; box-shadow: 0 0 8rpx {{ previewIgnitionTool.themeColor }};"></view>
            <view class="fs-dot fs-d2" style="background: {{ previewIgnitionTool.themeColor }}; box-shadow: 0 0 8rpx {{ previewIgnitionTool.themeColor }};"></view>
            <view class="fs-dot fs-d3" style="background: {{ previewIgnitionTool.themeColor }}; box-shadow: 0 0 8rpx {{ previewIgnitionTool.themeColor }};"></view>
            <view class="fs-dot fs-d4" style="background: {{ previewIgnitionTool.themeColor }}; box-shadow: 0 0 8rpx {{ previewIgnitionTool.themeColor }};"></view>
          </view>
        </view>
      </view>

      <!-- 试火与手势指引胶囊（向下独立外置，不再遮挡机身与光轮） -->
      <view class="matrix-action-indicator-dock" catchtap="onTapHeroStage">
        <view class="matrix-action-indicator" style="border-color: {{ previewIgnitionTool.themeColor }}55;">
          <text class="mai-text" style="{{ isPreviewTesting ? 'color:' + previewIgnitionTool.themeColor + '; font-weight:800;' : '' }}">{{ isPreviewTesting ? '🔥 机巧引燃 · 物理共振' : (previewIgnitionTool.id === 'zippo_vintage' && isZippoLidOpen ? '🪙 已掀开纯铜顶盖 · 轻触搓动打火' : (previewIgnitionTool.fidgetHint ? '👆 ' + previewIgnitionTool.fidgetHint : '👆 轻触机体 释放专属物理点火')) }}</text>
        </view>
      </view>

      <!-- 核心 2：悬浮解构机巧铭牌与情绪心境金句 (严格恒高，杜绝切换大小跳变) -->
      <view class="matrix-spec-card">
        <view class="msc-header">
          <view class="msc-title-left">
            <text class="msc-name">{{ previewIgnitionTool.name }}</text>
            <view class="fidget-mood-chip" style="color: {{ previewIgnitionTool.themeColor }}; border-color: {{ previewIgnitionTool.themeColor }}55; background: {{ previewIgnitionTool.themeColor }}15;">
              {{ previewIgnitionTool.moodTag || previewIgnitionTool.badge }}
            </view>
          </view>
          <view class="msc-title-right">
            <text class="fidget-material-tag">{{ previewIgnitionTool.craftMaterial || previewIgnitionTool.subTitle }}</text>
            <view class="msc-equipped-chip" wx:if="{{ previewIgnitionTool.id === currentIgnitionTool.id }}">
              <text class="chip-dot"></text>
              <text class="chip-label">专属伴侣</text>
            </view>
          </view>
        </view>
        
        <!-- 情绪抚慰灵魂语录 (固定单行省略，恒定高度) -->
        <view class="fidget-quote-box">
          <text class="fqb-quote">“{{ previewIgnitionTool.moodQuote || previewIgnitionTool.description }}”</text>
        </view>
      </view>

      <!-- 核心 3：5 位平视机械舱卡（即点即换即试装） -->
      <view class="matrix-selector-strip">
        <view
          class="matrix-slot-unit {{ item.id === previewIgnitionTool.id ? 'slot-current-focus' : '' }} {{ item.id === currentIgnitionTool.id ? 'slot-is-equipped' : '' }}"
          wx:for="{{ ignitionToolsList }}"
          wx:key="id"
          bindtap="onSelectShowcaseTool"
          data-id="{{ item.id }}"
        >
          <!-- 选中高亮光框 -->
          <view class="msu-glow-border" wx:if="{{ item.id === previewIgnitionTool.id }}" style="border-color: {{ item.themeColor }}; box-shadow: 0 0 16rpx {{ item.themeColor }}66;"></view>
          
          <view class="msu-icon-wrap" style="background: {{ item.id === previewIgnitionTool.id ? item.themeColor + '20' : 'rgba(255,255,255,0.04)' }};">
            <image class="msu-svg" wx:if="{{ item.iconImage }}" src="{{ item.iconImage }}" mode="aspectFit" />
            <text class="msu-emoji" wx:else>{{ item.icon }}</text>
            <view class="msu-active-pip" wx:if="{{ item.id === currentIgnitionTool.id }}"></view>
          </view>
          <text class="msu-label" style="{{ item.id === previewIgnitionTool.id ? 'color:' + item.themeColor + '; font-weight:800;' : '' }}">{{ item.name }}</text>
        </view>
      </view>

      <!-- 核心 4：悬浮胶囊装配主操作键 (单行无换行，严格绝对几何双居中) -->
      <view class="matrix-action-dock">
        <view
          class="matrix-equip-btn {{ previewIgnitionTool.id === currentIgnitionTool.id ? 'meb-equipped' : '' }} {{ justEquippedAnim ? 'meb-just-equipped' : '' }}"
          catchtap="onConfirmEquipTool"
          style="background: {{ previewIgnitionTool.id === currentIgnitionTool.id ? 'rgba(255,255,255,0.08)' : (previewIgnitionTool.buttonGradient || 'linear-gradient(135deg, ' + previewIgnitionTool.themeColor + ' 0%, #d97706 100%)') }}; border-color: {{ previewIgnitionTool.id === currentIgnitionTool.id ? 'rgba(52,211,153,0.35)' : previewIgnitionTool.themeColor }};"
        >
          <text class="meb-text {{ previewIgnitionTool.id === currentIgnitionTool.id ? 'text-is-equipped' : 'text-need-equip' }}">{{ justEquippedAnim ? '✨ 契约已缔结 · 专属点火伴侣' : (previewIgnitionTool.id === currentIgnitionTool.id ? '✓ 当前已装配为专属点火器具' : '立即装配为专属点火器具') }}</text>
        </view>
      </view>

    </view>
  </view>

  <!-- 全局腾讯级灵动微胶囊 Toast HUD -->
  <custom-toast id="customToast" />

</view>

