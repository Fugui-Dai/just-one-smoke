          <view class="dev-group">
            <view class="dev-group-label">🍂 心绪便笺 · 随烟散尽与贤者时刻</view>
            <view class="dev-row-grid cols-4">
              <view class="dev-btn btn-amber" bindtap="devSetMoodNote" data-mood="琐事心烦" hover-class="dev-btn-active">笺:琐事心烦</view>
              <view class="dev-btn btn-amber" bindtap="devSetMoodNote" data-mood="身心疲惫" hover-class="dev-btn-active">笺:身心疲惫</view>
              <view class="dev-btn btn-amber" bindtap="devSetMoodNote" data-mood="焦虑紧绷" hover-class="dev-btn-active">笺:焦虑紧绷</view>
