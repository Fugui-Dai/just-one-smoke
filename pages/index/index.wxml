<!-- pages/index/index.wxml -->
<view class="app-container {{ vipTheme ? 'theme-' + vipTheme : '' }}">

  <!-- 🎨 全局 VIP 尊享极光天幕与浮光星尘 (全站背景装扮) -->
  <view wx:if="{{ vipTheme }}" class="vip-ambient-stage">
    <view class="vip-aurora-orb orb-primary"></view>
    <view class="vip-aurora-orb orb-secondary"></view>
    <view class="vip-spark s1"></view>
    <view class="vip-spark s2"></view>
    <view class="vip-spark s3"></view>
  </view>

  <!-- ==================== 沉浸式模拟器主页 ==================== -->
  <view class="tab-page simulator-tab active">

    <!-- ==================== 左侧主控 DOCK 栏 (黑曜石微距悬浮太空坞 · 一体化毛玻璃外壳) ==================== -->
    <view class="left-arc-dock right-arc-dock">
      <!-- 1. 点燃 / 掐灭 / 抽新烟 (单击点燃/掐灭，UNLIT状态长按弹出器具选择) -->
      <view
        class="dock-btn-wrap ignite-dock-wrap"
        bindtap="triggerIgnite"
        bindlongpress="onIgniteLongPress"
      >
        <!-- 💡 UNLIT 状态首次进入引导气泡：长按换器具 -->
        <view
          class="smoke-guide-tooltip ignite-guide-tooltip {{ isIgniteGuideFading ? 'guide-fade-out' : '' }}"
          wx:if="{{ showIgniteGuide }}"
          catchtap="onTapIgniteGuideTooltip"
        >
          <text class="sgt-text">💡 长按换点烟器具</text>
          <view class="sgt-arrow"></view>
        </view>

        <view
          class="dock-circle-btn ignite-btn {{ simulatorState === 'FINISHED' ? 'is-draw-new' : ((simulatorState !== 'UNLIT') ? 'is-lit' : 'is-unlit-tool') }} {{ isSparking ? 'is-btn-sparking' : '' }}"
          style="{{ simulatorState === 'UNLIT' ? 'border-color: ' + currentIgnitionTool.themeColor + 'bb; box-shadow: 0 4rpx 14rpx rgba(0,0,0,0.6), 0 0 16rpx ' + currentIgnitionTool.themeColor + '66, inset 0 2rpx 3rpx rgba(255,255,255,0.4);' : '' }}"
        >
          <image class="dock-svg-icon draw-svg-icon" src="{{ drawCigIconUri }}" mode="aspectFit" wx:if="{{ simulatorState === 'FINISHED' }}" />
          <image class="dock-svg-icon extinguish-svg-icon" src="{{ extinguishIconUri }}" mode="aspectFit" wx:elif="{{ simulatorState !== 'UNLIT' }}" />
          <!-- 未点燃时：优先显示当前点火器具的高清矢量SVG或烈火图标，杜绝裸露文字emoji -->
          <image class="dock-svg-icon ignite-svg-icon {{ isSparking ? 'ignite-icon-spark' : '' }}" src="{{ currentIgnitionTool.iconImage || igniteIconUri }}" mode="aspectFit" wx:else />
        </view>
        <text class="dock-title">{{ simulatorState === 'FINISHED' ? '抽新烟' : (simulatorState === 'UNLIT' ? '点燃' : '掐灭') }}</text>
      </view>

      <!-- 2. 抖灰 (圆形烟灰进度条 + 顺时针烟灰环 + 45°落灰图标) -->
      <view class="dock-btn-wrap" bindtap="manualTapAsh">
        <view class="dock-circle-btn ash-btn-circle {{ isAshTapping ? 'is-tapping' : '' }} {{ ashPercent >= 70 ? 'alert-ash' : (ashPercent > 0 ? 'has-ash' : '') }}">
          <!-- 圆形烟灰进度条 (根据当前烟灰长度顺时针环绕) -->
          <view 
            class="ash-progress-ring" 
            style="{{ ashProgressStyle }}"
          ></view>
          <!-- 内核灰按钮实体 -->
          <view class="ash-btn-inner">
            <image class="dock-svg-icon ash-svg-icon" src="{{ ashTapIconUri }}" mode="aspectFit" />
          </view>
        </view>
        <text class="dock-title">抖灰</text>
      </view>

      <!-- 3. 抽烟环境 (单击快速切换环境 · 长按开启列表 · 首次气泡引导 · 纯矢量天地穹顶) -->
      <view 
        class="dock-btn-wrap scene-dock-wrap" 
        bindtap="toggleScene" 
        bindlongpress="openSceneModal"
      >
        <!-- 💡 首次新手引导呼吸微气泡 -->
        <view 
          class="smoke-guide-tooltip scene-guide-tooltip {{ isSceneGuideFading ? 'guide-fade-out' : '' }}" 
          wx:if="{{ showSceneGuide }}"
          catchtap="onTapSceneGuideTooltip"
        >
          <text class="sgt-text">💡 长按环境开启列表</text>
          <view class="sgt-arrow"></view>
        </view>

        <view 
          class="dock-circle-btn scene-btn-circle" 
          style="{{ currentSceneInfo.accentColor ? ('border-color: ' + currentSceneInfo.accentColor + '; box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.65), 0 0 14rpx ' + currentSceneInfo.accentColor + '44;') : '' }}"
        >
          <image class="dock-svg-icon scene-svg-icon" src="{{ sceneAmbientIconUri }}" mode="aspectFit" />
        </view>
        <text class="dock-title">环境</text>
      </view>

      <!-- 4. 烟雾特效 (分段刻度环 + 3D烟圈与星芒) -->
      <view 
        class="dock-btn-wrap smoke-dock-wrap" 
        bindtap="toggleSmokeEffect" 
        bindlongpress="openSmokeEffectDrawer"
      >
        <!-- 💡 首次新手引导呼吸微气泡 -->
        <view 
          class="smoke-guide-tooltip {{ isGuideFading ? 'guide-fade-out' : '' }}" 
          wx:if="{{ showSmokeEffectGuide }}"
          catchtap="onTapSmokeGuideTooltip"
        >
          <text class="sgt-text">💡 长按烟雾开启列表</text>
          <view class="sgt-arrow"></view>
        </view>

        <view 
          class="dock-circle-btn smoke-effect-btn" 
          style="{{ currentSmokeEffect.accentBorder ? ('border-color: ' + currentSmokeEffect.accentBorder + ';') : '' }}"
        >
          <image class="dock-img-icon" wx:if="{{ currentSmokeEffect.iconImage }}" src="{{ currentSmokeEffect.iconImage }}" mode="aspectFit" />
          <image class="dock-svg-icon vfx-svg-icon" wx:else src="{{ smokeVfxIconUri }}" mode="aspectFit" />
        </view>
        <text class="dock-title">烟雾</text>
      </view>

      <!-- 5. 递烟 (盒内有烟: 微信原生分享; 盒内已空: 触发拆新盒闭环) -->
      <button 
        class="dock-btn-wrap share-dock-item" 
        open-type="share" 
        bindtap="giveCigarette"
        wx:if="{{ currentPackRemaining > 0 }}"
      >
        <view class="dock-circle-btn share-btn-circle">
          <!-- 仅外层圆圈显示进度环 (薄边径向遮罩) -->
          <view 
            class="share-progress-ring" 
            style="background: conic-gradient(#34d399 0deg, #10b981 {{ shareProgressDeg }}deg, rgba(255, 255, 255, 0.14) {{ shareProgressDeg }}deg 360deg);"
          ></view>
          <image class="dock-svg-icon share-svg-icon" src="{{ giveCigIconUri }}" mode="aspectFit" />
        </view>
        <text class="dock-title">递烟</text>
      </button>

      <view 
        class="dock-btn-wrap share-dock-item" 
        bindtap="giveCigarette"
        wx:else
      >
        <view class="dock-circle-btn share-btn-circle">
          <!-- 动态烟盒余量进度圆环 (0支空环) -->
          <view 
            class="share-progress-ring" 
            style="background: rgba(255, 255, 255, 0.14);"
          ></view>
          <image class="dock-svg-icon share-svg-icon" src="{{ giveCigIconUri }}" mode="aspectFit" />
        </view>
        <text class="dock-title">递烟</text>
      </view>

      <!-- 6. 商店 (经典双色雨篷精品店铺，选烟与烟盒馆) -->
      <view class="dock-btn-wrap store-dock-wrap" bindtap="openCigarettePicker">
        <view class="dock-circle-btn store-btn-circle">
          <image class="dock-svg-icon store-svg-icon" src="{{ storeIconUri }}" mode="aspectFit" />
        </view>
        <text class="dock-title">商店</text>
      </view>

      <!-- 7. 排行榜 (曜金奖杯图标 + 下方“排行榜”) -->
      <view class="dock-btn-wrap rank-dock-wrap" bindtap="switchToLeaderboard">
        <view class="dock-circle-btn rank-btn-circle">
          <image class="dock-svg-icon rank-svg-icon" src="{{ leaderboardIconUri }}" mode="aspectFit" />
        </view>
        <text class="dock-title">排行榜</text>
      </view>

      <!-- 8. 我的 (金冠头像 + 下方“我的”，支持长按直接唤醒管理员测试) -->
      <view class="dock-btn-wrap" bindtap="switchToStats" bindlongpress="devQuickUnlockAdmin">
        <view class="dock-circle-btn my-btn-circle {{ vipTheme ? 'is-vip-my-btn' : '' }}">
          <image class="dock-svg-icon my-svg-icon" src="{{ myProfileIconUri }}" mode="aspectFit" />
        </view>
        <text class="dock-title {{ vipTheme ? 'gold-title' : '' }}">我的</text>
      </view>

      <!-- 9. 管理员测试 (点击我的页面底部版权单次开启后，在此显现) -->
      <view class="dock-btn-wrap dev-dock-wrap" wx:if="{{ isDevAdminMode }}" bindtap="openAdminTest">
        <view class="dock-circle-btn dev-btn-circle">
          <text class="dock-char-icon dev-char-icon">🛠️</text>
        </view>
        <text class="dock-title dev-gold-title">测试</text>
      </view>
    </view>

    <!-- 画布区域 (居中展示 3D 拟真卷烟/雪茄与袅袅青烟) -->
    <view class="canvas-wrapper">

      <!-- 微信原生 Canvas 2D 高清画布 -->
      <canvas
        type="2d"
        id="smokeCanvas"
        class="smoke-canvas"
        bindtouchstart="onTouchStart"
        bindtouchmove="onTouchMove"
        bindtouchend="onTouchEnd"
        bindtouchcancel="onTouchEnd"
      ></canvas>


      <!-- 腾讯总监级 · 电影级沉浸呼吸暗角 (长按深吸时凝聚视线 · 呼气释然平滑消散) -->
      <view class="cinematic-vignette-mask {{ simulatorState === 'INHALING' ? 'active-inhale' : '' }}"></view>

    </view>

    <!-- 腾讯总监设计级：赛博贤者时刻 · 动态灵动浮岛 (Dynamic Zen Island HUD) -->
    <view 
      class="zen-hud-capsule {{ showZenHud ? 'zen-hud-visible' : '' }}" 
      wx:if="{{ showZenHud }}" 
      bindtap="openRewardModal"
      style="top: {{ (capsuleTop && capsuleTop > 0) ? (capsuleTop + 42) : 108 }}px;"
    >
      <view class="zhc-ambient-glow"></view>
      <view class="zhc-aura-border"></view>
      <view class="zhc-inner-layout">
        <view class="zhc-icon-badge">
          <text class="zib-icon">🌿</text>
          <view class="zib-breath-dot"></view>
        </view>
        <view class="zhc-content-col">
          <view class="zhc-headline-row">
            <text class="zhr-title">贤者时刻 · 身心澄澈</text>
            <view class="zhr-tag">替烟达成</view>
          </view>
          <view class="zhc-subtext-row">
            <text class="zsr-text">{{ zenHudText }}</text>
          </view>
        </view>
        <view class="zhc-arrow-action">
          <text class="zaa-text">成果</text>
          <text class="zaa-arrow">➔</text>
        </view>
      </view>
    </view>


    <!-- 🪙 桌面极简冷淡风微距铜托盘/烟灰缸 (生活真实留存与空间沉淀) -->
    <view class="desk-ashtray-wrap" bindtap="onTapAshtray">
      <view class="ashtray-dish">
        <view class="ashtray-rim"></view>
        <view class="ashtray-bed">
          <!-- 灰渣沉淀底晕 (随抖灰次数自然加深) -->
          <view class="ashtray-ash-layer" style="opacity: {{ ashtrayAshLevel > 0 ? (ashtrayAshLevel * 0.007 + 0.15) : 0 }};"></view>

          <!-- 真实散落的立体炭灰粉末微粒 -->
          <block wx:for="{{ ashtrayAshFlakes }}" wx:key="id">
            <view class="ashtray-ash-flake" style="left: {{ item.x }}rpx; top: {{ item.y }}rpx; width: {{ item.size }}rpx; height: {{ item.size }}rpx; opacity: {{ item.opacity }}; transform: rotate({{ item.rot }}deg); background: {{ item.color }};"></view>
          </block>

          <block wx:for="{{ ashtrayButts }}" wx:key="id">
            <view class="ashtray-butt butt-pos-{{ index % 20 }}" style="--butt-filter-color: {{ item.filterColor || '#ca8a04' }}; z-index: {{ index + 1 }};">
              <view class="butt-filter"></view>
              <view class="butt-stub"></view>
              <view class="butt-ash-tip"></view>
            </view>
          </block>
          <view class="ashtray-cold-smoke" wx:if="{{ showAshtraySmoke }}"></view>
        </view>
      </view>
      <text class="ashtray-badge" wx:if="{{ ashtrayButts.length > 0 }}">{{ ashtrayButts.length }}</text>
    </view>

    <!-- 🍂 桌面雅致心绪笺 (写下心事 · 随吸烟青烟消散升华 · 情绪价值拉满) -->
    <view class="desk-mood-note-wrap {{ currentMoodText ? 'has-mood-note' : '' }} {{ isMoodDissolving ? 'mood-dissolving' : '' }}" bindtap="openMoodModal">
      <view class="mood-note-paper">
        <view class="mood-paper-texture"></view>
        <block wx:if="{{ currentMoodText }}">
          <text class="mood-note-tag">“{{ currentMoodText }}”</text>
          <text class="mood-note-sub">随烟散尽 ➔</text>
        </block>
        <block wx:else>
          <text class="mood-note-icon">📜</text>
          <text class="mood-note-label">心绪笺</text>
        </block>
        <view class="mood-smoke-wisp" wx:if="{{ isMoodDissolving }}"></view>
      </view>
    </view>

    <!-- 🍵 饮茶润喉模式 (连续吸食生理关怀阻尼 · 东方禅意高奢静心空间) -->
    <view class="glass-modal-backdrop tea-soothing-backdrop" wx:if="{{ showTeaModal }}" catchtouchmove="preventTouchMove" bindtap="closeTeaModal">
      <view class="tea-soothing-card" catchtap="stopBubble">
        <!-- 顶部柔光与流光装饰框 -->
        <view class="tea-card-ambient-glow"></view>
        <view class="tea-card-aura-border"></view>
        <view class="tea-card-close" bindtap="closeTeaModal">✕</view>

        <!-- 禅意茶盏灵动舞台 -->
        <view class="tea-cup-stage">
          <view class="tea-stage-ring-outer"></view>
          <view class="tea-stage-ring-inner"></view>
          <view class="tea-steam-wisp wisp-1"></view>
          <view class="tea-steam-wisp wisp-2"></view>
          <view class="tea-steam-wisp wisp-3"></view>
          <view class="tea-cup-glow"></view>
          <view class="tea-cup-icon">🍵</view>
        </view>

        <!-- 典雅主标题与副标 -->
        <view class="tea-header-group">
          <text class="tea-badge-tag">{{ teaBadgeText || (isVipUser ? '👑 VIP尊享关怀 · 今日抽吸已超40支' : '🌿 今日抽吸较多 · 请歇一歇') }}</text>
          <text class="tea-soothing-title">喉咙需要休息一下了</text>
        </view>

        <!-- 关怀解释文案 -->
        <view class="tea-quote-box">
          <text class="tea-soothing-quote">{{ teaDescriptionText || '您今天已经连续抽吸较多。频繁抽吸容易引起喉咙干涩与心率加快，建议放下手机喝口温水，休息片刻。' }}</text>
        </view>

        <!-- 控烟实用贴士 -->
        <view class="tea-breathing-guide">
          <view class="tbg-icon-wrap">
            <text class="tbg-leaf">💧</text>
          </view>
          <view class="tbg-content">
            <text class="tbg-title">控烟实用贴士</text>
            <text class="tbg-text">喝一杯温水或深呼吸，能迅速冲淡对尼古丁的急迫渴望</text>
          </view>
        </view>

        <!-- 确定按钮 -->
        <button class="tea-action-btn" hover-class="tea-btn-hover" bindtap="closeTeaModal">
          <view class="tea-btn-shine"></view>
          <text class="tea-btn-emoji">🍵</text>
          <text class="tea-btn-label">知道了，去喝口水休息</text>
        </button>
      </view>
    </view>

    <!-- 🪵 桌面应急小抽屉抽屉板 (居中拟物原木/黑金暗屉 · 人体工学舒适区) -->
    <view class="glass-modal-backdrop drawer-modal-backdrop" wx:if="{{ showDeskDrawerModal }}" catchtouchmove="preventTouchMove" bindtap="closeDeskDrawerModal">
      <view class="desk-drawer-card {{ isVipUser ? 'vip-drawer-card' : '' }}" catchtap="stopBubble">
        
        <!-- 抽屉顶部黄铜横梁与拉环装饰 -->
        <view class="drawer-top-brass-beam">
          <view class="brass-beam-stud left"></view>
          <view class="brass-beam-handle"></view>
          <view class="brass-beam-stud right"></view>
        </view>

        <!-- 标题栏 -->
        <view class="dds-header">
          <view class="dds-title-wrap">
            <text class="dds-title">{{ isVipUser ? '👑 尊享典藏暗屉 · 无限开盒' : '🪵 桌下胡桃木暗屉 · 应急修心' }}</text>
            <text class="dds-sub-tag">{{ isVipUser ? 'VIP 专属无限开盒' : '生活化应急链路' }}</text>
          </view>
          <view class="sheet-close-btn" bindtap="closeDeskDrawerModal">✕</view>
        </view>

        <!-- 选项列表 -->
        <view class="dds-options-grid">
          
          <!-- VIP 专属选项: 无限开箱拆新盒 -->
          <view class="dds-card dds-vip-unwrap-card" wx:if="{{ isVipUser }}" bindtap="onVipDirectUnwrapNewPack" hover-class="dds-card-active">
            <view class="ddsc-icon-wrap vip-gold-icon">
              <text class="ddsc-emoji">✨</text>
            </view>
            <view class="ddsc-info">
              <text class="ddsc-name gold-shine-text">典藏无限开盒 · 撕开金拉线</text>
              <text class="ddsc-desc">尊享私藏典藏特权 · 开箱即享满盒</text>
            </view>
            <view class="ddsc-action-btn vip-btn">开新盒</view>
          </view>

          <!-- 普通选项 1: 拆新盒 (若有未拆库存) -->
          <view class="dds-card dds-unwrap-card" wx:elif="{{ unopenedPacksCount > 0 }}" bindtap="onUnwrapNewPackFromDrawer" hover-class="dds-card-active">
            <view class="ddsc-icon-wrap pack-icon">
              <text class="ddsc-emoji">📦</text>
            </view>
            <view class="ddsc-info">
              <text class="ddsc-name">拆开未拆烟盒 · 撕开金拉线</text>
              <text class="ddsc-desc">抽屉存量：{{ unopenedPacksCount }} 包 · 撕拉金线开盒</text>
            </view>
            <view class="ddsc-action-btn unwrap-btn">拆封</view>
          </view>

          <!-- 选项 2: 翻抽屉摸应急散烟 -->
          <view class="dds-card dds-single-card" bindtap="onTakeSingleEmergencyStick" hover-class="dds-card-active">
            <view class="ddsc-icon-wrap single-icon">
              <text class="ddsc-emoji">🚬</text>
            </view>
            <view class="ddsc-info">
              <text class="ddsc-name">翻寻案底暗屉 · 偶得单支散烟</text>
              <text class="ddsc-desc">屉底落单的 1 支经典好烟 · 即点即抽</text>
            </view>
            <view class="ddsc-action-btn single-btn">取出</view>
          </view>

          <!-- 选项 3: 4-7-8 静心顺顺气 (普通用户获得新包入库，VIP进入心境冥想) -->
          <view class="dds-card dds-zen-card" bindtap="openBreathingSpace" hover-class="dds-card-active">
            <view class="ddsc-icon-wrap zen-icon">
              <text class="ddsc-emoji">🌿</text>
            </view>
            <view class="ddsc-info">
              <text class="ddsc-name">4-7-8 静心吐纳 · 顺气平燥</text>
              <text class="ddsc-desc">{{ isVipUser ? 'VIP 专属颂钵音疗 · 涤净心胸平复焦躁' : '平复焦躁冲动 · 顺气安顿奖赏 1 包存入暗屉' }}</text>
            </view>
            <view class="ddsc-action-btn zen-btn">去顺气</view>
          </view>

          <!-- 选项 4: 借个火 (微信好友互敬赠烟) -->
          <view class="dds-card dds-share-card" hover-class="dds-card-active">
            <button class="dds-share-button-mask" open-type="share" bindtap="giveCigarette"></button>
            <view class="ddsc-icon-wrap fire-icon">
              <text class="ddsc-emoji">🤝</text>
            </view>
            <view class="ddsc-info">
              <text class="ddsc-name">微信递烟敬友 · 赠友留香</text>
              <text class="ddsc-desc">递一支给兄弟 · 双方各得 1 整包体面好烟</text>
            </view>
            <view class="ddsc-action-btn share-btn">敬烟</view>
          </view>

        </view>
      </view>
    </view>

    <!-- 🌿 4-7-8 顺顺气 · 沉浸式静心吐纳空间 (拒绝顺完气粗暴塞烟) -->
    <view class="glass-modal-backdrop breathing-space-backdrop" wx:if="{{ showBreathingSpaceModal }}" catchtouchmove="preventTouchMove">
      <view class="breathing-space-container">
        
        <!-- 顶部状态栏与关闭 -->
        <view class="bsc-header">
          <view class="bsc-badge">
            <text class="bsc-badge-dot"></text>
            <text class="bsc-badge-text">4-7-8 科学呼吸减压法</text>
          </view>
          <view class="bsc-close-btn" bindtap="closeBreathingSpace">✕ 收气归元</view>
        </view>

        <!-- 吐纳进行中视效 -->
        <block wx:if="{{ !breathingCompleted }}">
          <!-- 呼吸指示语 (19秒黄金正念周期) -->
          <view class="bsc-cycle-indicator">
            <text class="bsc-cycle-text">4-7-8 静心吐纳</text>
            <text class="bsc-cycle-sub">平复交感神经 · 抚去心瘾焦躁 (19秒)</text>
          </view>

          <!-- 核心呼吸光环动效区 (独立层级 · 黄金留白 · 绝不遮挡圆圈) -->
          <view class="bsc-halo-stage">
            <view class="bsc-halo-outer {{ 'phase-' + breathingPhase }}"></view>
            <view class="bsc-halo-inner {{ 'phase-' + breathingPhase }}"></view>
            <!-- 中心独立文字区：不随圆环过度缩放变形，永远完美居中且留白宽裕，绝不遮挡圆圈 -->
            <view class="bsc-center-content">
              <text class="bsc-timer-num">{{ breathingCountdown }}</text>
              <text class="bsc-phase-label">{{ breathingPhaseLabel }}</text>
            </view>
          </view>

          <!-- 底部引导语与轻柔跳过 -->
          <view class="bsc-footer">
            <text class="bsc-guide-hint">“{{ breathingGuideQuote }}”</text>
            <view class="bsc-quick-finish-btn" bindtap="finishBreathingEarly">提前平复</view>
          </view>
        </block>

        <!-- 吐纳完成后的因果闭环成果卡片 (绝不粗暴强塞烟！) -->
        <block wx:else>
          <view class="bsc-success-card">
            <view class="bsc-success-icon-wrap">
              <text class="bsc-success-emoji">🌿</text>
            </view>
            <text class="bsc-success-title">吐纳圆满 · 身心安顿</text>
            <text class="bsc-success-quote">“呼吸深长，胸中烦热已如微云消散。你的克制与自律，已为你赢下 1 整包崭新好烟，稳妥收入桌下暗屉，作为自律资产备用。”</text>

            <view class="bsc-asset-reward-badge">
              <text class="barb-icon">📦</text>
              <text class="barb-text">暗屉备用烟包 +1（现有存量: {{ unopenedPacksCount }} 包）</text>
            </view>

            <!-- 尊严自选双通道 -->
            <view class="bsc-action-duo">
              <!-- 选项 A: 自律胜利，今天到此为止 (推荐) -->
              <button class="bsc-choice-btn btn-zen-peace" bindtap="onBreathingChoicePeace">
                <text class="bcb-title">身心已平 · 今日自律到此</text>
                <text class="bcb-sub">平复心瘾 ➔ 存入资产 ➔ 退出留白</text>
              </button>

              <!-- 选项 B: 体面取单支品吸 -->
              <button class="bsc-choice-btn btn-zen-draw" bindtap="onBreathingChoiceTakeSingle">
                <text class="bcb-title">取 1 支应急 · 慢吸品味</text>
                <text class="bcb-sub">从暗屉取出一支好烟，温和点燃</text>
              </button>
            </view>
          </view>
        </block>

      </view>
    </view>

    <!-- 🪙 桌面青铜/紫砂烟灰缸 · 沉淀自律微观展台弹窗 -->
    <view class="glass-modal-backdrop ashtray-modal-backdrop" wx:if="{{ showAshtrayModal }}" catchtouchmove="preventTouchMove" bindtap="closeAshtrayModal">
      <view class="ashtray-dialog-card" catchtap="stopBubble">
        <view class="dialog-drag-handle"></view>
        <view class="adc-header">
          <view class="adc-title-box">
            <image class="adc-icon-svg" src="{{ ashtrayBronzeIcon }}" mode="aspectFit"></image>
            <view class="adc-title-col">
              <text class="adc-title">紫铜托盘 · 岁月留痕</text>
              <text class="adc-sub-tag">生活微距沉淀 · 真实自律见证</text>
            </view>
          </view>
          <view class="adc-close-btn" bindtap="closeAshtrayModal">✕</view>
        </view>

        <!-- 拟物微距托盘特写展示区 -->
        <view class="adc-visual-stage">
          <view class="adc-tray-mock">
            <view class="atm-ring-glow"></view>
            <view class="atm-inner-bed">
              <view class="atm-sweep-brush {{ isCleaningAshtray ? 'sweep-active' : '' }}" wx:if="{{ isCleaningAshtray }}"></view>
              <view class="atm-ash-shadow" style="opacity: {{ ashtrayAshLevel > 0 ? (ashtrayAshLevel * 0.008 + 0.2) : 0 }};"></view>
              <!-- 弹窗微距特写：散落立体炭灰颗粒 (忠实呈现全部微距灰屑) -->
              <block wx:for="{{ ashtrayAshFlakes }}" wx:key="id">
                <view class="atm-ash-flake" style="left: {{ item.x * 1.5 }}rpx; top: {{ item.y * 1.5 }}rpx; width: {{ item.size * 1.4 }}rpx; height: {{ item.size * 1.4 }}rpx; opacity: {{ item.opacity }}; transform: rotate({{ item.rot }}deg); background: {{ item.color }};"></view>
              </block>
              <block wx:for="{{ ashtrayButts }}" wx:key="id">
                <view class="atm-butt-item butt-pos-{{ index % 20 }}" style="--butt-filter-color: {{ item.filterColor || '#ca8a04' }}; z-index: {{ index + 1 }};">
                  <view class="butt-filter"></view>
                  <view class="butt-stub"></view>
                  <view class="butt-ash-tip"></view>
                </view>
              </block>
              <view class="atm-empty-hint" wx:if="{{ ashtrayButts.length === 0 }}">
                <text class="aeh-icon">🌿</text>
                <text class="aeh-text">一尘不染 · 今日极尽克制</text>
              </view>
            </view>
          </view>
        </view>

        <!-- 自律见证状态与容量胶囊 (忠实记录今日抽吸痕迹) -->
        <view class="adc-metric-strip">
          <view class="ams-item">
            <text class="ams-val">{{ ashtrayButts.length }}<text class="ams-unit">支</text></text>
            <text class="ams-lbl">今日沉淀烟蒂</text>
          </view>
          <view class="ams-divider"></view>
          <view class="ams-item">
            <text class="ams-val">{{ ashtrayAshLevel > 0 ? (ashtrayAshLevel + '%') : '无积灰' }}</text>
            <text class="ams-lbl">余灰沉淀厚度</text>
          </view>
          <view class="ams-divider"></view>
          <view class="ams-item">
            <text class="ams-val ams-gold">{{ ashtrayButts.length === 0 ? '极佳' : (ashtrayButts.length <= 5 ? '清简' : (ashtrayButts.length <= 20 ? '适度' : '堆叠过厚')) }}</text>
            <text class="ams-lbl">自律心境评价</text>
          </view>
        </view>

        <!-- 人文寄语 -->
        <view class="adc-quote-box">
          <text class="adc-quote-text" wx:if="{{ ashtrayButts.length === 0 }}">“干净的烟灰缸，是成年人最不声张的克制与自律。”</text>
          <text class="adc-quote-text" wx:elif="{{ ashtrayButts.length <= 5 }}">“晨起日暮各一支，不多贪、不放纵，恰到好处的茶歇慢调。”</text>
          <text class="adc-quote-text" wx:elif="{{ ashtrayButts.length <= 20 }}">“烟蒂渐次成排，生活节奏亦当缓和，多饮两盏清茶。”</text>
          <text class="adc-quote-text" wx:else>“一池烟尘如浮生杂念。不妨倾倒洗净，给身心换一片清朗。”</text>
        </view>

        <!-- 底部操作按钮 -->
        <view class="adc-actions">
          <button class="adc-clean-btn {{ ashtrayButts.length === 0 && ashtrayAshLevel === 0 ? 'btn-disabled' : '' }}" bindtap="clearAshtrayNow" disabled="{{ ashtrayButts.length === 0 && ashtrayAshLevel === 0 }}">
            <image class="acb-icon-svg" src="{{ broomCleanIcon }}" mode="aspectFit"></image>
            <text class="acb-text">倾倒清洗 · 拂去烟尘</text>
          </button>
        </view>
      </view>
    </view>

    <!-- 🍂 心绪便笺 · 随烟散尽弹窗 -->
    <view class="glass-modal-backdrop mood-modal-backdrop" wx:if="{{ showMoodModal }}" catchtouchmove="preventTouchMove" bindtap="closeMoodModal">
      <view class="mood-dialog-card" catchtap="stopBubble">
        <view class="dialog-drag-handle"></view>
        <view class="mdc-header">
          <view class="mdc-title-box">
            <text class="mdc-icon">🍂</text>
            <text class="mdc-title">心绪便笺 · 随烟散尽</text>
          </view>
          <view class="mdc-close-btn" bindtap="closeMoodModal">✕</view>
        </view>
        <text class="mdc-subtitle">“心头若有琐碎与烦忧，写在笺上。伴着深吸长呼，让它随缕缕青烟散入虚空。”</text>
        
        <!-- 快捷心绪标签 -->
        <view class="mdc-chips-grid">
          <block wx:for="{{ moodPresets }}" wx:key="*this">
            <view 
              class="mdc-chip {{ currentMoodText === item ? 'chip-selected' : '' }}" 
              bindtap="onSelectMoodPreset" 
              data-mood="{{ item }}"
            >
              <text class="chip-text">{{ item }}</text>
            </view>
          </block>
        </view>

        <!-- 自定义写心绪 -->
        <view class="mdc-input-row">
          <input 
            class="mdc-input" 
            placeholder="或写下此刻的烦闷 (8字以内)" 
            placeholder-class="mdc-placeholder"
            maxlength="8"
            value="{{ customMoodInput }}"
            bindinput="onInputCustomMood"
          />
          <view class="mdc-confirm-btn" bindtap="onConfirmCustomMood">入笺</view>
        </view>

        <view class="mdc-footer-actions" wx:if="{{ currentMoodText }}">
          <text class="mdc-clear-link" bindtap="onClearMood">清空当前笺文</text>
        </view>
      </view>
    </view>

  <!-- ==================== 弹窗 1: 抽完结算达成弹窗 (腾讯高品质游戏化胜利战报) ==================== -->
  <view class="glass-modal-backdrop reward-modal-backdrop" wx:if="{{ showRewardModal }}" catchtouchmove="preventTouchMove">
    <view class="reward-dialog-card">
      
      <!-- 极简右上角关闭按钮 -->
      <view class="dialog-close-btn" bindtap="closeRewardModal">✕</view>

      <!-- 顶部荣誉徽章与胜利光晕 -->
      <view class="dialog-crest-wrap">
        <view class="crest-halo-glow"></view>
        <view class="crest-badge-circle">
          <image class="dialog-medal-img" src="{{ victoryMedalSvgUri }}" mode="aspectFit" />
        </view>
        <view class="crest-tag-pill">✦ 替烟成果 ✦</view>
      </view>

      <text class="dialog-title">心神渐静 · 成功替烟 1 支</text>
      <text class="dialog-subtitle">阻断焦油摄入 · 呼吸日渐清润</text>

      <!-- 每日自律点亮入册闭环提示条 (腾讯大厂仪式感激励 · 消除断层) -->
      <view class="reward-punch-stamp-strip">
        <view class="rpss-left">
          <text class="rpss-dot"></text>
          <text class="rpss-title">今日自律心灯已自动点亮入册 ✓</text>
        </view>
        <view class="rpss-right">
          <text class="rpss-streak-label">连续自律</text>
          <text class="rpss-streak-num">{{ lastReward.streakDays || 1 }}</text>
          <text class="rpss-streak-unit">天</text>
        </view>
      </view>

      <!-- 尊享自律金券入账条 (深度联动钱包自律储备金券概念) -->
      <view class="reward-bill-deposit-box">
        <!-- 迷你自律金券 -->
        <view class="rb-mini-bill-wrap">
          <image 
            class="rb-banknote-img" 
            src="{{ goldVoucherSvgUri || '/images/cyber_gold_voucher.png' }}" 
            mode="aspectFit" 
          />
        </view>
        <!-- 入账文案 -->
        <view class="rb-deposit-desc">
          <text class="rb-deposit-title">自律金券入账！</text>
          <text class="rb-deposit-sub">少抽 1 支真烟，成功省下</text>
        </view>
        <!-- 入账金额高亮 -->
        <view class="rb-deposit-val">
          <text class="rb-val-prefix">+¥</text>
          <text class="rb-val-num">{{ lastReward.savedMoney }}</text>
        </view>
      </view>

      <!-- 4 宫格核心收益结算 (HUD 科技能量卡片) -->
      <view class="reward-grid">
        <view class="reward-cell gold-cell">
          <view class="rc-header">
            <text class="rc-icon">💰</text>
            <text class="reward-cell-label">节省开支</text>
          </view>
          <view class="rc-body">
            <text class="reward-cell-val gold-text">¥{{ lastReward.savedMoney }}</text>
          </view>
        </view>

        <view class="reward-cell green-cell">
          <view class="rc-header">
            <text class="rc-icon">🛡️</text>
            <text class="reward-cell-label">阻断焦油</text>
          </view>
          <view class="rc-body">
            <text class="reward-cell-val green-text">-{{ lastReward.tarAvoided }}<text class="unit-text">mg</text></text>
          </view>
        </view>

        <view class="reward-cell purple-cell">
          <view class="rc-header">
            <text class="rc-icon">❤️</text>
            <text class="reward-cell-label">健康时光</text>
          </view>
          <view class="rc-body">
            <text class="reward-cell-val purple-text">+{{ lastReward.lifeRegained }}<text class="unit-text">分</text></text>
          </view>
        </view>

        <view class="reward-cell cyan-cell">
          <view class="rc-header">
            <text class="rc-icon">⏱️</text>
            <text class="reward-cell-label">品吸时长</text>
          </view>
          <view class="rc-body">
            <text class="reward-cell-val cyan-text">{{ lastReward.durationSeconds }}<text class="unit-text">s</text> / {{ lastReward.inhaleCount }}<text class="unit-text">口</text></text>
          </view>
        </view>
      </view>

      <!-- 累计里程碑与排位战报 -->
      <view class="reward-milestone-box">
        <text class="rmb-icon">🌟</text>
        <text class="rmb-text">累计替烟 {{ totalSubstituted }} 次 · 累计已省 ¥{{ totalSavedMoney }}<block wx:if="{{ myRankInfo }}"> · 英雄榜第{{ myRankInfo.rank }}席</block></text>
      </view>

      <!-- 鼓励金句气泡 -->
      <view class="reward-humor-bubble">
        <text class="rhb-emoji">💬</text>
        <text class="rhb-quote">“{{ rewardPunchline || '指间清风过，心头杂念消。' }}”</text>
      </view>

      <!-- 操作按钮阶梯 -->
      <view class="dialog-btn-stack">
        <button class="primary-gold-btn reward-confirm-btn" catchtap="closeRewardModal">
          <text class="btn-main-text">收下记录</text>
        </button>
        <button class="secondary-dark-btn reward-again-btn" catchtap="drawNewCigarette">
          <text class="btn-sub-text">再抽一支</text>
        </button>
      </view>

    </view>
  </view>





  <!-- ==================== 弹窗 4: 抽烟环境面板 (底部精致抽屉布局) ==================== -->
  <view class="glass-modal-backdrop" wx:if="{{ showSceneModal }}" catchtouchmove="preventTouchMove" bindtap="closeSceneModal">
    <view class="skill-bottom-sheet scene-bottom-sheet" catchtap="stopBubble">
      <view class="sheet-top-handle"></view>
      <view class="sheet-title-row">
        <view class="sheet-title-left">
          <text class="sheet-main-title">🌿 抽烟环境 · 典藏声景</text>
          <text class="sheet-sub-title-tag">支持「吸烟火光映照」实时联动</text>
        </view>
        <view class="sheet-close-btn" bindtap="closeSceneModal">✕</view>
      </view>

      <!-- 场景主题分类快筛胶囊栏 -->
      <view class="scene-category-pills-row">
        <view 
          class="scene-cat-pill {{ activeSceneCategory === cat.id ? 'active-cat-pill' : '' }}"
          wx:for="{{ sceneCategories }}"
          wx:for-item="cat"
          wx:key="id"
          bindtap="onSelectSceneCategory"
          data-id="{{ cat.id }}"
        >
          <text class="scp-icon">{{ cat.icon }}</text>
          <text class="scp-text">{{ cat.name }}</text>
        </view>
      </view>

      <!-- 可滚动区域 -->
      <scroll-view class="scene-sheet-scroll" scroll-y="true" enhanced="true" show-scrollbar="false" scroll-into-view="{{ activeScrollSceneId }}">
        <!-- 声学系统主控 (全局吸烟/点火交互音效 + 环境声景伴吸) -->
        <view class="menu-tools-section">
          <text class="menu-section-title">🔊 声学氛围与交互音效</text>
          
          <!-- 1. 全局交互音效开关 (点火、吸烟、抽烟呼吸声、爆珠、抖灰等) -->
          <view class="scene-sound-toggle-bar" bindtap="toggleMute">
            <view class="sst-left">
              <image class="sst-svg-icon" src="{{ isMuted ? soundMuteIconUri : soundOnIconUri }}" mode="aspectFit" />
              <view class="sst-info">
                <text class="sst-title">真实抽吸与点火音效</text>
                <text class="sst-desc">{{ !isMuted ? '已开启 · 真实烟丝燃烧声、深呼吸、抖灰' : '已静音 · 全局静音纯净抽烟' }}</text>
              </view>
            </view>
            <switch checked="{{ !isMuted }}" color="#f59e0b" style="pointer-events: none;" />
          </view>

          <!-- 2. 环境声景白噪音开关 -->
          <view class="scene-sound-toggle-bar scene-ambient-toggle-bar" bindtap="toggleAmbientSound">
            <view class="sst-left">
              <text class="sst-icon">{{ isAmbientEnabled ? '🎧' : '🔇' }}</text>
              <view class="sst-info">
                <text class="sst-title">大师级柔绒微声景伴吸</text>
                <text class="sst-desc">{{ isAmbientEnabled ? '已开启暖频环境声景 · 伴您静心呼吸冥想' : '已静音 · 纯享无声' }}</text>
              </view>
            </view>
            <switch checked="{{ isAmbientEnabled }}" color="#10b981" style="pointer-events: none;" />
          </view>
        </view>

        <!-- 沉浸场景网格卡片 -->
        <view class="menu-skills-section">
          <text class="menu-section-title">沉浸声景 ({{ filteredAtmosphereScenes.length }}款)</text>
          <view class="skill-cards-grid">
            <view 
              id="scene_card_{{ item.id }}"
              class="skill-item-card scene-item-card {{ item.id === currentScene ? 'is-active-skill' : '' }}"
              wx:for="{{ filteredAtmosphereScenes }}"
              wx:key="id"
              bindtap="onSelectAtmosphereScene"
              data-id="{{ item.id }}"
            >
              <view class="skill-card-top-row">
                <view class="scene-icon-wrap">
                  <text class="skill-card-icon">{{ item.icon }}</text>
                  <view class="scene-accent-dot" style="background: {{ item.accentColor || '#10b981' }}; box-shadow: 0 0 10rpx {{ item.accentColor || '#10b981' }};"></view>
                </view>
                <view class="scene-item-lock-badge" wx:if="{{ !isVipUser && item.requiredCount > 0 && totalSubstituted < item.requiredCount }}">🔒 {{ item.requiredCount }}支</view>
                <view class="scene-item-badge {{ item.id === currentScene ? 'active-badge' : '' }}" wx:elif="{{ item.badge }}">{{ item.badge }}</view>
              </view>
              <view class="skill-card-info">
                <view class="skill-card-title">{{ item.name }}</view>
                <view class="skill-card-sub">{{ item.subtitle }}</view>
                <view class="scene-card-sound-row">
                  <text class="scs-icon">🔊</text>
                  <text class="scs-text">{{ item.ambientDesc }}</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </scroll-view>

    </view>
  </view>





  <!-- ==================== 弹窗 7: 烟雾特工坊 · 尊享展厅 ==================== -->
  <view class="glass-modal-backdrop" wx:if="{{ showSmokeEffectDrawer }}" catchtouchmove="preventTouchMove" bindtap="closeSmokeEffectDrawer">
    <view class="smoke-effects-drawer" catchtap="stopBubble">
      <view class="sheet-top-handle"></view>
      
      <!-- 展厅头部 -->
      <view class="effects-drawer-header">
        <view class="ed-header-left">
          <view class="ed-title-row">
            <text class="ed-main-title">💨 烟雾工坊 · 灵动展厅</text>
          </view>
          <text class="ed-sub-title">已省烟资 ¥{{ totalSavedMoney }} · 每一支少抽皆是勋绩点亮</text>
        </view>
        <view class="sheet-close-btn" bindtap="closeSmokeEffectDrawer">✕</view>
      </view>

      <!-- 特效卡片纵向滚动流 -->
      <scroll-view class="effects-cards-scroll" scroll-y scroll-into-view="{{ activeScrollEffectId }}" scroll-with-animation="false">
        <view class="effects-cards-list">
          <view 
            id="effect_card_{{ item.id }}"
            class="effect-card {{ item.id === currentSmokeEffect.id ? 'active-effect-card' : '' }} {{ !item.unlocked ? 'locked-effect-card' : '' }}"
            wx:for="{{ smokeEffectsList }}"
            wx:key="id"
          >
            <!-- 卡片左侧：大图标与动态微光 -->
            <view class="effect-card-left" style="background: {{ item.glowColor }}; border-color: {{ item.accentBorder }};">
              <image class="ec-img-icon" wx:if="{{ item.iconImage }}" src="{{ item.iconImage }}" mode="aspectFit" />
              <text class="ec-icon" wx:else>{{ item.icon }}</text>
            </view>

            <!-- 卡片中央：信息与介绍 -->
            <view class="effect-card-info">
              <view class="ec-name-row">
                <text class="ec-name">{{ item.name }}</text>
                <view class="ec-cat-badge" style="background: {{ item.badgeBg }}; color: {{ item.tagColor }}; border: 1rpx solid {{ item.badgeBorder }};">
                  {{ item.categoryTag }}
                </view>
                <view class="ec-using-badge" wx:if="{{ item.id === currentSmokeEffect.id }}">使用中</view>
              </view>
              <text class="ec-desc">{{ item.description }}</text>
              <view class="ec-price-line">
                <text class="ec-price-tag">{{ item.priceDisplay }}</text>
                <text class="ec-need-note" wx:if="{{ !item.unlocked && item.requiredCount > 0 }}">还差 {{ item.requiredCount - totalSubstituted > 0 ? (item.requiredCount - totalSubstituted) : 1 }} 支即可免费点亮 (进度 {{ totalSubstituted }}/{{ item.requiredCount }})</text>
