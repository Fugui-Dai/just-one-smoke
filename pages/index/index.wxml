  <!-- ==================== 💎 创新点火工坊 · 掌心 EDC 机巧把玩所 (Tactile Fidget Lab) ==================== -->
  <view class="glass-modal-backdrop matrix-vault-backdrop" wx:if="{{ showIgnitionToolDrawer }}" catchtouchmove="preventTouchMove" bindtap="closeIgnitionToolDrawer">
    <view class="matrix-vault-container" catchtap="stopBubble">

      <!-- 顶栏：点火器具工坊标题 + 情绪解压计数勋章 + 优雅关闭按钮 -->
      <view class="matrix-top-bar">
        <view class="mtb-title-group">
          <text class="mtb-en-tag">LIGHTER & IGNITION WORKSHOP // 点火解压</text>
          <text class="mtb-main-title">🔥 点火器具工坊</text>
        </view>
        <view class="mtb-right-actions">
          <view class="fidget-counter-pill {{ fidgetCounterBumping ? 'fcp-bump' : '' }}" wx:if="{{ fidgetCount > 0 }}">
            <text class="fcp-spark">✨</text>
            <text class="fcp-label">已解压 <text class="fcp-count">{{ fidgetCount }}</text> 次</text>
          </view>
          <view class="matrix-close-circle" bindtap="closeIgnitionToolDrawer">✕</view>
        </view>
      </view>

      <!-- 核心 1：中央全息悬浮机体光轮展台 (纯净通透，支持高频点击与手势物理把玩) -->
      <view
        class="matrix-halo-stage fidget-tactile-stage"
        bindtouchstart="onStageTouchStart"
        bindtouchmove="onStageTouchMove"
        bindtouchend="onStageTouchEnd"
        catchtap="onTapHeroStage"
      >
        <!-- 动态色温流光环与能量粒子线 -->
        <view class="matrix-radial-aurora" style="background: radial-gradient(circle, {{ previewIgnitionTool.themeColor }}40 0%, {{ previewIgnitionTool.themeColor }}12 55%, transparent 75%);"></view>
        <view class="matrix-reticle-ring" style="border-color: {{ previewIgnitionTool.themeColor }}55; box-shadow: 0 0 36rpx {{ previewIgnitionTool.themeColor }}25;"></view>
        
        <!-- 悬浮机体主像与点触微爆 (双态交替，连续点击每次必重新震荡爆破) -->
        <view class="matrix-hero-pod {{ isFidgetActive ? 'pod-fidget-active' : '' }} {{ fidgetBlastIndex === 1 ? 'pod-blast-a' : (fidgetBlastIndex === 2 ? 'pod-blast-b' : (isPreviewTesting ? 'pod-ignite-blast' : '')) }}">
          <image class="matrix-hero-svg" src="{{ previewIgnitionTool.iconImage }}" mode="aspectFit" wx:if="{{ previewIgnitionTool.iconImage }}" />
          <text class="matrix-hero-emoji" wx:else>{{ previewIgnitionTool.icon }}</text>
          <!-- 物理火星冲击波光环 (双波交替重绘) -->
          <view class="matrix-shockwave shockwave-a" wx:if="{{ shockwaveToggle === 1 }}" style="border-color: {{ previewIgnitionTool.themeColor }};"></view>
          <view class="matrix-shockwave shockwave-b" wx:if="{{ shockwaveToggle === 2 }}" style="border-color: {{ previewIgnitionTool.themeColor }};"></view>
          <!-- 飞溅星火微粒 -->
          <view class="fidget-spark-dots" wx:if="{{ fidgetSparksVisible }}">
            <view class="fs-dot fs-d1" style="background: {{ previewIgnitionTool.themeColor }}; box-shadow: 0 0 8rpx {{ previewIgnitionTool.themeColor }};"></view>
            <view class="fs-dot fs-d2" style="background: {{ previewIgnitionTool.themeColor }}; box-shadow: 0 0 8rpx {{ previewIgnitionTool.themeColor }};"></view>
            <view class="fs-dot fs-d3" style="background: {{ previewIgnitionTool.themeColor }}; box-shadow: 0 0 8rpx {{ previewIgnitionTool.themeColor }};"></view>
            <view class="fs-dot fs-d4" style="background: {{ previewIgnitionTool.themeColor }}; box-shadow: 0 0 8rpx {{ previewIgnitionTool.themeColor }};"></view>
          </view>
        </view>
      </view>

      <!-- 试火与手势指引胶囊（向下独立外置，不再遮挡机身与光轮） -->
      <view class="matrix-action-indicator-dock" catchtap="onTapHeroStage">
        <view class="matrix-action-indicator" style="border-color: {{ previewIgnitionTool.themeColor }}55;">
          <text class="mai-text" style="{{ isPreviewTesting ? 'color:' + previewIgnitionTool.themeColor + '; font-weight:800;' : '' }}">{{ isPreviewTesting ? '🔥 器具引燃 · 物理声效' : (previewIgnitionTool.id === 'zippo_vintage' && isZippoLidOpen ? '🪙 已掀开纯铜顶盖 · 轻触搓动打火' : (previewIgnitionTool.fidgetHint ? '👆 ' + previewIgnitionTool.fidgetHint : '👆 轻触器具 释放专属物理点火')) }}</text>
        </view>
      </view>

      <!-- 核心 2：悬浮解构器具铭牌与情绪心境金句 (严格恒高，杜绝切换大小跳变) -->
      <view class="matrix-spec-card">
        <view class="msc-header">
          <view class="msc-title-left">
            <text class="msc-name">{{ previewIgnitionTool.name }}</text>
            <view class="fidget-mood-chip" style="color: {{ previewIgnitionTool.themeColor }}; border-color: {{ previewIgnitionTool.themeColor }}55; background: {{ previewIgnitionTool.themeColor }}15;">
              {{ previewIgnitionTool.moodTag || previewIgnitionTool.badge }}
            </view>
          </view>
          <view class="msc-title-right">
            <text class="fidget-material-tag">{{ previewIgnitionTool.craftMaterial || previewIgnitionTool.subTitle }}</text>
            <view class="msc-equipped-chip" wx:if="{{ previewIgnitionTool.id === currentIgnitionTool.id }}">
              <text class="chip-dot"></text>
              <text class="chip-label">当前使用</text>
            </view>
          </view>
        </view>
        
        <!-- 情绪抚慰灵魂语录 (固定单行省略，恒定高度) -->
        <view class="fidget-quote-box">
          <text class="fqb-quote">“{{ previewIgnitionTool.moodQuote || previewIgnitionTool.description }}”</text>
        </view>
      </view>

      <!-- 核心 3：5 位平视机械舱卡（即点即换即试装） -->
      <view class="matrix-selector-strip">
        <view
          class="matrix-slot-unit {{ item.id === previewIgnitionTool.id ? 'slot-current-focus' : '' }} {{ item.id === currentIgnitionTool.id ? 'slot-is-equipped' : '' }}"
          wx:for="{{ ignitionToolsList }}"
          wx:key="id"
          bindtap="onSelectShowcaseTool"
          data-id="{{ item.id }}"
        >
          <!-- 选中高亮光框 -->
          <view class="msu-glow-border" wx:if="{{ item.id === previewIgnitionTool.id }}" style="border-color: {{ item.themeColor }}; box-shadow: 0 0 16rpx {{ item.themeColor }}66;"></view>
          
          <view class="msu-icon-wrap" style="background: {{ item.id === previewIgnitionTool.id ? item.themeColor + '20' : 'rgba(255,255,255,0.04)' }};">
            <image class="msu-svg" wx:if="{{ item.iconImage }}" src="{{ item.iconImage }}" mode="aspectFit" />
            <text class="msu-emoji" wx:else>{{ item.icon }}</text>
            <view class="msu-active-pip" wx:if="{{ item.id === currentIgnitionTool.id }}"></view>
            <view class="msu-lock-pip" wx:elif="{{ !isVipUser && item.requiredCount > 0 && totalSubstituted < item.requiredCount }}">🔒</view>
          </view>
          <text class="msu-label" style="{{ item.id === previewIgnitionTool.id ? 'color:' + item.themeColor + '; font-weight:800;' : '' }}">{{ item.name }}</text>
        </view>
      </view>

      <!-- 核心 4：悬浮胶囊装配主操作键 (单行无换行，严格绝对几何双居中) -->
      <view class="matrix-action-dock">
        <view
          class="matrix-equip-btn {{ previewIgnitionTool.id === currentIgnitionTool.id ? 'meb-equipped' : (!isVipUser && previewIgnitionTool.requiredCount > 0 && totalSubstituted < previewIgnitionTool.requiredCount ? 'meb-locked' : '') }} {{ justEquippedAnim ? 'meb-just-equipped' : '' }}"
          catchtap="onConfirmEquipTool"
          style="background: {{ previewIgnitionTool.id === currentIgnitionTool.id ? 'rgba(255,255,255,0.08)' : (!isVipUser && previewIgnitionTool.requiredCount > 0 && totalSubstituted < previewIgnitionTool.requiredCount ? 'rgba(255,255,255,0.04)' : (previewIgnitionTool.buttonGradient || 'linear-gradient(135deg, ' + previewIgnitionTool.themeColor + ' 0%, #d97706 100%)')) }}; border-color: {{ previewIgnitionTool.id === currentIgnitionTool.id ? 'rgba(52,211,153,0.35)' : (!isVipUser && previewIgnitionTool.requiredCount > 0 && totalSubstituted < previewIgnitionTool.requiredCount ? 'rgba(255,255,255,0.15)' : previewIgnitionTool.themeColor) }};"
        >
          <text class="meb-text {{ previewIgnitionTool.id === currentIgnitionTool.id ? 'text-is-equipped' : 'text-need-equip' }}">{{ justEquippedAnim ? '✨ 换装成功 · 专属点火器具' : (previewIgnitionTool.id === currentIgnitionTool.id ? '✓ 当前正在使用的点火器具' : (!isVipUser && previewIgnitionTool.requiredCount > 0 && totalSubstituted < previewIgnitionTool.requiredCount ? '🔒 累计替烟 ' + previewIgnitionTool.requiredCount + ' 支解锁（差 ' + (previewIgnitionTool.requiredCount - totalSubstituted) + ' 支）' : '立即换用此点火器具')) }}</text>
        </view>
      </view>

    </view>
  </view>

  <!-- ==========================================================================
       [DEV_ADMIN_TEST] 首页管理员极速测试控制台抽屉 (点击我的页面底部版权单次开启)
