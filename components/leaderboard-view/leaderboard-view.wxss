/* components/leaderboard-view/leaderboard-view.wxss */

:host {
  display: block;
  width: 100%;
  height: 100%;
  flex: 1;
  min-height: 0;
  overflow: hidden;
  box-sizing: border-box;
}

.leaderboard-scroll {
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  -webkit-overflow-scrolling: touch;
}

.leaderboard-content {
  padding: 24rpx;
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom, 0px));
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  box-sizing: border-box;
}

/* 我的排位尊贵卡片 */
.my-rank-card {
  background: linear-gradient(135deg, rgba(245, 158, 11, 0.18) 0%, rgba(20, 26, 38, 0.88) 100%);
  border: 1px solid rgba(245, 158, 11, 0.4);
  border-radius: 28rpx;
  padding: 26rpx;
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, 0.45);
}

.my-rank-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.my-rank-identity {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.my-rank-badge-num {
  font-size: 28rpx;
  font-weight: 800;
  color: #111827;
  background: linear-gradient(135deg, #fef08a, #f59e0b);
  padding: 4rpx 14rpx;
  border-radius: 14rpx;
  box-shadow: 0 4rpx 10rpx rgba(245, 158, 11, 0.4);
}

.my-rank-avatar-img {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  border: 2rpx solid #f59e0b;
  box-shadow: 0 0 14rpx rgba(245, 158, 11, 0.4);
  background: #0f172a;
}

.my-rank-text-wrap {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.my-rank-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #f8fafc;
  display: block;
}

.my-rank-title {
  font-size: 22rpx;
  font-weight: 500;
  color: #fbbf24;
  display: block;
}

.my-rank-beat {
  text-align: right;
}

.beat-label {
  font-size: 18rpx;
  color: #9ca3af;
  display: block;
}

.beat-pct {
  font-size: 36rpx;
  font-weight: 800;
  color: #34d399;
}

.my-rank-metrics {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  background: rgba(0, 0, 0, 0.25);
  border-radius: 20rpx;
  padding: 16rpx;
  border: 1px solid rgba(255, 255, 255, 0.05);
}

.metric-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.m-val {
  font-size: 32rpx;
  font-weight: 800;
  color: #fbbf24;
}

.m-lbl {
  font-size: 18rpx;
  color: #9ca3af;
  margin-top: 4rpx;
}

/* 英雄榜单列表 */
.rank-list-wrapper {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.rank-row-card {
  background: rgba(22, 28, 40, 0.75);
  border: 1px solid rgba(255, 255, 255, 0.08);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-radius: 24rpx;
  padding: 20rpx 22rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.3);
}

.rank-row-card.top-1 {
  border-color: rgba(245, 158, 11, 0.5);
  background: linear-gradient(135deg, rgba(245, 158, 11, 0.14) 0%, rgba(22, 28, 40, 0.9) 100%);
  box-shadow: 0 10rpx 30rpx rgba(245, 158, 11, 0.2);
}

.rank-row-card.top-2 {
  border-color: rgba(226, 232, 240, 0.4);
  background: linear-gradient(135deg, rgba(226, 232, 240, 0.1) 0%, rgba(22, 28, 40, 0.9) 100%);
}

.rank-row-card.top-3 {
  border-color: rgba(217, 119, 6, 0.4);
  background: linear-gradient(135deg, rgba(217, 119, 6, 0.1) 0%, rgba(22, 28, 40, 0.9) 100%);
}

.rank-row-card.is-me-card {
  border: 1px solid rgba(245, 158, 11, 0.7);
  background: linear-gradient(135deg, rgba(245, 158, 11, 0.18) 0%, rgba(22, 28, 40, 0.96) 100%);
  box-shadow: 0 10rpx 32rpx rgba(245, 158, 11, 0.25);
}

.rank-number-box {
  width: 44rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.crown-icon { font-size: 36rpx; }
.plain-rank {
  font-size: 28rpx;
  font-weight: 800;
  color: #6b7280;
}

.plain-rank.is-me-rank {
  color: #fbbf24;
  font-weight: 900;
}

.hero-avatar {
  font-size: 42rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-avatar-img {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 2rpx solid #f59e0b;
  background: #0f172a;
  flex-shrink: 0;
  box-shadow: 0 0 10rpx rgba(245, 158, 11, 0.35);
}

.hero-info-main {
  flex: 1;
}

.hero-title-line {
  display: flex;
  align-items: center;
  margin-bottom: 6rpx;
}

.hero-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #f3f4f6;
  max-width: 420rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  letter-spacing: 0.5rpx;
}

.hero-name.is-me-name {
  color: #fbbf24;
  font-weight: 800;
}

.hero-title-tag {
  margin-left: 10rpx;
  font-size: 19rpx;
  font-weight: 600;
  color: #fbbf24;
  background: rgba(245, 158, 11, 0.12);
  border: 1px solid rgba(245, 158, 11, 0.28);
  padding: 1rpx 10rpx;
  border-radius: 8rpx;
  line-height: 1.3;
}

.me-badge {
  margin-left: 12rpx;
  font-size: 20rpx;
  font-weight: 800;
  color: #111827;
  background: linear-gradient(135deg, #fef08a, #f59e0b);
  padding: 2rpx 12rpx;
  border-radius: 10rpx;
  line-height: 1.4;
  box-shadow: 0 2rpx 8rpx rgba(245, 158, 11, 0.4);
  vertical-align: middle;
}

.hero-quote {
  font-size: 18rpx;
  color: #9ca3af;
  font-style: italic;
  display: block;
  margin-bottom: 8rpx;
  line-height: 1.35;
}

.hero-data-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.data-tag {
  font-size: 18rpx;
  color: #ffaa55;
  background: rgba(255, 102, 0, 0.12);
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}

.data-tag.green {
  color: #34d399;
  background: rgba(16, 185, 129, 0.12);
}

.data-tag.purple {
  color: #c084fc;
  background: rgba(168, 85, 247, 0.12);
}

.like-btn-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 12rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.08);
  transition: all 0.2s ease;
}

.like-btn-wrap:active {
  transform: scale(0.9);
}

.like-btn-wrap.liked {
  border-color: rgba(239, 68, 68, 0.4);
  background: rgba(239, 68, 68, 0.15);
}

.like-heart { font-size: 26rpx; }
.like-count {
  font-size: 18rpx;
  color: #9ca3af;
  margin-top: 2rpx;
}

.like-btn-wrap.liked .like-count {
  color: #f87171;
  font-weight: 700;
}

/* 底部收尾文案 */
.list-end-footer {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 36rpx 20rpx 20rpx;
}

.footer-divider-line {
  flex: 1;
  height: 1px;
  background: rgba(255, 255, 255, 0.08);
}

.footer-text {
  font-size: 20rpx;
  color: #64748b;
  letter-spacing: 2rpx;
  font-weight: 500;
}

