.v-track-descending {
  left: 210rpx;
  top: 255rpx;
  width: 14rpx;
  height: 135rpx;
  margin-left: -7rpx;
}

/* 动脉流光粒子 (赤红金暖流·由内向外射血) */
.artery-pulse-flow {
  position: absolute;
  left: 1rpx;
  width: 4rpx;
  height: 36rpx;
  border-radius: 999px;
  background: linear-gradient(180deg, rgba(254, 240, 138, 0) 0%, rgba(245, 158, 11, 0.75) 40%, rgba(239, 68, 68, 0.95) 80%, rgba(254, 240, 138, 1) 100%);
  box-shadow: 0 0 8rpx rgba(239, 68, 68, 0.7);
  animation: flowDownwards 1.35s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  will-change: transform, opacity;
}

/* 静脉流光粒子 (清冽青蓝微光·向心回流) */
.vein-pulse-flow {
  position: absolute;
  right: 1rpx;
  width: 4rpx;
  height: 36rpx;
  border-radius: 999px;
  background: linear-gradient(0deg, rgba(56, 189, 248, 0) 0%, rgba(14, 165, 233, 0.6) 40%, rgba(56, 189, 248, 0.95) 80%, rgba(167, 243, 208, 1) 100%);
  box-shadow: 0 0 8rpx rgba(56, 189, 248, 0.7);
  animation: flowUpwards 1.75s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  will-change: transform, opacity;
}

/* 腹主动脉下行流光 */
.aorta-blood-flow {
  position: absolute;
  left: 4rpx;
  width: 5rpx;
  height: 38rpx;
  border-radius: 999px;
  background: linear-gradient(180deg, rgba(239, 68, 68, 0) 0%, rgba(239, 68, 68, 0.85) 60%, rgba(245, 158, 11, 1) 100%);
  box-shadow: 0 0 10rpx rgba(239, 68, 68, 0.7);
  animation: flowDownwards 1.4s cubic-bezier(0.3, 0.1, 0.3, 1) infinite;
  will-change: transform, opacity;
}

.delay-1 {
  animation-delay: 0.65s;
}

@keyframes flowDownwards {
  0% { transform: translateY(-40rpx); opacity: 0; }
  25% { opacity: 0.85; }
  80% { opacity: 0.85; }
  100% { transform: translateY(165rpx); opacity: 0; }
}

@keyframes flowUpwards {
  0% { transform: translateY(165rpx); opacity: 0; }
  25% { opacity: 0.85; }
  80% { opacity: 0.85; }
  100% { transform: translateY(-40rpx); opacity: 0; }
}

/* 3. 神经突触电位微闪节点 (Synaptic Micro-Sparks) */
.synapse-node {
  position: absolute;
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
  background: #fef08a;
  box-shadow: 0 0 8rpx #f59e0b, 0 0 16rpx rgba(251, 191, 36, 0.6);
  animation: synapseFlicker 3.2s ease-in-out infinite;
  will-change: transform, opacity;
}

.node-shoulder-l { left: 146rpx; top: 168rpx; animation-delay: 0.2s; }
.node-forearm-l { left: 74rpx; top: 345rpx; animation-delay: 1.3s; }
.node-shoulder-r { right: 146rpx; top: 168rpx; animation-delay: 2.1s; }
