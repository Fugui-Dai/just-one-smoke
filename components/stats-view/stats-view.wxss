  color: #fef08a;
  border: 1.5rpx solid rgba(251, 191, 36, 0.7);
  box-shadow: 0 0 18rpx rgba(251, 191, 36, 0.35);
}

.cert-status-badge.badge-unlocked-equipable {
  background: rgba(16, 185, 129, 0.22);
  color: #34d399;
  border: 1.5rpx solid rgba(52, 211, 153, 0.6);
  box-shadow: 0 0 16rpx rgba(16, 185, 129, 0.32);
  cursor: pointer;
}

.cert-status-badge.badge-next-status {
  background: rgba(56, 189, 248, 0.2);
  color: #38bdf8;
  border: 1.5rpx solid rgba(56, 189, 248, 0.65);
  box-shadow: 0 0 18rpx rgba(56, 189, 248, 0.38);
  animation: pulseNextStatus 2s infinite ease-in-out;
}

@keyframes pulseNextStatus {
  0%, 100% { box-shadow: 0 0 14rpx rgba(56, 189, 248, 0.3); }
  50% { box-shadow: 0 0 24rpx rgba(56, 189, 248, 0.65); }
}

.cert-status-badge.badge-progress {
  background: rgba(255, 255, 255, 0.08);
  color: #94a3b8;
  border: 1.5rpx solid rgba(255, 255, 255, 0.15);
}

/* 情绪价值箴言金句框 (高逼格灵魂寄语) */
.cert-emotion-quote-box {
  width: 100%;
  box-sizing: border-box;
  background: rgba(0, 0, 0, 0.38);
  border: 1px solid rgba(255, 255, 255, 0.09);
  border-radius: 20rpx;
  padding: 18rpx 22rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ceq-mark {
  font-size: 34rpx;
  font-weight: 900;
  color: #fbbf24;
  opacity: 0.7;
  line-height: 1;
  padding: 0 6rpx;
}

.ceq-quote-text {
  font-size: 24rpx;
  color: #f1f5f9;
  line-height: 1.55;
  text-align: center;
  font-weight: 500;
  font-style: italic;
  letter-spacing: 0.6rpx;
}

/* 典故说明 */
.cert-desc {
  font-size: 23rpx;
  color: #94a3b8;
  text-align: center;
  line-height: 1.5;
  margin-bottom: 22rpx;
  padding: 0 12rpx;
  box-sizing: border-box;
}

/* 极简高定数据展台 */
.cert-progress-box {
  width: 100%;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 18rpx;
  padding: 16rpx 22rpx;
}

.cp-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 23rpx;
  margin-bottom: 10rpx;
}

.cp-label {
  color: #94a3b8;
  font-weight: 500;
}

.cp-val {
  font-weight: 800;
  font-size: 24rpx;
}

.cp-track {
  width: 100%;
  height: 10rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 8rpx;
  overflow: hidden;
}

.cp-bar {
  height: 100%;
  border-radius: 8rpx;
  transition: width 0.4s ease;
}

/* ========================================================================= */
/* 自律打卡日历 · 每日历史战报详情弹窗 (Calendar Day Detail Modal)            */
/* ========================================================================= */
.calendar-day-dialog-card {
  width: 620rpx;
  max-width: 90vw;
  background: linear-gradient(165deg, rgba(20, 28, 44, 0.96) 0%, rgba(10, 15, 26, 0.98) 100%);
  border: 1.5rpx solid rgba(251, 191, 36, 0.38);
  border-radius: 32rpx;
  padding: 36rpx 32rpx 32rpx;
  box-sizing: border-box;
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.85), 0 0 32rpx rgba(245, 158, 11, 0.15);
  animation: dayModalPop 0.28s cubic-bezier(0.34, 1.56, 0.64, 1);
  display: flex;
  flex-direction: column;
  align-items: center;
}

@keyframes dayModalPop {
  0% { transform: scale(0.85); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}

.cdd-top-bar {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.cdd-date-pill {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: rgba(255, 255, 255, 0.06);
  padding: 8rpx 18rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.cdd-icon {
  font-size: 24rpx;
}

.cdd-date-text {
  font-size: 24rpx;
  font-weight: 700;
  color: #f1f5f9;
}

.cdd-tag {
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}
.cdd-tag.tag-punched {
  background: rgba(16, 185, 129, 0.2);
  color: #34d399;
  border: 1rpx solid rgba(52, 211, 153, 0.4);
}
.cdd-tag.tag-future {
  background: rgba(56, 189, 248, 0.15);
  color: #7dd3fc;
  border: 1rpx solid rgba(56, 189, 248, 0.35);
}
.cdd-tag.tag-unpunched {
  background: rgba(148, 163, 184, 0.15);
  color: #94a3b8;
  border: 1rpx solid rgba(148, 163, 184, 0.3);
}

.cdd-close-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #94a3b8;
  transition: all 0.2s ease;
}
.cdd-close-btn:active {
  transform: scale(0.9);
  background: rgba(255, 255, 255, 0.18);
  color: #ffffff;
}

.cdd-crest-box {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 12rpx 0 28rpx;
}

.cdd-halo {
  position: absolute;
  top: -10rpx;
  width: 110rpx;
  height: 110rpx;
  background: radial-gradient(circle, rgba(251, 191, 36, 0.35) 0%, rgba(251, 191, 36, 0) 70%);
  border-radius: 50%;
  pointer-events: none;
}

.cdd-emoji {
  font-size: 64rpx;
  margin-bottom: 12rpx;
  position: relative;
  z-index: 1;
}

.cdd-headline {
  font-size: 32rpx;
  font-weight: 800;
  color: #fef08a;
  text-shadow: 0 2rpx 10rpx rgba(245, 158, 11, 0.5);
  text-align: center;
}

/* 4宫格数据矩阵 */
.cdd-metrics-grid {
  width: 100%;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.cdd-metric-item {
  background: rgba(15, 23, 42, 0.7);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 20rpx;
  padding: 16rpx 14rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.cdd-m-val {
  font-size: 34rpx;
  font-weight: 900;
  font-family: monospace;
}
.cdd-m-val.gold { color: #fde047; }
.cdd-m-val.emerald { color: #34d399; }
.cdd-m-val.green { color: #4ade80; }
.cdd-m-val.purple { color: #c084fc; }

.cdd-m-unit {
  font-size: 20rpx;
  font-weight: 500;
  margin-left: 4rpx;
}

.cdd-m-lbl {
  font-size: 20rpx;
  color: #94a3b8;
  font-weight: 500;
}

/* 箴言气泡 */
.cdd-quote-box {
  width: 100%;
  background: rgba(245, 158, 11, 0.08);
  border: 1rpx solid rgba(245, 158, 11, 0.22);
  border-radius: 20rpx;
  padding: 18rpx 22rpx;
  box-sizing: border-box;
  margin-bottom: 28rpx;
}

.cdd-quote {
  font-size: 23rpx;
  color: #fef08a;
  line-height: 1.5;
  text-align: center;
  display: block;
}

/* 操作按钮 */
.cdd-action-box {
  width: 100%;
}

.cdd-punch-btn {
  width: 100%;
  height: 84rpx;
  background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
  color: #0c1017;
  font-size: 28rpx;
  font-weight: 800;
  border-radius: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(245, 158, 11, 0.45);
  border: none;
}
.cdd-punch-btn:active {
  transform: scale(0.97);
  opacity: 0.92;
}

.cdd-confirm-btn {
  width: 100%;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.09);
  color: #e2e8f0;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 40rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  display: flex;
  align-items: center;
  justify-content: center;
}
.cdd-confirm-btn:active {
  transform: scale(0.97);
  background: rgba(255, 255, 255, 0.16);
}



