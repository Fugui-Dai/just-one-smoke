  margin-bottom: 24rpx;
  padding: 0 16rpx;
}

.cert-progress-box {
  width: 100%;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 20rpx;
  padding: 18rpx 22rpx;
  box-sizing: border-box;
  margin-bottom: 20rpx;
}

.cp-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 20rpx;
  margin-bottom: 10rpx;
}

.cp-label {
  color: #94a3b8;
}

.cp-val {
  font-weight: 800;
  font-size: 22rpx;
}

.cp-track {
  width: 100%;
  height: 10rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 8rpx;
  overflow: hidden;
}

.cp-bar {
  height: 100%;
  border-radius: 8rpx;
  transition: width 0.4s ease;
}

.cert-quote-box {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 18rpx;
  background: rgba(245, 158, 11, 0.08);
  border: 1px solid rgba(245, 158, 11, 0.2);
  border-radius: 18rpx;
  margin-bottom: 28rpx;
  box-sizing: border-box;
}

.cq-icon {
  font-size: 26rpx;
}

.cq-text {
  font-size: 19rpx;
  color: #fbbf24;
  line-height: 1.4;
}

.cert-confirm-btn {
  width: 100%;
  height: 80rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
  color: #1e1204;
  font-size: 26rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  box-shadow: 0 6rpx 20rpx rgba(245, 158, 11, 0.4);
}


