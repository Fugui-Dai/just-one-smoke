/* components/stats-view/stats-view.wxss */

:host {
  display: block;
  width: 100%;
  height: 100%;
  flex: 1;
  min-height: 0;
  overflow: hidden;
  box-sizing: border-box;
}

.stats-scroll {
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  -webkit-overflow-scrolling: touch;
}

.stats-content {
  padding: 24rpx;
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom, 0px));
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  box-sizing: border-box;
}

/* ==================== 全局模块卡片标题通用排版规范 ==================== */
.section-top-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-name-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.sec-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #06b6d4;
  box-shadow: 0 0 10rpx #06b6d4;
  flex-shrink: 0;
}

.sec-dot.green {
  background: #10b981;
  box-shadow: 0 0 10rpx #10b981;
}

.sec-dot.gold {
  background: #f59e0b;
  box-shadow: 0 0 10rpx #f59e0b;
}

.sec-heading {
  font-size: 28rpx;
  font-weight: 700;
  color: #f8fafc;
  letter-spacing: 0.5rpx;
}

.sec-sub-info {
  font-size: 22rpx;
  color: #94a3b8;
}

/* 0. 个人微信头像与昵称名片卡片 (自适应全宽排版，无多余图标，展示打开第几天) */
/* 0. 个人微信头像、昵称与打卡卡片 (左侧头像，中间两行信息，右侧打卡方卡) */
.user-profile-header-card {
  background: linear-gradient(180deg, rgba(20, 27, 42, 0.82) 0%, rgba(10, 14, 24, 0.94) 100%);
  border: 1px solid rgba(255, 255, 255, 0.10);
  border-radius: 28rpx;
  padding: 22rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  box-shadow: 0 14rpx 38rpx rgba(0, 0, 0, 0.52), inset 0 1px 0 rgba(255, 255, 255, 0.12);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  box-sizing: border-box;
  width: 100%;
  transition: all 0.35s ease;
}

/* VIP 会员专属顶部名片：曜世黑金底座 + 尊享流光边框 */
.user-profile-header-card.is-vip-profile-card {
  background: linear-gradient(135deg, rgba(44, 34, 18, 0.94) 0%, rgba(20, 16, 10, 0.98) 55%, rgba(36, 26, 12, 0.94) 100%);
  border: 1px solid rgba(245, 208, 128, 0.45);
  box-shadow: 0 14rpx 42rpx rgba(0, 0, 0, 0.65), 0 0 28rpx rgba(212, 175, 55, 0.16), inset 0 1px 0 rgba(255, 236, 179, 0.25);
}

.user-profile-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-width: 0;
}

/* 左侧头像与昵称组合：头像严格靠左，名字紧随其后 */
.user-profile-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
}

.user-avatar-wrap {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  flex-shrink: 0;
}

/* 微信原生头像按钮：严格靠左对齐，彻底清除微信默认 button:not([size='mini']) 的 184px 宽度与 margin: auto */
button.user-avatar-btn,
.user-avatar-btn {
  position: relative !important;
  width: 96rpx !important;
  min-width: 96rpx !important;
  max-width: 96rpx !important;
  height: 96rpx !important;
  min-height: 96rpx !important;
  max-height: 96rpx !important;
  padding: 0 !important;
  margin: 0 !important;
  margin-left: 0 !important;
  margin-right: 0 !important;
  background: transparent !important;
  border-radius: 50% !important;
  border: none !important;
  line-height: normal !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  overflow: hidden !important;
  flex-shrink: 0 !important;
}

button.user-avatar-btn::after,
.user-avatar-btn::after {
  display: none !important;
  border: none !important;
  width: 0 !important;
  height: 0 !important;
}

.user-avatar-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(56, 189, 248, 0.4);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.5), 0 0 12rpx rgba(56, 189, 248, 0.15);
  background: #0f172a;
  display: block;
  flex-shrink: 0;
}

.user-avatar-img.vip-avatar-img {
  border: 3rpx solid #f5d080;
  box-shadow: 0 4rpx 18rpx rgba(0, 0, 0, 0.65), 0 0 18rpx rgba(245, 208, 128, 0.42);
}

.profile-avatar-vip-crown {
  position: absolute;
  top: -10rpx;
  right: -6rpx;
  font-size: 26rpx;
  line-height: 1;
  filter: drop-shadow(0 2rpx 6rpx rgba(0, 0, 0, 0.85));
  pointer-events: none;
  z-index: 3;
}

/* 名字列：紧贴头像右侧 */
.user-info-col {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.user-nickname-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
  max-width: 100%;
}

.user-nickname-wrap {
  position: relative;
  display: inline-flex;
  align-items: center;
  max-width: 260rpx;
  min-width: 0;
  flex-shrink: 0;
}

.user-nickname-display {
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 46rpx;
  letter-spacing: 0.5rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 260rpx;
  display: block;
}

.user-nickname-display.vip-nickname-gold {
  color: #fde68a;
  text-shadow: 0 2rpx 10rpx rgba(245, 208, 128, 0.25);
}

.user-nickname-input {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  z-index: 2;
  caret-color: transparent !important;
}

.profile-vip-nameplate {
  position: relative;
  overflow: hidden;
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #3b2a10 0%, #1c150a 100%);
  border: 1px solid rgba(251, 191, 36, 0.75);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.55), 0 0 10rpx rgba(251, 191, 36, 0.25);
  transition: all 0.25s ease;
  white-space: nowrap;
}

.profile-vip-nameplate .pvn-crown,
.profile-vip-nameplate .pvn-text {
  position: relative;
  z-index: 1;
}

.profile-vip-nameplate .pvn-crown {
  font-size: 18rpx;
  line-height: 1;
}

.profile-vip-nameplate .pvn-text {
  font-size: 22rpx;
  font-weight: 800;
  color: #fde68a;
  line-height: 1.1;
  letter-spacing: 0.5rpx;
}

/* VIP 尊荣流光扫光动效 (与替烟艺术展柜完全一致的 10s 高奢金芒流光) */
.profile-vip-nameplate.is-vip::after {
  content: '';
  position: absolute;
  top: -50%;
  left: -80%;
  width: 50%;
  height: 200%;
  background: linear-gradient(
    90deg,
    transparent 0%,
    transparent 46%,
    rgba(245, 158, 11, 0.30) 49%,
    rgba(254, 240, 138, 0.85) 50%,
    rgba(245, 158, 11, 0.30) 51%,
    transparent 54%,
    transparent 100%
  );
  transform: rotate(12deg);
  opacity: 0;
  will-change: transform, opacity;
  animation: vipSweepLight 10s cubic-bezier(0.25, 1, 0.5, 1) infinite;
  pointer-events: none;
  z-index: 2;
}

@keyframes vipSweepLight {
  0%, 35% {
    transform: translateX(0) rotate(12deg);
    opacity: 0;
  }
  40% {
    opacity: 1;
  }
  68% {
    transform: translateX(380%) rotate(12deg);
    opacity: 1;
  }
  74%, 100% {
    transform: translateX(380%) rotate(12deg);
    opacity: 0;
  }
}

.profile-vip-nameplate.is-vip-inactive {
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.16);
  box-shadow: none;
}

.profile-vip-nameplate.is-vip-inactive .pvn-text {
  color: #94a3b8;
  font-size: 20rpx;
  font-weight: 600;
}

.profile-vip-nameplate.is-vip-inactive .pvn-crown {
  filter: grayscale(1);
  opacity: 0.65;
}

.user-meta-subrow {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  margin-top: 8rpx;
  padding: 3rpx 14rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.10);
  border-radius: 999rpx;
  width: fit-content;
  max-width: 100%;
  box-sizing: border-box;
  cursor: pointer;
  white-space: nowrap;
  transition: all 0.2s ease;
}

.user-meta-subrow:active {
  background: rgba(255, 255, 255, 0.12);
  transform: scale(0.97);
}

.user-meta-smoke-tag {
  font-size: 22rpx;
  color: #cbd5e1;
  font-weight: 500;
  line-height: 1.25;
  white-space: nowrap;
}

.user-meta-edit-icon {
  font-size: 20rpx;
  color: #38bdf8;
  margin-left: 2rpx;
  line-height: 1;
}

.profile-action-pills-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding-top: 14rpx;
  border-top: 1px solid rgba(255, 255, 255, 0.06);
}

.profile-action-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.12);
  transition: all 0.2s ease;
  cursor: pointer;
}

.profile-action-pill:active {
  transform: scale(0.95);
  background: rgba(255, 255, 255, 0.14);
}

.profile-action-pill.settings-pill {
  flex: 1;
  background: rgba(56, 189, 248, 0.1);
  border-color: rgba(56, 189, 248, 0.28);
}

.profile-action-pill.leaderboard-pill {
  background: linear-gradient(135deg, rgba(245, 158, 11, 0.16) 0%, rgba(217, 119, 6, 0.08) 100%);
  border-color: rgba(245, 158, 11, 0.35);
}

.pap-text {
  font-size: 22rpx;
  font-weight: 600;
  color: #e2e8f0;
  line-height: 1.2;
}

.leaderboard-pill .pap-text {
  color: #fbbf24;
}

/* 最右边打卡状态方卡 (主动盖印自律状态 / 敲章仪式感) */
.user-punch-card {
  flex-shrink: 0;
  margin-left: 16rpx;
  min-width: 120rpx;
  padding: 10rpx 14rpx;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.05);
  transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), border-color 0.25s, background 0.25s;
  cursor: pointer;
  position: relative;
  overflow: hidden;
}

/* 1. 待打卡状态：暖金微光脉冲 · 强交互自律号召 */
.user-punch-card.is-pending-card {
  background: linear-gradient(135deg, rgba(38, 28, 12, 0.92) 0%, rgba(24, 18, 8, 0.96) 100%);
  border: 1.5rpx solid rgba(245, 158, 11, 0.55);
  box-shadow: 0 6rpx 20rpx rgba(245, 158, 11, 0.22), inset 0 1px 0 rgba(254, 240, 138, 0.2);
  animation: pendingCardPulse 2.8s ease-in-out infinite;
}

@keyframes pendingCardPulse {
  0%, 100% {
    border-color: rgba(245, 158, 11, 0.45);
    box-shadow: 0 4rpx 14rpx rgba(245, 158, 11, 0.18);
  }
  50% {
    border-color: rgba(245, 158, 11, 0.85);
    box-shadow: 0 6rpx 24rpx rgba(245, 158, 11, 0.38), inset 0 0 12rpx rgba(245, 158, 11, 0.2);
  }
}

/* 2. 已打卡状态：沉静墨玉翡翠 · 尊贵从容自律 */
.user-punch-card.is-punched-card {
  background: linear-gradient(135deg, rgba(14, 26, 22, 0.88) 0%, rgba(8, 18, 15, 0.96) 100%);
  border: 1px solid rgba(16, 185, 129, 0.32);
}

.user-punch-card:active {
  transform: scale(0.92);
}

/* 3. 敲章下压震颤与微粒子爆开动效 */
.user-punch-card.is-stamping-active {
  animation: stampPress 0.45s cubic-bezier(0.17, 0.89, 0.32, 1.28) forwards;
}

@keyframes stampPress {
  0% { transform: scale(1) rotate(0deg); }
  35% { transform: scale(0.82) rotate(-4deg); filter: drop-shadow(0 0 16rpx #f59e0b); }
  70% { transform: scale(1.08) rotate(1.5deg); filter: drop-shadow(0 0 24rpx #34d399); }
  100% { transform: scale(1) rotate(0deg); }
}

.punch-card-badge-row {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-bottom: 2rpx;
}

.punch-card-status-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.punch-card-status-dot.dot-pending {
  background: #f59e0b;
  box-shadow: 0 0 8rpx #f59e0b;
  animation: pendingDotFlash 1.6s ease-in-out infinite;
}

@keyframes pendingDotFlash {
  0%, 100% { opacity: 0.5; transform: scale(0.85); }
  50% { opacity: 1; transform: scale(1.3); }
}

.punch-card-status-dot.dot-punched {
  background: #10b981;
  box-shadow: 0 0 8rpx rgba(16, 185, 129, 0.6);
}

.punch-card-title {
  font-size: 21rpx;
  line-height: 1.2;
  white-space: nowrap;
}

.punch-card-title.title-pending {
  color: #fde68a;
  font-weight: 700;
}

.punch-card-title.title-punched {
  color: #94a3b8;
  font-weight: 500;
}

.punch-card-days-row {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 3rpx;
}

.punch-card-num {
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.1;
}

.punch-card-num.num-pending {
  color: #fbbf24;
  text-shadow: 0 0 10rpx rgba(251, 191, 36, 0.4);
}

.punch-card-num.num-punched {
  color: #34d399;
  text-shadow: 0 0 10rpx rgba(52, 211, 153, 0.35);
}

.punch-card-unit {
  font-size: 20rpx;
  font-weight: 600;
}

.punch-card-unit.unit-pending {
  color: #fde68a;
}

.punch-card-unit.unit-punched {
  color: #a7f3d0;
}

.punch-card-action-hint {
  font-size: 18rpx;
  font-weight: 700;
  color: #f59e0b;
  background: rgba(245, 158, 11, 0.16);
  border: 1px solid rgba(245, 158, 11, 0.3);
  padding: 1rpx 8rpx;
  border-radius: 999rpx;
  margin-top: 4rpx;
  line-height: 1.2;
  letter-spacing: 0.5rpx;
}

/* ==================== VIP 尊享特权入口横幅 (腾讯黑金曜石奢雅标准) ==================== */
.vip-entry-banner {
  position: relative;
  background: 
    radial-gradient(ellipse at 88% -10%, rgba(229, 192, 123, 0.16) 0%, transparent 60%),
    radial-gradient(ellipse at 10% 110%, rgba(56, 189, 248, 0.06) 0%, transparent 50%),
    linear-gradient(135deg, rgba(22, 28, 42, 0.90) 0%, rgba(13, 17, 26, 0.96) 100%);
  border: 1px solid rgba(229, 192, 123, 0.24);
  border-radius: 26rpx;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, 0.42), inset 0 1px 0 rgba(254, 240, 138, 0.16);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  overflow: hidden;
  box-sizing: border-box;
  width: 100%;
  transition: all 0.2s ease;
}

.vip-entry-banner:active {
  transform: scale(0.985);
  border-color: rgba(229, 192, 123, 0.4);
}

.vip-banner-left {
  display: flex;
  align-items: center;
  gap: 18rpx;
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
}

/* 3D 曜石黑金微光皇冠容器 */
.vb-emblem-wrap {
  width: 60rpx;
  height: 60rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.vb-emblem-svg {
  width: 60rpx;
  height: 60rpx;
  display: block;
}

.vip-banner-text {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  flex: 1;
  min-width: 0;
}

.vb-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

/* 标题：奢雅香槟白金 */
.vb-main {
  font-size: 28rpx;
  font-weight: 700;
  color: #f7e7ca;
  letter-spacing: 0.8rpx;
  line-height: 1.2;
}

/* 黑金超微胶囊微标 */
.vb-black-gold-tag {
  font-size: 22rpx;
  font-weight: 700;
  color: #e5c07b;
  background: rgba(229, 192, 123, 0.12);
  border: 1px solid rgba(229, 192, 123, 0.32);
  padding: 2rpx 14rpx;
  border-radius: 999px;
  letter-spacing: 0.5rpx;
  line-height: 1.2;
  flex-shrink: 0;
}

/* 副文案：钛银冷灰，清晰可读 */
.vb-sub {
  font-size: 24rpx;
  color: #8c9bb0;
  line-height: 1.3;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 右侧 CTA 胶囊：丝滑香槟钛金 */
.vip-banner-btn {
  background: linear-gradient(135deg, #f5d499 0%, #d4a757 100%);
  border: 1px solid rgba(255, 255, 255, 0.4);
  padding: 10rpx 22rpx;
  border-radius: 999px;
  box-shadow: 0 4rpx 16rpx rgba(212, 167, 87, 0.35);
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.vbb-text {
  font-size: 24rpx;
  font-weight: 800;
  color: #17120a;
  letter-spacing: 0.5rpx;
  line-height: 1;
}

/* ==================== 3. 钱包 (24K 曜世黑金高定自律金券，黑曜金库底座) ==================== */
.wallet-section-card {
  background: linear-gradient(145deg, rgba(26, 20, 12, 0.92) 0%, rgba(13, 10, 6, 0.98) 100%);
  border: 1px solid rgba(245, 158, 11, 0.35);
  border-radius: 28rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 14rpx 38rpx rgba(0, 0, 0, 0.58), 0 0 24rpx rgba(245, 158, 11, 0.08), inset 0 1px 0 rgba(254, 240, 138, 0.18);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  box-sizing: border-box;
}

.wallet-top-header {
  margin-bottom: 16rpx;
}


.sec-pill-tag {
  font-size: 22rpx;
  color: #34d399;
  background: rgba(52, 211, 153, 0.15);
  border: 1px solid rgba(52, 211, 153, 0.35);
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
  font-weight: 600;
  margin-left: 10rpx;
}

/* 核心算式展台：[调皮1元小纸币] × 金额 = 累计省下 */
.wallet-formula-stage {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 6rpx 10rpx;
  width: 100%;
  box-sizing: border-box;
}

/* 调皮搞笑 1 元微缩纸币外层包裹 (带多层叠钞质感与 Q 弹触感) */
.funny-mini-bill-wrap {
  position: relative;
  width: 240rpx;
  height: 122rpx;
  flex-shrink: 0;
  cursor: pointer;
  transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.funny-mini-bill-wrap:active {
  transform: scale(0.92) rotate(-2deg);
}

/* 3D 叠纸堆叠背板效果 (厚度与立体感 · 24K 黑金奢华色调) */
.bill-stack-back {
  position: absolute;
  border-radius: 10rpx;
  background: #251a08;
  border: 1px solid rgba(245, 158, 11, 0.35);
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.6);
}

.bill-stack-back.layer-2 {
  top: -4rpx;
  left: -4rpx;
  right: 4rpx;
  bottom: 4rpx;
  opacity: 0.5;
}

.bill-stack-back.layer-1 {
  top: -2rpx;
  left: -2rpx;
