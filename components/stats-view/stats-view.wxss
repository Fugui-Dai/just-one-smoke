.photon-1 { left: 75rpx; bottom: 70rpx; animation-delay: 0s; animation-duration: 4.8s; }
.photon-2 { left: 155rpx; bottom: 120rpx; animation-delay: 1.6s; animation-duration: 5.4s; }
.photon-3 { right: 85rpx; bottom: 85rpx; animation-delay: 0.9s; animation-duration: 5.1s; }
.photon-4 { right: 155rpx; bottom: 140rpx; animation-delay: 2.4s; animation-duration: 5.8s; }
.photon-5 { left: 208rpx; bottom: 50rpx; animation-delay: 3.2s; animation-duration: 6.2s; }

@keyframes floatPhoton {
  0% { transform: translate(0, 0); opacity: 0; }
  25% { opacity: 0.75; }
  75% { opacity: 0.55; }
  100% { transform: translate(12rpx, -90rpx); opacity: 0; }
