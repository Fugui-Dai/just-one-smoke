/* components/stats-view/stats-view.wxss */

:host {
  display: block;
  width: 100%;
  height: 100%;
  flex: 1;
  min-height: 0;
  overflow: hidden;
  box-sizing: border-box;
}

.stats-scroll {
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  -webkit-overflow-scrolling: touch;
}

.stats-content {
  padding: 24rpx;
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom, 0px));
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  box-sizing: border-box;
}

/* ==================== 全局模块卡片标题通用排版规范 ==================== */
.section-top-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-name-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.sec-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #06b6d4;
  box-shadow: 0 0 10rpx #06b6d4;
  flex-shrink: 0;
}

.sec-dot.green {
  background: #10b981;
  box-shadow: 0 0 10rpx #10b981;
}

.sec-dot.gold {
  background: #f59e0b;
  box-shadow: 0 0 10rpx #f59e0b;
}

.sec-heading {
  font-size: 28rpx;
  font-weight: 700;
  color: #f8fafc;
  letter-spacing: 0.5rpx;
}

.sec-sub-info {
  font-size: 22rpx;
  color: #94a3b8;
}

/* 0. 个人微信头像与昵称名片卡片 (自适应全宽排版，无多余图标，展示打开第几天) */
/* 0. 个人微信头像、昵称与打卡卡片 (左侧头像，中间两行信息，右侧打卡方卡) */
.user-profile-header-card {
  background: linear-gradient(135deg, rgba(22, 28, 42, 0.85) 0%, rgba(13, 17, 26, 0.94) 100%);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 28rpx;
  padding: 22rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.06);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  box-sizing: border-box;
  width: 100%;
  transition: all 0.35s ease;
}

/* VIP 会员专属顶部名片：曜世黑金底座 + 尊享流光边框 */
.user-profile-header-card.is-vip-profile-card {
  background: linear-gradient(135deg, rgba(44, 34, 18, 0.94) 0%, rgba(20, 16, 10, 0.98) 55%, rgba(36, 26, 12, 0.94) 100%);
  border: 1px solid rgba(245, 208, 128, 0.45);
  box-shadow: 0 14rpx 42rpx rgba(0, 0, 0, 0.65), 0 0 28rpx rgba(212, 175, 55, 0.16), inset 0 1px 0 rgba(255, 236, 179, 0.25);
}

.user-profile-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-width: 0;
}

/* 左侧头像与昵称组合：头像严格靠左，名字紧随其后 */
.user-profile-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
}

.user-avatar-wrap {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  flex-shrink: 0;
}

/* 微信原生头像按钮：严格靠左对齐，彻底清除微信默认 button:not([size='mini']) 的 184px 宽度与 margin: auto */
button.user-avatar-btn,
.user-avatar-btn {
  position: relative !important;
  width: 96rpx !important;
  min-width: 96rpx !important;
  max-width: 96rpx !important;
  height: 96rpx !important;
  min-height: 96rpx !important;
  max-height: 96rpx !important;
  padding: 0 !important;
  margin: 0 !important;
  margin-left: 0 !important;
  margin-right: 0 !important;
  background: transparent !important;
  border-radius: 50% !important;
  border: none !important;
  line-height: normal !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  overflow: hidden !important;
  flex-shrink: 0 !important;
}

button.user-avatar-btn::after,
.user-avatar-btn::after {
  display: none !important;
  border: none !important;
  width: 0 !important;
  height: 0 !important;
}

.user-avatar-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(56, 189, 248, 0.4);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.5), 0 0 12rpx rgba(56, 189, 248, 0.15);
  background: #0f172a;
  display: block;
  flex-shrink: 0;
}

.user-avatar-img.vip-avatar-img {
  border: 3rpx solid #f5d080;
  box-shadow: 0 4rpx 18rpx rgba(0, 0, 0, 0.65), 0 0 18rpx rgba(245, 208, 128, 0.42);
}

.profile-avatar-vip-crown {
  position: absolute;
  top: -10rpx;
  right: -6rpx;
  font-size: 26rpx;
  line-height: 1;
  filter: drop-shadow(0 2rpx 6rpx rgba(0, 0, 0, 0.85));
  pointer-events: none;
  z-index: 3;
}

/* 名字列：紧贴头像右侧 */
.user-info-col {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.user-nickname-input {
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
  caret-color: transparent !important;
  line-height: 46rpx;
  height: 46rpx;
  min-height: 46rpx;
  letter-spacing: 0.5rpx;
  background: transparent;
  border: none;
  outline: none;
  padding: 0;
  margin: 0;
  max-width: 380rpx;
}

.user-nickname-input.vip-nickname-gold {
  color: #fde68a;
  text-shadow: 0 2rpx 10rpx rgba(245, 208, 128, 0.25);
}

.user-meta-subrow {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 6rpx;
  cursor: pointer;
}

.user-meta-smoke-info {
  font-size: 21rpx;
  color: #94a3b8;
  line-height: 1.3;
}

.profile-vip-nameplate {
  display: inline-flex;
  align-items: center;
  align-self: flex-start;
  padding: 3rpx 14rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, rgba(245, 208, 128, 0.22) 0%, rgba(212, 175, 55, 0.08) 100%);
  border: 1px solid rgba(245, 208, 128, 0.45);
  font-size: 20rpx;
  font-weight: 700;
  color: #f5d080;
  letter-spacing: 1rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.35);
  transition: all 0.25s ease;
}

.profile-vip-nameplate.is-vip-inactive {
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.16);
  color: #94a3b8;
  box-shadow: none;
}

.profile-vip-nameplate.is-vip-inactive .pvn-crown {
  filter: grayscale(1);
  opacity: 0.65;
}

.profile-action-pills-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding-top: 14rpx;
  border-top: 1px solid rgba(255, 255, 255, 0.06);
}

.profile-action-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.12);
  transition: all 0.2s ease;
  cursor: pointer;
}

.profile-action-pill:active {
  transform: scale(0.95);
  background: rgba(255, 255, 255, 0.14);
}

.profile-action-pill.settings-pill {
  flex: 1;
  background: rgba(56, 189, 248, 0.1);
  border-color: rgba(56, 189, 248, 0.28);
}

.profile-action-pill.leaderboard-pill {
  background: linear-gradient(135deg, rgba(245, 158, 11, 0.16) 0%, rgba(217, 119, 6, 0.08) 100%);
  border-color: rgba(245, 158, 11, 0.35);
}

.pap-text {
  font-size: 22rpx;
  font-weight: 600;
  color: #e2e8f0;
  line-height: 1.2;
}

.leaderboard-pill .pap-text {
  color: #fbbf24;
}

/* 最右边打卡状态方卡 (已打卡 / X天) */
.user-punch-card {
  flex-shrink: 0;
  margin-left: 16rpx;
  min-width: 110rpx;
  padding: 10rpx 16rpx;
  background: linear-gradient(135deg, rgba(16, 28, 28, 0.88) 0%, rgba(10, 20, 22, 0.96) 100%);
  border: 1px solid rgba(16, 185, 129, 0.28);
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.05);
  transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), border-color 0.2s;
  cursor: pointer;
}

.user-punch-card:active {
  transform: scale(0.92);
  border-color: rgba(52, 211, 153, 0.7);
  box-shadow: 0 2rpx 10rpx rgba(52, 211, 153, 0.4);
}

.punch-card-title {
  font-size: 20rpx;
  color: #94a3b8;
  line-height: 1.2;
  margin-bottom: 2rpx;
}

.punch-card-days-row {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 2rpx;
}

.punch-card-num {
  font-size: 34rpx;
  font-weight: 800;
  color: #34d399;
  line-height: 1.1;
  text-shadow: 0 0 10rpx rgba(52, 211, 153, 0.35);
}

.punch-card-unit {
  font-size: 22rpx;
  font-weight: 600;
  color: #a7f3d0;
}

/* ==================== VIP 尊享特权入口横幅 (腾讯黑金曜石奢雅标准) ==================== */
.vip-entry-banner {
  position: relative;
  background: 
    radial-gradient(ellipse at 88% -10%, rgba(229, 192, 123, 0.16) 0%, transparent 60%),
    radial-gradient(ellipse at 10% 110%, rgba(56, 189, 248, 0.06) 0%, transparent 50%),
    linear-gradient(135deg, rgba(22, 28, 42, 0.90) 0%, rgba(13, 17, 26, 0.96) 100%);
  border: 1px solid rgba(229, 192, 123, 0.24);
  border-radius: 26rpx;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, 0.42), inset 0 1px 0 rgba(254, 240, 138, 0.16);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  overflow: hidden;
  box-sizing: border-box;
  width: 100%;
  transition: all 0.2s ease;
}

.vip-entry-banner:active {
  transform: scale(0.985);
  border-color: rgba(229, 192, 123, 0.4);
}

.vip-banner-left {
  display: flex;
  align-items: center;
  gap: 18rpx;
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
}

/* 3D 曜石黑金微光皇冠容器 */
.vb-emblem-wrap {
  width: 60rpx;
  height: 60rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.vb-emblem-svg {
  width: 60rpx;
  height: 60rpx;
  display: block;
}

.vip-banner-text {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  flex: 1;
  min-width: 0;
}

.vb-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

/* 标题：奢雅香槟白金 */
.vb-main {
  font-size: 28rpx;
  font-weight: 700;
  color: #f7e7ca;
  letter-spacing: 0.8rpx;
  line-height: 1.2;
}

/* 黑金超微胶囊微标 */
.vb-black-gold-tag {
  font-size: 18rpx;
  font-weight: 700;
  color: #e5c07b;
  background: rgba(229, 192, 123, 0.12);
  border: 1px solid rgba(229, 192, 123, 0.32);
  padding: 2rpx 12rpx;
  border-radius: 999px;
  letter-spacing: 0.5rpx;
  line-height: 1.2;
  flex-shrink: 0;
}

/* 副文案：钛银冷灰，清晰可读 */
.vb-sub {
  font-size: 22rpx;
  color: #8c9bb0;
  line-height: 1.3;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 右侧 CTA 胶囊：丝滑香槟钛金 */
.vip-banner-btn {
  background: linear-gradient(135deg, #f5d499 0%, #d4a757 100%);
  border: 1px solid rgba(255, 255, 255, 0.4);
  padding: 10rpx 22rpx;
  border-radius: 999px;
  box-shadow: 0 4rpx 16rpx rgba(212, 167, 87, 0.35);
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.vbb-text {
  font-size: 22rpx;
  font-weight: 800;
  color: #17120a;
  letter-spacing: 0.5rpx;
  line-height: 1;
}

/* ==================== 3. 钱包 (一张纸币是一元 × 金额，调皮搞笑微缩纸币) ==================== */
.wallet-section-card {
  background: linear-gradient(135deg, rgba(16, 36, 26, 0.92) 0%, rgba(9, 20, 15, 0.96) 100%);
  border: 1px solid rgba(52, 211, 153, 0.3);
  border-radius: 28rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.08);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  box-sizing: border-box;
}

.wallet-top-header {
  margin-bottom: 16rpx;
}

.sec-pill-tag {
  font-size: 18rpx;
  color: #34d399;
  background: rgba(52, 211, 153, 0.15);
  border: 1px solid rgba(52, 211, 153, 0.35);
  padding: 2rpx 10rpx;
  border-radius: 12rpx;
  font-weight: 600;
  margin-left: 10rpx;
}

/* 核心算式展台：[调皮1元小纸币] × 金额 = 累计省下 */
.wallet-formula-stage {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 6rpx 10rpx;
  width: 100%;
  box-sizing: border-box;
}

/* 调皮搞笑 1 元微缩纸币外层包裹 (带多层叠钞质感与 Q 弹触感) */
.funny-mini-bill-wrap {
  position: relative;
  width: 240rpx;
  height: 122rpx;
  flex-shrink: 0;
  cursor: pointer;
  transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.funny-mini-bill-wrap:active {
  transform: scale(0.92) rotate(-2deg);
}

/* 3D 叠纸堆叠背板效果 (厚度与立体感) */
.bill-stack-back {
  position: absolute;
  border-radius: 10rpx;
  background: #154530;
  border: 1px solid rgba(52, 211, 153, 0.3);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.4);
}

.bill-stack-back.layer-2 {
  top: -4rpx;
  left: -4rpx;
  right: 4rpx;
  bottom: 4rpx;
  opacity: 0.5;
}

.bill-stack-back.layer-1 {
  top: -2rpx;
  left: -2rpx;
  right: 2rpx;
  bottom: 2rpx;
  opacity: 0.75;
}

/* 钞票图片容器 */
.bill-img-container {
  position: relative;
  width: 100%;
  height: 100%;
  border-radius: 10rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.5), 0 0 10rpx rgba(52, 211, 153, 0.35);
  border: 1.5rpx solid rgba(52, 211, 153, 0.6);
  background: #0f2c1f;
}

.funny-banknote-img {
  width: 100%;
  height: 100%;
  display: block;
}

/* 算式符号 */
.formula-operator {
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1;
  padding: 0 6rpx;
}

.formula-multiply {
  color: #34d399;
  text-shadow: 0 0 8rpx rgba(52, 211, 153, 0.4);
}

.formula-equal {
  color: #64748b;
}

/* 乘数金额 */
.formula-multiplier-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 80rpx;
}

.multiplier-num {
  font-size: 40rpx;
  font-weight: 900;
  color: #f8fafc;
  font-family: monospace;
  line-height: 1;
}

.multiplier-label {
  font-size: 18rpx;
  color: #94a3b8;
  margin-top: 6rpx;
}

/* 累计结果 */
.formula-result-box {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: center;
  min-width: 120rpx;
}

.result-val-row {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
}

.result-yen {
  font-size: 22rpx;
  font-weight: 800;
  color: #fbbf24;
}

.result-val {
  font-size: 38rpx;
  font-weight: 900;
  color: #fbbf24;
  line-height: 1;
  font-family: monospace;
  text-shadow: 0 0 10rpx rgba(251, 191, 36, 0.35);
}

.result-label {
  font-size: 18rpx;
  color: #94a3b8;
  margin-top: 6rpx;
}

/* 底部幽默提示条 */
.wallet-humor-footer {
  margin-top: 14rpx;
  padding: 10rpx 14rpx;
  background: rgba(0, 0, 0, 0.25);
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.whf-icon {
  font-size: 22rpx;
}

.whf-text {
  font-size: 20rpx;
  color: #6ee7b7;
  font-weight: 500;
}

/* ==================== 5. 系统统计 (3项关键数据 + 7天累计折线图) ==================== */
.system-stats-card {
  background: rgba(22, 28, 40, 0.78);
  border: 1px solid rgba(255, 255, 255, 0.08);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-radius: 28rpx;
  padding: 24rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.35);
}

.stats-top-four-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.st-cell {
  background: rgba(255, 255, 255, 0.035);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 18rpx;
  padding: 16rpx 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.st-cell.gold-cell {
  background: rgba(245, 158, 11, 0.08);
  border-color: rgba(245, 158, 11, 0.25);
}

.st-num {
  font-size: 30rpx;
  font-weight: 800;
  color: #f8fafc;
  line-height: 1.2;
}

.st-num.gold {
  color: #fbbf24;
}

.st-label {
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 6rpx;
}

/* 抢回健康寿命 (吸烟统计中纯文字展示) */
.stats-life-text-row {
  display: flex;
  align-items: baseline;
  justify-content: flex-start;
  padding: 4rpx 8rpx;
  margin-bottom: 16rpx;
  line-height: 1.4;
}

.life-text-label {
  font-size: 24rpx;
  color: #94a3b8;
  font-weight: 500;
}

.life-text-val {
  font-size: 26rpx;
  color: #38bdf8;
  font-weight: 700;
  margin-left: 2rpx;
}

.life-text-sub {
  font-size: 22rpx;
  color: #64748b;
  margin-left: 6rpx;
}

.line-chart-box {
  background: rgba(11, 15, 25, 0.65);
  border: 1px solid rgba(255, 255, 255, 0.06);
  border-radius: 20rpx;
  padding: 16rpx;
  display: flex;
  flex-direction: column;
}

.lcb-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.lcb-title {
  font-size: 24rpx;
  color: #cbd5e1;
  font-weight: 600;
}

.lcb-badge {
  font-size: 20rpx;
  color: #34d399;
  background: rgba(16, 185, 129, 0.15);
  border-radius: 8rpx;
  padding: 2rpx 8rpx;
}

.trend-line-chart-img {
  width: 100%;
  height: auto;
  display: block;
}

/* WHO 临床时间轴 */
.who-section-card {
  background: rgba(22, 28, 40, 0.78);
  border: 1px solid rgba(255, 255, 255, 0.08);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.35);
}

.who-medical-spine {
  display: flex;
  flex-direction: column;
}

.who-node-item {
  display: flex;
  gap: 20rpx;
}

.node-spine-axis {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 32rpx;
}

