  box-shadow: 0 0 8rpx rgba(56, 189, 248, 0.7);
  animation: flowUpwards 1.75s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  will-change: transform, opacity;
}

/* 腹主动脉下行流光 */
.aorta-blood-flow {
  position: absolute;
  left: 4rpx;
  width: 5rpx;
  height: 38rpx;
