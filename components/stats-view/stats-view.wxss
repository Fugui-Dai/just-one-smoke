@keyframes synapseFlicker {
  0%, 100% { transform: scale(0.7); opacity: 0.25; }
  45% { transform: scale(0.7); opacity: 0.25; }
  50% { transform: scale(1.45); opacity: 1; filter: drop-shadow(0 0 8rpx #fbbf24); }
  55% { transform: scale(0.9); opacity: 0.45; }
