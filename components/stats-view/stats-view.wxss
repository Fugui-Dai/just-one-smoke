  background: linear-gradient(180deg, rgba(239, 68, 68, 0) 0%, rgba(239, 68, 68, 0.85) 60%, rgba(245, 158, 11, 1) 100%);
  box-shadow: 0 0 10rpx rgba(239, 68, 68, 0.7);
