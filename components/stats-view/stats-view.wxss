/* 1. 心脏真实生理节律泵核 (Cardiac Pulse Core · lub-dub 1.25s) */
.cardiac-chamber-core {
  position: absolute;
  left: 218rpx;
  top: 206rpx;
  width: 36rpx;
  height: 46rpx;
  margin-left: -18rpx;
  margin-top: -23rpx;
  border-radius: 50% 50% 45% 45%;
  background: radial-gradient(ellipse at 50% 40%, rgba(255, 60, 60, 0.92) 0%, rgba(239, 68, 68, 0.6) 45%, rgba(245, 158, 11, 0.25) 75%, transparent 100%);
  filter: blur(2px);
  transform-origin: center center;
  animation: cardiacLubDub 1.25s cubic-bezier(0.25, 0.1, 0.25, 1) infinite;
  will-change: transform, opacity;
}

@keyframes cardiacLubDub {
  0% { transform: scale(0.95); opacity: 0.35; }
  12% { transform: scale(1.24); opacity: 0.95; } /* 第一心音：强缩射血 */
  22% { transform: scale(1.02); opacity: 0.55; }
  32% { transform: scale(1.14); opacity: 0.82; } /* 第二心音：微弹射血 */
  48% { transform: scale(0.98); opacity: 0.40; }
  100% { transform: scale(0.95); opacity: 0.35; } /* 舒张充盈静息 */
}

.cardiac-aorta-wave {
  position: absolute;
  left: 218rpx;
  top: 206rpx;
  width: 72rpx;
  height: 72rpx;
  margin-left: -36rpx;
  margin-top: -36rpx;
  border-radius: 50%;
  border: 1.5rpx solid rgba(255, 99, 71, 0.65);
  box-shadow: 0 0 16rpx rgba(239, 68, 68, 0.5);
  transform-origin: center center;
  animation: aortaWavePulse 1.25s cubic-bezier(0.1, 0.8, 0.2, 1) infinite;
  will-change: transform, opacity;
}

@keyframes aortaWavePulse {
  0% { transform: scale(0.35); opacity: 0; }
  14% { transform: scale(0.65); opacity: 0.85; }
  42% { transform: scale(1.35); opacity: 0; }
  100% { transform: scale(1.35); opacity: 0; }
}

/* 2. 动静脉向心与离心微光血管流道 (Vascular Tracks & Flows) */
.vascular-track {
  position: absolute;
  pointer-events: none;
  overflow: hidden;
  border-radius: 999px;
}

/* 左臂上段 (大臂) */
.v-track-arm-l-upper {
  left: 116rpx;
  top: 188rpx;
  width: 14rpx;
  height: 125rpx;
  transform: rotate(26deg);
  transform-origin: top center;
}

/* 左臂下段 (小臂至手腕) */
.v-track-arm-l-lower {
  left: 72rpx;
  top: 300rpx;
  width: 14rpx;
  height: 155rpx;
  transform: rotate(18deg);
  transform-origin: top center;
}

/* 右臂上段 (大臂) */
.v-track-arm-r-upper {
  right: 116rpx;
  top: 188rpx;
  width: 14rpx;
  height: 125rpx;
  transform: rotate(-26deg);
  transform-origin: top center;
}

/* 右臂下段 (小臂至手腕) */
.v-track-arm-r-lower {
  right: 72rpx;
  top: 300rpx;
  width: 14rpx;
  height: 155rpx;
  transform: rotate(-18deg);
  transform-origin: top center;
}

